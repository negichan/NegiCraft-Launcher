<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 零 UI 依赖、零 NuGet 依赖：像素画与软件光栅化都是纯计算，
         两个平台（WPF / Avalonia）共用同一份源码。 -->
  </PropertyGroup>

  <ItemGroup>
    <!-- 内置默认皮肤（Steve / Alex），供共享层生成默认头像。
         注意 Skin 工程里也各有一份，是给 GL 渲染栈用的，两边都不互相引用。 -->
    <EmbeddedResource Include="Assets\skin_alex.png" />
    <EmbeddedResource Include="Assets\skin_steve.png" />

    <!-- 加载器标志。Fabric / NeoForge / Quilt 用官方方形标志
         （Fabric 的 MIT、NeoForge 的 Unlicense、Quilt 的 art 仓库未附 LICENSE），
         声明都写在 Assets/ICONS-NOTICE.md 里。
         **Forge 不在这里** —— 它的实例改用游戏里的铁砧方块渲染（见 MainWindowViewModel.ForgeBlockType）。
         OptiFine 闭源、没有任何可用的官方方形标志，也回落到方块。
         NeoForge 存了两版：icon_neoforge.png 是官方那只狐狸，
         icon_neoforge_negi.png 是从本项目自己的 app.png 裁出来的橙狐狸（NegiPet）——
         两家都是狐狸，用哪只由 MainWindowViewModel.NeoForgeIcon 决定。 -->
    <EmbeddedResource Include="Assets\icon_fabric.png" />
    <EmbeddedResource Include="Assets\icon_quilt.png" />
    <EmbeddedResource Include="Assets\icon_neoforge.png" />
    <EmbeddedResource Include="Assets\icon_neoforge_negi.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- 只引用零依赖的 Core：几何表、UV 表、位姿数学、走路动画。
         刻意**不**引用 MinecraftSkinRender（Skia 侧那个）—— 那会把 SkiaSharp 拖进 WPF 包，
         而 WPF 迁移的全部意义就是甩掉 libSkiaSharp。 -->
    <ProjectReference Include="..\..\libs\MinecraftSkinRender.Core\MinecraftSkinRender.Core.csproj" />
  </ItemGroup>

</Project>
