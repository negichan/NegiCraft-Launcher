<Window x:Class="NegiCraftLauncher.App.Wpf.Probe.ThemeGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:neg="clr-namespace:NegiCraftLauncher.Theme.Wpf;assembly=NegiCraftLauncher.Theme.Wpf"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="NegiCraft Launcher — WPF theme gallery"
        Width="560"
        SizeToContent="Height"
        WindowStyle="None"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">
    <!--
        P4 的验证画廊：把主题里每一个控件摆一遍，离屏截图后与 Avalonia 版对照。
        它不是产品界面，只是让"样式搬对了没有"这件事能被看见。
        「theme」参数会把它起在屏幕外、截完图就关掉，全程不动光标、不抢焦点。

        每个小节都包在带 x:Name 的 StackPanel 里 —— 探针会**逐小节**单独出一张图。
        整张长图缩略之后 4px/6px 的细节全糊了，只有分块出图才看得清。
    -->
    <StackPanel Margin="20">

        <TextBlock Text="NegiCraft Launcher — WPF 主题画廊"
                   FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource ForegroundBrush}" />
        <TextBlock Text="与 Avalonia 版 NegiCraftLauncher.Theme 逐控件对照"
                   FontSize="12" Margin="0,4,0,16"
                   Foreground="{DynamicResource MutedForegroundBrush}" />

        <StackPanel x:Name="SecButton">
            <TextBlock Text="Button" FontSize="12" Margin="2,0,0,6"
                       Foreground="{DynamicResource MutedForegroundBrush}" />
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="16" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <Button Content="默认" Background="{DynamicResource AccentBrush}"
                            BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1"
                            Height="36" Margin="0,0,10,0" />
                    <Button Content="主色" Background="{DynamicResource PrimaryBrush}"
                            Foreground="{DynamicResource PrimaryForegroundBrush}"
                            Height="36" Margin="0,0,10,0" />
                    <Button Content="禁用" Background="{DynamicResource AccentBrush}" IsEnabled="False"
                            Height="36" Margin="0,0,10,0" />
                    <Button Content="小圆角" Background="{DynamicResource AccentBrush}" neg:Negi.CornerRadius="4"
                            Height="36" />
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel x:Name="SecTextBox">
            <TextBlock Text="TextBox（含水印）" FontSize="12" Margin="2,0,0,6"
                       Foreground="{DynamicResource MutedForegroundBrush}" />
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBox neg:Negi.Placeholder="搜索" Height="36" Margin="0,0,0,10" />
                    <TextBox Text="已经填好的内容" Height="36" Margin="0,0,0,10" />
                    <TextBox neg:Negi.Placeholder="禁用态" IsEnabled="False" Height="36" Margin="0,0,0,10" />
                    <!-- 跟主页搜索框一样：左侧留出图标的位置 -->
                    <TextBox neg:Negi.Placeholder="搜索（左侧留图标位）" Padding="34,0,10,0" Height="36" />
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel x:Name="SecCheckBox">
            <TextBlock Text="CheckBox — 承担 Avalonia ToggleSwitch 的角色" FontSize="12" Margin="2,0,0,6"
                       Foreground="{DynamicResource MutedForegroundBrush}" />
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="16" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <CheckBox IsChecked="False" Margin="0,0,24,0" />
                    <CheckBox IsChecked="True" Margin="0,0,24,0" />
                    <CheckBox IsChecked="True" IsEnabled="False" />
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel x:Name="SecSlider">
            <TextBlock Text="Slider" FontSize="12" Margin="2,0,0,6"
                       Foreground="{DynamicResource MutedForegroundBrush}" />
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <Slider Minimum="0" Maximum="100" Value="0" Margin="0,0,0,8" />
                    <Slider Minimum="0" Maximum="100" Value="25" Margin="0,0,0,8" />
                    <Slider Minimum="0" Maximum="100" Value="50" Margin="0,0,0,8" />
                    <Slider Minimum="0" Maximum="100" Value="75" Margin="0,0,0,8" />
                    <Slider Minimum="0" Maximum="100" Value="100" />
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel x:Name="SecProgress">
            <TextBlock Text="ProgressBar" FontSize="12" Margin="2,0,0,6"
                       Foreground="{DynamicResource MutedForegroundBrush}" />
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <!-- 高度 4 是项目里的实际用法（默认圆角 2 正好是一半，成胶囊） -->
                    <ProgressBar Minimum="0" Maximum="100" Value="0" Height="4" Margin="0,0,0,8" />
                    <ProgressBar Minimum="0" Maximum="100" Value="25" Height="4" Margin="0,0,0,8" />
                    <ProgressBar Minimum="0" Maximum="100" Value="60" Height="4" Margin="0,0,0,8" />
                    <ProgressBar Minimum="0" Maximum="100" Value="100" Height="4" Margin="0,0,0,8" />
                    <!-- 不定态：应用里资源加载那处就是它 -->
                    <ProgressBar IsIndeterminate="True" Width="120" Height="4" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel x:Name="SecScroll">
            <TextBlock Text="ScrollViewer + ScrollBar" FontSize="12" Margin="2,0,0,6"
                       Foreground="{DynamicResource MutedForegroundBrush}" />
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="16" Margin="0,0,0,16">
                <ScrollViewer Height="96" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="第一行" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,6" />
                        <TextBlock Text="第二行" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,6" />
                        <TextBlock Text="第三行" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,6" />
                        <TextBlock Text="第四行" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,6" />
                        <TextBlock Text="第五行" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,6" />
                        <TextBlock Text="第六行" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,6" />
                        <TextBlock Text="第七行" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,6" />
                        <TextBlock Text="第八行" Foreground="{DynamicResource ForegroundBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <StackPanel x:Name="SecMenu">
            <TextBlock Text="MenuItem（ContextMenu 的样子）" FontSize="12" Margin="2,0,0,6"
                       Foreground="{DynamicResource MutedForegroundBrush}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border Style="{StaticResource NegiMenuPopupBorderStyle}" Width="180">
                    <StackPanel>
                        <MenuItem Header="设为当前" />
                        <MenuItem Header="配置实例" />
                        <MenuItem Header="重命名" />
                        <Separator />
                        <MenuItem Header="删除" />
                        <MenuItem Header="禁用项" IsEnabled="False" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>

        <!--  ToolTip 不在这里展示：WPF 的 ToolTip 不允许有逻辑/视觉父级，塞进 StackPanel 会直接抛
            "ToolTip 不能有逻辑或视觉父级"。它的样式由报告里的资源检查覆盖。  -->
        <StackPanel x:Name="SecItems">
            <TextBlock Text="ItemsControl" FontSize="12" Margin="2,0,0,6"
                       Foreground="{DynamicResource MutedForegroundBrush}" />
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="16">
                <ItemsControl Padding="2">
                    <ItemsControl.Items>
                        <sys:String>ItemsControl 第一项</sys:String>
                        <sys:String>ItemsControl 第二项</sys:String>
                    </ItemsControl.Items>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Margin="0,0,0,4"
                                       Foreground="{DynamicResource ForegroundBrush}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>

    </StackPanel>
</Window>
