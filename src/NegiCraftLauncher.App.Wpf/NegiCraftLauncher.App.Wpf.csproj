<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 端走原生 WPF；macOS / Linux 继续用 Avalonia 那份（NegiCraftLauncher.App）。
         两边共用 Core / ViewModels / Raster，只有 view 层不同。 -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- 软件光栅化器要直接写 WriteableBitmap 的后备缓冲。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>NegiCraftLauncher</AssemblyName>
    <RootNamespace>NegiCraftLauncher.App.Wpf</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- 托盘图标走 WinForms 的 NotifyIcon：WPF 自己没有托盘 API，而 System.Windows.Forms
         本来就随 Microsoft.WindowsDesktop.App 一起发布，框架依赖模式下不增加体积。 -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WFO0003 是 WinForms 分析器在劝人别用 manifest 配 DPI。我们只借 NotifyIcon，
         界面全是 WPF，而 WPF 正是靠 manifest 的 dpiAware 声明工作的，所以这条关掉。 -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms 会顺手把 System.Windows.Forms / System.Drawing 塞进隐式 using，
         于是 App / Control / Point / Image / KeyEventArgs 全部二义。这里把这两条摘掉，
         只在需要托盘的 MainWindow.xaml.cs 里用 Forms 别名显式引用。 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.1" />
    <!-- 与 Avalonia 侧同项目同版本，图标名（Kind）两边一致，XAML 可以逐行对照。 -->
    <PackageReference Include="Material.Icons.WPF" Version="3.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NegiCraftLauncher.Core\NegiCraftLauncher.Core.csproj" />
    <!-- 与 Avalonia 那份完全同一套逻辑：VM 与像素层都不含任何 UI 框架类型。 -->
    <ProjectReference Include="..\NegiCraftLauncher.Raster\NegiCraftLauncher.Raster.csproj" />
    <ProjectReference Include="..\NegiCraftLauncher.ViewModels\NegiCraftLauncher.ViewModels.csproj" />
    <!-- WPF 侧的 view 层主题。与 Avalonia 的 NegiCraftLauncher.Theme 是两份独立资产。 -->
    <ProjectReference Include="..\NegiCraftLauncher.Theme.Wpf\NegiCraftLauncher.Theme.Wpf.csproj" />
  </ItemGroup>

</Project>
