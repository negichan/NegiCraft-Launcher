<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia's build tasks auto-glob **/*.axaml into both AvaloniaXaml (compiled) and
         AvaloniaResource (addressable via avares://), so the theme files need no explicit items. -->
    <PackageReference Include="Avalonia" Version="12.1.3" />
  </ItemGroup>
</Project>
