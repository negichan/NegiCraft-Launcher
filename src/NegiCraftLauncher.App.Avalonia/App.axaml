<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NegiCraftLauncher.App.Avalonia.App"
             xmlns:local="using:NegiCraftLauncher.App.Avalonia"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <StyleInclude Source="avares://NegiCraftLauncher.Theme.Avalonia/Theme.axaml"/>
        <!-- 图标控件不用注册样式：它在 Render 里自绘（默认前景色由控件自己给）。 -->
    </Application.Styles>
</Application>