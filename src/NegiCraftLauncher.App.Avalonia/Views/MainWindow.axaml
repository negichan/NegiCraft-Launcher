<!-- 1180x720 is the *visible* window (Shell); the window itself opens at 1300x840 with
     60 on each side as room for the drop shadow. Tailwind's shadow-lg overflows only
     ~12px sideways / ~22px down, so most of that margin is slack — kept anyway, since
     shrinking it would move the window rect for no visible gain.
     A borderless transparent window cannot paint outside its own rect, so the window is
     grown and Shell sits inset instead. The fully transparent margin is click-through. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NegiCraftLauncher.ViewModels"
        xmlns:models="using:NegiCraftLauncher.ViewModels"
        xmlns:conv="using:NegiCraftLauncher.App.Avalonia.Converters"
        xmlns:controls="using:NegiCraftLauncher.Skin.Avalonia.Controls"
        xmlns:pop="using:NegiCraftLauncher.App.Avalonia.Views"
        xmlns:materialIcons="clr-namespace:NegiCraftLauncher.Icons.Avalonia;assembly=NegiCraftLauncher.Icons.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="720"
        x:Class="NegiCraftLauncher.App.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1300" Height="840"
        MinWidth="1080" MinHeight="740"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Icon="avares://NegiCraftLauncher.Avalonia/Assets/app.ico"
        DragDrop.AllowDrop="True"
        KeyDown="OnWindowKeyDown"
        KeyUp="OnWindowKeyUp"
        Title="NegiCraft Launcher">

    <Window.Resources>
        <!-- The VM only carries platform-neutral pixels (NegiCraftLauncher.Raster.PixelBuffer);
             turning them into an Avalonia Bitmap is the view's job. -->
        <conv:PixelBufferToBitmapConverter x:Key="PixelsToBitmap"/>
        <conv:PathToBitmapConverter x:Key="PathToBitmap"/>
        <!-- One download-task row, shared by the popover and the settings 下载中心 list.
             Action buttons reach the window VM because the row's own type is DownloadTaskModel. -->
        <DataTemplate x:Key="DownloadRowTemplate" x:DataType="models:DownloadTaskModel">
            <Border BorderBrush="#26262b" BorderThickness="0,0,0,1" Padding="12,10">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="* Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"
                                       Foreground="#fafafa" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#a1a1aa"/>
                                <TextBlock Text="{Binding PercentText}" FontSize="12" Foreground="#71717a"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Classes="BtnSm BtnOutline" Content="暂停" Height="26" FontSize="12" Padding="10,0"
                                    IsVisible="{Binding IsRunning}"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PauseDownloadTaskCommand}"
                                    CommandParameter="{Binding .}"/>
                            <Button Classes="BtnSm BtnOutline" Content="取消" Height="26" FontSize="12" Padding="10,0"
                                    IsVisible="{Binding IsRunning}"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CancelDownloadTaskCommand}"
                                    CommandParameter="{Binding .}"/>
                            <Button Classes="BtnSm BtnOutline" Content="继续" Height="26" FontSize="12" Padding="10,0"
                                    IsVisible="{Binding CanResume}"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ResumeDownloadTaskCommand}"
                                    CommandParameter="{Binding .}"/>
                        </StackPanel>
                    </Grid>
                    <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4"
                                 CornerRadius="999" Foreground="#fafafa" Background="#26262b"/>
                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="#71717a"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <!-- 这扇窗自己的全部选择器样式（NavBtn / Sidebar / WinCtrl / Popover / InstCard …）。
             拆出去只为让这个文件回到「结构」本身；要加新样式请改那个文件。 -->
        <StyleInclude Source="avares://NegiCraftLauncher.Avalonia/Styles/MainStyles.axaml"/>
    </Window.Styles>

    <!-- Outermost Window Shell: 22px border radius, background #09090b, **no outline** —
         the shell reads against the desktop from its own fill plus the shadow below.
         Do not add a BorderThickness here: it would inset every child by that much. -->
    <!-- Wrapper Panel: keeps the window's Content a full-size (1300x840) element so the
         debug bridge's `shot` (which renders Window.Content) includes the shadow margin —
         same as the WPF side, whose root is a Grid. Without it Content would be the
         inset Shell (1180x720) and the shadow would never appear in a screenshot. -->
    <Panel>
    <!-- Shadow caster: a separate Border that only exists to cast the shadow; the Shell
         (same rect, painted on top) covers its body completely.
         ⚠️ The BoxShadow must NOT live on Shell itself: Shell has ClipToBounds="True",
         and Avalonia clips a visual's *own* drawing to its bounds too — so the shadow
         (painted outside the rect) got cut away entirely and never showed.
         Value = Tailwind v4 `shadow-lg` verbatim (two layers, both black at 10%).
         Avalonia parses the comma-separated list and the negative spread natively, so
         this is a 1:1 port; the WPF side has to fake it with two casters.
         Margin 60 = exactly the Shell's rect: the insetting is the spread's job. -->
    <Border x:Name="ShellShadowCaster"
            Margin="60"
            Background="#09090b"
            CornerRadius="22"
            IsHitTestVisible="False"
            BoxShadow="0 10 15 -3 #1A000000, 0 4 6 -4 #1A000000"/>
    <!-- Margin 60 = room for the shadow, which is painted outside this Border's rect. -->
    <Border x:Name="Shell"
            Margin="60"
            Background="#09090b"
            CornerRadius="22"
            ClipToBounds="True">

        <Panel>
            <!-- ========================================== -->
            <!-- 1. PIXEL BACKGROUND & SHADE (every page)   -->
            <!-- ========================================== -->
            <!-- 以前这块只在首页露出，其他页是壳那层死黑 #09090b。现在整窗一张背景，
                 侧栏玻璃与导航按钮的"透光态"也跟着变成唯一态。 -->
            <Panel>
                <!-- The generated 240x146 scene is stretched to fill and kept crisp; a picked photo
                     is cropped to the shell and interpolated. RenderOptions cannot be bound, so the
                     two cases are separate elements. -->
                <Panel x:Name="BgLayer">
                    <Panel.Effect>
                        <BlurEffect Radius="{Binding BgBlur}"/>
                    </Panel.Effect>
                    <Image Source="{Binding BgArt, Converter={StaticResource PixelsToBitmap}}"
                           Stretch="Fill"
                           RenderOptions.BitmapInterpolationMode="None"
                           IsVisible="{Binding !HasCustomBackground}"/>
                    <!-- Picked wallpaper: same shape as the WPF side — a Rectangle filled with one
                         shared ImageBrush whose SourceRect/DestinationRect are absolute, so the
                         framing math is identical on both stacks. Do NOT switch back to
                         <Image Stretch="UniformToFill"> + RenderTransform: an Image inflates its
                         own measured size to the cover result, so the element stops being the
                         visible rect and the pan range comes out wrong (measured on WPF: 1200
                         inside an 1180 shell ⇒ 5px short on every pan). -->
                    <Rectangle x:Name="BgCustomImage"
                               IsVisible="{Binding IsCustomBackground}"/>
                </Panel>

                <!-- 亮度: negative dims the art under a black wash, positive lifts it with a white one -->
                <Border Background="#ffffff" Opacity="{Binding BgLightOpacity}" IsHitTestVisible="False"/>
                <Border Background="#000000" Opacity="{Binding BgDarkOpacity}" IsHitTestVisible="False"/>

                <!-- .shade gradient overlay -->
                <Panel>
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,100%" EndPoint="0%,68%">
                                <GradientStop Color="#73000000" Offset="0.0"/>
                                <GradientStop Color="#00000000" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="100%,0%" EndPoint="55%,0%">
                                <GradientStop Color="#33000000" Offset="0.0"/>
                                <GradientStop Color="#00000000" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Panel>

            </Panel>

            <!-- ========================================== -->
            <!-- 2. TOP DRAG AREA & CONTROLS                -->
            <!-- ========================================== -->
            <!-- Draggable Region。稿子那条 .drag{z-index:25} 压在 .content{z-index:10} 之上，
                 网页里没症状（空 div，没有按下处理），搬进来就成了真 bug：页头那颗胶囊上半截 16px
                 归它管，点下去只拖窗口。所以降到内容层之下（9）—— 内容层不带 Background，
                 空的地方照样穿下来命中这条带子，而按钮该收的点击归按钮。 -->
            <Border x:Name="DragBand" Height="40" Margin="88,0,100,0"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    PointerPressed="OnDragAreaPointerPressed"
                    ZIndex="9"/>

            <!-- Top Right: ONLY Minimize & Close (1:1 with Material Icons) -->
            <!-- 这排也参与首页小人的绕障碍夹位（见 MainWindow.axaml.cs 的 ClampHomeSkinPlace）。 -->
            <StackPanel x:Name="TopRightControls" Orientation="Horizontal" Spacing="4"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,12,14,0" ZIndex="30">
                <Button Classes="WinCtrl" ToolTip.Tip="最小化" Click="OnMinimizeClick">
                    <materialIcons:MaterialIcon Kind="WindowMinimize" Width="17" Height="17"/>
                </Button>
                <Button Classes="WinCtrl Close" ToolTip.Tip="关闭" Click="OnCloseClick">
                    <materialIcons:MaterialIcon Kind="Close" Width="17" Height="17"/>
                </Button>
            </StackPanel>

            <!-- ========================================== -->
            <!-- 3. FROSTED BACKDROP UNDER THE SIDEBAR      -->
            <!-- ========================================== -->
            <Border x:Name="SidebarBackdrop"
                    HorizontalAlignment="Left" VerticalAlignment="Stretch"
                    Margin="12" Width="60"
                    CornerRadius="18"
                    ClipToBounds="True"
                    IsHitTestVisible="False"
                    ZIndex="19">
                <Panel>
                    <!-- the shell art again, offset back to the shell origin so it
                         registers with what the glass sits on top of -->
                    <Image Source="{Binding BgArt, Converter={StaticResource PixelsToBitmap}}"
                           Stretch="Fill"
                           HorizontalAlignment="Left" VerticalAlignment="Top"
                           Margin="-12,-12,0,0"
                           Width="{Binding #Shell.Bounds.Width}"
                           Height="{Binding #Shell.Bounds.Height}"
                           RenderOptions.BitmapInterpolationMode="None"
                           IsVisible="{Binding !HasCustomBackground}">
                        <Image.Effect>
                            <BlurEffect Radius="18"/>
                        </Image.Effect>
                    </Image>
                    <!-- Same brush instance as the main layer (assigned in code): its local rect is
                         the shell rect (the -12 margin cancels the backdrop's 12 margin), so one
                         absolute SourceRect serves both and they cannot drift apart. -->
                    <Rectangle x:Name="SidebarCustomImage"
                               HorizontalAlignment="Left" VerticalAlignment="Top"
                               Margin="-12,-12,0,0"
                               Width="{Binding #Shell.Bounds.Width}"
                               Height="{Binding #Shell.Bounds.Height}"
                               IsVisible="{Binding IsCustomBackground}">
                        <Rectangle.Effect>
                            <BlurEffect Radius="18"/>
                        </Rectangle.Effect>
                    </Rectangle>
                    <!-- same bottom shade as the art layer, so the glass is not brighter -->
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,100%" EndPoint="0%,68%">
                                <GradientStop Color="#73000000" Offset="0.0"/>
                                <GradientStop Color="#00000000" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Panel>
            </Border>

            <!-- ========================================== -->
            <!-- 4. FLOATING SIDEBAR (60px, radius 18, 12px)-->
            <!-- ========================================== -->
            <Border x:Name="Sidebar"
                    Classes="Sidebar"
                    HorizontalAlignment="Left" VerticalAlignment="Stretch"
                    Margin="12" Width="60"
                    CornerRadius="18"
                    BorderThickness="1"
                    BoxShadow="0 10 30 -12 #B0000000"
                    Padding="0,12"
                    ZIndex="20">
                <Grid RowDefinitions="Auto * Auto Auto">
                    <Image Grid.Row="0" Source="avares://NegiCraftLauncher.Avalonia/Assets/app.png"
                           Width="36" Height="36" Margin="0,0,0,8"
                           HorizontalAlignment="Center" IsHitTestVisible="False"/>

                    <!-- Center Nav: Home, Instances, Download, Resources -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="8" HorizontalAlignment="Center">
                        <!-- Home -->
                        <Button Classes="NavBtn"
                                Classes.Active="{Binding CurrentPage, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='home'}"
                                Command="{Binding GoCommand}" CommandParameter="home"
                                ToolTip.Tip="首页">
                            <materialIcons:MaterialIcon Kind="Home" Width="20" Height="20"/>
                        </Button>

                        <!-- Instances -->
                        <Button Classes="NavBtn"
                                Classes.Active="{Binding IsInstancesActive}"
                                Command="{Binding GoCommand}" CommandParameter="instances"
                                ToolTip.Tip="实例">
                            <materialIcons:MaterialIcon Kind="LayersOutline" Width="20" Height="20"/>
                        </Button>

                        <!-- Download (the version/resource browser; task list hangs off it) -->
                        <Button Classes="NavBtn"
                                Classes.Active="{Binding CurrentPage, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='download'}"
                                Command="{Binding GoCommand}" CommandParameter="download"
                                ToolTip.Tip="下载">
                            <materialIcons:MaterialIcon Kind="DownloadOutline" Width="20" Height="20"/>
                        </Button>
                    </StackPanel>

                    <!-- Bottom Nav: Settings -->
                    <Button Grid.Row="2" Classes="NavBtn"
                            Classes.Active="{Binding CurrentPage, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='settings'}"
                            Command="{Binding GoCommand}" CommandParameter="settings"
                            ToolTip.Tip="设置"
                            HorizontalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="CogOutline" Width="20" Height="20"/>
                    </Button>

                    <!-- Bottom Nav: Account Avatar -->
                    <Button x:Name="AccountAvatar"
                            Grid.Row="3"
                            Width="42" Height="42"
                            CornerRadius="12"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Margin="0,6,0,0"
                            Cursor="Hand"
                            Command="{Binding ToggleAccPopCommand}"
                            ToolTip.Tip="账户"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                        <Image Source="{Binding AvatarBitmap, Converter={StaticResource PixelsToBitmap}}"
                               Width="38" Height="38"
                               RenderOptions.BitmapInterpolationMode="None"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ========================================== -->
            <!-- 5. CONTENT AREA (Padding: 22 28 22 100)    -->
            <!-- ========================================== -->
            <Panel Margin="100,22,28,22" ZIndex="10">

                <!-- PAGE 1: HOME -->
                <Panel x:Name="PageHome" Classes="PageAnim" IsVisible="{Binding IsOnHome}" Margin="-100,-22,-28,-22">
                    <!-- .stage: top: 44px; left: 92px; width: 160px; height: 250px; -->
                    <Canvas IsVisible="{Binding ShowHomeSkinModel}">
                        <!-- 3D skin model inside launcher: 有账号才有人可画，外观设置里可以关掉（默认开）。
                             左键拖位置（按首页比例存，见 MainWindow.axaml.cs 的 LayoutHomeSkinPreview），右键转。
                             HitFootprintOnly：命中区剪到身体那一块，脚下那 81 DIP 空档不再替小人吃掉按钮的点击。 -->
                        <controls:MinecraftSkinPreview x:Name="SkinPreview"
                                                       Canvas.Left="92" Canvas.Top="44"
                                                       CanDragPosition="True"
                                                       RotateButton="Right"
                                                       HitFootprintOnly="True"
                                                       PlayerName="{Binding CurrentAccount.Name}"/>
                    </Canvas>

                    <!-- .dock: right: 20px; bottom: 20px; width: 380px; padding: 10px; border-radius: 18px; -->
                    <Border x:Name="DockCard"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,20,20" Width="380"
                            Background="#8C0E0E12"
                            BorderBrush="#17FFFFFF"
                            BorderThickness="1"
                            CornerRadius="18"
                            BoxShadow="0 10 30 -12 #B0000000"
                            Padding="10">
                        <StackPanel Spacing="0">
                            <!-- Top row: Instance selector + Launch button -->
                            <Grid ColumnDefinitions="* Auto">
                                <!-- .inst-select: height: 52px; padding: 0 10px 0 6px; border-radius: 12px; -->
                                <Button Grid.Column="0" Classes="InstSelect"
                                        x:Name="InstSelectBtn"
                                        Command="{Binding ToggleInstPopCommand}">
                                    <Panel>
                                        <Grid ColumnDefinitions="Auto * Auto"
                                              IsVisible="{Binding CurrentInstance, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <!-- 40x40 Block Icon -->
                                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="9" ClipToBounds="True" Margin="0,0,10,0">
                                                <Image Source="{Binding CurrentInstance.IconBitmap, Converter={StaticResource PixelsToBitmap}}"
                                                       Width="40" Height="40"
                                                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                            </Border>
                                            <!-- Instance Meta: Name & Ver/Loader -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CurrentInstance.Name}"
                                                           FontSize="14" FontWeight="Bold" Foreground="#fafafa"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding CurrentInstance.MetaText}"
                                                           FontSize="12" Foreground="#a1a1aa"/>
                                            </StackPanel>
                                            <!-- ChevronUp matching Image 2 -->
                                            <materialIcons:MaterialIcon Grid.Column="2" Kind="ChevronUp"
                                                                       Width="18" Height="18" Foreground="#71717a"
                                                                       Margin="6,0,0,0"/>
                                        </Grid>

                                        <!-- First run: nothing installed yet -->
                                        <Grid ColumnDefinitions="Auto * Auto"
                                              IsVisible="{Binding CurrentInstance, Converter={x:Static ObjectConverters.IsNull}}">
                                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="9" Margin="0,0,10,0"
                                                    Background="#1c1c21" BorderBrush="#26262b" BorderThickness="1">
                                                <materialIcons:MaterialIcon Kind="Plus" Width="18" Height="18"
                                                                            Foreground="#71717a"
                                                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="还没有实例" FontSize="14" FontWeight="Bold" Foreground="#fafafa"/>
                                                <TextBlock Text="选择已有实例，或安装新版本" FontSize="12" Foreground="#a1a1aa"/>
                                            </StackPanel>
                                            <materialIcons:MaterialIcon Grid.Column="2" Kind="ChevronUp"
                                                                       Width="18" Height="18" Foreground="#71717a"
                                                                       Margin="6,0,0,0"/>
                                        </Grid>
                                    </Panel>
                                </Button>

                                <!-- .launch: height: 52px; border-radius: 12px; font-weight: 600; font-size: 15px;
                                     MinWidth pins the box to the longest label ("游戏运行中") so switching
                                     launch state never reflows the dock row. -->
                                <Button Grid.Column="1" Classes="LaunchBtn"
                                        Height="52" MinWidth="122" Padding="10,0"
                                        CornerRadius="12"
                                        FontWeight="SemiBold"
                                        FontSize="15"
                                        HorizontalContentAlignment="Center"
                                        Margin="10,0,0,0"
                                        Cursor="Hand"
                                        IsEnabled="{Binding CanLaunch}"
                                        Command="{Binding LaunchGameCommand}"
                                        Content="{Binding LaunchBtnText}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- #launchProgress: its own card in the empty bottom-left area, so the dock
                         does not change height while the game is starting -->
                    <Border x:Name="LaunchProgressCard"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Margin="100,0,0,20" Width="320"
                            Background="#8C0E0E12"
                            BorderBrush="#17FFFFFF"
                            BorderThickness="1"
                            CornerRadius="18"
                            BoxShadow="0 10 30 -12 #B0000000"
                            Padding="14,12"
                            IsVisible="{Binding IsLaunching}">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="* Auto">
                                <TextBlock Grid.Column="0" Text="{Binding LaunchStepText}" FontSize="12" Foreground="#a1a1aa"/>
                                <TextBlock Grid.Column="1" Text="{Binding LaunchPctText}" FontSize="12" Foreground="#a1a1aa"/>
                            </Grid>
                            <ProgressBar Value="{Binding LaunchProgress}" Maximum="100" Height="4"
                                         CornerRadius="999"
                                         Foreground="#fafafa"
                                         Background="#407f7f7f"/>
                        </StackPanel>
                    </Border>
                </Panel>

                <!-- PAGE 2: INSTANCES -->
                <Panel Name="PageInstances" Classes="PageAnim" Focusable="False" IsVisible="{Binding CurrentPage, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='instances'}">
                    <Grid RowDefinitions="Auto Auto *">
                        <!-- 页头两层。第一层只有标题和「当前目录」那颗胶囊：右上角那片（喇叭 + 最小化 +
                             关闭，y 12..42）是窗口操作区，不跟它抢，所以右边留 96 的安全区。
                             计数按稿子删掉了 —— 标题旁摆数字和胶囊抢视线，筛选后有没有剩东西由空状态说。 -->
                        <!-- 页头标题：右上角那片（喇叭 + 最小化 + 关闭，y 12..42）是窗口操作区，留出安全区。 -->
                        <Grid Grid.Row="0" Height="36" Margin="0,0,96,14">
                            <TextBlock Text="实例" FontSize="24" Height="32" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#fafafa"/>
                        </Grid>

                        <!-- 第二层工具条：统一 32 高。它已经在窗口操作区下面，所以能一直铺到内容列右边缘。
                             搜索框不再吃满整行 —— 右边那排（导入 / 添加目录 / 目录切换 / 视图切换）要地方。 -->
                        <Grid Grid.Row="1" ColumnDefinitions="Auto Auto Auto Auto * Auto Auto Auto Auto Auto Auto" Height="32" Margin="0,0,0,16">
                            <!-- 搜索框：统一定义在 Theme.Avalonia/Generated/Controls.g.axaml 中的 Classes="SearchBox"，
                                 内含 32 高度、8 圆角、左侧放大镜（防击穿）、右侧动态清空按钮。 -->
                            <TextBox Grid.Column="0" x:Name="SearchBox" Classes="SearchBox"
                                     Width="220" Margin="0,0,8,0"
                                     PlaceholderText="搜索实例名或版本..."
                                     Text="{Binding InstanceSearch}" />

                            <!-- 加载器筛选：下拉只列实例里真出现过的加载器**种类**。 -->
                            <Button Grid.Column="1" x:Name="LoaderFilterBtn" Classes="BtnSm BtnOutline"
                                    Height="32" MinWidth="116" Margin="0,0,8,0"
                                    Command="{Binding ToggleLoaderPopCommand}">
                                <Grid ColumnDefinitions="* Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding InstanceLoaderLabel}" FontSize="12.5" VerticalAlignment="Center"/>
                                    <materialIcons:MaterialIcon Grid.Column="1" Kind="ChevronDown" Width="13" Height="13"
                                                                Foreground="#71717a" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </Button>

                            <Border Grid.Column="2" Width="1" Height="18" Background="#26262b" Margin="0,0,10,0" VerticalAlignment="Center"/>

                            <!-- 排序：分段控件，容器与右下角那排视图切换同一套（muted 底 + 2 内边距 +
                                 选中那段卡底）。两颗都摆在容器里，字色不再和壁纸抢对比度。 -->
                            <Border Grid.Column="3" Height="32" Padding="2" CornerRadius="9" VerticalAlignment="Center"
                                    Background="#27272a" BorderBrush="#26262b" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Classes="SortTab" Content="最近游玩"
                                            Classes.On="{Binding InstanceSort, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='最近游玩'}"
                                            Command="{Binding SelectInstanceSortCommand}" CommandParameter="最近游玩"/>
                                    <Button Classes="SortTab" Content="名称"
                                            Classes.On="{Binding InstanceSort, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='名称'}"
                                            Command="{Binding SelectInstanceSortCommand}" CommandParameter="名称"/>
                                </StackPanel>
                            </Border>

                            <!-- 右边这一排全推到内容列末端。 -->
                            <Button Grid.Column="5" Name="ImportPackBtn" Classes="BtnSm BtnOutline" Height="32"
                                    Margin="0,0,8,0" Command="{Binding BeginPackImportCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="PackageVariantClosed" Width="15" Height="15" Foreground="#a1a1aa" VerticalAlignment="Center"/>
                                    <TextBlock Text="导入整合包" FontSize="12.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="6" Name="AddFolderBtn" Classes="BtnSm BtnOutline" Height="32"
                                    Margin="0,0,8,0" Command="{Binding BeginAddFolderCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="FolderPlusOutline" Width="15" Height="15" Foreground="#a1a1aa" VerticalAlignment="Center"/>
                                    <TextBlock Text="添加文件夹" FontSize="12.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- 实例文件夹切换按钮：移到添加文件夹右侧，与其它按钮保持统一的 8 圆角与 32 高度 -->
                            <Button Grid.Column="7" x:Name="FolderPillBtn" Classes="FolderPill"
                                    Height="32" Margin="0,0,8,0"
                                    Classes.On="{Binding IsFolderPopOpen}"
                                    Command="{Binding ToggleFolderPopCommand}"
                                    ToolTip.Tip="切换游戏目录">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="FolderOutline" Width="15" Height="15" Foreground="#a1a1aa" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ActiveFolderName}" FontSize="12.5" Foreground="#fafafa"
                                               MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <materialIcons:MaterialIcon Kind="ChevronDown" Width="13" Height="13" Foreground="#71717a" VerticalAlignment="Center"
                                                                IsVisible="{Binding !IsFolderPopOpen}"/>
                                    <materialIcons:MaterialIcon Kind="ChevronUp" Width="13" Height="13" Foreground="#71717a" VerticalAlignment="Center"
                                                                IsVisible="{Binding IsFolderPopOpen}"/>
                                </StackPanel>
                            </Button>

                            <Border Grid.Column="8" Width="1" Height="18" Background="#26262b" Margin="0,0,10,0" VerticalAlignment="Center"/>

                            <!-- 视图切换：网格 / 列表。选中那颗是卡底，容器是 muted 底，两层分得开。 -->
                            <Border Grid.Column="9" Height="32" Padding="2" CornerRadius="9" VerticalAlignment="Center"
                                    Background="#27272a" BorderBrush="#26262b" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Classes="ViewBtn" ToolTip.Tip="卡片网格"
                                            Classes.On="{Binding IsGridView}"
                                            Command="{Binding SelectInstanceViewCommand}" CommandParameter="grid">
                                        <materialIcons:MaterialIcon Kind="ViewGridOutline" Width="14" Height="14"
                                                                    Foreground="{Binding $parent[Button].Foreground}"/>
                                    </Button>
                                    <Button Classes="ViewBtn" ToolTip.Tip="紧凑列表"
                                            Classes.On="{Binding IsListView}"
                                            Command="{Binding SelectInstanceViewCommand}" CommandParameter="list">
                                        <materialIcons:MaterialIcon Kind="FormatListBulleted" Width="14" Height="14"
                                                                    Foreground="{Binding $parent[Button].Foreground}"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- 刷新：外部装的版本不用等游戏退出或切目录才冒出来。 -->
                            <Button Grid.Column="10" Classes="BtnSm BtnOutline" Height="32" Margin="8,0,0,0"
                                    Command="{Binding RefreshInstancesListCommand}" ToolTip.Tip="刷新实例列表">
                                <materialIcons:MaterialIcon Kind="Refresh" Width="14" Height="14"/>
                            </Button>
                        </Grid>

                        <Panel Grid.Row="2">
                            <!-- 卡片模式。UniformGrid 而不是 WrapPanel —— 卡片要"自适应拉伸"就得等宽，
                                 还要等高（底行那句最近游玩是贴底摆的，卡片不齐高就贴不出效果）。
                                 列数由视图按页宽算（见 MainWindow.axaml.cs 的 UpdateInstanceColumns）。
                                 VerticalAlignment=Top：不顶住的话这一格会拿到整屏高，UniformGrid 再把
                                 它平摊给一两张卡 —— 卡片会被撑成半屏高。 -->
                            <Panel Classes="PageAnim" IsVisible="{Binding IsGridView}">
                                <ScrollViewer Focusable="False" IsVisible="{Binding HasInstances}">
                                    <ItemsControl Focusable="False" VerticalAlignment="Top" Margin="0,0,0,56" ItemsSource="{Binding VisibleInstances}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="{Binding InstanceColumns}" Margin="0,0,-12,0"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:InstanceModel">
                                                <!-- 和列表行同一套 其他启动器 交互：单击=设为当前，双击=启动，配置走齿轮。 -->
                                                <Button Classes="InstCard"
                                                        Classes.Current="{Binding IsCurrent}"
                                                        Margin="0,0,12,12"
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).MakeCurrentInstanceCommand}"
                                                        CommandParameter="{Binding .}"
                                                        DoubleTapped="OnInstanceRowDoubleTapped">
                                                    <!-- 右键菜单与「⋯」共用这一份：⋯ 只是把同一个菜单就地开起来
                                                         （见 MainWindow.axaml.cs 的 OnRowMoreClick）。 -->
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="设为当前" IsVisible="{Binding !IsCurrent}"
                                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).MakeCurrentInstanceCommand}"
                                                                      CommandParameter="{Binding .}"/>
                                                            <MenuItem Header="立即启动"
                                                                      IsEnabled="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CanQuickLaunch}"
                                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LaunchInstanceCommand}"
                                                                      CommandParameter="{Binding .}"/>
                                                            <MenuItem Header="实例配置"
                                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenInstanceConfigCommand}"
                                                                      CommandParameter="{Binding .}"/>
                                                            <Separator/>
                                                            <MenuItem Header="重命名"
                                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RenameInstanceCommand}"
                                                                      CommandParameter="{Binding .}"/>
                                                            <MenuItem Header="打开游戏目录"
                                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenInstanceFolderCommand}"
                                                                      CommandParameter="{Binding .}"/>
                                                            <MenuItem Header="打开存档文件夹"
                                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenInstanceSavesCommand}"
                                                                      CommandParameter="{Binding .}"/>
                                                            <MenuItem Header="导出整合包"
                                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ExportInstanceCommand}"
                                                                      CommandParameter="{Binding .}"/>
                                                            <Separator/>
                                                            <MenuItem Header="删除" Foreground="#f87171"
                                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteInstanceCommand}"
                                                                      CommandParameter="{Binding .}"/>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>

                                                    <Grid RowDefinitions="* Auto">
                                                        <!-- 上：图标 + 名字 + 两个 tag，右上角「⋯」 -->
                                                        <Grid Grid.Row="0" ColumnDefinitions="Auto * Auto" Margin="0,0,0,10">
                                                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="9" ClipToBounds="True" VerticalAlignment="Top">
                                                                <Image Source="{Binding IconBitmap, Converter={StaticResource PixelsToBitmap}}"
                                                                       Width="40" Height="40"
                                                                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Top" Spacing="7" Margin="12,0,4,0">
                                                                <!-- 名字自己截断；「当前」不再挂胶囊，整张卡的底色就是那个意思。
                                                                     MaxWidth 是"名字长到多长才开始截"的上限 —— 横排 StackPanel
                                                                     给孩子的可用宽度是无限的，不封顶的话长名字会把卡撑破。
                                                                     HorizontalAlignment 必须显式 Left：Stretch + MaxWidth 会把
                                                                     夹小的元素在槽位里居中，名字就会比下面那排 tag 右移。 -->
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                                           MaxWidth="170" HorizontalAlignment="Left"
                                                                           Foreground="#fafafa" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                <!-- tag 行：版本 Auto（封顶 88）、加载器吃剩余宽度；超长都走省略号，悬停看完整文本。 -->
                                                                <Grid Margin="0,0,4,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="0" Classes="TagPill" Classes.Current="{Binding IsCurrent}"
                                                                            MaxWidth="88" Margin="0,0,6,0">
                                                                        <TextBlock Text="{Binding VersionId}" Classes="TagText" Classes.Current="{Binding IsCurrent}"
                                                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding VersionId}"/>
                                                                    </Border>
                                                                    <Border Grid.Column="1" Classes="TagPill" Classes.Current="{Binding IsCurrent}"
                                                                            HorizontalAlignment="Left">
                                                                        <TextBlock Text="{Binding Loader}" Classes="TagText" Classes.Current="{Binding IsCurrent}"
                                                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Loader}"/>
                                                                    </Border>
                                                                </Grid>
                                                            </StackPanel>
                                                            <Button Grid.Column="2" Classes="IconBtn" Width="28" Height="28"
                                                                    VerticalAlignment="Top" ToolTip.Tip="更多" Click="OnRowMoreClick">
                                                                <materialIcons:MaterialIcon Kind="DotsHorizontal" Width="16" Height="16" Foreground="#a1a1aa"/>
                                                            </Button>
                                                        </Grid>

                                                        <!-- 下：最近游玩贴底，右边配置 + 启动。启动钮只在当前实例上展开出
                                                             「启动」二字，其余保持纯图标；游戏运行中压灰。 -->
                                                        <Grid Grid.Row="1" ColumnDefinitions="* Auto Auto">
                                                            <TextBlock Grid.Column="0" Text="{Binding LastPlayedText}" FontSize="12"
                                                                       Foreground="#a1a1aa" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <Button Grid.Column="1" Classes="IconBtn" Width="28" Height="28" Margin="0,0,6,0" ToolTip.Tip="实例配置"
                                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenInstanceConfigCommand}"
                                                                    CommandParameter="{Binding .}">
                                                                <materialIcons:MaterialIcon Kind="CogOutline" Width="16" Height="16" Foreground="#a1a1aa"/>
                                                            </Button>
                                                            <Button Grid.Column="2" Classes="CardPlay" Classes.Current="{Binding IsCurrent}" ToolTip.Tip="启动"
                                                                    IsEnabled="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CanQuickLaunch}"
                                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LaunchInstanceCommand}"
                                                                    CommandParameter="{Binding .}">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <materialIcons:MaterialIcon Kind="Play" Width="18" Height="18"
                                                                                                Foreground="{Binding $parent[Button].Foreground}"/>
                                                                    <TextBlock Text="启动" FontSize="12.5" VerticalAlignment="Center"
                                                                               IsVisible="{Binding IsCurrent}"
                                                                               Foreground="{Binding $parent[Button].Foreground}"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </Grid>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Panel>

                            <!-- 列表模式：一行 54，图标 / 名字 / 三个 tag / 最近游玩 / 三颗图标按钮。
                                 名字那格按稿子给固定宽度，剩下的高度留给"最近游玩"那一段自己靠右，
                                 窗口再窄也不会把 tag 挤没（它比名字更容易一眼比对）。 -->
                            <Panel Classes="PageAnim" IsVisible="{Binding IsListView}">
                                <ScrollViewer Focusable="False" IsVisible="{Binding HasInstances}">
                                    <ItemsControl Focusable="False" VerticalAlignment="Top" Margin="0,0,0,56" ItemsSource="{Binding VisibleInstances}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:InstanceModel">
                                                <!-- 其他启动器 式行交互：单击=设为当前（高亮不跳页），双击=直接启动；
                                                     进配置页走行尾的齿轮或右键菜单。 -->
                                                <Button Classes="InstRow"
                                                        Classes.Current="{Binding IsCurrent}"
                                                        Margin="0,0,0,8"
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).MakeCurrentInstanceCommand}"
                                                        CommandParameter="{Binding .}"
                                                        DoubleTapped="OnInstanceRowDoubleTapped">
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="设为当前" IsVisible="{Binding !IsCurrent}"
                                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).MakeCurrentInstanceCommand}"
                                                                      CommandParameter="{Binding .}"/>
                                                            <MenuItem Header="立即启动"
                                                                      IsEnabled="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CanQuickLaunch}"
                                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LaunchInstanceCommand}"
                                                                      CommandParameter="{Binding .}"/>
                                                            <MenuItem Header="实例配置"
                                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenInstanceConfigCommand}"
                                                                      CommandParameter="{Binding .}"/>
                                                            <Separator/>
                                                            <MenuItem Header="重命名"
                                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RenameInstanceCommand}"
                                                                      CommandParameter="{Binding .}"/>
                                                            <MenuItem Header="打开游戏目录"
                                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenInstanceFolderCommand}"
                                                                      CommandParameter="{Binding .}"/>
                                                            <MenuItem Header="打开存档文件夹"
                                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenInstanceSavesCommand}"
                                                                      CommandParameter="{Binding .}"/>
                                                            <MenuItem Header="导出整合包"
                                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ExportInstanceCommand}"
                                                                      CommandParameter="{Binding .}"/>
                                                            <Separator/>
                                                            <MenuItem Header="删除" Foreground="#f87171"
                                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteInstanceCommand}"
                                                                      CommandParameter="{Binding .}"/>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>

                                                    <Grid>
                                                        <!-- 当前行左侧的指示条：贴到行的左沿（负边距探出内边距）。 -->
                                                        <Border Width="3" CornerRadius="1.5" Background="#fafafa"
                                                                HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                                                Margin="-14,7,0,7"
                                                                IsVisible="{Binding IsCurrent}"/>
                                                        <Grid ColumnDefinitions="Auto Auto Auto * Auto" Height="52">
                                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" ClipToBounds="True" VerticalAlignment="Center">
                                                            <Image Source="{Binding IconBitmap, Converter={StaticResource PixelsToBitmap}}"
                                                                   Width="36" Height="36" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                                        </Border>

                                                        <!-- 名字列对齐稿子 .main-info：14 的左边距＝ .inst-row 的 flex gap，300 是列宽本身
                                                             （稿子 .block(36) + gap(14) + .main-info(300) + gap(14) + .tags(290)）。 -->
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Width="300" Margin="14,0,0,0"
                                                                   FontSize="13.5" FontWeight="SemiBold" Foreground="#fafafa"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                                        <!-- tag 自己成列（稿子 .inst-row .tags{width:290px;flex:0 0 290px}、左对齐），
                                                             不然名字短的时候这排会往左跑，行与行之间对不齐。
                                                             版本 Auto（封顶 88）、加载器吃剩余宽度；超长省略，悬停看完整文本。 -->
                                                        <Grid Grid.Column="2" Width="290" Margin="14,0,0,0" VerticalAlignment="Center">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Classes="TagPill" Classes.Current="{Binding IsCurrent}"
                                                                    MaxWidth="88" Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding VersionId}" Classes="TagText" Classes.Current="{Binding IsCurrent}"
                                                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding VersionId}"/>
                                                            </Border>
                                                            <Border Grid.Column="1" Classes="TagPill" Classes.Current="{Binding IsCurrent}"
                                                                    HorizontalAlignment="Left" Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding Loader}" Classes="TagText" Classes.Current="{Binding IsCurrent}"
                                                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Loader}"/>
                                                            </Border>
                                                            <!-- 「N 模组」只在装了模组时出现：空 tag 是噪声，原版实例不需要被提醒自己是原版。 -->
                                                            <Border Grid.Column="2" Classes="TagPill" Classes.Current="{Binding IsCurrent}"
                                                                    IsVisible="{Binding HasMods}">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <materialIcons:MaterialIcon Kind="CubeOutline" Width="12" Height="12"
                                                                                                Classes="TagIcon" Classes.Current="{Binding IsCurrent}" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding ModCountText}" Classes="TagText" Classes.Current="{Binding IsCurrent}"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>

                                                        <TextBlock Grid.Column="3" Text="{Binding LastPlayedText}" FontSize="12"
                                                                   Foreground="#a1a1aa" Margin="12,0,12,0" HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <Button Classes="IconBtn" Width="28" Height="28" ToolTip.Tip="实例配置"
                                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenInstanceConfigCommand}"
                                                                    CommandParameter="{Binding .}">
                                                                <materialIcons:MaterialIcon Kind="CogOutline" Width="16" Height="16" Foreground="#a1a1aa"/>
                                                            </Button>
                                                            <Button Classes="CardPlay" Classes.Current="{Binding IsCurrent}" ToolTip.Tip="启动"
                                                                    IsEnabled="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CanQuickLaunch}"
                                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LaunchInstanceCommand}"
                                                                    CommandParameter="{Binding .}">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <materialIcons:MaterialIcon Kind="Play" Width="18" Height="18"
                                                                                                Foreground="{Binding $parent[Button].Foreground}"/>
                                                                    <TextBlock Text="启动" FontSize="12.5" VerticalAlignment="Center"
                                                                               IsVisible="{Binding IsCurrent}"
                                                                               Foreground="{Binding $parent[Button].Foreground}"/>
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Classes="IconBtn" Width="28" Height="28"
                                                                    ToolTip.Tip="更多" Click="OnRowMoreClick">
                                                                <materialIcons:MaterialIcon Kind="DotsHorizontal" Width="16" Height="16" Foreground="#a1a1aa"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Panel>

                            <!-- 两种空法：这个目录里真没有一个实例，和有实例但被筛没了。
                                 空态下面那两颗按钮是稿子里搬来的：这时候用户最可能做的两件事就是导入一份包，
                                 或者去下载页装一个版本。 -->
                            <StackPanel IsVisible="{Binding !HasInstances}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                <materialIcons:MaterialIcon Kind="LayersOutline" Width="36" Height="36"
                                                            Foreground="#3f3f46" HorizontalAlignment="Center"/>
                                <TextBlock Text="还没有实例" FontSize="14" Foreground="#a1a1aa" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                    <Button Classes="BtnSm BtnPrimary" Command="{Binding BeginPackImportCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="PackageVariantClosed" Width="15" Height="15" VerticalAlignment="Center"/>
                                            <TextBlock Text="导入整合包" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="BtnSm BtnOutline" Command="{Binding NewInstanceCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="Download" Width="15" Height="15" Foreground="#fafafa" VerticalAlignment="Center"/>
                                            <TextBlock Text="安装新版本" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding HasNoInstanceMatches}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                <TextBlock Text="没有匹配的实例" FontSize="14" Foreground="#a1a1aa" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding InstanceEmptyHint}" FontSize="12" Foreground="#71717a" HorizontalAlignment="Center"/>
                                <!-- 光出主意不给出口等于没说：一键清掉搜索词和加载器筛选。 -->
                                <Button Classes="BtnSm BtnOutline" Height="28" HorizontalAlignment="Center"
                                        IsVisible="{Binding HasInstanceFilter}"
                                        Command="{Binding ClearInstanceFiltersCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="FilterOffOutline" Width="14" Height="14"/>
                                        <TextBlock Text="清除筛选" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- 右下角悬浮安装入口：和首页停靠卡同一个内缩。空态已经有两颗主按钮，这颗就不重复出现了。 -->
                            <Border Classes="FabPill" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,24,24" ZIndex="40" IsVisible="{Binding HasInstances}">
                                <Button Classes="Fab" Command="{Binding NewInstanceCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <materialIcons:MaterialIcon Kind="Plus" Width="16" Height="16"/>
                                        <TextBlock Text="安装新版本" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Border>
                        </Panel>
                    </Grid>
                </Panel>

                <!-- PAGE 2.5: INSTANCE MANAGE (hidden page navigated directly from instance card/list) -->
                <Panel Classes="PageAnim" IsVisible="{Binding CurrentPage, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='instance_manage'}">
                    <Grid RowDefinitions="Auto *">
                        <!-- Top nav & header info -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto Auto * Auto" Height="42" Margin="0,0,96,16">
                            <!-- Back button -->
                            <Button Grid.Column="0" Classes="BtnSm BtnOutline" Height="34" Margin="0,0,14,0"
                                    Command="{Binding BackToInstancesCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="ArrowLeft" Width="16" Height="16"/>
                                    <TextBlock Text="返回" FontSize="12.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Instance Info -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Border Width="36" Height="36" CornerRadius="8" ClipToBounds="True" VerticalAlignment="Center">
                                    <Image Source="{Binding EditingInstance.IconBitmap, Converter={StaticResource PixelsToBitmap}}"
                                           Width="36" Height="36" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                </Border>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding EditingInstance.Name, FallbackValue='实例管理'}"
                                               FontSize="15.5" FontWeight="SemiBold" Foreground="#fafafa" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding EditingVersionSummary, FallbackValue=''}"
                                               FontSize="12" Foreground="#a1a1aa" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Quick actions -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Button Classes="BtnSm BtnOutline" Height="34" Content="设为当前"
                                        IsVisible="{Binding !IsEditingCurrentInstance}"
                                        Command="{Binding MakeEditingInstanceCurrentCommand}"/>
                                <Button Classes="BtnSm BtnPrimary" Height="34"
                                        IsEnabled="{Binding CanQuickLaunch}"
                                        Command="{Binding LaunchEditingInstanceCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="Play" Width="16" Height="16"/>
                                        <TextBlock Text="启动游戏" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Main Content: Left Nav (180px) + Right Detail Panels. 中间不画分隔线 ——
                             侧栏自己有 #0c0c0e 的底和圆角，再压一根线就是多出来的一道框。 -->
                        <Grid Grid.Row="1" ColumnDefinitions="180 24 *">
                            <!-- Left Tab Nav -->
                            <Border Grid.Column="0" Background="#0c0c0e" CornerRadius="12" Padding="8,10" VerticalAlignment="Stretch">
                                <StackPanel Spacing="4">
                                    <!-- 概览 -->
                                    <Button Classes="InstNavBtn"
                                            Classes.On="{Binding ConfigTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='概览'}"
                                            Command="{Binding SelectConfigTabCommand}" CommandParameter="概览">
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="LayersOutline" Width="16" Height="16" VerticalAlignment="Center"/>
                                            <TextBlock Text="概览" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- 设置：隔离 / Java / 内存（其他启动器 的「设置」页同构） -->
                                    <Button Classes="InstNavBtn"
                                            Classes.On="{Binding ConfigTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='设置'}"
                                            Command="{Binding SelectConfigTabCommand}" CommandParameter="设置">
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="CogOutline" Width="16" Height="16" VerticalAlignment="Center"/>
                                            <TextBlock Text="设置" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- 模组 -->
                                    <Button Classes="InstNavBtn"
                                            Classes.On="{Binding ConfigTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='模组'}"
                                            Command="{Binding SelectConfigTabCommand}" CommandParameter="模组">
                                        <Grid ColumnDefinitions="Auto * Auto" VerticalAlignment="Center">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="CubeOutline" Width="16" Height="16" VerticalAlignment="Center"/>
                                                <TextBlock Text="模组" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Classes="TagPill" Padding="6,1"
                                                    IsVisible="{Binding HasEditingMods}">
                                                <TextBlock Text="{Binding EditingMods.Count}" Classes="TagText"/>
                                            </Border>
                                        </Grid>
                                    </Button>

                                    <!-- 资源包 -->
                                    <Button Classes="InstNavBtn"
                                            Classes.On="{Binding ConfigTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='资源包'}"
                                            Command="{Binding SelectConfigTabCommand}" CommandParameter="资源包">
                                        <Grid ColumnDefinitions="Auto * Auto" VerticalAlignment="Center">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="PaletteOutline" Width="16" Height="16" VerticalAlignment="Center"/>
                                                <TextBlock Text="资源包" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Classes="TagPill" Padding="6,1"
                                                    IsVisible="{Binding HasEditingResourcePacks}">
                                                <TextBlock Text="{Binding EditingResourcePacks.Count}" Classes="TagText"/>
                                            </Border>
                                        </Grid>
                                    </Button>

                                    <!-- 世界 -->
                                    <Button Classes="InstNavBtn"
                                            Classes.On="{Binding ConfigTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='世界'}"
                                            Command="{Binding SelectConfigTabCommand}" CommandParameter="世界">
                                        <Grid ColumnDefinitions="Auto * Auto" VerticalAlignment="Center">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="Earth" Width="16" Height="16" VerticalAlignment="Center"/>
                                                <TextBlock Text="世界" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Classes="TagPill" Padding="6,1"
                                                    IsVisible="{Binding HasEditingWorlds}">
                                                <TextBlock Text="{Binding EditingWorlds.Count}" Classes="TagText"/>
                                            </Border>
                                        </Grid>
                                    </Button>

                                    <!-- Java 与内存已并入概览的设置卡，这里不再单列一页。 -->

                                    <!-- 文件与管理 -->
                                    <Button Classes="InstNavBtn"
                                            Classes.On="{Binding ConfigTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='目录'}"
                                            Command="{Binding SelectConfigTabCommand}" CommandParameter="目录">
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="FolderOutline" Width="16" Height="16" VerticalAlignment="Center"/>
                                            <TextBlock Text="文件与管理" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Splitter Line -->
                            <!-- （已删：侧栏有底色和圆角，独立的一根线是多余的框。） -->

                            <!-- Right Content Panels -->
                            <Grid Grid.Column="2">
                                <!-- 1. 概览：其他启动器 式 —— 头部大图标 + 就地改名，统计卡一眼看全，
                                     快捷操作与危险区收在底部。 -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              IsVisible="{Binding ConfigTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='概览'}">
                                    <StackPanel Spacing="16" Margin="0,0,10,0">
                                        <!-- 头部：图标 / 名称 / 元信息 / 换图标 -->
                                        <Border Background="#18181b" BorderBrush="#26262b" BorderThickness="1" CornerRadius="12" Padding="16,14">
                                            <Grid ColumnDefinitions="Auto * Auto">
                                                <Border Grid.Column="0" Width="56" Height="56" CornerRadius="12" ClipToBounds="True"
                                                        Background="#111114" VerticalAlignment="Top">
                                                    <Image Source="{Binding EditingInstance.IconBitmap, Converter={StaticResource PixelsToBitmap}}"
                                                           Width="56" Height="56" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6" Margin="14,0,16,0">
                                                    <!-- Delay 让自动保存等打字停稳再落盘。 -->
                                                    <TextBox Width="280" Height="32" MinHeight="0"
                                                             Text="{Binding ConfigInstName, Mode=TwoWay, Delay=500}"
                                                             ToolTip.Tip="{Binding ConfigInstName}"
                                                             Background="#111114" BorderBrush="#26262b" BorderThickness="1"
                                                             CornerRadius="8" Foreground="#fafafa" Padding="10,0" FontSize="12.5"
                                                             VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding EditingInstance.MetaText, FallbackValue=''}" FontSize="12"
                                                               Foreground="#a1a1aa" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding EditingGameDirectory}" FontSize="11.5" Foreground="#52525b"
                                                               FontFamily="Consolas" TextTrimming="CharacterEllipsis"
                                                               ToolTip.Tip="{Binding EditingGameDirectory}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                                                    <Button x:Name="IconPickerAnchor" Classes="IconBtn" Width="28" Height="28"
                                                            ToolTip.Tip="换图标（标志 / 方块）"
                                                            Command="{Binding OpenIconPickerCommand}">
                                                        <materialIcons:MaterialIcon Kind="Pencil" Width="15" Height="15" Foreground="#a1a1aa"/>
                                                    </Button>
                                                    <!-- 重置：只在有自定义图标时出现，清掉之后图标回到「跟着加载器走」。 -->
                                                    <Button Classes="IconBtn" Width="28" Height="28" ToolTip.Tip="重置图标"
                                                            Command="{Binding ResetInstanceIconCommand}"
                                                            IsVisible="{Binding HasCustomIcon}">
                                                        <materialIcons:MaterialIcon Kind="Restore" Width="15" Height="15" Foreground="#a1a1aa"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- 统计卡：六格。占用空间是后台慢慢扫出来的，先占着「统计中…」。 -->
                                        <Border Background="#18181b" BorderBrush="#26262b" BorderThickness="1" CornerRadius="12" Padding="16,12">
                                            <Grid ColumnDefinitions="* * *" RowDefinitions="Auto Auto">
                                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3" Margin="0,2,0,12">
                                                    <TextBlock Text="最近游玩" FontSize="11.5" Foreground="#71717a"/>
                                                    <TextBlock Text="{Binding EditingInstance.LastPlayedText, FallbackValue='—'}" FontSize="13" Foreground="#fafafa"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="3" Margin="0,2,0,12">
                                                    <TextBlock Text="创建于" FontSize="11.5" Foreground="#71717a"/>
                                                    <TextBlock Text="{Binding InstanceCreatedText}" FontSize="13" Foreground="#fafafa"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="0" Grid.Column="2" Spacing="3" Margin="0,2,0,12">
                                                    <TextBlock Text="占用空间" FontSize="11.5" Foreground="#71717a"/>
                                                    <TextBlock Text="{Binding InstanceFolderSizeText}" FontSize="13" Foreground="#fafafa"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="3">
                                                    <TextBlock Text="模组" FontSize="11.5" Foreground="#71717a"/>
                                                    <TextBlock Text="{Binding EditingModCountText}" FontSize="13" Foreground="#fafafa"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                                                    <TextBlock Text="资源包" FontSize="11.5" Foreground="#71717a"/>
                                                    <TextBlock Text="{Binding EditingResourcePackCountText}" FontSize="13" Foreground="#fafafa"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="2" Spacing="3">
                                                    <TextBlock Text="存档" FontSize="11.5" Foreground="#71717a"/>
                                                    <TextBlock Text="{Binding EditingWorldCountText}" FontSize="13" Foreground="#fafafa"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- 快捷操作 -->
                                        <Border Background="#18181b" BorderBrush="#26262b" BorderThickness="1" CornerRadius="12" Padding="16,0">
                                            <StackPanel>
                                                <Border Height="54" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                                    <Grid ColumnDefinitions="* Auto">
                                                        <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                            <TextBlock Text="打开实例文件夹" FontWeight="Medium" Foreground="#fafafa" FontSize="13"/>
                                                            <TextBlock Text="{Binding EditingGameDirectory}" FontSize="12" Foreground="#71717a"
                                                                       TextTrimming="CharacterEllipsis" FontFamily="Consolas"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Classes="BtnSm BtnOutline"
                                                                Command="{Binding OpenInstanceFolderCommand}" CommandParameter="{Binding EditingInstance}">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <materialIcons:MaterialIcon Kind="FolderOutline" Width="14" Height="14"/>
                                                                <TextBlock Text="打开" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                                <Border Height="54">
                                                    <Grid ColumnDefinitions="* Auto">
                                                        <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                            <TextBlock Text="导出整合包" FontWeight="Medium" Foreground="#fafafa" FontSize="13"/>
                                                            <TextBlock Text="打包模组与配置，不含存档；可分享或重新导入" FontSize="12" Foreground="#71717a"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Classes="BtnSm BtnOutline"
                                                                Command="{Binding ExportInstanceCommand}" CommandParameter="{Binding EditingInstance}">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <materialIcons:MaterialIcon Kind="PackageVariantClosed" Width="14" Height="14"/>
                                                                <TextBlock Text="导出" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- 危险区 -->
                                        <Border Background="#18181b" BorderBrush="#26262b" BorderThickness="1" CornerRadius="12" Padding="16,0">
                                            <Border Height="54">
                                                <Grid ColumnDefinitions="* Auto">
                                                    <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                        <TextBlock Text="删除实例" FontWeight="Medium" Foreground="#fafafa" FontSize="13"/>
                                                        <TextBlock Text="版本文件夹会移入回收站" FontSize="12" Foreground="#f87171"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Classes="BtnSm Danger" Content="删除"
                                                            Command="{Binding DeleteEditingInstanceCommand}"/>
                                                </Grid>
                                            </Border>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- 1b. 设置：隔离 / Java / 内存，一行一项（其他启动器 的「设置」页同构）。 -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              IsVisible="{Binding ConfigTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='设置'}">
                                    <StackPanel Spacing="16" Margin="0,0,10,0">
                                        <Border Background="#18181b" BorderBrush="#26262b" BorderThickness="1" CornerRadius="12" Padding="16,0">
                                            <StackPanel>
                                                <Border Height="54" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                                    <Grid ColumnDefinitions="* Auto">
                                                        <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                            <TextBlock Text="版本隔离" FontWeight="Medium" Foreground="#fafafa" FontSize="13"/>
                                                            <TextBlock Text="存档与模组独立存放（推荐）；切换时已有文件不会移动" FontSize="12" Foreground="#71717a"/>
                                                        </StackPanel>
                                                        <CheckBox Grid.Column="1" Classes="Tick" IsChecked="{Binding ConfigInstIsolated}"/>
                                                    </Grid>
                                                </Border>
                                                <Border Height="54" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                                    <Grid ColumnDefinitions="* Auto">
                                                        <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                            <TextBlock Text="独立 Java 运行时" FontWeight="Medium" Foreground="#fafafa" FontSize="13"/>
                                                            <TextBlock Text="关闭后使用全局 Java 设置" FontSize="12" Foreground="#71717a"/>
                                                        </StackPanel>
                                                        <CheckBox Grid.Column="1" Classes="Tick" IsChecked="{Binding ConfigInstCustomJava}"/>
                                                    </Grid>
                                                </Border>
                                                <Border MinHeight="54" Padding="0,10" BorderBrush="#26262b" BorderThickness="0,0,0,1"
                                                        IsVisible="{Binding ConfigInstCustomJava}">
                                                    <Grid ColumnDefinitions="* Auto">
                                                        <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                            <TextBlock Text="运行时版本" FontWeight="Medium" Foreground="#fafafa" FontSize="13"/>
                                                            <TextBlock Text="{Binding ConfigInstJavaLabel}" FontSize="12" Foreground="#71717a" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <Button Classes="BtnSm BtnOutline" Width="160"
                                                                    HorizontalContentAlignment="Stretch"
                                                                    Command="{Binding ToggleInstJavaChooserCommand}">
                                                                <Grid ColumnDefinitions="* Auto">
                                                                    <TextBlock Grid.Column="0" Text="选择…" VerticalAlignment="Center" FontSize="12"/>
                                                                    <materialIcons:MaterialIcon Grid.Column="1" Kind="ChevronDown" Width="14" Height="14" Foreground="#71717a"/>
                                                                </Grid>
                                                            </Button>
                                                            <Button Classes="BtnSm BtnOutline" Click="OnPickInstJavaClick" ToolTip.Tip="浏览自定义路径">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <materialIcons:MaterialIcon Kind="FolderSearchOutline" Width="14" Height="14"/>
                                                                    <TextBlock Text="浏览…" FontSize="12" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <Border BorderBrush="#26262b" BorderThickness="1" CornerRadius="10" Background="#111114" Padding="4"
                                                        Margin="0,8,0,8" IsVisible="{Binding IsInstJavaChooserOpen}">
                                                    <ItemsControl ItemsSource="{Binding InstJavaOptions}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:JavaOptionModel">
                                                                <Button Classes="MenuItem"
                                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectInstJavaCommand}"
                                                                        CommandParameter="{Binding .}">
                                                                    <Grid ColumnDefinitions="* Auto">
                                                                        <TextBlock Text="{Binding Label}" FontSize="13" Foreground="#fafafa"
                                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                        <materialIcons:MaterialIcon Grid.Column="1" Kind="Check" Width="14" Height="14"
                                                                                                    Foreground="#fafafa" IsVisible="{Binding IsSelected}"/>
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                                <Border Height="54" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                                    <Grid ColumnDefinitions="* Auto">
                                                        <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                            <TextBlock Text="JVM 附加启动参数" FontWeight="Medium" Foreground="#fafafa" FontSize="13"/>
                                                            <TextBlock Text="以空格分隔，逐条传给游戏进程" FontSize="12" Foreground="#71717a"/>
                                                        </StackPanel>
                                                        <TextBox Grid.Column="1" Width="220" Height="32" VerticalAlignment="Center"
                                                                 CornerRadius="8" Background="#111114" BorderBrush="#26262b"
                                                                 PlaceholderText="-XX:+UseG1GC" FontSize="12"
                                                                 Text="{Binding ConfigInstExtraJvmArgs, Mode=TwoWay, Delay=500}"/>
                                                    </Grid>
                                                </Border>
                                                <Border Height="54" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                                    <Grid ColumnDefinitions="* Auto">
                                                        <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                            <TextBlock Text="独立最大内存" FontWeight="Medium" Foreground="#fafafa" FontSize="13"/>
                                                            <TextBlock Text="{Binding GlobalMemoryGbSummary, StringFormat='关闭后使用全局设置（当前 {0}）'}"
                                                                       FontSize="12" Foreground="#71717a"/>
                                                        </StackPanel>
                                                        <CheckBox Grid.Column="1" Classes="Tick" IsChecked="{Binding ConfigInstCustomMemory}"/>
                                                    </Grid>
                                                </Border>
                                                <Border Height="54" BorderBrush="#26262b" BorderThickness="0,0,0,1"
                                                        IsVisible="{Binding ConfigInstCustomMemory}">
                                                    <Grid ColumnDefinitions="* Auto">
                                                        <TextBlock Text="分配给这个实例" FontWeight="Medium" Foreground="#fafafa" FontSize="13" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                            <!-- 拖动期间数字跟着滑条走（#名字），落盘等拇指停下（Delay），
                                                                 不然一寸一寸写盘、字还滞后。上限按物理内存封顶。 -->
                                                            <Slider x:Name="InstMemSlider" Value="{Binding ConfigInstMemoryGb, Delay=300}"
                                                                    Minimum="1" Maximum="{Binding MemorySliderMax}" Width="180"/>
                                                            <TextBlock Text="{Binding #InstMemSlider.Value, StringFormat='{}{0} GB'}"
                                                                       Width="48" TextAlignment="Right" Foreground="#fafafa" FontWeight="Medium" FontSize="13"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <Border Height="54">
                                                    <Grid ColumnDefinitions="* Auto">
                                                        <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                            <TextBlock Text="内存预分配 (Xms)" FontWeight="Medium" Foreground="#fafafa" FontSize="13"/>
                                                            <TextBlock Text="启动时即占满最大内存，可减少 GC 碎片"
                                                                       FontSize="12" Foreground="#71717a"/>
                                                        </StackPanel>
                                                        <CheckBox Grid.Column="1" Classes="Tick" IsChecked="{Binding ConfigInstPreallocate}"/>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- 图标选择浮层。放 Popup 而不是在卡片里往下展开：21 个格子铺开会把
                                     下面每一行都顶下去，而这是个「挑一下就关」的动作，不该占一块常驻位置。
                                     Avalonia 的 Placement 自带右对齐档（BottomEdgeAlignedRight），不用像
                                     WPF 那边手算负偏移：浮层右沿贴着铅笔按钮，不会伸出窗口右边。
                                     宽 316 = 7 格 × 42 步进（38 槽 + 4 间距）+ 左右各 10 内边距 + 2 余量；
                                     3 只加载器标志 + 18 块方块 = 21 项，正好铺满三行，标志在前、方块在后。
                                     注意：Popup 的内容是独立的可视树，`$parent[Window]` 在那里找不到，
                                     命令只能就近取 ItemsControl 的 DataContext。
                                     出场动画走 pop:PopupMotion（缩放+淡入），Avalonia 的 Popup 自己
                                     没有任何动画，不挂这一条就是"啪"地出现。 -->
                                <Popup x:Name="IconPickerPopup"
                                       PlacementTarget="{Binding #IconPickerAnchor}"
                                       Placement="BottomEdgeAlignedRight"
                                       VerticalOffset="6"
                                       IsLightDismissEnabled="True"
                                       pop:PopupMotion.Enable="True" pop:PopupMotion.Origin="TopRight"
                                       IsOpen="{Binding IsIconPickerOpen, Mode=TwoWay}">
                                    <Border Width="316" Background="#18181b" BorderBrush="#26262b" BorderThickness="1"
                                            CornerRadius="12" Padding="10,8">
                                        <ItemsControl ItemsSource="{Binding IconPresets}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:BlockIconModel">
                                                    <Button Classes="IconTile" Classes.On="{Binding IsSelected}"
                                                            ToolTip.Tip="{Binding Name}"
                                                            Command="{Binding $parent[ItemsControl].DataContext.SetInstanceIconPresetCommand}"
                                                            CommandParameter="{Binding}">
                                                        <Image Source="{Binding Bitmap, Converter={StaticResource PixelsToBitmap}}"
                                                               Width="34" Height="34"
                                                               RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Popup>

                                <!-- 2. 模组 -->
                                <Grid RowDefinitions="Auto *"
                                      IsVisible="{Binding ConfigTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='模组'}">
                                    <!-- Toolbar -->
                                    <Grid Grid.Row="0" ColumnDefinitions="Auto * Auto Auto Auto Auto Auto" Height="32" Margin="0,0,0,12">
                                        <TextBox Grid.Column="0" Classes="SearchBox" Width="200"
                                                 PlaceholderText="搜索模组..."
                                                 Text="{Binding ModSearch, Mode=TwoWay}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding EditingModCountText}" FontSize="12.5" Foreground="#a1a1aa"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        <Button Grid.Column="2" Classes="BtnSm BtnOutline" Height="32" Margin="0,0,8,0"
                                                Command="{Binding EnableAllModsCommand}" ToolTip.Tip="一键启用全部模组">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <materialIcons:MaterialIcon Kind="CheckAll" Width="14" Height="14"/>
                                                <TextBlock Text="全部启用" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="3" Classes="BtnSm BtnOutline" Height="32" Margin="0,0,8,0"
                                                Command="{Binding DisableAllModsCommand}" ToolTip.Tip="一键禁用全部模组">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <materialIcons:MaterialIcon Kind="CloseBoxOutline" Width="14" Height="14"/>
                                                <TextBlock Text="全部禁用" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="4" Classes="BtnSm BtnOutline" Height="32" Margin="0,0,8,0"
                                                Command="{Binding AddModFileCommand}" ToolTip.Tip="复制选中的 .jar 到 mods 文件夹，原文件保留">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <materialIcons:MaterialIcon Kind="Plus" Width="14" Height="14"/>
                                                <TextBlock Text="添加模组" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="5" Classes="BtnSm BtnOutline" Height="32" Margin="0,0,8,0"
                                                Command="{Binding OpenEditingModsCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <materialIcons:MaterialIcon Kind="FolderOutline" Width="14" Height="14"/>
                                                <TextBlock Text="打开文件夹" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="6" Classes="BtnSm BtnOutline" Height="32"
                                                Command="{Binding RefreshInstanceManageDataCommand}" ToolTip.Tip="刷新模组列表">
                                            <materialIcons:MaterialIcon Kind="Refresh" Width="14" Height="14"/>
                                        </Button>
                                    </Grid>

                                    <!-- Mod List / Empty State -->
                                    <Grid Grid.Row="1">
                                        <!-- Empty State -->
                                        <Border IsVisible="{Binding !HasFilteredEditingMods}"
                                                Background="#111114" BorderBrush="#26262b" BorderThickness="1" CornerRadius="14"
                                                Padding="40,32" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                                <materialIcons:MaterialIcon Kind="CubeOutline" Width="38" Height="38" Foreground="#52525b" HorizontalAlignment="Center"/>
                                                <TextBlock Text="暂无模组" FontSize="14" FontWeight="SemiBold" Foreground="#fafafa" HorizontalAlignment="Center"/>
                                                <TextBlock Text="可直接把 .jar 放进 mods 文件夹" FontSize="12" Foreground="#a1a1aa" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasFilteredEditingMods}">
                                            <ItemsControl ItemsSource="{Binding FilteredEditingMods}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#18181b" BorderBrush="#26262b" BorderThickness="1" CornerRadius="10"
                                                                Padding="12,8" Margin="0,0,0,6">
                                                            <Grid ColumnDefinitions="Auto * Auto Auto Auto">
                                                                <CheckBox Grid.Column="0" Classes="Tick" IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleModCommand}"
                                                                          CommandParameter="{Binding .}" Margin="0,0,12,0"/>
                                                                <!-- 模组名称 + 版本 pill（jar 清单里解析出来的） -->
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Medium"
                                                                                   Foreground="#fafafa" TextTrimming="CharacterEllipsis"/>
                                                                        <Border Classes="TagPill" Padding="6,1" VerticalAlignment="Center"
                                                                                IsVisible="{Binding HasModVersion}">
                                                                            <TextBlock Text="{Binding ModVersionText}" Classes="TagText"/>
                                                                        </Border>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="#52525b" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="2" Text="{Binding FileSizeText}" FontSize="12" Foreground="#71717a"
                                                                           VerticalAlignment="Center" Margin="14,0"/>
                                                                <TextBlock Grid.Column="3" Text="{Binding ModifiedTimeText}" FontSize="11.5" Foreground="#52525b"
                                                                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                                <Button Grid.Column="4" Classes="IconBtn" Width="28" Height="28"
                                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteModCommand}"
                                                                        CommandParameter="{Binding .}" ToolTip.Tip="删除模组">
                                                                    <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="14" Height="14" Foreground="#f87171"/>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Grid>

                                <!-- 3. 资源包 -->
                                <Grid RowDefinitions="Auto *"
                                      IsVisible="{Binding ConfigTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='资源包'}">
                                    <Grid Grid.Row="0" ColumnDefinitions="* Auto Auto Auto" Height="32" Margin="0,0,0,12">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="已安装资源包" FontSize="14" FontWeight="SemiBold" Foreground="#fafafa" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding EditingResourcePackCountText}" FontSize="12.5" Foreground="#71717a" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="BtnSm BtnOutline" Height="32" Margin="0,0,8,0"
                                                Command="{Binding AddResourcePackFileCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <materialIcons:MaterialIcon Kind="Plus" Width="14" Height="14"/>
                                                <TextBlock Text="添加资源包" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Classes="BtnSm BtnOutline" Height="32" Margin="0,0,8,0"
                                                Command="{Binding OpenEditingResourcePacksCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <materialIcons:MaterialIcon Kind="FolderOutline" Width="14" Height="14"/>
                                                <TextBlock Text="打开文件夹" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="3" Classes="BtnSm BtnOutline" Height="32"
                                                Command="{Binding RefreshInstanceManageDataCommand}" ToolTip.Tip="刷新资源包列表">
                                            <materialIcons:MaterialIcon Kind="Refresh" Width="14" Height="14"/>
                                        </Button>
                                    </Grid>

                                    <Grid Grid.Row="1">
                                        <!-- Empty State -->
                                        <Border IsVisible="{Binding !HasEditingResourcePacks}"
                                                Background="#111114" BorderBrush="#26262b" BorderThickness="1" CornerRadius="14"
                                                Padding="40,32" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                                <materialIcons:MaterialIcon Kind="PaletteOutline" Width="38" Height="38" Foreground="#52525b" HorizontalAlignment="Center"/>
                                                <TextBlock Text="暂无资源包" FontSize="14" FontWeight="SemiBold" Foreground="#fafafa" HorizontalAlignment="Center"/>
                                                <TextBlock Text="可直接把材质包放进 resourcepacks 文件夹" FontSize="12" Foreground="#a1a1aa" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasEditingResourcePacks}">
                                            <ItemsControl ItemsSource="{Binding EditingResourcePacks}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#18181b" BorderBrush="#26262b" BorderThickness="1" CornerRadius="10"
                                                                Padding="14,10" Margin="0,0,0,6">
                                                            <Grid ColumnDefinitions="Auto * Auto Auto Auto">
                                                                <materialIcons:MaterialIcon Grid.Column="0" Kind="PaletteOutline" Width="18" Height="18"
                                                                                            Foreground="#a1a1aa" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="Medium"
                                                                           Foreground="#fafafa" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="12" Foreground="#71717a"
                                                                           VerticalAlignment="Center" Margin="14,0"/>
                                                                <TextBlock Grid.Column="3" Text="{Binding ModifiedTimeText}" FontSize="11.5" Foreground="#52525b"
                                                                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                                <Button Grid.Column="4" Classes="IconBtn" Width="28" Height="28"
                                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteResourcePackCommand}"
                                                                        CommandParameter="{Binding .}" ToolTip.Tip="删除资源包">
                                                                    <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="14" Height="14" Foreground="#f87171"/>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Grid>

                                <!-- 4. 世界 (存档) -->
                                <Grid RowDefinitions="Auto *"
                                      IsVisible="{Binding ConfigTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='世界'}">
                                    <Grid Grid.Row="0" ColumnDefinitions="* Auto Auto" Height="32" Margin="0,0,0,12">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="世界存档" FontSize="14" FontWeight="SemiBold" Foreground="#fafafa" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding EditingWorldCountText}" FontSize="12.5" Foreground="#71717a" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="BtnSm BtnOutline" Height="32" Margin="0,0,8,0"
                                                Command="{Binding OpenEditingSavesCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <materialIcons:MaterialIcon Kind="FolderOutline" Width="14" Height="14"/>
                                                <TextBlock Text="打开存档文件夹" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Classes="BtnSm BtnOutline" Height="32"
                                                Command="{Binding RefreshInstanceManageDataCommand}" ToolTip.Tip="刷新世界列表">
                                            <materialIcons:MaterialIcon Kind="Refresh" Width="14" Height="14"/>
                                        </Button>
                                    </Grid>

                                    <Grid Grid.Row="1">
                                        <!-- Empty State -->
                                        <Border IsVisible="{Binding !HasEditingWorlds}"
                                                Background="#111114" BorderBrush="#26262b" BorderThickness="1" CornerRadius="14"
                                                Padding="40,32" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                                <materialIcons:MaterialIcon Kind="Earth" Width="38" Height="38" Foreground="#52525b" HorizontalAlignment="Center"/>
                                                <TextBlock Text="暂无世界存档" FontSize="14" FontWeight="SemiBold" Foreground="#fafafa" HorizontalAlignment="Center"/>
                                                <TextBlock Text="进游戏创建一个，或把存档解压到 saves 文件夹" FontSize="12" Foreground="#a1a1aa" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasEditingWorlds}">
                                            <ItemsControl ItemsSource="{Binding EditingWorlds}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#18181b" BorderBrush="#26262b" BorderThickness="1" CornerRadius="10"
                                                                Padding="14,10" Margin="0,0,0,6">
                                                            <Grid ColumnDefinitions="Auto * Auto Auto Auto">
                                                                <materialIcons:MaterialIcon Grid.Column="0" Kind="Earth" Width="18" Height="18"
                                                                                            Foreground="#a1a1aa" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="Medium"
                                                                           Foreground="#fafafa" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding LastPlayedText, StringFormat='保存于 {0}'}" FontSize="12" Foreground="#71717a"
                                                                           VerticalAlignment="Center" Margin="14,0"/>
                                                                <Button Grid.Column="3" Classes="BtnSm BtnOutline" Height="28" Margin="0,0,8,0"
                                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenWorldFolderCommand}"
                                                                        CommandParameter="{Binding .}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                                        <materialIcons:MaterialIcon Kind="FolderOutline" Width="12" Height="12"/>
                                                                        <TextBlock Text="打开" FontSize="11.5" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button Grid.Column="4" Classes="IconBtn" Width="28" Height="28"
                                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteWorldCommand}"
                                                                        CommandParameter="{Binding .}" ToolTip.Tip="删除世界存档">
                                                                    <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="14" Height="14" Foreground="#f87171"/>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Grid>

                                <!-- 5. 文件与管理 -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              IsVisible="{Binding ConfigTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='目录'}">
                                    <StackPanel Spacing="16" Margin="0,0,10,0">
                                        <Border Background="#18181b" BorderBrush="#26262b" BorderThickness="1" CornerRadius="12" Padding="16,0">
                                            <StackPanel>
                                                <Border Height="54" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                                    <Grid ColumnDefinitions="* Auto">
                                                        <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                            <TextBlock Text="实例文件夹" FontWeight="Medium" Foreground="#fafafa" FontSize="13"/>
                                                            <TextBlock Text="{Binding EditingGameDirectory}" FontSize="12" Foreground="#71717a"
                                                                       TextTrimming="CharacterEllipsis" FontFamily="Consolas"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Classes="BtnSm BtnOutline"
                                                                Command="{Binding OpenInstanceFolderCommand}" CommandParameter="{Binding EditingInstance}">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <materialIcons:MaterialIcon Kind="FolderOutline" Width="14" Height="14"/>
                                                                <TextBlock Text="打开" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                                <Border Height="54" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                                    <Grid ColumnDefinitions="* Auto">
                                                        <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                            <TextBlock Text="存档 (saves)" FontWeight="Medium" Foreground="#fafafa" FontSize="13"/>
                                                            <TextBlock Text="{Binding EditingSavesDirectory}" FontSize="12" Foreground="#71717a"
                                                                       TextTrimming="CharacterEllipsis" FontFamily="Consolas"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Classes="BtnSm BtnOutline"
                                                                Command="{Binding OpenEditingSavesCommand}">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <materialIcons:MaterialIcon Kind="FolderOutline" Width="14" Height="14"/>
                                                                <TextBlock Text="打开" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                                <Border Height="54" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                                    <Grid ColumnDefinitions="* Auto">
                                                        <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                            <TextBlock Text="模组 (mods)" FontWeight="Medium" Foreground="#fafafa" FontSize="13"/>
                                                            <TextBlock Text="{Binding EditingModsDirectory}" FontSize="12" Foreground="#71717a"
                                                                       TextTrimming="CharacterEllipsis" FontFamily="Consolas"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Classes="BtnSm BtnOutline"
                                                                Command="{Binding OpenEditingModsCommand}">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <materialIcons:MaterialIcon Kind="FolderOutline" Width="14" Height="14"/>
                                                                <TextBlock Text="打开" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                                <Border Height="54">
                                                    <Grid ColumnDefinitions="* Auto">
                                                        <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                            <TextBlock Text="资源包 (resourcepacks)" FontWeight="Medium" Foreground="#fafafa" FontSize="13"/>
                                                            <TextBlock Text="{Binding EditingResourcePacksDirectory}" FontSize="12" Foreground="#71717a"
                                                                       TextTrimming="CharacterEllipsis" FontFamily="Consolas"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Classes="BtnSm BtnOutline"
                                                                Command="{Binding OpenEditingResourcePacksCommand}">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <materialIcons:MaterialIcon Kind="FolderOutline" Width="14" Height="14"/>
                                                                <TextBlock Text="打开" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                                <!-- 导出与删除挪去了概览（快捷操作 / 危险区），这里只留路径。 -->
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Grid>
                </Panel>


                <!-- PAGE 3: DOWNLOAD (version/resource browser; the task list is a popover) -->
                <Panel Classes="PageAnim" IsVisible="{Binding CurrentPage, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='download'}">
                    <Grid RowDefinitions="Auto *">
                        <!-- .page-head -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto Auto * Auto Auto" Height="36" Margin="0,0,84,16">
                            <TextBlock Grid.Column="0" Text="下载" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#fafafa" Margin="0,0,8,0"/>
                            <!-- .tabs: 游戏, 模组, 整合包, 资源包, 光影 -->
                            <Border Grid.Column="1" Background="#1c1c21" CornerRadius="10" Padding="3">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Classes="SegmentBtn" Content="游戏"
                                            Classes.On="{Binding CurrentResCategory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='game'}"
                                            Command="{Binding SelectResCategoryCommand}" CommandParameter="game"/>
                                    <Button Classes="SegmentBtn" Content="模组"
                                            Classes.On="{Binding CurrentResCategory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='mod'}"
                                            Command="{Binding SelectResCategoryCommand}" CommandParameter="mod"/>
                                    <Button Classes="SegmentBtn" Content="整合包"
                                            Classes.On="{Binding CurrentResCategory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='pack'}"
                                            Command="{Binding SelectResCategoryCommand}" CommandParameter="pack"/>
                                    <Button Classes="SegmentBtn" Content="资源包"
                                            Classes.On="{Binding CurrentResCategory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='rp'}"
                                            Command="{Binding SelectResCategoryCommand}" CommandParameter="rp"/>
                                    <Button Classes="SegmentBtn" Content="光影"
                                            Classes.On="{Binding CurrentResCategory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='shader'}"
                                            Command="{Binding SelectResCategoryCommand}" CommandParameter="shader"/>
                                </StackPanel>
                            </Border>

                            <!-- Task list popover trigger -->
                            <Button Grid.Column="3" x:Name="DlPopBtn" Classes="BtnSm BtnOutline"
                                    Content="下载任务" Command="{Binding ToggleDlPopCommand}"
                                    Margin="0,0,8,0" VerticalAlignment="Center"/>

                            <!-- Search -->
                            <TextBox Grid.Column="4" Classes="SearchBox" Width="240"
                                     PlaceholderText="搜索"
                                     Text="{Binding ResourceSearch}" />
                        </Grid>

                        <!-- .list -->
                        <ScrollViewer Grid.Row="1" IsVisible="{Binding HasResources}">
                            <Border Background="#111114" BorderBrush="#26262b" BorderThickness="1" CornerRadius="14" ClipToBounds="True" VerticalAlignment="Top">
                                <ItemsControl ItemsSource="{Binding FilteredResources}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ResourceModel">
                                            <!-- .list-item -->
                                            <Border BorderBrush="#26262b" BorderThickness="0,0,0,1" Padding="16,12">
                                                <Grid ColumnDefinitions="Auto * Auto Auto">
                                                    <!-- 36x36 Pixel Icon -->
                                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" ClipToBounds="True" Margin="0,0,14,0">
                                                        <Image Source="{Binding IconBitmap, Converter={StaticResource PixelsToBitmap}}"
                                                               Width="36" Height="36"
                                                               RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                                    </Border>

                                                    <!-- .grow: b + desc -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#fafafa"/>
                                                        <TextBlock Text="{Binding Desc}" FontSize="12" Foreground="#a1a1aa" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <!-- .stat -->
                                                    <TextBlock Grid.Column="2" Text="{Binding Stat}"
                                                               FontSize="12" Foreground="#a1a1aa"
                                                               VerticalAlignment="Center" Margin="16,0"/>

                                                    <!-- .btn .btn-outline .btn-sm -->
                                                    <Button Grid.Column="3" Classes="BtnSm BtnOutline"
                                                            Content="{Binding ActionText}"
                                                            IsEnabled="{Binding IsActionEnabled}"
                                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).InstallResourceCommand}"
                                                            CommandParameter="{Binding .}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </ScrollViewer>

                        <StackPanel Grid.Row="1" IsVisible="{Binding !HasResources}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <ProgressBar IsIndeterminate="True" Width="120" Height="4" CornerRadius="999"
                                         Foreground="#fafafa" Background="#26262b"
                                         HorizontalAlignment="Center"
                                         IsVisible="{Binding IsLoadingResources}"/>
                            <TextBlock Text="{Binding ResourceEmptyText}" FontSize="13" Foreground="#a1a1aa"
                                       HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="420"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Panel>

                <!-- PAGE 5: SETTINGS -->
                <Panel Classes="PageAnim" IsVisible="{Binding CurrentPage, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='settings'}">
                    <Grid RowDefinitions="Auto *">
                        <TextBlock Grid.Row="0" Text="设置" FontSize="20" FontWeight="SemiBold" Height="36" VerticalAlignment="Center" Foreground="#fafafa" Margin="0,0,0,16"/>

                        <!-- .settings: 2 columns 160px 1fr -->
                        <Grid Grid.Row="1" ColumnDefinitions="160 24 *">
                            <!-- .set-nav. ⚠️ The Debug entry is NOT in this file — it is appended
                                 from MainWindow.Debug.cs under #if DEBUG, so a Release build never
                                 compiles it (see that file). -->
                            <StackPanel x:Name="SettingsNavPanel" Grid.Column="0" Spacing="4">
                                <Button Classes="SetNavBtn" Content="游戏"
                                        Classes.On="{Binding CurrentSettingsTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='游戏'}"
                                        Command="{Binding SelectSettingsTabCommand}" CommandParameter="游戏"/>
                                <Button Classes="SetNavBtn" Content="Java"
                                        Classes.On="{Binding CurrentSettingsTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Java'}"
                                        Command="{Binding SelectSettingsTabCommand}" CommandParameter="Java"/>
                                <Button Classes="SetNavBtn" Content="下载"
                                        Classes.On="{Binding CurrentSettingsTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='下载'}"
                                        Command="{Binding SelectSettingsTabCommand}" CommandParameter="下载"/>
                                <!-- 「地区」暂时只在 Debug 构建里出现（见 ViewModels/RegionFeature.cs）：
                                     Release 下 IsRegionVisible 恒 false，这一项连同右侧卡片都到不了。 -->
                                <Button Classes="SetNavBtn" Content="地区"
                                        IsVisible="{Binding IsRegionVisible}"
                                        Classes.On="{Binding CurrentSettingsTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='地区'}"
                                        Command="{Binding SelectSettingsTabCommand}" CommandParameter="地区"/>
                                <Button Classes="SetNavBtn" Content="外观"
                                        Classes.On="{Binding CurrentSettingsTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='外观'}"
                                        Command="{Binding SelectSettingsTabCommand}" CommandParameter="外观"/>
                                <Button Classes="SetNavBtn" Content="关于"
                                        Classes.On="{Binding CurrentSettingsTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='关于'}"
                                        Command="{Binding SelectSettingsTabCommand}" CommandParameter="关于"/>
                            </StackPanel>

                            <!-- .set-card: one card per tab, so each group ends on a borderless row.
                                 The Debug card is likewise appended from MainWindow.Debug.cs (Debug only). -->
                            <Panel x:Name="SettingsCardsPanel" Grid.Column="2" VerticalAlignment="Top">

                                <!-- 游戏 -->
                                <Border Background="#111114" BorderBrush="#26262b" BorderThickness="1" CornerRadius="14" Padding="18,0"
                                        IsVisible="{Binding CurrentSettingsTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='游戏'}">
                                    <StackPanel>
                                        <Border Height="58" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="* Auto">
                                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="最大内存" FontWeight="Medium" Foreground="#fafafa"/>
                                                    <TextBlock Text="分配给游戏的堆内存，建议不超过物理内存的一半。"
                                                               FontSize="12" Foreground="#71717a"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Width="280" VerticalAlignment="Center">
                                                    <Slider Value="{Binding MaxMemoryGb}" Minimum="1" Maximum="32" Width="210"/>
                                                    <TextBlock Text="{Binding MaxMemoryGb, StringFormat='{}{0} GB'}"
                                                               Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                                               Foreground="#fafafa"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Height="58" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="* Auto">
                                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="版本隔离" FontWeight="Medium" Foreground="#fafafa"/>
                                                    <TextBlock Text="每个实例有独立的存档、Mod 和配置文件。"
                                                               FontSize="12" Foreground="#71717a"/>
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding VersionIsolation}" OnContent="" OffContent=""/>
                                            </Grid>
                                        </Border>

                                        <Border Height="58" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="* Auto">
                                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="启动后隐藏启动器" FontWeight="Medium" Foreground="#fafafa"/>
                                                    <TextBlock Text="游戏退出后会自动恢复。" FontSize="12" Foreground="#71717a"/>
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding HideOnLaunch}" OnContent="" OffContent=""/>
                                            </Grid>
                                        </Border>

                                        <Border Height="58" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="* Auto">
                                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="关闭窗口时" FontWeight="Medium" Foreground="#fafafa"/>
                                                    <TextBlock Text="点 ✕ 或按 Alt+F4 的时候走哪条路。" FontSize="12" Foreground="#71717a"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#1c1c21" CornerRadius="10" Padding="3" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                                        <Button Classes="SegmentBtn" Content="每次询问"
                                                                Classes.On="{Binding CloseWindowBehavior, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='ask'}"
                                                                Command="{Binding SetCloseWindowBehaviorCommand}" CommandParameter="ask"/>
                                                        <Button Classes="SegmentBtn" Content="收进托盘"
                                                                Classes.On="{Binding CloseWindowBehavior, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='tray'}"
                                                                Command="{Binding SetCloseWindowBehaviorCommand}" CommandParameter="tray"/>
                                                        <Button Classes="SegmentBtn" Content="直接退出"
                                                                Classes.On="{Binding CloseWindowBehavior, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='exit'}"
                                                                Command="{Binding SetCloseWindowBehaviorCommand}" CommandParameter="exit"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <Border Height="58">
                                            <Grid ColumnDefinitions="* Auto">
                                                <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                    <TextBlock Text="游戏目录" FontWeight="Medium" Foreground="#fafafa"/>
                                                    <TextBlock Text="{Binding GameRoot}" FontSize="12" Foreground="#71717a"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="BtnSm BtnOutline" VerticalAlignment="Center"
                                                        Command="{Binding OpenGameRootCommand}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="14" Height="14"/>
                                                        <TextBlock Text="打开" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Java -->
                                <Border Background="#111114" BorderBrush="#26262b" BorderThickness="1" CornerRadius="14" Padding="18,0"
                                        IsVisible="{Binding CurrentSettingsTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Java'}">
                                    <StackPanel>
                                        <Border Height="58" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="* Auto">
                                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="Java 运行时" FontWeight="Medium" Foreground="#fafafa"/>
                                                    <TextBlock Text="自动模式会按版本要求挑选合适的 Java。" FontSize="12" Foreground="#71717a"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="BtnSm BtnOutline" Width="240"
                                                        HorizontalContentAlignment="Stretch"
                                                        Command="{Binding ToggleJavaChooserCommand}">
                                                    <Grid ColumnDefinitions="* Auto">
                                                        <TextBlock Text="{Binding JavaLabel}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <materialIcons:MaterialIcon Grid.Column="1" Kind="ChevronDown"
                                                                                    Width="14" Height="14" Foreground="#71717a"/>
                                                    </Grid>
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <Border Padding="0,8" IsVisible="{Binding IsJavaChooserOpen}">
                                            <StackPanel Spacing="2">
                                                <ItemsControl ItemsSource="{Binding JavaOptions}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:JavaOptionModel">
                                                            <Button Classes="MenuItem"
                                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectJavaCommand}"
                                                                    CommandParameter="{Binding .}">
                                                                <Grid ColumnDefinitions="* Auto">
                                                                    <TextBlock Text="{Binding Label}" FontSize="13" Foreground="#fafafa"
                                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                    <materialIcons:MaterialIcon Grid.Column="1" Kind="Check" Width="16" Height="16"
                                                                                                Foreground="#fafafa" IsVisible="{Binding IsSelected}"/>
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Button Classes="MenuItem" Click="OnPickJavaClick">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <materialIcons:MaterialIcon Kind="FolderSearchOutline" Width="18" Height="18"
                                                                                    Foreground="#a1a1aa" Margin="7,0"/>
                                                        <TextBlock Text="浏览 javaw.exe…" FontSize="13" Foreground="#fafafa" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                        <Border Height="58">
                                            <TextBlock Text="缺少合适的 Java 时，启动会失败并提示需要的版本。"
                                                       FontSize="12" Foreground="#71717a" VerticalAlignment="Center"
                                                       TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- 下载 -->
                                <Border Background="#111114" BorderBrush="#26262b" BorderThickness="1" CornerRadius="14" Padding="18,0"
                                        IsVisible="{Binding CurrentSettingsTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='下载'}">
                                    <StackPanel>
                                        <Border Height="58" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="* Auto">
                                                <TextBlock Text="下载源" FontWeight="Medium" VerticalAlignment="Center" Foreground="#fafafa"/>
                                                <Border Grid.Column="1" Background="#1c1c21" CornerRadius="10" Padding="3">
                                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                                        <Button Classes="SegmentBtn" Content="官方"
                                                                Classes.On="{Binding DownloadSource, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='官方'}"
                                                                Command="{Binding SetDownloadSourceCommand}" CommandParameter="官方"/>
                                                        <Button Classes="SegmentBtn" Content="BMCLAPI"
                                                                Classes.On="{Binding DownloadSource, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='BMCLAPI'}"
                                                                Command="{Binding SetDownloadSourceCommand}" CommandParameter="BMCLAPI"/>
                                                        <Button Classes="SegmentBtn" Content="自动"
                                                                Classes.On="{Binding DownloadSource, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='自动'}"
                                                                Command="{Binding SetDownloadSourceCommand}" CommandParameter="自动"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- BMCLAPI's terms require the sponsor to be credited wherever the mirror is
                                             offered, so the line stays put no matter which source is selected. -->
                                        <Border Padding="0,14" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{Binding SourceHint}" FontSize="12" Foreground="#71717a"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="BMCLAPI 由 bangbang93 赞助提供。" FontSize="12"
                                                           Foreground="#71717a" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Height="58" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="* Auto">
                                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="下载线程" FontWeight="Medium" Foreground="#fafafa"/>
                                                    <TextBlock Text="同时下载的连接数，大文件会拆成多段并行。"
                                                               FontSize="12" Foreground="#71717a"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Width="280" VerticalAlignment="Center">
                                                    <Slider Value="{Binding DownloadThreads}" Minimum="1" Maximum="64" Width="210"/>
                                                    <TextBlock Text="{Binding DownloadThreads, StringFormat='{}{0}'}"
                                                               Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                                               Foreground="#fafafa"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Padding="0,16,0,18">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnDefinitions="* Auto">
                                                    <TextBlock Text="下载中心" FontWeight="Medium" Foreground="#fafafa"
                                                               VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Classes="BtnSm BtnOutline" Content="清除已完成"
                                                            Command="{Binding ClearDownloadsCommand}"/>
                                                </Grid>
                                                <Border BorderBrush="#26262b" BorderThickness="1" CornerRadius="10"
                                                        ClipToBounds="True" IsVisible="{Binding HasDownloads}">
                                                    <ScrollViewer MaxHeight="320">
                                                        <ItemsControl ItemsSource="{Binding Downloads}"
                                                                      ItemTemplate="{StaticResource DownloadRowTemplate}"/>
                                                    </ScrollViewer>
                                                </Border>
                                                <TextBlock Text="暂无下载任务" IsVisible="{Binding !HasDownloads}"
                                                           FontSize="13" Foreground="#71717a"
                                                           HorizontalAlignment="Center" Margin="0,16"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- 地区 -->
                                <Border Background="#111114" BorderBrush="#26262b" BorderThickness="1" CornerRadius="14" Padding="18,0"
                                        IsVisible="{Binding CurrentSettingsTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='地区'}">
                                    <StackPanel>
                                        <Border Height="58" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="* Auto">
                                                <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                    <TextBlock Text="所在地区" FontWeight="Medium" Foreground="#fafafa"/>
                                                    <TextBlock Text="{Binding RegionHint}" FontSize="12" Foreground="#71717a"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding RegionLabel}" FontSize="14" FontWeight="Medium"
                                                               Foreground="#fafafa" VerticalAlignment="Center"/>
                                                    <Button Classes="BtnSm BtnOutline" Content="重新检测"
                                                            Command="{Binding RefreshRegionCommand}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Padding="0,14,0,16">
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="为什么需要它" FontWeight="Medium" Foreground="#fafafa"/>
                                                <TextBlock FontSize="12" Foreground="#71717a" TextWrapping="Wrap"
                                                           Text="不同国家和地区对内容分发、镜像与在线服务的要求不一样，启动器按这一项决定某些内容给不给、从哪拿。判断只看出口 IP 的注册地：不读设备信息、不做定位，也不会上报给任何人。"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- 外观 -->
                                <Border Background="#111114" BorderBrush="#26262b" BorderThickness="1" CornerRadius="14" Padding="18,0"
                                        IsVisible="{Binding CurrentSettingsTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='外观'}">
                                    <StackPanel>
                                        <Border Height="58" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="* Auto">
                                                <TextBlock Text="主题" FontWeight="Medium" VerticalAlignment="Center" Foreground="#fafafa"/>
                                                <Button Grid.Column="1" Classes="BtnSm BtnOutline" Command="{Binding ToggleThemeCommand}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <materialIcons:MaterialIcon Kind="WeatherSunny" Width="14" Height="14"/>
                                                        <TextBlock Text="切换深浅色" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <Border Height="58" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="* Auto">
                                                <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                    <TextBlock Text="界面动画" FontWeight="Medium" Foreground="#fafafa"/>
                                                    <TextBlock Text="页面切换、浮层开合这类过渡。"
                                                               FontSize="12" Foreground="#71717a" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="BtnSm BtnOutline"
                                                        Command="{Binding CycleMotionPreferenceCommand}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <materialIcons:MaterialIcon Kind="MovieOpen" Width="14" Height="14"/>
                                                        <TextBlock Text="{Binding MotionPreferenceLabel}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <Border Height="58" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="* Auto">
                                                <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                    <TextBlock Text="首页 3D 模型" FontWeight="Medium" Foreground="#fafafa"/>
                                                    <TextBlock Text="左键拖它的位置（会记住），右键转角度。关掉它会把拖过的位置一起清掉，重开回到默认站位。"
                                                               FontSize="12" Foreground="#71717a" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <!-- 只清位置、不动开关：拖乱了想回原点，不该顺手把模型也关掉 -->
                                                    <Button Classes="BtnSm BtnOutline" Content="复位位置"
                                                            Command="{Binding ResetHomeSkinModelPositionCommand}"
                                                            IsVisible="{Binding HasHomeSkinModelPosition}"/>
                                                    <ToggleSwitch IsChecked="{Binding HomeSkinModelVisible}" OnContent="" OffContent=""/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Height="58">
                                            <Grid ColumnDefinitions="* Auto">
                                                <TextBlock Text="背景图片" FontWeight="Medium" VerticalAlignment="Center" Foreground="#fafafa"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <!-- current background, so the picked image is identifiable at a glance -->
                                                    <Border Width="52" Height="34" CornerRadius="8" ClipToBounds="True"
                                                            BorderBrush="#26262b" BorderThickness="1"
                                                            IsVisible="{Binding IsCustomBackground}">
                                                        <Panel>
                                                            <Image Source="{Binding BgCustomArt, Converter={StaticResource PixelsToBitmap}}" Stretch="UniformToFill"/>
                                                            <Border Background="#ffffff" Opacity="{Binding BgLightOpacity}"/>
                                                            <Border Background="#000000" Opacity="{Binding BgDarkOpacity}"/>
                                                        </Panel>
                                                    </Border>
                                                    <!-- 门控看 HasCustomBackground（图片**或**视频），
                                                         与 WPF 侧一致：只按 IsCustomBackground 的话，
                                                         换成视频壁纸后这一排按钮会整排消失。 -->
                                                    <Button Classes="BtnSm BtnOutline" Content="调整"
                                                            Command="{Binding OpenBgTuningCommand}"
                                                            IsVisible="{Binding HasCustomBackground}"/>
                                                    <!-- 这颗是"换回默认壁纸"（连背景一起清掉）；调节窗里那颗同名的
                                                         只归零参数、不动壁纸 —— 两件事，文案必须分开。 -->
                                                    <Button Classes="BtnSm BtnOutline" Content="恢复默认壁纸"
                                                            Command="{Binding ResetBackgroundCommand}"
                                                            IsVisible="{Binding HasCustomBackground}"/>
                                                    <Button Classes="BtnSm BtnOutline" Click="OnPickBackgroundClick">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <materialIcons:MaterialIcon Kind="ImageFrame" Width="14" Height="14"/>
                                                            <TextBlock Text="选择图片" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- 关于 -->
                                <Border Background="#111114" BorderBrush="#26262b" BorderThickness="1" CornerRadius="14" Padding="18,18"
                                        IsVisible="{Binding CurrentSettingsTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='关于'}">
                                    <StackPanel Spacing="14">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Image Source="avares://NegiCraftLauncher.Avalonia/Assets/app.png" Width="40" Height="40"/>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="NegiCraft Launcher" FontSize="16" FontWeight="SemiBold" Foreground="#fafafa"/>
                                                <TextBlock Text="{Binding LauncherVersion, StringFormat='版本 {0}'}"
                                                           FontSize="12" Foreground="#a1a1aa"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock FontSize="12" Foreground="#71717a" TextWrapping="Wrap" LineHeight="20"
                                                   Text="本项目与 Mojang Studios 及 Microsoft 无关联。Minecraft 是 Mojang Studios 的商标。"/>
                                    </StackPanel>
                                </Border>
                            </Panel>
                        </Grid>
                    </Grid>
                </Panel>
            </Panel>

            <!-- ========================================== -->
            <!-- 6. POPOVER DISMISS OVERLAY (Click outside) -->
            <!-- ========================================== -->
            <Panel Background="Transparent"
                   ZIndex="45"
                   PointerPressed="OnPopoverBackgroundPointerPressed"
                   IsVisible="{Binding HasOpenPopover}"/>

            <!-- ========================================== -->
            <!-- 7. POPOVERS (1:1 with Image 2 & mockup)    -->
            <!-- ========================================== -->
            <!-- #accPop: left: 84px; bottom: 12px; width: 280px; -->
            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Margin="84,0,0,12" Width="280"
                    Background="#111114" BorderBrush="#26262b" BorderThickness="1"
                    CornerRadius="14" Padding="6"
                    BoxShadow="0 30 80 -20 #EE000000"
                    Classes="Popover"
                    pop:Pop.Anchor="BottomLeft"
                    pop:Pop.Trigger="{Binding #AccountAvatar}"
                    pop:Pop.IsOpen="{Binding IsAccPopOpen}"
                    Classes.Open="{Binding IsAccPopOpen}"
                    ZIndex="50">
                <StackPanel Spacing="2">
                    <ScrollViewer MaxHeight="260">
                        <ItemsControl ItemsSource="{Binding Accounts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:AccountModel">
                                    <Grid ColumnDefinitions="* Auto" Margin="0,1">
                                        <Button Grid.Column="0" Classes="MenuItem"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectAccountCommand}"
                                                CommandParameter="{Binding .}">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="删除账户"
                                                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveAccountCommand}"
                                                              CommandParameter="{Binding .}"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <Grid ColumnDefinitions="Auto * Auto">
                                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" ClipToBounds="True" Margin="0,0,10,0">
                                                    <Image Source="{Binding AvatarBitmap, Converter={StaticResource PixelsToBitmap}}" Width="30" Height="30" RenderOptions.BitmapInterpolationMode="None"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#fafafa" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Type}" FontSize="12" Foreground="#a1a1aa"/>
                                                </StackPanel>
                                                <!-- Checkmark if active -->
                                                <materialIcons:MaterialIcon Grid.Column="2" Kind="Check" Width="16" Height="16" Foreground="#fafafa"
                                                                            IsVisible="{Binding IsCurrent}" Margin="0,0,4,0"/>
                                            </Grid>
                                        </Button>
                                        <!-- Direct Delete Button -->
                                        <Button Grid.Column="1" Classes="IconBtn Danger" Width="28" Height="28" Margin="4,0,2,0"
                                                ToolTip.Tip="删除账户"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveAccountCommand}"
                                                CommandParameter="{Binding .}">
                                            <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="15" Height="15" Foreground="#71717a"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Separator -->
                    <Rectangle Height="1" Fill="#26262b" Margin="0,6" IsVisible="{Binding HasAccounts}"/>

                    <Button Classes="MenuItem" Command="{Binding AddOfflineAccountCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <materialIcons:MaterialIcon Kind="AccountPlusOutline" Width="18" Height="18" Foreground="#a1a1aa" Margin="7,0"/>
                            <TextBlock Text="添加离线账户" FontSize="13" Foreground="#fafafa" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Reserved until an Azure application id is available; the command explains why -->
                    <Button Classes="MenuItem" Command="{Binding AddMicrosoftAccountCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <materialIcons:MaterialIcon Kind="Microsoft" Width="18" Height="18" Foreground="#a1a1aa" Margin="7,0"/>
                            <TextBlock Text="添加微软账户" FontSize="13" Foreground="#71717a" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- #instPop: exactly 8px above dock (bottom: 100px), width: 380px (1:1 with Image 2) -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,20,100" Width="380"
                    Background="#111114" BorderBrush="#26262b" BorderThickness="1"
                    CornerRadius="14" Padding="6"
                    BoxShadow="0 30 80 -20 #EE000000"
                    Classes="Popover"
                    pop:Pop.Anchor="BottomLeft"
                    pop:Pop.Trigger="{Binding #InstSelectBtn}"
                    pop:Pop.IsOpen="{Binding IsInstPopOpen}"
                    Classes.Open="{Binding IsInstPopOpen}"
                    ZIndex="50">
                <StackPanel Spacing="2">
                    <ScrollViewer MaxHeight="300">
                        <ItemsControl ItemsSource="{Binding Instances}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:InstanceModel">
                                    <Button Classes="MenuItem"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectInstanceCommand}"
                                            CommandParameter="{Binding .}">
                                        <Grid ColumnDefinitions="Auto * Auto">
                                            <!-- 32x32 Block icon with 7px radius (matching Image 2) -->
                                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="7" ClipToBounds="True" Margin="0,0,10,0">
                                                <Image Source="{Binding IconBitmap, Converter={StaticResource PixelsToBitmap}}" Width="32" Height="32" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#fafafa"/>
                                                <TextBlock Text="{Binding MetaText}" FontSize="12" Foreground="#a1a1aa"/>
                                            </StackPanel>
                                            <!-- Checkmark if active (matching Image 2) -->
                                            <materialIcons:MaterialIcon Grid.Column="2" Kind="Check" Width="16" Height="16" Foreground="#fafafa"
                                                                       IsVisible="{Binding IsCurrent}"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Rectangle Height="1" Fill="#26262b" Margin="0,6" IsVisible="{Binding HasInstances}"/>

                    <Button Classes="MenuItem" Command="{Binding NewInstanceCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <materialIcons:MaterialIcon Kind="Plus" Width="18" Height="18" Foreground="#a1a1aa" Margin="7,0"/>
                            <TextBlock Text="安装新版本" FontSize="13" Foreground="#fafafa" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ========================================== -->
            <!-- 7a2. 加载器筛选下拉（挂在实例页工具条那颗按钮上） -->
            <!-- ========================================== -->
            <!-- 选项由 VM 的 LoaderChoices 生成：只列实例里真出现过的加载器。
                 种类再多也不会把工具条撑爆，没装过的类型也不摆出来碍事。 -->
            <!-- 停的位置由 Pop.Pin 按那颗按钮的矩形现算（UnderLeft = 左边与按钮齐、上沿在按钮下方 6），
                 和稿子里 `p.style.left=r.left; p.style.top=r.bottom+6` 同一条规则；Margin 只兜底。 -->
            <Border x:Name="LoaderPop" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="0,102,0,0" Width="208"
                    Background="#111114" BorderBrush="#26262b" BorderThickness="1"
                    CornerRadius="14" Padding="6"
                    BoxShadow="0 30 80 -20 #EE000000"
                    Classes="Popover"
                    pop:Pop.Anchor="TopLeft"
                    pop:Pop.Pin="UnderLeft"
                    pop:Pop.PinGap="6"
                    pop:Pop.Trigger="{Binding #LoaderFilterBtn}"
                    pop:Pop.IsOpen="{Binding IsLoaderPopOpen}"
                    Classes.Open="{Binding IsLoaderPopOpen}"
                    ZIndex="50">
                <ScrollViewer MaxHeight="280" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding LoaderChoices}" HorizontalAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:LoaderOptionModel">
                                <Button Classes="MenuItem"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectInstanceLoaderCommand}"
                                        CommandParameter="{Binding Name}">
                                    <Grid ColumnDefinitions="* Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="13" Foreground="#fafafa" VerticalAlignment="Center"/>
                                        <materialIcons:MaterialIcon Grid.Column="1" Kind="Check" Width="16" Height="16" Foreground="#fafafa"
                                                                    VerticalAlignment="Center" IsVisible="{Binding IsSelected}"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- ========================================== -->
            <!-- 7a3. 目录切换浮层（挂在页头那颗胶囊上）      -->
            <!-- ========================================== -->
            <!-- 每个目录是一棵自己的 .minecraft：versions/ 各扫各的，实例元数据按目录分开存。
                 每行右边那颗「⋯」和行右键是同一个菜单（重命名 / 设为默认 / 复制路径 / 移除）。
                 选中态不再打勾，直接给 muted 底 —— 稿子定的口径。 -->
            <!-- 停的位置交给 Pop.Pin：UnderRight + 间隙 6，右边缘与按钮对齐展开。
                 下面的 Margin 只在 Pin 量不到时兜底。 -->
            <Border x:Name="FolderPop" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="0,102,0,0" Width="300"
                    Background="#111114" BorderBrush="#26262b" BorderThickness="1"
                    CornerRadius="12" Padding="4"
                    BoxShadow="0 30 80 -20 #EE000000"
                    Classes="Popover"
                    pop:Pop.Anchor="TopRight"
                    pop:Pop.Pin="UnderRight"
                    pop:Pop.PinGap="6"
                    pop:Pop.Trigger="{Binding #FolderPillBtn}"
                    pop:Pop.IsOpen="{Binding IsFolderPopOpen}"
                    Classes.Open="{Binding IsFolderPopOpen}"
                    ZIndex="50">
                <ScrollViewer MaxHeight="280" HorizontalScrollBarVisibility="Disabled">
                    <!-- 稿子 .folder-pop-list{gap:2px}：行与行之间留缝，选中/hover 的底色
                         才不会连成一整块看不出边界。 -->
                    <ItemsControl ItemsSource="{Binding Folders}" HorizontalAlignment="Stretch">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:GameFolderModel">
                                <Button Classes="FolderRow"
                                        Classes.On="{Binding IsCurrent}"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectFolderCommand}"
                                        CommandParameter="{Binding Path}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="重命名目录"
                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RenameFolderCommand}"
                                                      CommandParameter="{Binding Path}"/>
                                            <MenuItem Header="设为默认目录"
                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetDefaultFolderCommand}"
                                                      CommandParameter="{Binding Path}"/>
                                            <MenuItem Header="复制路径" Click="OnCopyFolderPath"/>
                                            <!-- 官方启动器目录由启动器托管，不给移除入口（Settings 层还有一道守卫）。 -->
                                            <Separator IsVisible="{Binding !IsOfficial}"/>
                                            <MenuItem Header="移除此目录" Foreground="#f87171"
                                                      IsVisible="{Binding !IsOfficial}"
                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveFolderCommand}"
                                                      CommandParameter="{Binding Path}"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>

                                    <Grid ColumnDefinitions="Auto * Auto">
                                        <materialIcons:MaterialIcon Grid.Column="0" Kind="FolderOutline" Width="16" Height="16"
                                                                    Foreground="#a1a1aa" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <!-- 名字与路径之间的间距靠行高给（稿子 .folder-pop-item .grow 的 line-height:1.25），不另加 Spacing。 -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#fafafa"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="170" VerticalAlignment="Center"
                                                           Classes.isCur="{Binding IsCurrent}">
                                                    <!-- 稿子 .folder-pop-item b{font-weight:500}，选中那条 .on b{600}。
                                                         两条都写成 Style：Avalonia 里直接值压过样式，
                                                         字重写在属性上就让 isCur 那条失效了。 -->
                                                    <TextBlock.Styles>
                                                        <Style Selector="TextBlock">
                                                            <Setter Property="FontWeight" Value="Medium"/>
                                                        </Style>
                                                        <Style Selector="TextBlock.isCur">
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </Style>
                                                    </TextBlock.Styles>
                                                </TextBlock>
                                                <!-- 「默认」是 .badge 那一套：透明底 + 1px 描边，行内覆写 height 16 / 字号 10 / padding 0 5。
                                                     实心块会比旁边的目录名更抢眼，而它只是个状态。 -->
                                                <Border Height="16" Padding="5,0" CornerRadius="8"
                                                        BorderBrush="#26262b" BorderThickness="1"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding IsDefault}">
                                                    <TextBlock Text="默认" FontSize="10" Foreground="#a1a1aa" VerticalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                            <!-- 目录不在了要说清楚：路径念一遍不如这一句有用（拔了移动硬盘不是 bug）。 -->
                                            <TextBlock Text="{Binding Path}" FontSize="11" Foreground="#71717a"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       IsVisible="{Binding Exists}"/>
                                            <TextBlock Text="这个目录已经不在了" FontSize="11" Foreground="#f87171"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding !Exists}"/>
                                        </StackPanel>
                                        <!-- 稿子把这颗「⋯」做成 hover 才露出来：右键开的是同一个菜单，
                                             每行常驻一颗只会一路喊"这里还有东西"。判据用的是**这一行**
                                             的 IsPointerOver（与 WPF 那条 AncestorType=Button 同一个意思）。 -->
                                        <Button Grid.Column="2" Classes="RowMore" Width="24" Height="24"
                                                Classes.RowOver="{Binding $parent[Button].IsPointerOver}"
                                                VerticalAlignment="Center" ToolTip.Tip="目录设置" Click="OnRowMoreClick">
                                            <materialIcons:MaterialIcon Kind="DotsHorizontal" Width="13" Height="13" Foreground="#a1a1aa"/>
                                        </Button>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- ========================================== -->
            <!-- 7b. DOWNLOAD TASKS POPOVER (hangs off the  -->
            <!--       download page's 下载任务 button)      -->
            <!-- ========================================== -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,64,112,0" Width="440"
                    Background="#111114" BorderBrush="#26262b" BorderThickness="1"
                    CornerRadius="14" Padding="4" ClipToBounds="True"
                    BoxShadow="0 30 80 -20 #EE000000"
                    Classes="Popover"
                    pop:Pop.Anchor="TopRight"
                    pop:Pop.Trigger="{Binding #DlPopBtn}"
                    pop:Pop.IsOpen="{Binding IsDlPopOpen}"
                    Classes.Open="{Binding IsDlPopOpen}"
                    ZIndex="50">
                <Grid RowDefinitions="Auto *">
                    <Grid Grid.Row="0" ColumnDefinitions="* Auto" Margin="10,8,10,10">
                        <TextBlock Grid.Column="0" Text="下载任务" FontWeight="SemiBold" FontSize="13"
                                   Foreground="#fafafa" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="BtnSm BtnOutline" Content="清除已完成"
                                Command="{Binding ClearDownloadsCommand}"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" MaxHeight="380" IsVisible="{Binding HasDownloads}">
                        <ItemsControl ItemsSource="{Binding Downloads}"
                                      ItemTemplate="{StaticResource DownloadRowTemplate}"/>
                    </ScrollViewer>

                    <TextBlock Grid.Row="1" Text="暂无下载任务" IsVisible="{Binding !HasDownloads}"
                               FontSize="13" Foreground="#a1a1aa"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,28"/>
                </Grid>
            </Border>

            <!-- ========================================== -->
            <!-- 8. BACKGROUND FRAMING TRIO (picked art)    -->
            <!--      与 WPF 的 8. 背景取景三件套逐项对齐     -->
            <!-- ========================================== -->
            <!-- 调节卡片已经搬去独立窗口（Views/BackgroundTuningWindow），主窗口里只留"看"的
                 东西：中上一句提示、右上角一格画中画、底下一条操作说明。 -->
            <!-- 调节模式的独占层：按住拖 = 平移，滚轮 = 缩放。它压在侧栏 / 皮肤 / 停靠栏**之上**
                 （ZIndex 44），所以调节期间那些控件点不动 —— 否则一边调一边能翻页、甚至把游戏
                 启动了，而背景只在首页存在，调节窗就成了在调一个看不见的东西。
                 顶部让出 52px：窗口按钮和拖窗口那条得一直能用。
                 ⚠️ 这里绝不能碰 BeginMoveDrag()：那是拖窗口，本层拖的是背景。 -->
            <Panel x:Name="BgPanSurface" ZIndex="44" Background="Transparent" Cursor="SizeAll"
                   Margin="0,52,0,0"
                   IsVisible="{Binding IsFramingVisible}"
                   PointerPressed="OnBackgroundPanPressed"
                   PointerMoved="OnBackgroundPanMoved"
                   PointerReleased="OnBackgroundPanReleased"
                   PointerCaptureLost="OnBackgroundPanCaptureLost"
                   PointerWheelChanged="OnBackgroundWheel"/>

            <Border x:Name="BgHintPill" ZIndex="45" Cursor="SizeAll"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,0"
                    Background="#E6111114" BorderBrush="#26262b" BorderThickness="1"
                    CornerRadius="15" Padding="11,0" Height="30"
                    BoxShadow="0 20 50 -20 #DE000000"
                    PointerPressed="OnHintPillPressed"
                    PointerMoved="OnFloatDragMove"
                    PointerReleased="OnFloatDragEnd"
                    PointerCaptureLost="OnFloatDragCaptureLost"
                    IsVisible="{Binding IsFramingVisible}">
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="ImageFrame" Width="13" Height="13"
                                                Foreground="#a1a1aa" VerticalAlignment="Center"/>
                    <TextBlock Text="背景预览" FontSize="12" Foreground="#d4d4d8" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 画中画：整张图 contain 进来，白框 = 窗口真正看得见的那一块。两个矩形都出自
                 共享的 BackgroundFrame.ComputeCoverage，和背景同一组数 ⇒ 不可能对不上。
                 ⚠️ 视频没有解码缓冲，画不出缩略图，所以这格只给自选图片看。 -->
            <Border x:Name="BgShot" ZIndex="45" Cursor="SizeAll"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,52,14,0"
                    Width="156" Height="95" CornerRadius="6" ClipToBounds="True"
                    BoxShadow="0 10 15 -3 #1A000000, 0 4 6 -4 #1A000000"
                    PointerPressed="OnBackgroundShotPressed"
                    PointerMoved="OnFloatDragMove"
                    PointerReleased="OnFloatDragEnd"
                    PointerCaptureLost="OnFloatDragCaptureLost"
                    IsVisible="{Binding IsFramingVisible}">
                <Canvas>
                    <!-- 描边画的是"整张画面"的边界：图片有缩略图时贴着图边几乎看不见，
                         而视频没有缓冲可画，全靠这条线才看得出"只看到中间这块"。 -->
                    <Rectangle x:Name="BgShotImage" Stroke="#3f3f46" StrokeThickness="1"/>
                    <Rectangle x:Name="BgShotView" Stroke="#fafafa" StrokeThickness="1.5"
                               RadiusX="3" RadiusY="3"/>
                </Canvas>
            </Border>

            <!-- 操作说明：窗口最下面。左右分别是停靠栏和进度卡，居中这条正好落在它们中间。 -->
            <Border ZIndex="45"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"
                    Background="#E6111114" BorderBrush="#26262b" BorderThickness="1"
                    CornerRadius="15" Padding="12,0" Height="30"
                    BoxShadow="0 20 50 -20 #DE000000"
                    IsVisible="{Binding IsFramingVisible}">
                <TextBlock Text="在背景上按住拖动即可平移，滚轮缩放"
                           FontSize="12" Foreground="#d4d4d8" VerticalAlignment="Center"/>
            </Border>

            <!-- ========================================== -->
            <!-- 9. BANNER (transient status message)       -->
            <!-- ========================================== -->
            <!-- The launch dock owns the bottom-right band, so the toast hangs from the top edge
                 where nothing else lives instead of colliding with it. -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,20,0,0" MaxWidth="520"
                    Background="#F2111114" BorderBrush="#26262b" BorderThickness="1"
                    CornerRadius="12" Padding="14,10"
                    BoxShadow="0 20 50 -16 #DD000000"
                    Classes="Popover"
                    pop:Pop.Anchor="TopCenter"
                    pop:Pop.IsOpen="{Binding IsBannerOpen}"
                    Classes.Open="{Binding IsBannerOpen}"
                    ZIndex="65">
                <Grid ColumnDefinitions="Auto * Auto">
                    <materialIcons:MaterialIcon Grid.Column="0" Kind="InformationOutline" Width="16" Height="16"
                                                Foreground="#a1a1aa" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding BannerText}" FontSize="13" Foreground="#fafafa"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <Button Grid.Column="2" Classes="WinCtrl" Width="22" Height="22" CornerRadius="6"
                            Margin="10,0,0,0" VerticalAlignment="Center"
                            Command="{Binding DismissBannerCommand}" ToolTip.Tip="关闭">
                        <materialIcons:MaterialIcon Kind="Close" Width="13" Height="13"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ========================================== -->
            <!-- 10. DIALOG (in-window prompt / confirm)    -->
            <!-- ========================================== -->
            <Panel ZIndex="70">
                <Border Background="#A6000000" IsVisible="{Binding IsDialogOpen}"
                        PointerPressed="OnDialogBackdropPointerPressed"/>

                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        Width="400"
                        Background="#111114" BorderBrush="#26262b" BorderThickness="1"
                        CornerRadius="16" Padding="22,20"
                        BoxShadow="0 30 80 -20 #EE000000"
                        Classes="Popover"
                        pop:Pop.Anchor="Center"
                        pop:Pop.IsOpen="{Binding IsDialogOpen}"
                        Classes.Open="{Binding IsDialogOpen}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{Binding DialogTitle}" FontSize="16" FontWeight="SemiBold" Foreground="#fafafa"/>

                        <TextBlock Text="{Binding DialogMessage}" FontSize="13" Foreground="#a1a1aa"
                                   TextWrapping="Wrap" LineHeight="20"
                                   IsVisible="{Binding HasDialogMessage}"/>

                        <TextBox x:Name="DialogInputBox"
                                 Text="{Binding DialogInput, Mode=TwoWay}"
                                 PlaceholderText="{Binding DialogPlaceholder}"
                                 IsVisible="{Binding DialogHasInput}"
                                 Background="#1c1c21" BorderBrush="#26262b" BorderThickness="1"
                                 CornerRadius="10" Foreground="#fafafa"
                                 KeyDown="OnDialogInputKeyDown"/>

                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Classes="BtnSm BtnOutline" Content="{Binding DialogCancelText}" Command="{Binding CancelDialogCommand}"/>
                            <Button Classes="BtnSm BtnPrimary" Content="{Binding DialogConfirmText}"
                                    Command="{Binding ConfirmDialogCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Panel>

            <!-- ========================================== -->
            <!-- 10.4 导入整合包 / 添加已有目录 / 拖放遮罩     -->
            <!-- ========================================== -->
            <!-- 导入的进度同时进右下角的任务列表：这份活和装一个版本是同一量级，不该只在这张对话框里可见。 -->
            <Panel ZIndex="72" IsVisible="{Binding IsPackImportOpen}">
                <Border Background="#A6000000" PointerPressed="OnPackBackdropPointerPressed"/>

                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="480"
                        Background="#111114" BorderBrush="#26262b" BorderThickness="1"
                        CornerRadius="16" Padding="24,18"
                        BoxShadow="0 30 80 -20 #EE000000"
                        Classes="Popover"
                        pop:Pop.Anchor="Center"
                        pop:Pop.IsOpen="{Binding IsPackImportOpen}"
                        Classes.Open="{Binding IsPackImportOpen}">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="Auto * Auto">
                            <materialIcons:MaterialIcon Grid.Column="0" Kind="PackageVariantClosed" Width="22" Height="22"
                                                        Foreground="#fafafa" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="导入整合包" FontSize="16" FontWeight="SemiBold" Foreground="#fafafa"/>
                                <TextBlock Text="支持 Modrinth、CurseForge 与 MultiMC / Prism 整合包"
                                           FontSize="12" Foreground="#a1a1aa" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="2" Classes="WinCtrl" Width="26" Height="26" CornerRadius="7"
                                    VerticalAlignment="Top"
                                    Command="{Binding ClosePackImportCommand}" ToolTip.Tip="关闭">
                                <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14"/>
                            </Button>
                        </Grid>

                        <!-- 拖拽区：点它和把文件拖进窗口是同一件事（都走 OfferPackFile）。
                             选了文件之后这一格就改成念文件名，省得用户不确定到底选中了什么。
                             ⚠️ 点击用的是 PointerReleased —— WPF 那条是 MouseLeftButtonUp，
                             Avalonia 里 Panel 没有 Click，语义上就是同一个"松手即触发"。 -->
                        <Panel Classes="DropZone" Height="104" Background="Transparent" Cursor="Hand"
                               PointerReleased="OnPickPackFileClick">
                            <Rectangle Classes="DropRing" RadiusX="12" RadiusY="12" StrokeThickness="2"
                                       StrokeDashArray="5,4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="PackageVariantClosed" Width="26" Height="26"
                                                            Foreground="#a1a1aa" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding PackDropTitle}"
                                           FontSize="13.5" FontWeight="SemiBold" Foreground="#fafafa"
                                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                                <TextBlock Text="支持 .mrpack / .zip" FontSize="12"
                                           Foreground="#71717a" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Panel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="安装到" FontSize="13" FontWeight="Medium" Foreground="#fafafa"/>
                            <!-- 目录不多，一排 chip 比下拉少一层弹窗；只有一个目录时也照样摆，看得见落到哪。 -->
                            <ItemsControl ItemsSource="{Binding Folders}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:GameFolderModel">
                                        <Button Classes="PickChip" Content="{Binding Name}"
                                                MaxWidth="180"
                                                Classes.On="{Binding IsPackTarget}"
                                                ToolTip.Tip="{Binding Path}"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectPackTargetFolderCommand}"
                                                CommandParameter="{Binding Path}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="实例名称" FontSize="13" FontWeight="Medium" Foreground="#fafafa"/>
                            <TextBox CornerRadius="8" Background="#1c1c21" BorderBrush="#26262b"
                                     PlaceholderText="留空则使用压缩包名称" Text="{Binding PackInstanceName, Mode=TwoWay}"/>
                        </StackPanel>

                        <StackPanel Spacing="6" IsVisible="{Binding IsPackImportBusy}">
                            <Grid ColumnDefinitions="* Auto">
                                <TextBlock Grid.Column="0" Text="{Binding PackStageText}" FontSize="12" Foreground="#a1a1aa"/>
                                <TextBlock Grid.Column="1" Text="{Binding PackProgressText}" FontSize="12" Foreground="#a1a1aa"/>
                            </Grid>
                            <ProgressBar Value="{Binding PackProgressValue}" Maximum="100" Height="4"
                                         CornerRadius="2" Foreground="#fafafa" Background="#407f7f7f"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <Button Classes="BtnSm BtnOutline" Content="取消"
                                    Command="{Binding ClosePackImportCommand}"/>
                            <Button Classes="BtnSm BtnPrimary" Content="开始导入"
                                    IsEnabled="{Binding CanStartPackImport}"
                                    Command="{Binding StartPackImportCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Panel>

            <!-- 添加已有目录：关联本地现成的 .minecraft，让它进目录列表。这里只登记，不动盘上的东西。 -->
            <Panel ZIndex="72" IsVisible="{Binding IsAddFolderOpen}">
                <Border Background="#A6000000" PointerPressed="OnAddFolderBackdropPointerPressed"/>

                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="480"
                        Background="#111114" BorderBrush="#26262b" BorderThickness="1"
                        CornerRadius="16" Padding="24,18"
                        BoxShadow="0 30 80 -20 #EE000000"
                        Classes="Popover"
                        pop:Pop.Anchor="Center"
                        pop:Pop.IsOpen="{Binding IsAddFolderOpen}"
                        Classes.Open="{Binding IsAddFolderOpen}">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="Auto * Auto">
                            <materialIcons:MaterialIcon Grid.Column="0" Kind="FolderPlusOutline" Width="22" Height="22"
                                                        Foreground="#fafafa" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="添加已有目录" FontSize="16" FontWeight="SemiBold" Foreground="#fafafa"/>
                                <TextBlock Text="添加一个已有的 .minecraft 目录"
                                           FontSize="12" Foreground="#a1a1aa"/>
                            </StackPanel>
                            <Button Grid.Column="2" Classes="WinCtrl" Width="26" Height="26" CornerRadius="7"
                                    VerticalAlignment="Top"
                                    Command="{Binding CloseAddFolderCommand}" ToolTip.Tip="关闭">
                                <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14"/>
                            </Button>
                        </Grid>

                        <StackPanel Spacing="6">
                            <TextBlock Text="文件夹路径" FontSize="13" FontWeight="Medium" Foreground="#fafafa"/>
                            <Grid ColumnDefinitions="* Auto">
                                <TextBox Grid.Column="0" CornerRadius="8" Background="#1c1c21" BorderBrush="#26262b"
                                         PlaceholderText="例如 D:\Minecraft\mod client\.minecraft"
                                         Text="{Binding NewFolderPath, Mode=TwoWay}"
                                         VerticalAlignment="Stretch"/>
                                <Button Grid.Column="1" Classes="BtnSm BtnOutline" Content="浏览…"
                                        Width="76" Margin="8,0,0,0" Click="OnPickGameFolderClick"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="名称" FontSize="13" FontWeight="Medium" Foreground="#fafafa"/>
                            <TextBox CornerRadius="8" Background="#1c1c21" BorderBrush="#26262b"
                                     PlaceholderText="留空则使用文件夹名" Text="{Binding NewFolderName, Mode=TwoWay}"/>
                        </StackPanel>

                        <!-- 这句是真校验：路径存不存在、有没有重复、versions 里几个实例。 -->
                        <Border CornerRadius="8" Background="#1c1c21" BorderBrush="#26262b" BorderThickness="1" Padding="10,8">
                            <Grid ColumnDefinitions="Auto *">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="CheckCircleOutline" Width="15" Height="15"
                                                            Foreground="#4ade80" VerticalAlignment="Center" Margin="0,0,8,0"
                                                            IsVisible="{Binding NewFolderLooksValid}"/>
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="AlertCircleOutline" Width="15" Height="15"
                                                            Foreground="#fbbf24" VerticalAlignment="Center" Margin="0,0,8,0"
                                                            IsVisible="{Binding !NewFolderLooksValid}"/>
                                <TextBlock Grid.Column="1" Text="{Binding NewFolderScanHint}" FontSize="12"
                                           Foreground="#d4d4d8" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <Button Classes="BtnSm BtnOutline" Content="取消"
                                    Command="{Binding CloseAddFolderCommand}"/>
                            <Button Classes="BtnSm BtnPrimary" Content="确认添加"
                                    Command="{Binding ConfirmAddFolderCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Panel>

            <!-- 拖进来时的整窗提示：只要"松手就导入"这一句，别在用户还没松手时就开始解析。
                 这层不参与命中测试，鼠标的事全部交给窗口那套 DragOver / Drop 处理。 -->
            <Panel ZIndex="90" Background="#B8000000" IsHitTestVisible="False"
                   IsVisible="{Binding IsDropOverlayVisible}">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        CornerRadius="20" BorderThickness="2" BorderBrush="#fafafa"
                        Background="#111114" Padding="40,28">
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="PackageVariantClosed" Width="34" Height="34"
                                                    Foreground="#fafafa" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding DropOverlayText}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="#fafafa" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding DropOverlaySubtext}" FontSize="12" Foreground="#a1a1aa"
                                   HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Panel>


            <!-- ========================================== -->
            <!-- 10.6 CLOSE PROMPT                          -->
            <!-- ========================================== -->
            <!-- 只有设置里「关闭窗口时 = 每次询问」才会走到这里。三个出口：托盘 / 退出 / 取消；
                 勾了「不再询问」就把这次选的那条写回设置，以后不再弹（设置里随时能改回来）。 -->
            <Panel ZIndex="74" IsVisible="{Binding IsClosePromptOpen}">
                <Border Background="#A6000000"
                        PointerPressed="OnClosePromptBackdropPointerPressed"/>

                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="420"
                        Background="#111114" BorderBrush="#26262b" BorderThickness="1"
                        CornerRadius="16" Padding="22,20"
                        BoxShadow="0 30 80 -20 #EE000000"
                        Classes="Popover"
                        pop:Pop.Anchor="Center"
                        pop:Pop.IsOpen="{Binding IsClosePromptOpen}"
                        Classes.Open="{Binding IsClosePromptOpen}">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="关闭启动器" FontSize="16" FontWeight="SemiBold" Foreground="#fafafa"/>
                            <TextBlock Text="收进托盘后，点托盘图标就能再把启动器唤出来；直接退出会连同桌宠一起结束。"
                                       FontSize="13" Foreground="#a1a1aa" TextWrapping="Wrap" LineHeight="20"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <CheckBox Classes="Tick" IsChecked="{Binding ClosePromptRemember}"/>
                            <TextBlock Text="不再询问" FontSize="13" Foreground="#a1a1aa" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                            <Button Classes="BtnSm BtnOutline" Content="取消"
                                    Command="{Binding CancelCloseCommand}"/>
                            <Button Classes="BtnSm DangerFill" Content="直接退出"
                                    Command="{Binding AnswerCloseCommand}" CommandParameter="exit"/>
                            <Button Classes="BtnSm BtnPrimary" Content="最小化到托盘"
                                    Command="{Binding AnswerCloseCommand}" CommandParameter="tray"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Panel>

            <!-- 边缘改大小：无边框窗口的原生边框并不存在（壳子外面那 60px 是全透明像素，
                 系统按 alpha 把点击直接放行给桌面），所以自己铺八条把手，按下交给
                 BeginResizeDrag 走系统那套尺寸循环（最小尺寸、光标都由系统管）。
                 先四条边、后四个角 —— 角压在边上，斜着拖才落在角上。把手只有 6 DIP，
                 贴着壳子那圈描边，不吃内容区的点击。
                 ⚠️ 角上给的是 SizeAll 不是斜向箭头：Avalonia 12 的 CursorType 里**没有**
                 SizeNorthWest 那一族（只有 SizeWestEast / SizeNorthSouth / SizeAll），
                 写斜向名会在 XAML 解析期直接抛 "Unrecognized cursor type" 把窗口整个崩掉。
                 WPF 侧不是这么做的：那边在 WM_NCHITTEST 上把同一圈报成 HTLEFT…，
                 行为一致、机制不同，是平台 API 的差别，不是两端分歧。 -->
            <Panel ZIndex="60">
                <Border Width="6" Background="Transparent" Cursor="SizeWestEast"
                        HorizontalAlignment="Left" Tag="Left" PointerPressed="OnResizeGripPressed"/>
                <Border Width="6" Background="Transparent" Cursor="SizeWestEast"
                        HorizontalAlignment="Right" Tag="Right" PointerPressed="OnResizeGripPressed"/>
                <Border Height="6" Background="Transparent" Cursor="SizeNorthSouth"
                        VerticalAlignment="Top" Tag="Top" PointerPressed="OnResizeGripPressed"/>
                <Border Height="6" Background="Transparent" Cursor="SizeNorthSouth"
                        VerticalAlignment="Bottom" Tag="Bottom" PointerPressed="OnResizeGripPressed"/>
                <Border Width="16" Height="16" Background="Transparent" Cursor="SizeAll"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Tag="TopLeft" PointerPressed="OnResizeGripPressed"/>
                <Border Width="16" Height="16" Background="Transparent" Cursor="SizeAll"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Tag="TopRight" PointerPressed="OnResizeGripPressed"/>
                <Border Width="16" Height="16" Background="Transparent" Cursor="SizeAll"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Tag="BottomLeft" PointerPressed="OnResizeGripPressed"/>
                <Border Width="16" Height="16" Background="Transparent" Cursor="SizeAll"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Tag="BottomRight" PointerPressed="OnResizeGripPressed"/>
            </Panel>
        </Panel>
    </Border>
    </Panel>
</Window>
