<!-- 1180x720 is the *visible* window (Shell); the window itself opens at 1300x840 with
     60 on each side as room for the drop shadow. Tailwind's shadow-lg overflows only
     ~12px sideways / ~22px down, so most of that margin is slack — kept anyway, since
     shrinking it would move the window rect for no visible gain.
     A borderless transparent window cannot paint outside its own rect, so the window is
     grown and Shell sits inset instead. The fully transparent margin is click-through. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NegiCraftLauncher.ViewModels"
        xmlns:models="using:NegiCraftLauncher.ViewModels"
        xmlns:conv="using:NegiCraftLauncher.App.Avalonia.Converters"
        xmlns:controls="using:NegiCraftLauncher.Skin.Avalonia.Controls"
        xmlns:pop="using:NegiCraftLauncher.App.Avalonia.Views"
        xmlns:materialIcons="clr-namespace:NegiCraftLauncher.Icons.Avalonia;assembly=NegiCraftLauncher.Icons.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="720"
        x:Class="NegiCraftLauncher.App.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1300" Height="840"
        MinWidth="1080" MinHeight="740"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Icon="avares://NegiCraftLauncher.Avalonia/Assets/app.ico"
        KeyDown="OnWindowKeyDown"
        KeyUp="OnWindowKeyUp"
        Title="NegiCraft Launcher">

    <Window.Resources>
        <!-- The VM only carries platform-neutral pixels (NegiCraftLauncher.Raster.PixelBuffer);
             turning them into an Avalonia Bitmap is the view's job. -->
        <conv:PixelBufferToBitmapConverter x:Key="PixelsToBitmap"/>
        <conv:PathToBitmapConverter x:Key="PathToBitmap"/>
        <!-- One download-task row, shared by the popover and the settings 下载中心 list.
             Action buttons reach the window VM because the row's own type is DownloadTaskModel. -->
        <DataTemplate x:Key="DownloadRowTemplate" x:DataType="models:DownloadTaskModel">
            <Border BorderBrush="#26262b" BorderThickness="0,0,0,1" Padding="12,10">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="* Auto">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"
                                       Foreground="#fafafa" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#a1a1aa"/>
                                <TextBlock Text="{Binding PercentText}" FontSize="12" Foreground="#71717a"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Classes="BtnSm BtnOutline" Content="暂停" Height="26" FontSize="12" Padding="10,0"
                                    IsVisible="{Binding IsRunning}"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PauseDownloadTaskCommand}"
                                    CommandParameter="{Binding .}"/>
                            <Button Classes="BtnSm BtnOutline" Content="取消" Height="26" FontSize="12" Padding="10,0"
                                    IsVisible="{Binding IsRunning}"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CancelDownloadTaskCommand}"
                                    CommandParameter="{Binding .}"/>
                            <Button Classes="BtnSm BtnOutline" Content="继续" Height="26" FontSize="12" Padding="10,0"
                                    IsVisible="{Binding CanResume}"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ResumeDownloadTaskCommand}"
                                    CommandParameter="{Binding .}"/>
                        </StackPanel>
                    </Grid>
                    <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4"
                                 CornerRadius="999" Foreground="#fafafa" Background="#26262b"/>
                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="#71717a"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <!-- Nav Button: 42x42, radius 12, icon 20x20 -->
        <!-- 导航按钮。侧栏是浮在背景上的一块玻璃，所以未选中的图标只能"白 + 降不透明度"——
             灰图标（#a1a1aa）压在亮壁纸上会直接消失。以前这套只在首页生效（`Border.Sidebar.OnHome`
             那两条后代选择器），现在背景贯穿所有页，两条分支并成唯一态。 -->
        <Style Selector="Button.NavBtn">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#fafafa"/>
            <Setter Property="Opacity" Value="0.75"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.NavBtn:pointerover">
            <Setter Property="Background" Value="#2E7F7F7F"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="Opacity" Value="1.0"/>
        </Style>
        <!-- 排在 :pointerover 之后：选中态要压过 hover。Opacity 必须显式写回 1，
             不然基态那 0.75 会把整块白底压成半透明。 -->
        <Style Selector="Button.NavBtn.Active">
            <Setter Property="Background" Value="#fafafa"/>
            <Setter Property="Foreground" Value="#18181b"/>
            <Setter Property="Opacity" Value="1.0"/>
        </Style>
        <Style Selector="Button.NavBtn.Active:pointerover">
            <Setter Property="Background" Value="#fafafa"/>
            <Setter Property="Foreground" Value="#18181b"/>
            <Setter Property="Opacity" Value="1.0"/>
        </Style>

        <!-- Sidebar 玻璃背板 -->
        <Style Selector="Border.Sidebar">
            <Setter Property="Background" Value="#8C0E0E12"/>
            <!-- ⚠️ WPF 侧这条用的是等效色 #45555555，不是这里的 #17FFFFFF：
                 WPF 的 Border 把描边直接压在父级亮图上，Avalonia 的 BoxShadow 先压暗一层底色，
                 同一个色号两边看着差 R+45。别"顺手对齐"回去（详见 WPF MainWindow.xaml 那段注释）。 -->
            <Setter Property="BorderBrush" Value="#17FFFFFF"/>
        </Style>

        <!-- Window Control Button: 32x32 square, radius 9 -->
        <Style Selector="Button.WinCtrl">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#a1a1aa"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.WinCtrl:pointerover">
            <Setter Property="Background" Value="#1c1c21"/>
            <Setter Property="Foreground" Value="#fafafa"/>
        </Style>
        <Style Selector="Button.WinCtrl.Close:pointerover">
            <Setter Property="Background" Value="#e81123"/>
            <Setter Property="Foreground" Value="#ffffff"/>
        </Style>

        <!-- Shadcn 按钮那套（Button.Btn / BtnSm / BtnPrimary / BtnOutline）在 App.axaml ——
             背景调节窗和这扇窗共用同一套，抄两份必然有一天只改一边。 -->

        <!-- Instance Selector in Dock -->
        <Style Selector="Button.InstSelect">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="6,0,10,0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="RenderTransform" Value="none"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.InstSelect:pointerover">
            <Setter Property="Background" Value="#297F7F7F"/>
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
        </Style>

        <!-- Launch button: colours live here (not inline) so :pointerover can override them -->
        <Style Selector="Button.LaunchBtn">
            <Setter Property="Background" Value="#fafafa"/>
            <Setter Property="Foreground" Value="#18181b"/>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="RenderTransform" Value="none"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.LaunchBtn:pointerover">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="RenderTransform" Value="scale(1.03)"/>
        </Style>

        <!-- Popovers stay in the tree (hidden by opacity + not hit-testable) because toggling IsVisible
             would drop them out of layout. Views/Pop.cs drives the whole motion, opacity included:
             Avalonia has no animator for RenderTransform, so the stages cannot be a transition. -->
        <Style Selector="Border.Popover">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="Border.Popover.Open">
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>

        <!-- Instance Grid Card -->
        <Style Selector="Button.InstCard">
            <!-- 四边不等宽，照设计稿那两条 padding 来：上块 13/12/10/14、下条 0/12/12/14
                 （左 14 右 12 上 13 下 12），中间那 10 写在卡里的行间距上。 -->
            <Setter Property="Padding" Value="14,13,12,12"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="#111114"/>
            <Setter Property="BorderBrush" Value="#26262b"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <!-- 纵向也是 Stretch：UniformGrid 把格子拉成等高，卡片内容得跟着填满，
                 底行那句「最近游玩」才贴得到卡底。 -->
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.InstCard:pointerover">
            <Setter Property="BorderBrush" Value="#52525b"/>
        </Style>
        <Style Selector="Button.InstCard.Current">
            <Setter Property="BorderBrush" Value="#fafafa"/>
        </Style>

        <!-- Segmented Tab Button: 28px height, 7px radius -->
        <Style Selector="Button.SegmentBtn">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#a1a1aa"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.SegmentBtn:pointerover">
            <Setter Property="Foreground" Value="#fafafa"/>
        </Style>
        <Style Selector="Button.SegmentBtn.On">
            <Setter Property="Background" Value="#111114"/>
            <Setter Property="Foreground" Value="#fafafa"/>
        </Style>

        <!-- Setting Nav Button -->
        <Style Selector="Button.SetNavBtn">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#a1a1aa"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.SetNavBtn:pointerover">
            <Setter Property="Background" Value="#1c1c21"/>
            <Setter Property="Foreground" Value="#fafafa"/>
        </Style>
        <Style Selector="Button.SetNavBtn.On">
            <Setter Property="Background" Value="#1c1c21"/>
            <Setter Property="Foreground" Value="#fafafa"/>
        </Style>

        <!-- Menu Item in Popover -->
        <Style Selector="Button.MenuItem">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.MenuItem:pointerover">
            <Setter Property="Background" Value="#1c1c21"/>
        </Style>

        <!-- Icon Button (small action button) -->
        <Style Selector="Button.IconBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.IconBtn:pointerover">
            <Setter Property="Background" Value="#27272a"/>
        </Style>
        <Style Selector="Button.IconBtn.Danger:pointerover">
            <Setter Property="Background" Value="#3f1218"/>
        </Style>

        <!-- 实例卡上的 tag（版本 / 加载器）：20 高、圆角 999、描边 + muted 字 -->
        <Style Selector="Border.TagPill">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="BorderBrush" Value="#26262b"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.TagText">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#a1a1aa"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 工具条上的 chip（排序）。选中态刻意用"卡底 + 描边"而不是只换字色：
             dark 下 accent 与 tabs 同值，靠底色分选中会和 hover 糊在一起（设置页导航就栽过）。 -->
        <Style Selector="Button.Chip">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#a1a1aa"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.Chip:pointerover">
            <Setter Property="Foreground" Value="#fafafa"/>
        </Style>
        <Style Selector="Button.Chip.On">
            <Setter Property="Background" Value="#111114"/>
            <Setter Property="BorderBrush" Value="#26262b"/>
            <Setter Property="Foreground" Value="#fafafa"/>
        </Style>

        <!-- 卡片底行那颗「启动」：当前实例是主色实心，其余是灰图标。
             顺序不能调 —— .Current 必须排在 :pointerover 之后，两者同时命中时后写的赢。 -->
        <Style Selector="Button.CardPlay">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#a1a1aa"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.CardPlay:pointerover">
            <Setter Property="Background" Value="#27272a"/>
            <Setter Property="Foreground" Value="#fafafa"/>
        </Style>
        <Style Selector="Button.CardPlay.Current">
            <Setter Property="Background" Value="#fafafa"/>
            <Setter Property="Foreground" Value="#18181b"/>
        </Style>
        <Style Selector="Button.CardPlay.Current:pointerover">
            <Setter Property="Background" Value="#e4e4e7"/>
        </Style>

        <!-- 危险动作的文字按钮（配置弹窗里的「删除实例」）。描边和字都往红上偏一档，
             但不做实心红 —— 实心红在一堆中性按钮里太吵，反而降低点击的谨慎度。 -->
        <Style Selector="Button.BtnSm.Danger">
            <Setter Property="Foreground" Value="#f87171"/>
            <Setter Property="BorderBrush" Value="#3f1218"/>
        </Style>
        <Style Selector="Button.BtnSm.Danger:pointerover">
            <Setter Property="Background" Value="#3f1218"/>
            <Setter Property="BorderBrush" Value="#5b1a22"/>
        </Style>

        <!-- 实心红的动作键（关闭询问窗里的「直接退出」）。和上面那条分开的理由相反：
             这里它是三选一里唯一"做了就收不回来"的那颗，就该吵。
             底色取 #b3261e 而不是纯红：#111114 这张卡上纯红会发飘，压一档才和 zinc 系配得上。 -->
        <Style Selector="Button.BtnSm.DangerFill">
            <Setter Property="Background" Value="#b3261e"/>
            <Setter Property="Foreground" Value="#fafafa"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.BtnSm.DangerFill:pointerover">
            <Setter Property="Background" Value="#c8352c"/>
        </Style>

        <!-- 真·勾选框。Avalonia 这边更直接：CheckBox 压根没有控制主题，默认画不出来
             （背景调节窗那颗「视频声音」就是只看得见文字），所以自己给一颗 16 的方框。
             WPF 侧同名的 CheckTickStyle 画的是同一个东西。 -->
        <Style Selector="CheckBox.Tick">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Background="Transparent" Width="16" Height="16">
                        <Border Name="Box" CornerRadius="5"
                                Background="#1c1c21" BorderBrush="#26262b" BorderThickness="1">
                            <materialIcons:MaterialIcon Name="Tick" Kind="Check" Width="12" Height="12"
                                                        Foreground="#18181b" IsVisible="False"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="CheckBox.Tick:checked /template/ Border#Box">
            <Setter Property="Background" Value="#fafafa"/>
            <Setter Property="BorderBrush" Value="#fafafa"/>
        </Style>
        <Style Selector="CheckBox.Tick:checked /template/ materialIcons|MaterialIcon#Tick">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <!-- 勾选态已经是实心白，hover 再描一圈灰就脏了，所以只管未勾选的那半。 -->
        <Style Selector="CheckBox.Tick:pointerover:not(:checked) /template/ Border#Box">
            <Setter Property="BorderBrush" Value="#52525b"/>
        </Style>

        <!-- 配置弹窗左侧的 tab。和设置页那条 SetNavBtn 分开写：
             那条的 hover 与选中都是 #1c1c21（dark 下 accent 与 tabs 同值），选中态等于不存在。
             这里选中改用 #27272a + 加粗，hover 留 #1c1c21，两者分得开。 -->
        <Style Selector="Button.CfgNavBtn">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#a1a1aa"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.CfgNavBtn:pointerover">
            <Setter Property="Background" Value="#1c1c21"/>
            <Setter Property="Foreground" Value="#fafafa"/>
        </Style>
        <Style Selector="Button.CfgNavBtn.On">
            <Setter Property="Background" Value="#27272a"/>
            <Setter Property="Foreground" Value="#fafafa"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- 右下角悬浮「新建」：只在实例页出现，内缩与首页停靠卡一致（右 24 / 下 24）。
             Avalonia 12 里没有 DropShadowEffect 这个类型，Button 上也没有 BoxShadow（那是
             Border 的属性）—— 所以药丸的底色和投影交给外面那层 Border，按钮自己透明，
             hover 时用圆角底色盖住它，观感和设计稿那条 opacity:.9 一致。和首页停靠卡同一套写法。 -->
        <Style Selector="Border.FabPill">
            <Setter Property="Background" Value="#fafafa"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="BoxShadow" Value="0 10 30 -12 #B0000000"/>
        </Style>
        <Style Selector="Button.Fab">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#18181b"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.Fab:pointerover">
            <Setter Property="Background" Value="#e4e4e7"/>
        </Style>
    </Window.Styles>

    <!-- Outermost Window Shell: 22px border radius, background #09090b, **no outline** —
         the shell reads against the desktop from its own fill plus the shadow below.
         Do not add a BorderThickness here: it would inset every child by that much. -->
    <!-- Wrapper Panel: keeps the window's Content a full-size (1300x840) element so the
         debug bridge's `shot` (which renders Window.Content) includes the shadow margin —
         same as the WPF side, whose root is a Grid. Without it Content would be the
         inset Shell (1180x720) and the shadow would never appear in a screenshot. -->
    <Panel>
    <!-- Shadow caster: a separate Border that only exists to cast the shadow; the Shell
         (same rect, painted on top) covers its body completely.
         ⚠️ The BoxShadow must NOT live on Shell itself: Shell has ClipToBounds="True",
         and Avalonia clips a visual's *own* drawing to its bounds too — so the shadow
         (painted outside the rect) got cut away entirely and never showed.
         Value = Tailwind v4 `shadow-lg` verbatim (two layers, both black at 10%).
         Avalonia parses the comma-separated list and the negative spread natively, so
         this is a 1:1 port; the WPF side has to fake it with two casters.
         Margin 60 = exactly the Shell's rect: the insetting is the spread's job. -->
    <Border x:Name="ShellShadowCaster"
            Margin="60"
            Background="#09090b"
            CornerRadius="22"
            IsHitTestVisible="False"
            BoxShadow="0 10 15 -3 #1A000000, 0 4 6 -4 #1A000000"/>
    <!-- Margin 60 = room for the shadow, which is painted outside this Border's rect. -->
    <Border x:Name="Shell"
            Margin="60"
            Background="#09090b"
            CornerRadius="22"
            ClipToBounds="True">

        <Panel>
            <!-- ========================================== -->
            <!-- 1. PIXEL BACKGROUND & SHADE (every page)   -->
            <!-- ========================================== -->
            <!-- 以前这块只在首页露出，其他页是壳那层死黑 #09090b。现在整窗一张背景，
                 侧栏玻璃与导航按钮的"透光态"也跟着变成唯一态。 -->
            <Panel>
                <!-- The generated 240x146 scene is stretched to fill and kept crisp; a picked photo
                     is cropped to the shell and interpolated. RenderOptions cannot be bound, so the
                     two cases are separate elements. -->
                <Panel x:Name="BgLayer">
                    <Panel.Effect>
                        <BlurEffect Radius="{Binding BgBlur}"/>
                    </Panel.Effect>
                    <Image Source="{Binding BgArt, Converter={StaticResource PixelsToBitmap}}"
                           Stretch="Fill"
                           RenderOptions.BitmapInterpolationMode="None"
                           IsVisible="{Binding !HasCustomBackground}"/>
                    <!-- Picked wallpaper: same shape as the WPF side — a Rectangle filled with one
                         shared ImageBrush whose SourceRect/DestinationRect are absolute, so the
                         framing math is identical on both stacks. Do NOT switch back to
                         <Image Stretch="UniformToFill"> + RenderTransform: an Image inflates its
                         own measured size to the cover result, so the element stops being the
                         visible rect and the pan range comes out wrong (measured on WPF: 1200
                         inside an 1180 shell ⇒ 5px short on every pan). -->
                    <Rectangle x:Name="BgCustomImage"
                               IsVisible="{Binding IsCustomBackground}"/>
                </Panel>

                <!-- 亮度: negative dims the art under a black wash, positive lifts it with a white one -->
                <Border Background="#ffffff" Opacity="{Binding BgLightOpacity}" IsHitTestVisible="False"/>
                <Border Background="#000000" Opacity="{Binding BgDarkOpacity}" IsHitTestVisible="False"/>

                <!-- .shade gradient overlay -->
                <Panel>
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,100%" EndPoint="0%,68%">
                                <GradientStop Color="#73000000" Offset="0.0"/>
                                <GradientStop Color="#00000000" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="100%,0%" EndPoint="55%,0%">
                                <GradientStop Color="#33000000" Offset="0.0"/>
                                <GradientStop Color="#00000000" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Panel>

            </Panel>

            <!-- ========================================== -->
            <!-- 2. TOP DRAG AREA & CONTROLS                -->
            <!-- ========================================== -->
            <!-- Draggable Region -->
            <Border Height="40" Margin="88,0,100,0"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    PointerPressed="OnDragAreaPointerPressed"
                    ZIndex="25"/>

            <!-- Top Right: ONLY Minimize & Close (1:1 with Material Icons) -->
            <!-- 这排也参与首页小人的绕障碍夹位（见 MainWindow.axaml.cs 的 ClampHomeSkinPlace）。 -->
            <StackPanel x:Name="TopRightControls" Orientation="Horizontal" Spacing="4"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,12,14,0" ZIndex="30">
                <Button Classes="WinCtrl" ToolTip.Tip="最小化" Click="OnMinimizeClick">
                    <materialIcons:MaterialIcon Kind="WindowMinimize" Width="17" Height="17"/>
                </Button>
                <Button Classes="WinCtrl Close" ToolTip.Tip="关闭" Click="OnCloseClick">
                    <materialIcons:MaterialIcon Kind="Close" Width="17" Height="17"/>
                </Button>
            </StackPanel>

            <!-- ========================================== -->
            <!-- 3. FROSTED BACKDROP UNDER THE SIDEBAR      -->
            <!-- ========================================== -->
            <Border x:Name="SidebarBackdrop"
                    HorizontalAlignment="Left" VerticalAlignment="Stretch"
                    Margin="12" Width="60"
                    CornerRadius="18"
                    ClipToBounds="True"
                    IsHitTestVisible="False"
                    ZIndex="19">
                <Panel>
                    <!-- the shell art again, offset back to the shell origin so it
                         registers with what the glass sits on top of -->
                    <Image Source="{Binding BgArt, Converter={StaticResource PixelsToBitmap}}"
                           Stretch="Fill"
                           HorizontalAlignment="Left" VerticalAlignment="Top"
                           Margin="-12,-12,0,0"
                           Width="{Binding #Shell.Bounds.Width}"
                           Height="{Binding #Shell.Bounds.Height}"
                           RenderOptions.BitmapInterpolationMode="None"
                           IsVisible="{Binding !HasCustomBackground}">
                        <Image.Effect>
                            <BlurEffect Radius="18"/>
                        </Image.Effect>
                    </Image>
                    <!-- Same brush instance as the main layer (assigned in code): its local rect is
                         the shell rect (the -12 margin cancels the backdrop's 12 margin), so one
                         absolute SourceRect serves both and they cannot drift apart. -->
                    <Rectangle x:Name="SidebarCustomImage"
                               HorizontalAlignment="Left" VerticalAlignment="Top"
                               Margin="-12,-12,0,0"
                               Width="{Binding #Shell.Bounds.Width}"
                               Height="{Binding #Shell.Bounds.Height}"
                               IsVisible="{Binding IsCustomBackground}">
                        <Rectangle.Effect>
                            <BlurEffect Radius="18"/>
                        </Rectangle.Effect>
                    </Rectangle>
                    <!-- same bottom shade as the art layer, so the glass is not brighter -->
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,100%" EndPoint="0%,68%">
                                <GradientStop Color="#73000000" Offset="0.0"/>
                                <GradientStop Color="#00000000" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Panel>
            </Border>

            <!-- ========================================== -->
            <!-- 4. FLOATING SIDEBAR (60px, radius 18, 12px)-->
            <!-- ========================================== -->
            <Border x:Name="Sidebar"
                    Classes="Sidebar"
                    HorizontalAlignment="Left" VerticalAlignment="Stretch"
                    Margin="12" Width="60"
                    CornerRadius="18"
                    BorderThickness="1"
                    BoxShadow="0 10 30 -12 #B0000000"
                    Padding="0,12"
                    ZIndex="20">
                <Grid RowDefinitions="Auto * Auto Auto">
                    <Image Grid.Row="0" Source="avares://NegiCraftLauncher.Avalonia/Assets/app.png"
                           Width="36" Height="36" Margin="0,0,0,8"
                           HorizontalAlignment="Center" IsHitTestVisible="False"/>

                    <!-- Center Nav: Home, Instances, Download, Resources -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="8" HorizontalAlignment="Center">
                        <!-- Home -->
                        <Button Classes="NavBtn"
                                Classes.Active="{Binding CurrentPage, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='home'}"
                                Command="{Binding GoCommand}" CommandParameter="home"
                                ToolTip.Tip="首页">
                            <materialIcons:MaterialIcon Kind="Home" Width="20" Height="20"/>
                        </Button>

                        <!-- Instances -->
                        <Button Classes="NavBtn"
                                Classes.Active="{Binding CurrentPage, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='instances'}"
                                Command="{Binding GoCommand}" CommandParameter="instances"
                                ToolTip.Tip="实例">
                            <materialIcons:MaterialIcon Kind="LayersOutline" Width="20" Height="20"/>
                        </Button>

                        <!-- Download (the version/resource browser; task list hangs off it) -->
                        <Button Classes="NavBtn"
                                Classes.Active="{Binding CurrentPage, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='download'}"
                                Command="{Binding GoCommand}" CommandParameter="download"
                                ToolTip.Tip="下载">
                            <materialIcons:MaterialIcon Kind="DownloadOutline" Width="20" Height="20"/>
                        </Button>
                    </StackPanel>

                    <!-- Bottom Nav: Settings -->
                    <Button Grid.Row="2" Classes="NavBtn"
                            Classes.Active="{Binding CurrentPage, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='settings'}"
                            Command="{Binding GoCommand}" CommandParameter="settings"
                            ToolTip.Tip="设置"
                            HorizontalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="CogOutline" Width="20" Height="20"/>
                    </Button>

                    <!-- Bottom Nav: Account Avatar -->
                    <Button x:Name="AccountAvatar"
                            Grid.Row="3"
                            Width="42" Height="42"
                            CornerRadius="12"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Margin="0,6,0,0"
                            Cursor="Hand"
                            Command="{Binding ToggleAccPopCommand}"
                            ToolTip.Tip="账户"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                        <Image Source="{Binding AvatarBitmap, Converter={StaticResource PixelsToBitmap}}"
                               Width="38" Height="38"
                               RenderOptions.BitmapInterpolationMode="None"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ========================================== -->
            <!-- 5. CONTENT AREA (Padding: 22 28 22 100)    -->
            <!-- ========================================== -->
            <Panel Margin="100,22,28,22" ZIndex="10">

                <!-- PAGE 1: HOME -->
                <Panel x:Name="PageHome" IsVisible="{Binding IsOnHome}" Margin="-100,-22,-28,-22">
                    <!-- .stage: top: 44px; left: 92px; width: 160px; height: 250px; -->
                    <Canvas IsVisible="{Binding ShowHomeSkinModel}">
                        <!-- 3D skin model inside launcher: 有账号才有人可画，外观设置里可以关掉（默认开）。
                             左键拖位置（按首页比例存，见 MainWindow.axaml.cs 的 LayoutHomeSkinPreview），右键转。
                             HitFootprintOnly：命中区剪到身体那一块，脚下那 81 DIP 空档不再替小人吃掉按钮的点击。 -->
                        <controls:MinecraftSkinPreview x:Name="SkinPreview"
                                                       Canvas.Left="92" Canvas.Top="44"
                                                       CanDragPosition="True"
                                                       RotateButton="Right"
                                                       HitFootprintOnly="True"
                                                       PlayerName="{Binding CurrentAccount.Name}"/>
                    </Canvas>

                    <!-- .dock: right: 20px; bottom: 20px; width: 380px; padding: 10px; border-radius: 18px; -->
                    <Border x:Name="DockCard"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,20,20" Width="380"
                            Background="#8C0E0E12"
                            BorderBrush="#17FFFFFF"
                            BorderThickness="1"
                            CornerRadius="18"
                            BoxShadow="0 10 30 -12 #B0000000"
                            Padding="10">
                        <StackPanel Spacing="0">
                            <!-- Top row: Instance selector + Launch button -->
                            <Grid ColumnDefinitions="* Auto">
                                <!-- .inst-select: height: 52px; padding: 0 10px 0 6px; border-radius: 12px; -->
                                <Button Grid.Column="0" Classes="InstSelect"
                                        x:Name="InstSelectBtn"
                                        Command="{Binding ToggleInstPopCommand}">
                                    <Panel>
                                        <Grid ColumnDefinitions="Auto * Auto"
                                              IsVisible="{Binding CurrentInstance, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <!-- 40x40 Block Icon -->
                                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="9" ClipToBounds="True" Margin="0,0,10,0">
                                                <Image Source="{Binding CurrentInstance.IconBitmap, Converter={StaticResource PixelsToBitmap}}"
                                                       Width="40" Height="40"
                                                       RenderOptions.BitmapInterpolationMode="None"/>
                                            </Border>
                                            <!-- Instance Meta: Name & Ver/Loader -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CurrentInstance.Name}"
                                                           FontSize="14" FontWeight="Bold" Foreground="#fafafa"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding CurrentInstance.MetaText}"
                                                           FontSize="12" Foreground="#a1a1aa"/>
                                            </StackPanel>
                                            <!-- ChevronUp matching Image 2 -->
                                            <materialIcons:MaterialIcon Grid.Column="2" Kind="ChevronUp"
                                                                       Width="18" Height="18" Foreground="#71717a"
                                                                       Margin="6,0,0,0"/>
                                        </Grid>

                                        <!-- First run: nothing installed yet -->
                                        <Grid ColumnDefinitions="Auto * Auto"
                                              IsVisible="{Binding CurrentInstance, Converter={x:Static ObjectConverters.IsNull}}">
                                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="9" Margin="0,0,10,0"
                                                    Background="#1c1c21" BorderBrush="#26262b" BorderThickness="1">
                                                <materialIcons:MaterialIcon Kind="Plus" Width="18" Height="18"
                                                                            Foreground="#71717a"
                                                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="还没有实例" FontSize="14" FontWeight="Bold" Foreground="#fafafa"/>
                                                <TextBlock Text="点这里选择一个已有实例" FontSize="12" Foreground="#a1a1aa"/>
                                            </StackPanel>
                                            <materialIcons:MaterialIcon Grid.Column="2" Kind="ChevronUp"
                                                                       Width="18" Height="18" Foreground="#71717a"
                                                                       Margin="6,0,0,0"/>
                                        </Grid>
                                    </Panel>
                                </Button>

                                <!-- .launch: height: 52px; border-radius: 12px; font-weight: 600; font-size: 15px;
                                     MinWidth pins the box to the longest label ("游戏运行中") so switching
                                     launch state never reflows the dock row. -->
                                <Button Grid.Column="1" Classes="LaunchBtn"
                                        Height="52" MinWidth="122" Padding="10,0"
                                        CornerRadius="12"
                                        FontWeight="SemiBold"
                                        FontSize="15"
                                        HorizontalContentAlignment="Center"
                                        Margin="10,0,0,0"
                                        Cursor="Hand"
                                        IsEnabled="{Binding CanLaunch}"
                                        Command="{Binding LaunchGameCommand}"
                                        Content="{Binding LaunchBtnText}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- #launchProgress: its own card in the empty bottom-left area, so the dock
                         does not change height while the game is starting -->
                    <Border x:Name="LaunchProgressCard"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Margin="100,0,0,20" Width="320"
                            Background="#8C0E0E12"
                            BorderBrush="#17FFFFFF"
                            BorderThickness="1"
                            CornerRadius="18"
                            BoxShadow="0 10 30 -12 #B0000000"
                            Padding="14,12"
                            IsVisible="{Binding IsLaunching}">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="* Auto">
                                <TextBlock Grid.Column="0" Text="{Binding LaunchStepText}" FontSize="12" Foreground="#a1a1aa"/>
                                <TextBlock Grid.Column="1" Text="{Binding LaunchPctText}" FontSize="12" Foreground="#a1a1aa"/>
                            </Grid>
                            <ProgressBar Value="{Binding LaunchProgress}" Maximum="100" Height="4"
                                         CornerRadius="999"
                                         Foreground="#fafafa"
                                         Background="#407f7f7f"/>
                        </StackPanel>
                    </Border>
                </Panel>

                <!-- PAGE 2: INSTANCES -->
                <Panel Name="PageInstances" IsVisible="{Binding CurrentPage, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='instances'}">
                    <Grid RowDefinitions="Auto Auto *">
                        <!-- 页头分两层。标题行左边只有标题和计数 —— 右上角那片（喇叭 + 最小化 + 关闭，
                             y 12..42）留给窗口操作区，不跟它抢；工具条排在它下面，那一行已经在操作区之下，
                             所以能贴着内容列的右边缘走，不再留一截空档。 -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto Auto *" Height="36" Margin="0,0,0,14">
                            <TextBlock Grid.Column="0" Text="实例" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#fafafa"/>
                            <TextBlock Grid.Column="1" Text="{Binding InstanceCountText}" FontSize="12" Foreground="#a1a1aa"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>

                        <Grid Grid.Row="1" ColumnDefinitions="* Auto Auto Auto" Height="36" Margin="0,0,0,16">
                            <!-- 搜索：吃满剩下的宽度 -->
                            <Panel Grid.Column="0" Height="36" VerticalAlignment="Top" Margin="0,0,8,0">
                                <TextBox CornerRadius="10"
                                         Background="#111114" BorderBrush="#26262b"
                                         PlaceholderText="搜索实例名或版本"
                                         Text="{Binding InstanceSearch}"
                                         Padding="34,0,10,0" VerticalAlignment="Stretch"/>
                                <materialIcons:MaterialIcon Kind="Magnify" Width="16" Height="16"
                                                            Foreground="#a1a1aa"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                                            Margin="11,0,0,0" IsHitTestVisible="False"/>
                            </Panel>

                            <!-- 加载器筛选：下拉只列实例里真出现过的加载器，种类再多也撑不爆工具条 -->
                            <Button Grid.Column="1" Name="LoaderFilterBtn" Classes="BtnSm BtnOutline"
                                    Height="32" MinWidth="132" Margin="0,0,8,0"
                                    Command="{Binding ToggleLoaderPopCommand}">
                                <Grid ColumnDefinitions="* Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding InstanceLoaderLabel}" VerticalAlignment="Center"/>
                                    <materialIcons:MaterialIcon Grid.Column="1" Kind="ChevronDown" Width="14" Height="14"
                                                                Foreground="#71717a" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </Button>

                            <Border Grid.Column="2" Width="1" Height="18" Background="#26262b" Margin="0,0,12,0" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Classes="Chip" Content="最近游玩"
                                        Classes.On="{Binding InstanceSort, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='最近游玩'}"
                                        Command="{Binding SelectInstanceSortCommand}" CommandParameter="最近游玩"/>
                                <Button Classes="Chip" Content="名称"
                                        Classes.On="{Binding InstanceSort, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='名称'}"
                                        Command="{Binding SelectInstanceSortCommand}" CommandParameter="名称"/>
                            </StackPanel>
                        </Grid>

                        <Panel Grid.Row="2">
                            <!-- .inst-grid：UniformGrid 而不是 WrapPanel —— 卡片要"自适应拉伸"就得等宽，
                                 还要等高（底行那句最近游玩是贴底摆的，卡片不齐高就贴不出效果）。
                                 列数由视图按页宽算（见 MainWindow.axaml.cs 的 UpdateInstanceColumns）。
                                 VerticalAlignment=Top：不顶住的话这一格会拿到整屏高，UniformGrid 再把
                                 它平摊给一两张卡 —— 卡片会被撑成半屏高。 -->
                            <ScrollViewer IsVisible="{Binding HasInstances}">
                                <ItemsControl VerticalAlignment="Top" ItemsSource="{Binding VisibleInstances}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="{Binding InstanceColumns}" Margin="0,0,-12,0"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:InstanceModel">
                                            <Button Classes="InstCard"
                                                    Classes.Current="{Binding IsCurrent}"
                                                    Margin="0,0,12,12"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).MakeCurrentInstanceCommand}"
                                                    CommandParameter="{Binding .}">
                                                <!-- 右键菜单与「⋯」共用这一份：⋯ 只是把同一个菜单就地开起来
                                                     （见 MainWindow.axaml.cs 的 OnInstanceMoreClick）。 -->
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="设为当前"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).MakeCurrentInstanceCommand}"
                                                                  CommandParameter="{Binding .}"/>
                                                        <MenuItem Header="重命名"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RenameInstanceCommand}"
                                                                  CommandParameter="{Binding .}"/>
                                                        <MenuItem Header="打开游戏目录"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenInstanceFolderCommand}"
                                                                  CommandParameter="{Binding .}"/>
                                                        <MenuItem Header="打开存档文件夹"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenInstanceSavesCommand}"
                                                                  CommandParameter="{Binding .}"/>
                                                        <Separator/>
                                                        <MenuItem Header="删除"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteInstanceCommand}"
                                                                  CommandParameter="{Binding .}"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>

                                                <Grid RowDefinitions="* Auto">
                                                    <!-- 上：图标 + 名字（当前胶囊）+ 两个 tag，右上角「⋯」 -->
                                                    <Grid Grid.Row="0" ColumnDefinitions="Auto * Auto" Margin="0,0,0,10">
                                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="9" ClipToBounds="True" VerticalAlignment="Top">
                                                            <Image Source="{Binding IconBitmap, Converter={StaticResource PixelsToBitmap}}"
                                                                   Width="40" Height="40"
                                                                   RenderOptions.BitmapInterpolationMode="None"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Top" Spacing="7" Margin="12,0,4,0">
                                                            <!-- 名字和「当前」胶囊是一组：胶囊贴着名字走，不是顶到行尾。
                                                                 MaxWidth 是"名字长到多长才开始截"的上限 —— 横排 StackPanel
                                                                 给孩子的可用宽度是无限的，不封顶的话长名字会把胶囊顶出卡外。 -->
                                                            <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Left">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                                           MaxWidth="150" Foreground="#fafafa" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                <Border Height="18" Padding="7,0" CornerRadius="999"
                                                                        Background="#fafafa" VerticalAlignment="Center"
                                                                        IsVisible="{Binding IsCurrent}">
                                                                    <TextBlock Text="当前" FontSize="11" FontWeight="SemiBold" Foreground="#18181b" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <Border Classes="TagPill">
                                                                    <TextBlock Text="{Binding VersionId}" Classes="TagText"/>
                                                                </Border>
                                                                <Border Classes="TagPill">
                                                                    <TextBlock Text="{Binding Loader}" Classes="TagText"/>
                                                                </Border>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Classes="IconBtn" Width="28" Height="28"
                                                                VerticalAlignment="Top" ToolTip.Tip="更多" Click="OnInstanceMoreClick">
                                                            <materialIcons:MaterialIcon Kind="DotsHorizontal" Width="16" Height="16" Foreground="#a1a1aa"/>
                                                        </Button>
                                                    </Grid>

                                                    <!-- 下：最近游玩贴底，右边两颗图标按钮（配置 / 启动） -->
                                                    <Grid Grid.Row="1" ColumnDefinitions="* Auto Auto">
                                                        <TextBlock Grid.Column="0" Text="{Binding LastPlayedText}" FontSize="12"
                                                                   Foreground="#a1a1aa" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <Button Grid.Column="1" Classes="IconBtn" Width="28" Height="28"
                                                                Margin="0,0,6,0" ToolTip.Tip="配置实例"
                                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenInstanceConfigCommand}"
                                                                CommandParameter="{Binding .}">
                                                            <materialIcons:MaterialIcon Kind="CogOutline" Width="16" Height="16" Foreground="#a1a1aa"/>
                                                        </Button>
                                                        <Button Grid.Column="2" Classes="CardPlay" Classes.Current="{Binding IsCurrent}" ToolTip.Tip="启动"
                                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LaunchInstanceCommand}"
                                                                CommandParameter="{Binding .}">
                                                            <materialIcons:MaterialIcon Kind="Play" Width="14" Height="14"
                                                                                        Foreground="{Binding $parent[Button].Foreground}"/>
                                                        </Button>
                                                    </Grid>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- 两种空法：真没有一个实例，和有实例但被筛没了 -->
                            <StackPanel IsVisible="{Binding !HasInstances}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                <materialIcons:MaterialIcon Kind="LayersOutline" Width="36" Height="36"
                                                            Foreground="#3f3f46" HorizontalAlignment="Center"/>
                                <TextBlock Text="还没有实例" FontSize="14" Foreground="#a1a1aa" HorizontalAlignment="Center"/>
                                <TextBlock Text="点右下角「新建」安装一个 Minecraft 版本" FontSize="12"
                                           Foreground="#71717a" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding HasNoInstanceMatches}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                <TextBlock Text="没有匹配的实例" FontSize="14" Foreground="#a1a1aa" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding InstanceEmptyHint}" FontSize="12" Foreground="#71717a" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- 右下角悬浮新建：和首页停靠卡同一个内缩 -->
                            <Border Classes="FabPill" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,24,24" ZIndex="40">
                                <Button Classes="Fab" Command="{Binding NewInstanceCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <materialIcons:MaterialIcon Kind="Plus" Width="16" Height="16"/>
                                        <TextBlock Text="新建" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Border>
                        </Panel>
                    </Grid>
                </Panel>


                <!-- PAGE 3: DOWNLOAD (version/resource browser; the task list is a popover) -->
                <Panel IsVisible="{Binding CurrentPage, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='download'}">
                    <Grid RowDefinitions="Auto *">
                        <!-- .page-head -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto Auto * Auto Auto" Height="36" Margin="0,0,84,16">
                            <TextBlock Grid.Column="0" Text="下载" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#fafafa" Margin="0,0,8,0"/>
                            <!-- .tabs: 游戏, 模组, 整合包, 资源包, 光影 -->
                            <Border Grid.Column="1" Background="#1c1c21" CornerRadius="10" Padding="3">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Classes="SegmentBtn" Content="游戏"
                                            Classes.On="{Binding CurrentResCategory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='game'}"
                                            Command="{Binding SelectResCategoryCommand}" CommandParameter="game"/>
                                    <Button Classes="SegmentBtn" Content="模组"
                                            Classes.On="{Binding CurrentResCategory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='mod'}"
                                            Command="{Binding SelectResCategoryCommand}" CommandParameter="mod"/>
                                    <Button Classes="SegmentBtn" Content="整合包"
                                            Classes.On="{Binding CurrentResCategory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='pack'}"
                                            Command="{Binding SelectResCategoryCommand}" CommandParameter="pack"/>
                                    <Button Classes="SegmentBtn" Content="资源包"
                                            Classes.On="{Binding CurrentResCategory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='rp'}"
                                            Command="{Binding SelectResCategoryCommand}" CommandParameter="rp"/>
                                    <Button Classes="SegmentBtn" Content="光影"
                                            Classes.On="{Binding CurrentResCategory, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='shader'}"
                                            Command="{Binding SelectResCategoryCommand}" CommandParameter="shader"/>
                                </StackPanel>
                            </Border>

                            <!-- Task list popover trigger -->
                            <Button Grid.Column="3" x:Name="DlPopBtn" Classes="BtnSm BtnOutline"
                                    Content="下载任务" Command="{Binding ToggleDlPopCommand}"
                                    Margin="0,0,8,0" VerticalAlignment="Center"/>

                            <!-- Search -->
                            <Panel Grid.Column="4" Width="240" Height="36">
                                <TextBox CornerRadius="10"
                                         Background="#111114" BorderBrush="#26262b"
                                         PlaceholderText="搜索"
                                         Text="{Binding ResourceSearch}"
                                         Padding="34,0,10,0" VerticalAlignment="Stretch"/>
                                <materialIcons:MaterialIcon Kind="Magnify" Width="16" Height="16"
                                                            Foreground="#a1a1aa"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                                            Margin="11,0,0,0" IsHitTestVisible="False"/>
                            </Panel>
                        </Grid>

                        <!-- .list -->
                        <ScrollViewer Grid.Row="1" IsVisible="{Binding HasResources}">
                            <Border Background="#111114" BorderBrush="#26262b" BorderThickness="1" CornerRadius="14" ClipToBounds="True" VerticalAlignment="Top">
                                <ItemsControl ItemsSource="{Binding FilteredResources}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ResourceModel">
                                            <!-- .list-item -->
                                            <Border BorderBrush="#26262b" BorderThickness="0,0,0,1" Padding="16,12">
                                                <Grid ColumnDefinitions="Auto * Auto Auto">
                                                    <!-- 36x36 Pixel Icon -->
                                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" ClipToBounds="True" Margin="0,0,14,0">
                                                        <Image Source="{Binding IconBitmap, Converter={StaticResource PixelsToBitmap}}"
                                                               Width="36" Height="36"
                                                               RenderOptions.BitmapInterpolationMode="None"/>
                                                    </Border>

                                                    <!-- .grow: b + desc -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#fafafa"/>
                                                        <TextBlock Text="{Binding Desc}" FontSize="12" Foreground="#a1a1aa" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <!-- .stat -->
                                                    <TextBlock Grid.Column="2" Text="{Binding Stat}"
                                                               FontSize="12" Foreground="#a1a1aa"
                                                               VerticalAlignment="Center" Margin="16,0"/>

                                                    <!-- .btn .btn-outline .btn-sm -->
                                                    <Button Grid.Column="3" Classes="BtnSm BtnOutline"
                                                            Content="{Binding ActionText}"
                                                            IsEnabled="{Binding IsActionEnabled}"
                                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).InstallResourceCommand}"
                                                            CommandParameter="{Binding .}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </ScrollViewer>

                        <StackPanel Grid.Row="1" IsVisible="{Binding !HasResources}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <ProgressBar IsIndeterminate="True" Width="120" Height="4" CornerRadius="999"
                                         Foreground="#fafafa" Background="#26262b"
                                         HorizontalAlignment="Center"
                                         IsVisible="{Binding IsLoadingResources}"/>
                            <TextBlock Text="{Binding ResourceEmptyText}" FontSize="13" Foreground="#a1a1aa"
                                       HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="420"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Panel>

                <!-- PAGE 5: SETTINGS -->
                <Panel IsVisible="{Binding CurrentPage, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='settings'}">
                    <Grid RowDefinitions="Auto *">
                        <TextBlock Grid.Row="0" Text="设置" FontSize="20" FontWeight="SemiBold" Height="36" VerticalAlignment="Center" Foreground="#fafafa" Margin="0,0,0,16"/>

                        <!-- .settings: 2 columns 160px 1fr -->
                        <Grid Grid.Row="1" ColumnDefinitions="160 24 *">
                            <!-- .set-nav. ⚠️ The Debug entry is NOT in this file — it is appended
                                 from MainWindow.Debug.cs under #if DEBUG, so a Release build never
                                 compiles it (see that file). -->
                            <StackPanel x:Name="SettingsNavPanel" Grid.Column="0" Spacing="4">
                                <Button Classes="SetNavBtn" Content="游戏"
                                        Classes.On="{Binding CurrentSettingsTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='游戏'}"
                                        Command="{Binding SelectSettingsTabCommand}" CommandParameter="游戏"/>
                                <Button Classes="SetNavBtn" Content="Java"
                                        Classes.On="{Binding CurrentSettingsTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Java'}"
                                        Command="{Binding SelectSettingsTabCommand}" CommandParameter="Java"/>
                                <Button Classes="SetNavBtn" Content="下载"
                                        Classes.On="{Binding CurrentSettingsTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='下载'}"
                                        Command="{Binding SelectSettingsTabCommand}" CommandParameter="下载"/>
                                <Button Classes="SetNavBtn" Content="外观"
                                        Classes.On="{Binding CurrentSettingsTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='外观'}"
                                        Command="{Binding SelectSettingsTabCommand}" CommandParameter="外观"/>
                                <Button Classes="SetNavBtn" Content="关于"
                                        Classes.On="{Binding CurrentSettingsTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='关于'}"
                                        Command="{Binding SelectSettingsTabCommand}" CommandParameter="关于"/>
                            </StackPanel>

                            <!-- .set-card: one card per tab, so each group ends on a borderless row.
                                 The Debug card is likewise appended from MainWindow.Debug.cs (Debug only). -->
                            <Panel x:Name="SettingsCardsPanel" Grid.Column="2" VerticalAlignment="Top">

                                <!-- 游戏 -->
                                <Border Background="#111114" BorderBrush="#26262b" BorderThickness="1" CornerRadius="14" Padding="18,0"
                                        IsVisible="{Binding CurrentSettingsTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='游戏'}">
                                    <StackPanel>
                                        <Border Height="58" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="* Auto">
                                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="最大内存" FontWeight="Medium" Foreground="#fafafa"/>
                                                    <TextBlock Text="分配给游戏的堆内存，建议不超过物理内存的一半。"
                                                               FontSize="12" Foreground="#71717a"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Width="280" VerticalAlignment="Center">
                                                    <Slider Value="{Binding MaxMemoryGb}" Minimum="1" Maximum="32" Width="210"/>
                                                    <TextBlock Text="{Binding MaxMemoryGb, StringFormat='{}{0} GB'}"
                                                               Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                                               Foreground="#fafafa"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Height="58" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="* Auto">
                                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="版本隔离" FontWeight="Medium" Foreground="#fafafa"/>
                                                    <TextBlock Text="每个实例有独立的存档、Mod 和配置文件。"
                                                               FontSize="12" Foreground="#71717a"/>
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding VersionIsolation}" OnContent="" OffContent=""/>
                                            </Grid>
                                        </Border>

                                        <Border Height="58" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="* Auto">
                                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="启动后隐藏启动器" FontWeight="Medium" Foreground="#fafafa"/>
                                                    <TextBlock Text="游戏退出后会自动恢复。" FontSize="12" Foreground="#71717a"/>
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding HideOnLaunch}" OnContent="" OffContent=""/>
                                            </Grid>
                                        </Border>

                                        <Border Height="58" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="* Auto">
                                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="关闭窗口时" FontWeight="Medium" Foreground="#fafafa"/>
                                                    <TextBlock Text="点 ✕ 或按 Alt+F4 的时候走哪条路。" FontSize="12" Foreground="#71717a"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#1c1c21" CornerRadius="10" Padding="3" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                                        <Button Classes="SegmentBtn" Content="每次询问"
                                                                Classes.On="{Binding CloseWindowBehavior, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='ask'}"
                                                                Command="{Binding SetCloseWindowBehaviorCommand}" CommandParameter="ask"/>
                                                        <Button Classes="SegmentBtn" Content="收进托盘"
                                                                Classes.On="{Binding CloseWindowBehavior, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='tray'}"
                                                                Command="{Binding SetCloseWindowBehaviorCommand}" CommandParameter="tray"/>
                                                        <Button Classes="SegmentBtn" Content="直接退出"
                                                                Classes.On="{Binding CloseWindowBehavior, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='exit'}"
                                                                Command="{Binding SetCloseWindowBehaviorCommand}" CommandParameter="exit"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <Border Height="58">
                                            <Grid ColumnDefinitions="* Auto">
                                                <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                    <TextBlock Text="游戏目录" FontWeight="Medium" Foreground="#fafafa"/>
                                                    <TextBlock Text="{Binding GameRoot}" FontSize="12" Foreground="#71717a"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="BtnSm BtnOutline" VerticalAlignment="Center"
                                                        Command="{Binding OpenGameRootCommand}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="14" Height="14"/>
                                                        <TextBlock Text="打开" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Java -->
                                <Border Background="#111114" BorderBrush="#26262b" BorderThickness="1" CornerRadius="14" Padding="18,0"
                                        IsVisible="{Binding CurrentSettingsTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Java'}">
                                    <StackPanel>
                                        <Border Height="58" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="* Auto">
                                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="Java 运行时" FontWeight="Medium" Foreground="#fafafa"/>
                                                    <TextBlock Text="自动模式会按版本要求挑选合适的 Java。" FontSize="12" Foreground="#71717a"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="BtnSm BtnOutline" Width="240"
                                                        HorizontalContentAlignment="Stretch"
                                                        Command="{Binding ToggleJavaChooserCommand}">
                                                    <Grid ColumnDefinitions="* Auto">
                                                        <TextBlock Text="{Binding JavaLabel}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <materialIcons:MaterialIcon Grid.Column="1" Kind="ChevronDown"
                                                                                    Width="14" Height="14" Foreground="#71717a"/>
                                                    </Grid>
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <Border Padding="0,8" IsVisible="{Binding IsJavaChooserOpen}">
                                            <StackPanel Spacing="2">
                                                <ItemsControl ItemsSource="{Binding JavaOptions}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:JavaOptionModel">
                                                            <Button Classes="MenuItem"
                                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectJavaCommand}"
                                                                    CommandParameter="{Binding .}">
                                                                <Grid ColumnDefinitions="* Auto">
                                                                    <TextBlock Text="{Binding Label}" FontSize="13" Foreground="#fafafa"
                                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                    <materialIcons:MaterialIcon Grid.Column="1" Kind="Check" Width="16" Height="16"
                                                                                                Foreground="#fafafa" IsVisible="{Binding IsSelected}"/>
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Button Classes="MenuItem" Click="OnPickJavaClick">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <materialIcons:MaterialIcon Kind="FolderSearchOutline" Width="18" Height="18"
                                                                                    Foreground="#a1a1aa" Margin="7,0"/>
                                                        <TextBlock Text="浏览 javaw.exe…" FontSize="13" Foreground="#fafafa" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                        <Border Height="58">
                                            <TextBlock Text="缺少合适的 Java 时，启动会失败并提示需要的版本。"
                                                       FontSize="12" Foreground="#71717a" VerticalAlignment="Center"
                                                       TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- 下载 -->
                                <Border Background="#111114" BorderBrush="#26262b" BorderThickness="1" CornerRadius="14" Padding="18,0"
                                        IsVisible="{Binding CurrentSettingsTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='下载'}">
                                    <StackPanel>
                                        <Border Height="58" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="* Auto">
                                                <TextBlock Text="下载源" FontWeight="Medium" VerticalAlignment="Center" Foreground="#fafafa"/>
                                                <Border Grid.Column="1" Background="#1c1c21" CornerRadius="10" Padding="3">
                                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                                        <Button Classes="SegmentBtn" Content="官方"
                                                                Classes.On="{Binding DownloadSource, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='官方'}"
                                                                Command="{Binding SetDownloadSourceCommand}" CommandParameter="官方"/>
                                                        <Button Classes="SegmentBtn" Content="BMCLAPI"
                                                                Classes.On="{Binding DownloadSource, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='BMCLAPI'}"
                                                                Command="{Binding SetDownloadSourceCommand}" CommandParameter="BMCLAPI"/>
                                                        <Button Classes="SegmentBtn" Content="自动"
                                                                Classes.On="{Binding DownloadSource, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='自动'}"
                                                                Command="{Binding SetDownloadSourceCommand}" CommandParameter="自动"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- BMCLAPI's terms require the sponsor to be credited wherever the mirror is
                                             offered, so the line stays put no matter which source is selected. -->
                                        <Border Padding="0,14" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{Binding SourceHint}" FontSize="12" Foreground="#71717a"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="BMCLAPI 由 bangbang93 赞助提供。" FontSize="12"
                                                           Foreground="#71717a" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Height="58" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="* Auto">
                                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="下载线程" FontWeight="Medium" Foreground="#fafafa"/>
                                                    <TextBlock Text="同时下载的连接数，大文件会拆成多段并行。"
                                                               FontSize="12" Foreground="#71717a"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Width="280" VerticalAlignment="Center">
                                                    <Slider Value="{Binding DownloadThreads}" Minimum="1" Maximum="64" Width="210"/>
                                                    <TextBlock Text="{Binding DownloadThreads, StringFormat='{}{0}'}"
                                                               Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                                               Foreground="#fafafa"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Padding="0,16,0,18">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnDefinitions="* Auto">
                                                    <TextBlock Text="下载中心" FontWeight="Medium" Foreground="#fafafa"
                                                               VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Classes="BtnSm BtnOutline" Content="清除已完成"
                                                            Command="{Binding ClearDownloadsCommand}"/>
                                                </Grid>
                                                <Border BorderBrush="#26262b" BorderThickness="1" CornerRadius="10"
                                                        ClipToBounds="True" IsVisible="{Binding HasDownloads}">
                                                    <ScrollViewer MaxHeight="320">
                                                        <ItemsControl ItemsSource="{Binding Downloads}"
                                                                      ItemTemplate="{StaticResource DownloadRowTemplate}"/>
                                                    </ScrollViewer>
                                                </Border>
                                                <TextBlock Text="暂无下载任务" IsVisible="{Binding !HasDownloads}"
                                                           FontSize="13" Foreground="#71717a"
                                                           HorizontalAlignment="Center" Margin="0,16"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- 外观 -->
                                <Border Background="#111114" BorderBrush="#26262b" BorderThickness="1" CornerRadius="14" Padding="18,0"
                                        IsVisible="{Binding CurrentSettingsTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='外观'}">
                                    <StackPanel>
                                        <Border Height="58" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="* Auto">
                                                <TextBlock Text="主题" FontWeight="Medium" VerticalAlignment="Center" Foreground="#fafafa"/>
                                                <Button Grid.Column="1" Classes="BtnSm BtnOutline" Command="{Binding ToggleThemeCommand}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <materialIcons:MaterialIcon Kind="WeatherSunny" Width="14" Height="14"/>
                                                        <TextBlock Text="切换深浅色" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <Border Height="58" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="* Auto">
                                                <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                    <TextBlock Text="首页 3D 模型" FontWeight="Medium" Foreground="#fafafa"/>
                                                    <TextBlock Text="左键拖它的位置（会记住），右键转角度。关掉它会把拖过的位置一起清掉，重开回到默认站位。"
                                                               FontSize="12" Foreground="#71717a" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <!-- 只清位置、不动开关：拖乱了想回原点，不该顺手把模型也关掉 -->
                                                    <Button Classes="BtnSm BtnOutline" Content="复位位置"
                                                            Command="{Binding ResetHomeSkinModelPositionCommand}"
                                                            IsVisible="{Binding HasHomeSkinModelPosition}"/>
                                                    <ToggleSwitch IsChecked="{Binding HomeSkinModelVisible}" OnContent="" OffContent=""/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Height="58">
                                            <Grid ColumnDefinitions="* Auto">
                                                <TextBlock Text="背景图片" FontWeight="Medium" VerticalAlignment="Center" Foreground="#fafafa"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <!-- current background, so the picked image is identifiable at a glance -->
                                                    <Border Width="52" Height="34" CornerRadius="8" ClipToBounds="True"
                                                            BorderBrush="#26262b" BorderThickness="1"
                                                            IsVisible="{Binding IsCustomBackground}">
                                                        <Panel>
                                                            <Image Source="{Binding BgCustomArt, Converter={StaticResource PixelsToBitmap}}" Stretch="UniformToFill"/>
                                                            <Border Background="#ffffff" Opacity="{Binding BgLightOpacity}"/>
                                                            <Border Background="#000000" Opacity="{Binding BgDarkOpacity}"/>
                                                        </Panel>
                                                    </Border>
                                                    <!-- 门控看 HasCustomBackground（图片**或**视频），
                                                         与 WPF 侧一致：只按 IsCustomBackground 的话，
                                                         换成视频壁纸后这一排按钮会整排消失。 -->
                                                    <Button Classes="BtnSm BtnOutline" Content="调整"
                                                            Command="{Binding OpenBgTuningCommand}"
                                                            IsVisible="{Binding HasCustomBackground}"/>
                                                    <!-- 这颗是"换回默认壁纸"（连背景一起清掉）；调节窗里那颗同名的
                                                         只归零参数、不动壁纸 —— 两件事，文案必须分开。 -->
                                                    <Button Classes="BtnSm BtnOutline" Content="恢复默认壁纸"
                                                            Command="{Binding ResetBackgroundCommand}"
                                                            IsVisible="{Binding HasCustomBackground}"/>
                                                    <Button Classes="BtnSm BtnOutline" Click="OnPickBackgroundClick">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <materialIcons:MaterialIcon Kind="ImageFrame" Width="14" Height="14"/>
                                                            <TextBlock Text="选择图片" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- 关于 -->
                                <Border Background="#111114" BorderBrush="#26262b" BorderThickness="1" CornerRadius="14" Padding="18,18"
                                        IsVisible="{Binding CurrentSettingsTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='关于'}">
                                    <StackPanel Spacing="14">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Image Source="avares://NegiCraftLauncher.Avalonia/Assets/app.png" Width="40" Height="40"/>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="NegiCraft Launcher" FontSize="16" FontWeight="SemiBold" Foreground="#fafafa"/>
                                                <TextBlock Text="{Binding LauncherVersion, StringFormat='版本 {0}'}"
                                                           FontSize="12" Foreground="#a1a1aa"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock FontSize="12" Foreground="#71717a" TextWrapping="Wrap" LineHeight="20"
                                                   Text="本项目与 Mojang Studios 及 Microsoft 无关联。Minecraft 是 Mojang Studios 的商标。"/>
                                    </StackPanel>
                                </Border>
                            </Panel>
                        </Grid>
                    </Grid>
                </Panel>
            </Panel>

            <!-- ========================================== -->
            <!-- 6. POPOVER DISMISS OVERLAY (Click outside) -->
            <!-- ========================================== -->
            <Panel Background="Transparent"
                   ZIndex="45"
                   PointerPressed="OnPopoverBackgroundPointerPressed"
                   IsVisible="{Binding HasOpenPopover}"/>

            <!-- ========================================== -->
            <!-- 7. POPOVERS (1:1 with Image 2 & mockup)    -->
            <!-- ========================================== -->
            <!-- #accPop: left: 84px; bottom: 12px; width: 280px; -->
            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Margin="84,0,0,12" Width="280"
                    Background="#111114" BorderBrush="#26262b" BorderThickness="1"
                    CornerRadius="14" Padding="6"
                    BoxShadow="0 30 80 -20 #EE000000"
                    Classes="Popover"
                    pop:Pop.Anchor="BottomLeft"
                    pop:Pop.Trigger="{Binding #AccountAvatar}"
                    pop:Pop.IsOpen="{Binding IsAccPopOpen}"
                    Classes.Open="{Binding IsAccPopOpen}"
                    ZIndex="50">
                <StackPanel Spacing="2">
                    <ScrollViewer MaxHeight="260">
                        <ItemsControl ItemsSource="{Binding Accounts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:AccountModel">
                                    <Grid ColumnDefinitions="* Auto" Margin="0,1">
                                        <Button Grid.Column="0" Classes="MenuItem"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectAccountCommand}"
                                                CommandParameter="{Binding .}">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="删除账户"
                                                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveAccountCommand}"
                                                              CommandParameter="{Binding .}"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <Grid ColumnDefinitions="Auto * Auto">
                                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" ClipToBounds="True" Margin="0,0,10,0">
                                                    <Image Source="{Binding AvatarBitmap, Converter={StaticResource PixelsToBitmap}}" Width="30" Height="30" RenderOptions.BitmapInterpolationMode="None"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#fafafa" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Type}" FontSize="12" Foreground="#a1a1aa"/>
                                                </StackPanel>
                                                <!-- Checkmark if active -->
                                                <materialIcons:MaterialIcon Grid.Column="2" Kind="Check" Width="16" Height="16" Foreground="#fafafa"
                                                                            IsVisible="{Binding IsCurrent}" Margin="0,0,4,0"/>
                                            </Grid>
                                        </Button>
                                        <!-- Direct Delete Button -->
                                        <Button Grid.Column="1" Classes="IconBtn Danger" Width="28" Height="28" Margin="4,0,2,0"
                                                ToolTip.Tip="删除账户"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveAccountCommand}"
                                                CommandParameter="{Binding .}">
                                            <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="15" Height="15" Foreground="#71717a"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Separator -->
                    <Rectangle Height="1" Fill="#26262b" Margin="0,6" IsVisible="{Binding HasAccounts}"/>

                    <Button Classes="MenuItem" Command="{Binding AddOfflineAccountCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <materialIcons:MaterialIcon Kind="AccountPlusOutline" Width="18" Height="18" Foreground="#a1a1aa" Margin="7,0"/>
                            <TextBlock Text="添加离线账户" FontSize="13" Foreground="#fafafa" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Reserved until an Azure application id is available; the command explains why -->
                    <Button Classes="MenuItem" Command="{Binding AddMicrosoftAccountCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <materialIcons:MaterialIcon Kind="Microsoft" Width="18" Height="18" Foreground="#a1a1aa" Margin="7,0"/>
                            <TextBlock Text="添加微软账户" FontSize="13" Foreground="#71717a" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- #instPop: exactly 8px above dock (bottom: 100px), width: 380px (1:1 with Image 2) -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,20,100" Width="380"
                    Background="#111114" BorderBrush="#26262b" BorderThickness="1"
                    CornerRadius="14" Padding="6"
                    BoxShadow="0 30 80 -20 #EE000000"
                    Classes="Popover"
                    pop:Pop.Anchor="BottomLeft"
                    pop:Pop.Trigger="{Binding #InstSelectBtn}"
                    pop:Pop.IsOpen="{Binding IsInstPopOpen}"
                    Classes.Open="{Binding IsInstPopOpen}"
                    ZIndex="50">
                <StackPanel Spacing="2">
                    <ScrollViewer MaxHeight="300">
                        <ItemsControl ItemsSource="{Binding Instances}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:InstanceModel">
                                    <Button Classes="MenuItem"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectInstanceCommand}"
                                            CommandParameter="{Binding .}">
                                        <Grid ColumnDefinitions="Auto * Auto">
                                            <!-- 32x32 Block icon with 7px radius (matching Image 2) -->
                                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="7" ClipToBounds="True" Margin="0,0,10,0">
                                                <Image Source="{Binding IconBitmap, Converter={StaticResource PixelsToBitmap}}" Width="32" Height="32" RenderOptions.BitmapInterpolationMode="None"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#fafafa"/>
                                                <TextBlock Text="{Binding MetaText}" FontSize="12" Foreground="#a1a1aa"/>
                                            </StackPanel>
                                            <!-- Checkmark if active (matching Image 2) -->
                                            <materialIcons:MaterialIcon Grid.Column="2" Kind="Check" Width="16" Height="16" Foreground="#fafafa"
                                                                       IsVisible="{Binding IsCurrent}"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Rectangle Height="1" Fill="#26262b" Margin="0,6" IsVisible="{Binding HasInstances}"/>

                    <Button Classes="MenuItem" Command="{Binding NewInstanceCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <materialIcons:MaterialIcon Kind="Plus" Width="18" Height="18" Foreground="#a1a1aa" Margin="7,0"/>
                            <TextBlock Text="安装新版本" FontSize="13" Foreground="#fafafa" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ========================================== -->
            <!-- 7a2. 加载器筛选下拉（挂在实例页工具条那颗按钮上） -->
            <!-- ========================================== -->
            <!-- 选项由 VM 的 LoaderChoices 生成：只列实例里真出现过的加载器。
                 种类再多也不会把工具条撑爆，没装过的类型也不摆出来碍事。 -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,102,28,0" Width="208"
                    Background="#111114" BorderBrush="#26262b" BorderThickness="1"
                    CornerRadius="14" Padding="6"
                    BoxShadow="0 30 80 -20 #EE000000"
                    Classes="Popover"
                    pop:Pop.Anchor="TopRight"
                    pop:Pop.Trigger="{Binding #LoaderFilterBtn}"
                    pop:Pop.IsOpen="{Binding IsLoaderPopOpen}"
                    Classes.Open="{Binding IsLoaderPopOpen}"
                    ZIndex="50">
                <ScrollViewer MaxHeight="280">
                    <ItemsControl ItemsSource="{Binding LoaderChoices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:LoaderOptionModel">
                                <Button Classes="MenuItem"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectInstanceLoaderCommand}"
                                        CommandParameter="{Binding Name}">
                                    <Grid ColumnDefinitions="* Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="13" Foreground="#fafafa" VerticalAlignment="Center"/>
                                        <materialIcons:MaterialIcon Grid.Column="1" Kind="Check" Width="16" Height="16" Foreground="#fafafa"
                                                                    VerticalAlignment="Center" IsVisible="{Binding IsSelected}"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- ========================================== -->
            <!-- 7b. DOWNLOAD TASKS POPOVER (hangs off the  -->
            <!--       download page's 下载任务 button)      -->
            <!-- ========================================== -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,64,112,0" Width="440"
                    Background="#111114" BorderBrush="#26262b" BorderThickness="1"
                    CornerRadius="14" Padding="4" ClipToBounds="True"
                    BoxShadow="0 30 80 -20 #EE000000"
                    Classes="Popover"
                    pop:Pop.Anchor="TopRight"
                    pop:Pop.Trigger="{Binding #DlPopBtn}"
                    pop:Pop.IsOpen="{Binding IsDlPopOpen}"
                    Classes.Open="{Binding IsDlPopOpen}"
                    ZIndex="50">
                <Grid RowDefinitions="Auto *">
                    <Grid Grid.Row="0" ColumnDefinitions="* Auto" Margin="10,8,10,10">
                        <TextBlock Grid.Column="0" Text="下载任务" FontWeight="SemiBold" FontSize="13"
                                   Foreground="#fafafa" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="BtnSm BtnOutline" Content="清除已完成"
                                Command="{Binding ClearDownloadsCommand}"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" MaxHeight="380" IsVisible="{Binding HasDownloads}">
                        <ItemsControl ItemsSource="{Binding Downloads}"
                                      ItemTemplate="{StaticResource DownloadRowTemplate}"/>
                    </ScrollViewer>

                    <TextBlock Grid.Row="1" Text="暂无下载任务" IsVisible="{Binding !HasDownloads}"
                               FontSize="13" Foreground="#a1a1aa"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,28"/>
                </Grid>
            </Border>

            <!-- ========================================== -->
            <!-- 8. BACKGROUND FRAMING TRIO (picked art)    -->
            <!--      与 WPF 的 8. 背景取景三件套逐项对齐     -->
            <!-- ========================================== -->
            <!-- 调节卡片已经搬去独立窗口（Views/BackgroundTuningWindow），主窗口里只留"看"的
                 东西：中上一句提示、右上角一格画中画、底下一条操作说明。 -->
            <!-- 调节模式的独占层：按住拖 = 平移，滚轮 = 缩放。它压在侧栏 / 皮肤 / 停靠栏**之上**
                 （ZIndex 44），所以调节期间那些控件点不动 —— 否则一边调一边能翻页、甚至把游戏
                 启动了，而背景只在首页存在，调节窗就成了在调一个看不见的东西。
                 顶部让出 52px：窗口按钮和拖窗口那条得一直能用。
                 ⚠️ 这里绝不能碰 BeginMoveDrag()：那是拖窗口，本层拖的是背景。 -->
            <Panel x:Name="BgPanSurface" ZIndex="44" Background="Transparent" Cursor="SizeAll"
                   Margin="0,52,0,0"
                   IsVisible="{Binding IsFramingVisible}"
                   PointerPressed="OnBackgroundPanPressed"
                   PointerMoved="OnBackgroundPanMoved"
                   PointerReleased="OnBackgroundPanReleased"
                   PointerCaptureLost="OnBackgroundPanCaptureLost"
                   PointerWheelChanged="OnBackgroundWheel"/>

            <Border x:Name="BgHintPill" ZIndex="45" Cursor="SizeAll"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,0"
                    Background="#E6111114" BorderBrush="#26262b" BorderThickness="1"
                    CornerRadius="15" Padding="11,0" Height="30"
                    BoxShadow="0 20 50 -20 #DE000000"
                    PointerPressed="OnHintPillPressed"
                    PointerMoved="OnFloatDragMove"
                    PointerReleased="OnFloatDragEnd"
                    PointerCaptureLost="OnFloatDragCaptureLost"
                    IsVisible="{Binding IsFramingVisible}">
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="ImageFrame" Width="13" Height="13"
                                                Foreground="#a1a1aa" VerticalAlignment="Center"/>
                    <TextBlock Text="背景预览" FontSize="12" Foreground="#d4d4d8" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 画中画：整张图 contain 进来，白框 = 窗口真正看得见的那一块。两个矩形都出自
                 共享的 BackgroundFrame.ComputeCoverage，和背景同一组数 ⇒ 不可能对不上。
                 ⚠️ 视频没有解码缓冲，画不出缩略图，所以这格只给自选图片看。 -->
            <Border x:Name="BgShot" ZIndex="45" Cursor="SizeAll"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,52,14,0"
                    Width="156" Height="95" CornerRadius="6" ClipToBounds="True"
                    BoxShadow="0 10 15 -3 #1A000000, 0 4 6 -4 #1A000000"
                    PointerPressed="OnBackgroundShotPressed"
                    PointerMoved="OnFloatDragMove"
                    PointerReleased="OnFloatDragEnd"
                    PointerCaptureLost="OnFloatDragCaptureLost"
                    IsVisible="{Binding IsFramingVisible}">
                <Canvas>
                    <!-- 描边画的是"整张画面"的边界：图片有缩略图时贴着图边几乎看不见，
                         而视频没有缓冲可画，全靠这条线才看得出"只看到中间这块"。 -->
                    <Rectangle x:Name="BgShotImage" Stroke="#3f3f46" StrokeThickness="1"/>
                    <Rectangle x:Name="BgShotView" Stroke="#fafafa" StrokeThickness="1.5"
                               RadiusX="3" RadiusY="3"/>
                </Canvas>
            </Border>

            <!-- 操作说明：窗口最下面。左右分别是停靠栏和进度卡，居中这条正好落在它们中间。 -->
            <Border ZIndex="45"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"
                    Background="#E6111114" BorderBrush="#26262b" BorderThickness="1"
                    CornerRadius="15" Padding="12,0" Height="30"
                    BoxShadow="0 20 50 -20 #DE000000"
                    IsVisible="{Binding IsFramingVisible}">
                <TextBlock Text="在背景上按住拖动即可平移，滚轮缩放"
                           FontSize="12" Foreground="#d4d4d8" VerticalAlignment="Center"/>
            </Border>

            <!-- ========================================== -->
            <!-- 9. BANNER (transient status message)       -->
            <!-- ========================================== -->
            <!-- The launch dock owns the bottom-right band, so the toast hangs from the top edge
                 where nothing else lives instead of colliding with it. -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,20,0,0" MaxWidth="520"
                    Background="#F2111114" BorderBrush="#26262b" BorderThickness="1"
                    CornerRadius="12" Padding="14,10"
                    BoxShadow="0 20 50 -16 #DD000000"
                    Classes="Popover"
                    pop:Pop.Anchor="TopCenter"
                    pop:Pop.IsOpen="{Binding IsBannerOpen}"
                    Classes.Open="{Binding IsBannerOpen}"
                    ZIndex="65">
                <Grid ColumnDefinitions="Auto * Auto">
                    <materialIcons:MaterialIcon Grid.Column="0" Kind="InformationOutline" Width="16" Height="16"
                                                Foreground="#a1a1aa" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding BannerText}" FontSize="13" Foreground="#fafafa"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <Button Grid.Column="2" Classes="WinCtrl" Width="22" Height="22" CornerRadius="6"
                            Margin="10,0,0,0" VerticalAlignment="Center"
                            Command="{Binding DismissBannerCommand}" ToolTip.Tip="关闭">
                        <materialIcons:MaterialIcon Kind="Close" Width="13" Height="13"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ========================================== -->
            <!-- 10. DIALOG (in-window prompt / confirm)    -->
            <!-- ========================================== -->
            <Panel ZIndex="70">
                <Border Background="#A6000000" IsVisible="{Binding IsDialogOpen}"
                        PointerPressed="OnDialogBackdropPointerPressed"/>

                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        Width="400"
                        Background="#111114" BorderBrush="#26262b" BorderThickness="1"
                        CornerRadius="16" Padding="22,20"
                        BoxShadow="0 30 80 -20 #EE000000"
                        Classes="Popover"
                        pop:Pop.Anchor="Center"
                        pop:Pop.IsOpen="{Binding IsDialogOpen}"
                        Classes.Open="{Binding IsDialogOpen}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{Binding DialogTitle}" FontSize="16" FontWeight="SemiBold" Foreground="#fafafa"/>

                        <TextBlock Text="{Binding DialogMessage}" FontSize="13" Foreground="#a1a1aa"
                                   TextWrapping="Wrap" LineHeight="20"
                                   IsVisible="{Binding HasDialogMessage}"/>

                        <TextBox x:Name="DialogInputBox"
                                 Text="{Binding DialogInput, Mode=TwoWay}"
                                 PlaceholderText="{Binding DialogPlaceholder}"
                                 IsVisible="{Binding DialogHasInput}"
                                 Background="#1c1c21" BorderBrush="#26262b" BorderThickness="1"
                                 CornerRadius="10" Foreground="#fafafa"
                                 KeyDown="OnDialogInputKeyDown"/>

                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Classes="BtnSm BtnOutline" Content="取消" Command="{Binding CancelDialogCommand}"/>
                            <Button Classes="BtnSm BtnPrimary" Content="{Binding DialogConfirmText}"
                                    Command="{Binding ConfirmDialogCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Panel>

            <!-- ========================================== -->
            <!-- 10.5 INSTANCE CONFIG DIALOG                -->
            <!-- ========================================== -->
            <Panel ZIndex="72" IsVisible="{Binding IsInstConfigOpen}">
                <Border Background="#A6000000"
                        PointerPressed="OnInstConfigBackdropPointerPressed"/>

                <!-- 配置实例：左边 tab 栏、右边内容，走设置页那套导航语言。
                     宽 680 是让右侧那一列放得下"一句说明 + 控件"还不折行。 -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        Width="680" MaxHeight="600"
                        Background="#111114" BorderBrush="#26262b" BorderThickness="1"
                        CornerRadius="16" Padding="0"
                        BoxShadow="0 30 80 -20 #EE000000"
                        Classes="Popover"
                        pop:Pop.Anchor="Center"
                        pop:Pop.IsOpen="{Binding IsInstConfigOpen}"
                        Classes.Open="{Binding IsInstConfigOpen}">
                    <Grid RowDefinitions="Auto * Auto">
                        <!-- 头部：图标 + 实例名 + 版本·加载器 + 关闭 -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto * Auto" Margin="18,14,18,14">
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="9" ClipToBounds="True" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Image Source="{Binding EditingInstance.IconBitmap, Converter={StaticResource PixelsToBitmap}}" Width="36" Height="36" RenderOptions.BitmapInterpolationMode="None"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding EditingInstance.Name, FallbackValue='配置实例'}" FontSize="15" FontWeight="SemiBold" Foreground="#fafafa" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding EditingInstance.MetaText, FallbackValue=''}" FontSize="12" Foreground="#a1a1aa"/>
                            </StackPanel>
                            <Button Grid.Column="2" Classes="WinCtrl" Width="26" Height="26" CornerRadius="7"
                                    Command="{Binding CloseInstanceConfigCommand}" ToolTip.Tip="关闭">
                                <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14"/>
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1" ColumnDefinitions="172 *">
                            <!-- tab 栏：底色比卡再暗一档，和右侧内容分得开 -->
                            <Border Background="#09090b" BorderBrush="#26262b" BorderThickness="0,1,1,0" Padding="10,0,10,12">
                                <StackPanel Spacing="4" VerticalAlignment="Top" Margin="0,10,0,0">
                                    <Button Classes="CfgNavBtn"
                                            Classes.On="{Binding ConfigTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='概览'}"
                                            Command="{Binding SelectConfigTabCommand}" CommandParameter="概览">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <materialIcons:MaterialIcon Kind="CogOutline" Width="15" Height="15" Foreground="#a1a1aa"/>
                                            <TextBlock Text="概览" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="CfgNavBtn"
                                            Classes.On="{Binding ConfigTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Java'}"
                                            Command="{Binding SelectConfigTabCommand}" CommandParameter="Java">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <materialIcons:MaterialIcon Kind="Xml" Width="15" Height="15" Foreground="#a1a1aa"/>
                                            <TextBlock Text="Java" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="CfgNavBtn"
                                            Classes.On="{Binding ConfigTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='内存'}"
                                            Command="{Binding SelectConfigTabCommand}" CommandParameter="内存">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <materialIcons:MaterialIcon Kind="Memory" Width="15" Height="15" Foreground="#a1a1aa"/>
                                            <TextBlock Text="内存" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="CfgNavBtn"
                                            Classes.On="{Binding ConfigTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='目录'}"
                                            Command="{Binding SelectConfigTabCommand}" CommandParameter="目录">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <materialIcons:MaterialIcon Kind="FolderOutline" Width="15" Height="15" Foreground="#a1a1aa"/>
                                            <TextBlock Text="目录" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                <Grid Margin="6,0,0,0">
                                    <!-- 概览 -->
                                    <StackPanel IsVisible="{Binding ConfigTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='概览'}">
                                        <Border Height="64" BorderBrush="#26262b" BorderThickness="0,0,0,1" Margin="16,0,18,0">
                                            <Grid ColumnDefinitions="* Auto">
                                                <TextBlock Text="实例名称" FontWeight="Medium" VerticalAlignment="Center" Foreground="#fafafa"/>
                                                <TextBox Grid.Column="1" Width="240" Text="{Binding ConfigInstName, Mode=TwoWay}"
                                                         Background="#1c1c21" BorderBrush="#26262b" BorderThickness="1"
                                                         CornerRadius="10" Foreground="#fafafa" Padding="12,8" FontSize="13"
                                                         VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <Border Height="58" BorderBrush="#26262b" BorderThickness="0,0,0,1" Margin="16,0,18,0">
                                            <Grid ColumnDefinitions="* Auto">
                                                <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                    <TextBlock Text="版本隔离" FontWeight="Medium" Foreground="#fafafa"/>
                                                    <TextBlock Text="独立 saves、mods 与配置文件（推荐开启）" FontSize="12" Foreground="#71717a"/>
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ConfigInstIsolated}" OnContent="" OffContent=""/>
                                            </Grid>
                                        </Border>
                                        <!-- 版本是装这个实例时定死的，这里只报不猜 —— 没有"换版本"的
                                             后端之前不放那颗按钮。 -->
                                        <Border Height="58" Margin="16,0,18,0">
                                            <Grid ColumnDefinitions="* Auto">
                                                <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                    <TextBlock Text="游戏版本" FontWeight="Medium" Foreground="#fafafa"/>
                                                    <TextBlock Text="{Binding EditingInstance.MetaText, FallbackValue=''}" FontSize="12" Foreground="#71717a"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- Java -->
                                    <StackPanel IsVisible="{Binding ConfigTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Java'}">
                                        <Border Height="58" BorderBrush="#26262b" BorderThickness="0,0,0,1" Margin="16,0,18,0">
                                            <Grid ColumnDefinitions="* Auto">
                                                <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                    <TextBlock Text="独立 Java 运行时" FontWeight="Medium" Foreground="#fafafa"/>
                                                    <TextBlock Text="关掉则跟随设置 → Java 的全局选择" FontSize="12" Foreground="#71717a"/>
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ConfigInstCustomJava}" OnContent="" OffContent=""/>
                                            </Grid>
                                        </Border>
                                        <Border Height="58" BorderBrush="#26262b" BorderThickness="0,0,0,1" Margin="16,0,18,0"
                                                IsVisible="{Binding ConfigInstCustomJava}">
                                            <Grid ColumnDefinitions="* Auto">
                                                <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                    <TextBlock Text="运行时" FontWeight="Medium" Foreground="#fafafa"/>
                                                    <TextBlock Text="{Binding ConfigInstJavaLabel}" FontSize="12" Foreground="#71717a" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <Button Classes="BtnSm BtnOutline" Width="180"
                                                            HorizontalContentAlignment="Stretch"
                                                            Command="{Binding ToggleInstJavaChooserCommand}">
                                                        <Grid ColumnDefinitions="* Auto">
                                                            <TextBlock Grid.Column="0" Text="选择…" VerticalAlignment="Center" FontSize="12"/>
                                                            <materialIcons:MaterialIcon Grid.Column="1" Kind="ChevronDown" Width="14" Height="14" Foreground="#71717a"/>
                                                        </Grid>
                                                    </Button>
                                                    <Button Classes="BtnSm BtnOutline" Click="OnPickInstJavaClick" ToolTip.Tip="浏览自定义路径">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <materialIcons:MaterialIcon Kind="FolderSearchOutline" Width="14" Height="14"/>
                                                            <TextBlock Text="浏览…" FontSize="12" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border BorderBrush="#26262b" BorderThickness="1" CornerRadius="10" Background="#111114" Padding="4"
                                                Margin="16,14,18,0" IsVisible="{Binding IsInstJavaChooserOpen}">
                                            <ItemsControl ItemsSource="{Binding InstJavaOptions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:JavaOptionModel">
                                                        <Button Classes="MenuItem"
                                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectInstJavaCommand}"
                                                                CommandParameter="{Binding .}">
                                                            <Grid ColumnDefinitions="* Auto">
                                                                <TextBlock Text="{Binding Label}" FontSize="13" Foreground="#fafafa"
                                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                <materialIcons:MaterialIcon Grid.Column="1" Kind="Check" Width="14" Height="14"
                                                                                            Foreground="#fafafa" IsVisible="{Binding IsSelected}"/>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                        <Border Height="58" Margin="16,0,18,0">
                                            <TextBlock Text="缺少合适的 Java 时，启动会失败并提示需要的版本。"
                                                       FontSize="12" Foreground="#71717a" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- 内存 -->
                                    <StackPanel IsVisible="{Binding ConfigTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='内存'}">
                                        <Border Height="58" BorderBrush="#26262b" BorderThickness="0,0,0,1" Margin="16,0,18,0">
                                            <Grid ColumnDefinitions="* Auto">
                                                <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                    <TextBlock Text="独立最大内存" FontWeight="Medium" Foreground="#fafafa"/>
                                                    <TextBlock Text="{Binding GlobalMemoryGbSummary, StringFormat='关掉则跟随全局设置（当前 {0}）'}"
                                                               FontSize="12" Foreground="#71717a"/>
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ConfigInstCustomMemory}" OnContent="" OffContent=""/>
                                            </Grid>
                                        </Border>
                                        <Border Height="58" Margin="16,0,18,0"
                                                IsVisible="{Binding ConfigInstCustomMemory}">
                                            <Grid ColumnDefinitions="* Auto">
                                                <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                    <TextBlock Text="分配给这个实例" FontWeight="Medium" Foreground="#fafafa"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                    <Slider Value="{Binding ConfigInstMemoryGb}" Minimum="1" Maximum="32" Width="210"/>
                                                    <TextBlock Text="{Binding ConfigInstMemoryGb, StringFormat='{}{0} GB'}"
                                                               Width="52" TextAlignment="Right" Foreground="#fafafa" FontWeight="Medium" FontSize="13"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- 目录 -->
                                    <StackPanel IsVisible="{Binding ConfigTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='目录'}">
                                        <Border Height="58" BorderBrush="#26262b" BorderThickness="0,0,0,1" Margin="16,0,18,0">
                                            <Grid ColumnDefinitions="* Auto">
                                                <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                    <TextBlock Text="实例文件夹" FontWeight="Medium" Foreground="#fafafa"/>
                                                    <TextBlock Text="{Binding EditingGameDirectory}" FontSize="12" Foreground="#71717a"
                                                               TextTrimming="CharacterEllipsis" FontFamily="Consolas"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="BtnSm BtnOutline"
                                                        Command="{Binding OpenInstanceFolderCommand}" CommandParameter="{Binding EditingInstance}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <materialIcons:MaterialIcon Kind="FolderOutline" Width="14" Height="14"/>
                                                        <TextBlock Text="打开" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <Border Height="58" BorderBrush="#26262b" BorderThickness="0,0,0,1" Margin="16,0,18,0">
                                            <Grid ColumnDefinitions="* Auto">
                                                <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                    <TextBlock Text="存档" FontWeight="Medium" Foreground="#fafafa"/>
                                                    <TextBlock Text="{Binding EditingSavesDirectory}" FontSize="12" Foreground="#71717a"
                                                               TextTrimming="CharacterEllipsis" FontFamily="Consolas"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="BtnSm BtnOutline"
                                                        Command="{Binding OpenInstanceSavesCommand}" CommandParameter="{Binding EditingInstance}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <materialIcons:MaterialIcon Kind="FolderOutline" Width="14" Height="14"/>
                                                        <TextBlock Text="打开" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <Border Height="58" Margin="16,0,18,0">
                                            <Grid ColumnDefinitions="* Auto">
                                                <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                    <TextBlock Text="删除实例" FontWeight="Medium" Foreground="#fafafa"/>
                                                    <TextBlock Text="版本文件夹会一并删除，存档也在里面。" FontSize="12" Foreground="#71717a"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="BtnSm BtnOutline Danger" Content="删除"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding DeleteEditingInstanceCommand}"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </Grid>

                        <!-- 底部：设为当前（正在编辑的就是当前实例时不出现）+ 取消 / 保存 -->
                        <Grid Grid.Row="2" ColumnDefinitions="* Auto Auto" Margin="18,14,18,16">
                            <Button Grid.Column="0" Classes="BtnSm BtnOutline" Content="设为当前" HorizontalAlignment="Left"
                                    IsVisible="{Binding !IsEditingCurrentInstance}"
                                    Command="{Binding MakeEditingInstanceCurrentCommand}"/>
                            <Button Grid.Column="1" Classes="BtnSm BtnOutline" Content="取消" Margin="0,0,10,0"
                                    Command="{Binding CloseInstanceConfigCommand}"/>
                            <Button Grid.Column="2" Classes="BtnSm BtnPrimary" Content="保存设置"
                                    Command="{Binding SaveInstanceConfigCommand}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Panel>

            <!-- ========================================== -->
            <!-- 10.6 CLOSE PROMPT                          -->
            <!-- ========================================== -->
            <!-- 只有设置里「关闭窗口时 = 每次询问」才会走到这里。三个出口：托盘 / 退出 / 取消；
                 勾了「不再询问」就把这次选的那条写回设置，以后不再弹（设置里随时能改回来）。 -->
            <Panel ZIndex="74" IsVisible="{Binding IsClosePromptOpen}">
                <Border Background="#A6000000"
                        PointerPressed="OnClosePromptBackdropPointerPressed"/>

                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="420"
                        Background="#111114" BorderBrush="#26262b" BorderThickness="1"
                        CornerRadius="16" Padding="22,20"
                        BoxShadow="0 30 80 -20 #EE000000"
                        Classes="Popover"
                        pop:Pop.Anchor="Center"
                        pop:Pop.IsOpen="{Binding IsClosePromptOpen}"
                        Classes.Open="{Binding IsClosePromptOpen}">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="关闭启动器" FontSize="16" FontWeight="SemiBold" Foreground="#fafafa"/>
                            <TextBlock Text="收进托盘后，点托盘图标就能再把启动器唤出来；直接退出会连同桌宠一起结束。"
                                       FontSize="13" Foreground="#a1a1aa" TextWrapping="Wrap" LineHeight="20"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <CheckBox Classes="Tick" IsChecked="{Binding ClosePromptRemember}"/>
                            <TextBlock Text="不再询问" FontSize="13" Foreground="#a1a1aa" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                            <Button Classes="BtnSm BtnOutline" Content="取消"
                                    Command="{Binding CancelCloseCommand}"/>
                            <Button Classes="BtnSm DangerFill" Content="直接退出"
                                    Command="{Binding AnswerCloseCommand}" CommandParameter="exit"/>
                            <Button Classes="BtnSm BtnPrimary" Content="最小化到托盘"
                                    Command="{Binding AnswerCloseCommand}" CommandParameter="tray"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Panel>

        </Panel>
    </Border>
    </Panel>
</Window>
