<!-- MainWindow 专用的样式（与 WPF 侧 App/Styles/LauncherStyles.xaml 对应）。
     原先内联在 Views/MainWindow.axaml 的 Window.Styles 里，占掉整个文件近四分之一。
     这里只放选择器样式，没有一条 StaticResource 引用 —— 所以搬出来是纯搬运，
     不涉及资源作用域；窗口级的资源（converter、DownloadRowTemplate）仍然留在 Window.Resources。

     ⚠️ 想加新样式到主窗口，加在这个文件里，别退回 Window.Styles ——
        否则两个地方都能写样式，很快就会只改得动一边。 -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:NegiCraftLauncher.Icons.Avalonia;assembly=NegiCraftLauncher.Icons.Avalonia">

        <!-- Nav Button: 42x42, radius 12, icon 20x20 -->
        <!-- 导航按钮。侧栏是浮在背景上的一块玻璃，所以未选中的图标只能"白 + 降不透明度"——
             灰图标（#a1a1aa）压在亮壁纸上会直接消失。以前这套只在首页生效（`Border.Sidebar.OnHome`
             那两条后代选择器），现在背景贯穿所有页，两条分支并成唯一态。 -->
        <Style Selector="Button.NavBtn">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#fafafa"/>
            <Setter Property="Opacity" Value="0.75"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.18"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.NavBtn:pointerover">
            <Setter Property="Background" Value="#2E7F7F7F"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="Opacity" Value="1.0"/>
        </Style>
        <!-- 排在 :pointerover 之后：选中态要压过 hover。Opacity 必须显式写回 1，
             不然基态那 0.75 会把整块白底压成半透明。 -->
        <Style Selector="Button.NavBtn.Active">
            <Setter Property="Background" Value="#fafafa"/>
            <Setter Property="Foreground" Value="#18181b"/>
            <Setter Property="Opacity" Value="1.0"/>
        </Style>
        <Style Selector="Button.NavBtn.Active:pointerover">
            <Setter Property="Background" Value="#fafafa"/>
            <Setter Property="Foreground" Value="#18181b"/>
            <Setter Property="Opacity" Value="1.0"/>
        </Style>

        <!-- Sidebar 玻璃背板 -->
        <Style Selector="Border.Sidebar">
            <Setter Property="Background" Value="#8C0E0E12"/>
            <!-- ⚠️ WPF 侧这条用的是等效色 #45555555，不是这里的 #17FFFFFF：
                 WPF 的 Border 把描边直接压在父级亮图上，Avalonia 的 BoxShadow 先压暗一层底色，
                 同一个色号两边看着差 R+45。别"顺手对齐"回去（详见 WPF MainWindow.xaml 那段注释）。 -->
            <Setter Property="BorderBrush" Value="#17FFFFFF"/>
        </Style>

        <!-- Window Control Button: 32x32 square, radius 9 -->
        <Style Selector="Button.WinCtrl">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#a1a1aa"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.WinCtrl:pointerover">
            <Setter Property="Background" Value="#1c1c21"/>
            <Setter Property="Foreground" Value="#fafafa"/>
        </Style>
        <Style Selector="Button.WinCtrl.Close:pointerover">
            <Setter Property="Background" Value="#e81123"/>
            <Setter Property="Foreground" Value="#ffffff"/>
        </Style>

        <!-- Shadcn 按钮那套（Button.Btn / BtnSm / BtnPrimary / BtnOutline）在 App.axaml ——
             背景调节窗和这扇窗共用同一套，抄两份必然有一天只改一边。 -->

        <!-- Instance Selector in Dock -->
        <Style Selector="Button.InstSelect">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="6,0,10,0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="RenderTransform" Value="none"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.InstSelect:pointerover">
            <Setter Property="Background" Value="#297F7F7F"/>
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
        </Style>

        <!-- Launch button: colours live here (not inline) so :pointerover can override them -->
        <Style Selector="Button.LaunchBtn">
            <Setter Property="Background" Value="#fafafa"/>
            <Setter Property="Foreground" Value="#18181b"/>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="RenderTransform" Value="none"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.LaunchBtn:pointerover">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="RenderTransform" Value="scale(1.03)"/>
        </Style>

        <!-- Popovers stay in the tree (hidden by opacity + not hit-testable) because toggling IsVisible
             would drop them out of layout. Views/Pop.cs drives the whole motion, opacity included:
             Avalonia has no animator for RenderTransform, so the stages cannot be a transition. -->
        <Style Selector="Border.Popover">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="Border.Popover.Open">
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>

        <!-- Instance Grid Card -->
        <Style Selector="Button.InstCard">
            <!-- 四边不等宽，照设计稿那两条 padding 来：上块 13/12/10/14、下条 0/12/12/14
                 （左 14 右 12 上 13 下 12），中间那 10 写在卡里的行间距上。 -->
            <Setter Property="Padding" Value="14,13,12,12"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="#111114"/>
            <Setter Property="BorderBrush" Value="#26262b"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <!-- 纵向也是 Stretch：UniformGrid 把格子拉成等高，卡片内容得跟着填满，
                 底行那句「最近游玩」才贴得到卡底。 -->
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.InstCard:pointerover">
            <Setter Property="BorderBrush" Value="#52525b"/>
        </Style>
        <!-- 当前实例不再靠一颗「当前」胶囊表示，整张卡的底色就是那个意思（稿子改的）：
             muted 底 + 半透明白描边，白描边压在 #27272a 上比 #fafafa 那圈柔和，
             也不会和右下角那颗实心启动键抢焦点。
             ⚠️ .Current 必须排在 :pointerover 之后：Avalonia 的样式按书写顺序决胜，
             默认的 :pointerover 与 .Current 同权重，后写的才压得住。 -->
        <Style Selector="Button.InstCard.Current">
            <Setter Property="Background" Value="#27272a"/>
            <Setter Property="BorderBrush" Value="#24FFFFFF"/>
        </Style>
        <Style Selector="Button.InstCard.Current:pointerover">
            <Setter Property="BorderBrush" Value="#3DFFFFFF"/>
        </Style>

        <!-- 列表模式的一行：54 高、圆角 12，一整行可点（点=设为当前），右侧三颗图标按钮各有自己的事。
             当前行的底色与描边和卡片模式同一套语言，两种看法之间不用重新学。 -->
        <Style Selector="Button.InstRow">
            <Setter Property="Height" Value="54"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="#111114"/>
            <Setter Property="BorderBrush" Value="#26262b"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.InstRow:pointerover">
            <Setter Property="Background" Value="#1c1c21"/>
            <Setter Property="BorderBrush" Value="#52525b"/>
        </Style>
        <Style Selector="Button.InstRow.Current">
            <Setter Property="Background" Value="#27272a"/>
            <Setter Property="BorderBrush" Value="#24FFFFFF"/>
        </Style>
        <Style Selector="Button.InstRow.Current:pointerover">
            <Setter Property="BorderBrush" Value="#3DFFFFFF"/>
        </Style>

        <!-- Segmented Tab Button: 28px height, 7px radius -->
        <Style Selector="Button.SegmentBtn">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#a1a1aa"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.SegmentBtn:pointerover">
            <Setter Property="Foreground" Value="#fafafa"/>
        </Style>
        <Style Selector="Button.SegmentBtn.On">
            <Setter Property="Background" Value="#111114"/>
            <Setter Property="Foreground" Value="#fafafa"/>
        </Style>

        <!-- Setting Nav Button -->
        <Style Selector="Button.SetNavBtn">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#a1a1aa"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.SetNavBtn:pointerover">
            <Setter Property="Background" Value="#1c1c21"/>
            <Setter Property="Foreground" Value="#fafafa"/>
        </Style>
        <Style Selector="Button.SetNavBtn.On">
            <Setter Property="Background" Value="#1c1c21"/>
            <Setter Property="Foreground" Value="#fafafa"/>
        </Style>

        <!-- 实例配置对话框左侧 Tab 导航按钮 -->
        <Style Selector="Button.InstNavBtn">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#a1a1aa"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
        <Style Selector="Button.InstNavBtn:pointerover">
            <Setter Property="Background" Value="#1c1c21"/>
            <Setter Property="Foreground" Value="#fafafa"/>
        </Style>
        <Style Selector="Button.InstNavBtn.On">
            <Setter Property="Background" Value="#27272a"/>
            <Setter Property="Foreground" Value="#fafafa"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Menu Item in Popover -->
        <Style Selector="Button.MenuItem">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.MenuItem:pointerover">
            <Setter Property="Background" Value="#1c1c21"/>
        </Style>

        <!-- Icon Button (small action button) -->
        <Style Selector="Button.IconBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.IconBtn:pointerover">
            <Setter Property="Background" Value="#27272a"/>
        </Style>
        <Style Selector="Button.IconBtn.Danger:pointerover">
            <Setter Property="Background" Value="#3f1218"/>
        </Style>

        <!-- 「实例图标」那排预设方块：每块一个 38x38 的槽（+4 间距 = 步进 42）。
             步进是量着定的：配置页可用宽约 789 DIP，18 块 × 42 = 756 刚好排成一行；
             再大一点就掉到第二行只剩铁砧一个，很难看。窗口拉窄时仍然会自动换行，不算错。
             选中态（On）只换描边不换底 —— 18 个格子全上底色会喧宾夺主，
             方块自己就是内容，槽位只负责告诉人"点到哪一块"。
             ⚠️ 与 WPF 的 IconTileStyle 一一对应，改一边记得看另一边。 -->
        <Style Selector="Button.IconTile">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.IconTile:pointerover">
            <Setter Property="Background" Value="#111114"/>
            <Setter Property="BorderBrush" Value="#3f3f46"/>
        </Style>
        <Style Selector="Button.IconTile.On">
            <Setter Property="Background" Value="#111114"/>
            <Setter Property="BorderBrush" Value="#a1a1aa"/>
        </Style>

        <!-- 实例卡上的 tag（版本 / 加载器 / 模组数）。稿子改成了"有底的胶囊"：
             半透明白底 + 更亮一档的描边，压在卡片底色上才分得出层；圆角按稿子的 6 而不是半高，
             所以它不是药丸而是圆角方块。当前卡的那一份要再亮一档，用 IsCurrent 的数据触发。
             ⚠️ 描边是**往里画**的（Avalonia 的 Stroke 不越过 Bounds），所以 22 高、1 描边
             的胶囊里那圈 #1AFFFFFF 只会盖住最外 1px，和 WPF 的观感一致，不必另加内缩。 -->
        <Style Selector="Border.TagPill">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#0DFFFFFF"/>
            <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.TagPill.Current">
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="BorderBrush" Value="#38FFFFFF"/>
        </Style>
        <Style Selector="TextBlock.TagText">
            <!-- 稿子 .inst .badge{font-size:11.5px} -->
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#a1a1aa"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.TagText.Current">
            <Setter Property="Foreground" Value="#fafafa"/>
        </Style>
        <!-- 模组那颗 tag 里的小方块图标。WPF 是把兄弟 TextBlock 的 Foreground 借过来
             （`{Binding Foreground, RelativeSource={RelativeSource AncestorType=TextBlock}}`）；
             MaterialIcon 的祖先链上没有带前景的元素 —— 于是把同一对颜色改写成类，
             判据还是那个 IsCurrent。 -->
        <Style Selector="materialIcons|MaterialIcon.TagIcon">
            <Setter Property="Foreground" Value="#a1a1aa"/>
        </Style>
        <Style Selector="materialIcons|MaterialIcon.TagIcon.Current">
            <Setter Property="Foreground" Value="#fafafa"/>
        </Style>

        <!-- 工具条上的 chip（排序）。选中态刻意用"卡底 + 描边"而不是只换字色：
             dark 下 accent 与 tabs 同值，靠底色分选中会和 hover 糊在一起（设置页导航就栽过）。 -->
        <Style Selector="Button.Chip">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,0"/>
            <!-- ⚠️ 圆角写"半个高"，不能写 999：CSS 和 Avalonia 会把过大的圆角按**每个轴各自**夹住，
                 于是 999 就是胶囊；WPF 不是 —— 它把 X/Y **一起等比缩小**到放得下，52x22 的框就变成
                 rx=26 / ry=11 的**真椭圆**。所以凡是要药丸形的都得按各自高度写死半径。 -->
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#a1a1aa"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.Chip:pointerover">
            <Setter Property="Foreground" Value="#fafafa"/>
        </Style>
        <Style Selector="Button.Chip.On">
            <Setter Property="Background" Value="#111114"/>
            <Setter Property="BorderBrush" Value="#26262b"/>
            <Setter Property="Foreground" Value="#fafafa"/>
        </Style>

        <!-- 摆在卡片底（#111114）上的 chip：Chip 的选中态是"卡底 + 描边"，
             放到同为卡底的对话框里就等于没选中，所以这里改成 muted 底 + 亮一档描边。 -->
        <Style Selector="Button.PickChip">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#a1a1aa"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.PickChip:pointerover">
            <Setter Property="Foreground" Value="#fafafa"/>
        </Style>
        <Style Selector="Button.PickChip.On">
            <Setter Property="Background" Value="#27272a"/>
            <Setter Property="BorderBrush" Value="#3f3f46"/>
            <Setter Property="Foreground" Value="#fafafa"/>
        </Style>

        <!-- 卡片底行那颗「启动」：当前实例是主色实心，其余是灰图标暗底按钮。
             顺序不能调 —— .Current 必须排在 :pointerover 之后，两者同时命中时后写的赢。 -->
        <Style Selector="Button.CardPlay">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#27272a"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Background" Value="#18181b"/>
            <Setter Property="Foreground" Value="#a1a1aa"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.CardPlay:pointerover">
            <Setter Property="Background" Value="#27272a"/>
            <Setter Property="BorderBrush" Value="#3f3f46"/>
            <Setter Property="Foreground" Value="#fafafa"/>
        </Style>
        <Style Selector="Button.CardPlay.Current">
            <Setter Property="Background" Value="#fafafa"/>
            <Setter Property="Foreground" Value="#18181b"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.CardPlay.Current:pointerover">
            <Setter Property="Background" Value="#e4e4e7"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- 工具条「当前目录」按钮：32 高、8 圆角、卡底 + 描边，点开时保持 hover 那副样子，
             浮层开着时一眼能看出是谁把它叫出来的。 -->
        <Style Selector="Button.FolderPill">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,0,8,0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="#111114"/>
            <Setter Property="BorderBrush" Value="#26262b"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="#fafafa"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.FolderPill:pointerover">
            <Setter Property="Background" Value="#1c1c21"/>
            <Setter Property="BorderBrush" Value="#52525b"/>
        </Style>
        <Style Selector="Button.FolderPill.On">
            <Setter Property="Background" Value="#1c1c21"/>
            <Setter Property="BorderBrush" Value="#52525b"/>
        </Style>

        <!-- 目录浮层里的一行。选中态用 muted（#27272a）而不是 accent：dark 下 accent 与 hover
             同值，靠底色分不出"这就是当前目录"。 -->
        <Style Selector="Button.FolderRow">
            <!-- 稿子 .folder-pop-item{padding:7px 10px}：左右 10、上下 7。 -->
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.FolderRow:pointerover">
            <Setter Property="Background" Value="#1c1c21"/>
        </Style>
        <Style Selector="Button.FolderRow.On">
            <Setter Property="Background" Value="#27272a"/>
        </Style>

        <!-- 目录行那颗只在 hover 时才露出来的「⋯」。Opacity 走类而不是样式触发器：
             类绑的是**这一行**的 IsPointerOver —— 指到行上任何一处（包括这颗钮自己）都算，
             与 WPF 那条 AncestorType=Button 的 DataTrigger 同一个判据。 -->
        <Style Selector="Button.RowMore">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="Button.RowMore.RowOver">
            <Setter Property="Opacity" Value="0.75"/>
        </Style>
        <Style Selector="Button.FolderRow:pointerover Button.RowMore">
            <Setter Property="Opacity" Value="0.75"/>
        </Style>
        <Style Selector="Button.RowMore.RowOver:pointerover, Button.RowMore:pointerover">
            <Setter Property="Background" Value="#27272a"/>
        </Style>

        <!-- 视图切换那对小方钮（网格 / 列表）。选中态是"卡底 + 字亮"，
             容器自己有 muted 底 + 2 的内边距，所以选中那块看着像从槽里浮起来。 -->
        <Style Selector="Button.ViewBtn">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.ViewBtn:pointerover">
            <Setter Property="Background" Value="#1c1c21"/>
        </Style>
        <Style Selector="Button.ViewBtn.On">
            <Setter Property="Background" Value="#111114"/>
        </Style>

        <!-- 排序那两项：分段控件里的一段，和右下角「网格 / 列表」同一套语言（容器 muted、
             选中那段是卡底）。以前是两颗没有底的 chip —— 字直接压在壁纸上，亮壁纸上 #a1a1aa
             糊得看不见；给它们一个自己的底，对比度来自容器，就不吃壁纸了。
             圆角写半个高（28 ⇒ 7 那一档跟着容器内缩），不写 999。 -->
        <Style Selector="Button.SortTab">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="#a1a1aa"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.SortTab:pointerover">
            <Setter Property="Foreground" Value="#fafafa"/>
        </Style>
        <Style Selector="Button.SortTab.On">
            <Setter Property="Background" Value="#111114"/>
            <Setter Property="Foreground" Value="#fafafa"/>
        </Style>

        <!-- 危险动作的文字按钮（配置弹窗里的「删除实例」）。描边和字都往红上偏一档，
             但不做实心红 —— 实心红在一堆中性按钮里太吵，反而降低点击的谨慎度。 -->
        <Style Selector="Button.BtnSm.Danger">
            <Setter Property="Foreground" Value="#f87171"/>
            <Setter Property="BorderBrush" Value="#3f1218"/>
        </Style>
        <Style Selector="Button.BtnSm.Danger:pointerover">
            <Setter Property="Background" Value="#3f1218"/>
            <Setter Property="BorderBrush" Value="#5b1a22"/>
        </Style>

        <!-- 实心红的动作键（关闭询问窗里的「直接退出」）。和上面那条分开的理由相反：
             这里它是三选一里唯一"做了就收不回来"的那颗，就该吵。
             底色取 #b3261e 而不是纯红：#111114 这张卡上纯红会发飘，压一档才和 zinc 系配得上。 -->
        <Style Selector="Button.BtnSm.DangerFill">
            <Setter Property="Background" Value="#b3261e"/>
            <Setter Property="Foreground" Value="#fafafa"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.BtnSm.DangerFill:pointerover">
            <Setter Property="Background" Value="#c8352c"/>
        </Style>

        <!-- 真·勾选框。Avalonia 这边更直接：CheckBox 压根没有控制主题，默认画不出来
             （背景调节窗那颗「视频声音」就是只看得见文字），所以自己给一颗 16 的方框。
             WPF 侧同名的 CheckTickStyle 画的是同一个东西。 -->
        <Style Selector="CheckBox.Tick">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Background="Transparent" Width="16" Height="16">
                        <Border Name="Box" CornerRadius="5"
                                Background="#1c1c21" BorderBrush="#26262b" BorderThickness="1">
                            <materialIcons:MaterialIcon Name="Tick" Kind="Check" Width="12" Height="12"
                                                        Foreground="#18181b" IsVisible="False"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="CheckBox.Tick:checked /template/ Border#Box">
            <Setter Property="Background" Value="#fafafa"/>
            <Setter Property="BorderBrush" Value="#fafafa"/>
        </Style>
        <Style Selector="CheckBox.Tick:checked /template/ materialIcons|MaterialIcon#Tick">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <!-- 勾选态已经是实心白，hover 再描一圈灰就脏了，所以只管未勾选的那半。 -->
        <Style Selector="CheckBox.Tick:pointerover:not(:checked) /template/ Border#Box">
            <Setter Property="BorderBrush" Value="#52525b"/>
        </Style>

        <!-- 配置弹窗左侧的 tab。和设置页那条 SetNavBtn 分开写：
             那条的 hover 与选中都是 #1c1c21（dark 下 accent 与 tabs 同值），选中态等于不存在。
             这里选中改用 #27272a + 加粗，hover 留 #1c1c21，两者分得开。 -->
        <Style Selector="Button.CfgNavBtn">
            <!-- 稿子 .cfg nav button{height:36; border-radius:9; font-size:13} -->
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#a1a1aa"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.CfgNavBtn:pointerover">
            <Setter Property="Background" Value="#1c1c21"/>
            <Setter Property="Foreground" Value="#fafafa"/>
        </Style>
        <Style Selector="Button.CfgNavBtn.On">
            <!-- 选中那格与右侧内容同底（#111114），看起来像从轨道里"通"进了内容区 —— 稿子就是这么画的。
                 这里不用 muted：整张弹窗的底色就是 muted 那一档，再亮一档反而糊不出层次。 -->
            <Setter Property="Background" Value="#111114"/>
            <Setter Property="Foreground" Value="#fafafa"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- 右下角悬浮「新建」：只在实例页出现，内缩与首页停靠卡一致（右 24 / 下 24）。
             Avalonia 12 里没有 DropShadowEffect 这个类型，Button 上也没有 BoxShadow（那是
             Border 的属性）—— 所以药丸的底色和投影交给外面那层 Border，按钮自己透明，
             hover 时用圆角底色盖住它，观感和设计稿那条 opacity:.9 一致。和首页停靠卡同一套写法。 -->
        <Style Selector="Border.FabPill">
            <Setter Property="Background" Value="#fafafa"/>
            <!-- 半高（36 的那一半） -->
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="BoxShadow" Value="0 10 30 -12 #B0000000"/>
        </Style>
        <Style Selector="Button.Fab">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#18181b"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.Fab:pointerover">
            <Setter Property="Background" Value="#e4e4e7"/>
        </Style>

        <!-- 导入整合包那张拖拽区的虚线圈。和 WPF 同一个理由：只有 Shape 有 StrokeDashArray，
             Border 画不出虚线，所以这格用 Rectangle。描边色写在样式里，
             hover 那条挂在祖先 Panel 上（稿子是整格亮，不是只亮线本身）。 -->
        <Style Selector="Rectangle.DropRing">
            <Setter Property="Stroke" Value="#26262b"/>
        </Style>
        <Style Selector="Panel.DropZone:pointerover Rectangle.DropRing">
            <Setter Property="Stroke" Value="#52525b"/>
        </Style>

        <!-- 页面入场过渡**不在这里**了：XAML 样式读不到"上一页是谁"，
             而方向恰恰是"上一页 → 下一页"的函数（侧栏竖直顺序）。
             改成代码驱动，见 App.Avalonia/Views/PageTransition.cs（与 WPF 侧对照的两份）。
             Pages 仍然挂着 PageAnim 这个 class —— 只作标记，行为由代码接上去。 -->
</Styles>
