<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 图标**数据**层：只有枚举 + 几何字符串表，零 UI 依赖（net10.0，WPF/Avalonia 都能引）。
         控件（把字符串解析成各自框架的 Geometry 并画出来）分别在
         NegiCraftLauncher.Icons（WPF）与 NegiCraftLauncher.Icons.Avalonia 里。
         数据只生成一份 ⇒ 两端枚举天然同步，加图标不会只加一边。 -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- 与 Pet.Core 同样的手法：程序集叫 .Core，命名空间钉死在 NegiCraftLauncher.Icons。 -->
    <RootNamespace>NegiCraftLauncher.Icons</RootNamespace>
    <AssemblyName>NegiCraftLauncher.Icons.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- ⚠️ 只为了拿到包里的 dll 当**数据源**（构建时反射读取），绝不引用它的程序集。
         ExcludeAssets=all 保证编译/运行时都看不到它，GeneratePathProperty 给出 $(PkgMaterial_Icons)。 -->
    <PackageReference Include="Material.Icons" Version="3.0.2" ExcludeAssets="all" GeneratePathProperty="true" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <!-- ⚠️ $(PkgMaterial_Icons) **不带**尾随分隔符（不是 NuGet 文档里那种带斜杠的形式），
         这里必须自己补一个 \，否则拼出来是 "...3.0.2lib\netstandard2.0\..."。 -->
    <MaterialIconsAssembly>$(PkgMaterial_Icons)\lib\netstandard2.0\Material.Icons.dll</MaterialIconsAssembly>
    <IconDataSourceFile>$(MSBuildProjectDirectory)\Generated\IconData.g.cs</IconDataSourceFile>
    <!-- ⚠️ MSBuild 的通配符**不认路径里的 `..`**（会当成字面目录名，一个文件都匹配不到）。
         必须先 GetFullPath 规范化成不含 `..` 的绝对路径。 -->
    <IconScanRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</IconScanRoot>
  </PropertyGroup>

  <ItemGroup>
    <!-- 扫描范围：src 下所有工程的 XAML（.xaml = WPF，.axaml = Avalonia）。
         图标可以在任何一端使用，这里取并集。排除自己以及 bin/obj。 -->
    <IconSourceXaml Include="$(IconScanRoot)**\*.xaml;$(IconScanRoot)**\*.axaml"
                    Exclude="$(IconScanRoot)**\bin\**\*.xaml;$(IconScanRoot)**\bin\**\*.axaml;$(IconScanRoot)**\obj\**\*.xaml;$(IconScanRoot)**\obj\**\*.axaml" />
  </ItemGroup>

  <UsingTask TaskName="GenerateMaterialIconData" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <XamlFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <IconAssembly ParameterType="System.String" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Reflection" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Using Namespace="Microsoft.Build.Framework" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
var kindRx = new Regex("Kind\\s*=\\s*\"([A-Za-z0-9_]+)\"");
var commentRx = new Regex("<!--.*?-->", RegexOptions.Singleline);
var names = new SortedSet<string>(StringComparer.Ordinal);

foreach (ITaskItem item in XamlFiles)
{
    if (!File.Exists(item.ItemSpec)) continue;
    var text = commentRx.Replace(File.ReadAllText(item.ItemSpec), string.Empty);
    foreach (Match m in kindRx.Matches(text)) names.Add(m.Groups[1].Value);
}

if (names.Count == 0)
{
    Log.LogError("图标生成：在所有 XAML 里都没找到 Kind=\"...\"，扫描路径可能配错了。");
    return false;
}

if (!File.Exists(IconAssembly))
{
    Log.LogError("图标生成：找不到几何数据源 " + IconAssembly);
    return false;
}

var asm = Assembly.LoadFrom(IconAssembly);
var kindType = asm.GetType("Material.Icons.MaterialIconKind", true);
var providerType = asm.GetType("Material.Icons.MaterialIconDataProvider", true);
var instance = providerType.GetProperty("Instance", BindingFlags.Public | BindingFlags.Static).GetValue(null, null);
var getData = providerType.GetMethod("GetData", new[] { kindType });

var sb = new StringBuilder();
sb.AppendLine("// <auto-generated />");
sb.AppendLine("// 由 NegiCraftLauncher.Icons.Core.csproj 的 GenerateMaterialIconData 任务在构建时生成 —— 不要手改。");
sb.AppendLine("// 数据来源：" + Path.GetFileName(IconAssembly) + "（只取本仓库 XAML/AXAML 里实际用到的图标）。");
sb.AppendLine();
sb.AppendLine("namespace NegiCraftLauncher.Icons;");
sb.AppendLine();
sb.AppendLine("public enum MaterialIconKind");
sb.AppendLine("{");
foreach (var n in names) sb.AppendLine("    " + n + ",");
sb.AppendLine("}");
sb.AppendLine();
sb.AppendLine("// 供两端的控件读取（WPF / Avalonia 各自把字符串解析成自己的 Geometry）。");
sb.AppendLine("public static class MaterialIconData");
sb.AppendLine("{");
sb.AppendLine("    public static readonly Dictionary<MaterialIconKind, string> Paths = new()");
sb.AppendLine("    {");
foreach (var name in names)
{
    object kind;
    try { kind = Enum.Parse(kindType, name); }
    catch (ArgumentException)
    {
        Log.LogError("图标生成：Material.Icons 里没有叫 '" + name + "' 的图标，检查 XAML 里的 Kind=\"" + name + "\"。");
        continue;
    }
    var path = (string)getData.Invoke(instance, new[] { kind });
    if (string.IsNullOrWhiteSpace(path))
    {
        Log.LogError("图标生成：'" + name + "' 的几何数据是空的。");
        continue;
    }
    sb.AppendLine("        [MaterialIconKind." + name + "] = \"" + path + "\",");
}
sb.AppendLine("    };");
sb.AppendLine("}");

if (Log.HasLoggedErrors) return false;

var newText = sb.ToString();
if (File.Exists(OutputFile) && File.ReadAllText(OutputFile) == newText)
{
    Log.LogMessage(MessageImportance.Low, "图标数据无变化（" + names.Count + " 个）。");
    return true;
}

Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
File.WriteAllText(OutputFile, newText, new UTF8Encoding(false));
Log.LogMessage(MessageImportance.High, "已生成 " + names.Count + " 个图标的几何数据 -> " + OutputFile);
]]>
      </Code>
    </Task>
  </UsingTask>

  <!-- ⚠️ 挂在 BeforeCompile 而不是 CoreCompile：CoreCompile 自己有增量检查，
       被跳过时挂在它上面的 target 会一起不跑 —— 那样在别的工程里新写一个 Kind="NewIcon"
       就不会重新生成枚举，直接编译失败。BeforeCompile 是纯扩展点，每次构建都会走到。 -->
  <Target Name="GenerateMaterialIconData" BeforeTargets="BeforeCompile"
          Inputs="@(IconSourceXaml);$(MaterialIconsAssembly)"
          Outputs="$(IconDataSourceFile)">
    <GenerateMaterialIconData XamlFiles="@(IconSourceXaml)"
                              IconAssembly="$(MaterialIconsAssembly)"
                              OutputFile="$(IconDataSourceFile)" />
  </Target>

</Project>
