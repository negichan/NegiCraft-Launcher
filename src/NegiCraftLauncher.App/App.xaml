<Application x:Class="NegiCraftLauncher.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 设计 token + 自研控件样式。与 Avalonia 的 NegiCraftLauncher.Theme.Avalonia 视觉对齐，
                     但源码是两份（XAML 没有共同编译器）。 -->
                <ResourceDictionary Source="pack://application:,,,/NegiCraftLauncher.Theme;component/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
