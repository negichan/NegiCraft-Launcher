<!-- 1180x720 是**可见窗口**（Shell）的尺寸；窗口实际开到 1300x840，四周各留 60 给投影。
     Tailwind 的 shadow-lg 只溢出左右 ~12、下方 ~22，所以这 60 大部分是富余 —— 照样留着，
     缩小它只是白搬一次窗口矩形。无边框 + AllowsTransparency 的窗口没法把阴影画到自己矩形
     外面，只能把窗口开大、让 Shell 缩在里面。alpha=0 的留白是点击穿透的，不会挡住底下的窗口。 -->
<Window x:Class="NegiCraftLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NegiCraftLauncher.ViewModels;assembly=NegiCraftLauncher.ViewModels"
        xmlns:conv="clr-namespace:NegiCraftLauncher.App.Converters"
        xmlns:controls="clr-namespace:NegiCraftLauncher.App.Controls"
        xmlns:skin="clr-namespace:NegiCraftLauncher.Skin.Controls;assembly=NegiCraftLauncher.Skin"
        xmlns:pop="clr-namespace:NegiCraftLauncher.App.Controls"
        xmlns:neg="clr-namespace:NegiCraftLauncher.Theme;assembly=NegiCraftLauncher.Theme"
        xmlns:materialIcons="clr-namespace:NegiCraftLauncher.Icons;assembly=NegiCraftLauncher.Icons"
        Title="NegiCraft Launcher"
        Width="1300" Height="840"
        MinWidth="1080" MinHeight="740"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="14"
        TextElement.Foreground="#fafafa"
        AllowDrop="True"
        DragOver="OnWindowDragOver"
        DragLeave="OnWindowDragLeave"
        Drop="OnWindowDrop"
        KeyDown="OnWindowKeyDown"
        KeyUp="OnWindowKeyUp">

    <!-- ==========================================================================
         这是 src/NegiCraftLauncher.App.Avalonia/Views/MainWindow.axaml（1586 行）的 WPF 版。
         逐段对照着搬，映射规则：
           Panel                    → Grid（单格，子元素默认重叠）
           StackPanel Spacing       → neg:NegiStackPanel（见 Theme.Wpf/NegiLayout.cs）
           Grid ColumnDefinitions   → neg:NegiGrid Columns="* Auto"
           Classes="X"              → Style="{StaticResource XStyle}"
           Classes.Active/On/Current→ neg:Negi.Active / .On / .Current
           ToolTip.Tip              → ToolTip
           PlaceholderText          → neg:Negi.Placeholder
           CornerRadius（Button 等） → neg:Negi.CornerRadius（**按像素高度写具体值**，别抄 999）
           IsVisible                → Visibility + BoolToVis 转换器
           ToggleSwitch             → CheckBox（主题里重模板成开关样子）
           BoxShadow                → Effect={StaticResource Shadow*}
           $parent[Window].((vm:...)DataContext).X
                                    → {Binding DataContext.X, RelativeSource={RelativeSource AncestorType=Window}}
         ========================================================================== -->

    <Window.Resources>
        <!-- VM 只带平台中立像素（NegiCraftLauncher.Raster.PixelBuffer），转成位图是视图的事。 -->
        <conv:PixelBufferToBitmapConverter x:Key="PixelsToBitmap" />
        <!-- 只有这一扇窗用的资源留在本地；按钮、阴影、BoolToVis 那套两扇窗共用的在 App.xaml。 -->
        <conv:EqualsConverter x:Key="Equals" />
        <conv:NotNullConverter x:Key="NotNull" />
        <conv:IsNullConverter x:Key="IsNull" />

        <!-- 托盘右键菜单。WinForms 的 ContextMenuStrip 画的是系统原生外观（浅灰、9pt），
             和应用的深色主题完全对不上 —— Avalonia 侧的托盘菜单是 TrayPopupRoot，
             走的正是这套 ContextMenu / MenuItem 主题。所以这里也换成 WPF 的 ContextMenu，
             右键时由代码在光标处打开（见 SetupTrayIcon / ShowTrayMenu）。
             Tag="pet" 是给 UpdateTrayMenu 定位「桌面宠物 / 收起桌宠」那一项的锚点。 -->
        <ContextMenu x:Key="TrayMenu" x:Shared="False">
            <MenuItem Header="打开启动器" Click="OnTrayOpenLauncherClick" />
            <MenuItem Header="桌面宠物" Tag="pet" Click="OnTrayTogglePetClick" />
            <Separator />
            <MenuItem Header="退出启动器" Click="OnTrayExitClick" />
        </ContextMenu>

        <!-- ================= 样式 ================= -->

        <!-- 导航按钮：42x42，圆角 12，图标 20x20。
             侧栏是浮在背景上的一块玻璃，所以未选中的图标只能"白 + 降不透明度"——
             灰图标（#a1a1aa）压在亮壁纸上会直接消失。以前这套只在首页生效（背景也只在首页），
             现在背景贯穿所有页，OnHome 那一半条件已经并进基态。 -->
        <Style x:Key="NavBtnStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="neg:Negi.CornerRadius" Value="12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#fafafa" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid neg:ButtonMotion.Enabled="True"
                              neg:ButtonMotion.Pressed="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}"
                              neg:ButtonMotion.Hovered="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border x:Name="HoverBd" Background="#2E7F7F7F" CornerRadius="12" Opacity="0" />
                            <Border x:Name="ActiveBd" Background="#fafafa" CornerRadius="12" Opacity="0" />
                            <ContentPresenter x:Name="Content"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Opacity="0.75" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverBd"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetName="Content"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverBd"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetName="Content"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.75" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="neg:Negi.Active" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ActiveBd"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ActiveBd"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="ActiveBd" Property="Opacity" Value="1.0" />
                                <Setter Property="Foreground" Value="#18181b" />
                                <Setter TargetName="Content" Property="Opacity" Value="1.0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 首页时侧栏是磨砂透光的。
             ⚠️ 侧栏**刻意不加 Effect**（Avalonia 那边是 BoxShadow="0 10 30 -12 #B0000000"）：
             WPF 的 DropShadowEffect **没有 spread 参数**，阴影画出来是完整 60xH 矩形再模糊，
             而 Avalonia 靠 spread=-12 把阴影形状收进 12px，观感几乎不可见（实测盒外只暗 1/255）。
             更要命的是 DropShadowEffect 把阴影画在元素**背后**，侧栏是半透明（#8C0E0E12，α=0.549）
             的，自家阴影会从内部透出来把它压暗约 35%（实测 R-2 G-6 B-9，蓝通道差最大）。
             两个参数都调不平 ⇒ 干脆不加；侧栏**内部**因此与 Avalonia 逐点吻合到 ≤2/255。

             ⚠️ 但不加 Effect 会留下描边这个副作用：Avalonia 的 BoxShadow 画在描边**底下**，
             先把 1px 描边的底色压暗约 20%，所以那边同一支 #17FFFFFF 看着是偏暗的洋红线；
             WPF 的 Border 把描边直接压在父级（明亮的首页图）上 ⇒ 同色号看着明显更亮（实测 R+45）。
             ⇒ 这里把描边换成**等效色**：让 a*C + (1-a)*page 等于 0x17 白 over (page×0.8)，
               解得 a=0.2706(0x45)、C=85(0x55) —— 对任意底色都成立。
               实测 y=300/500 与 Avalonia 差 ≤4/255（改前差 44）。 -->
        <Style x:Key="SidebarStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#8C0E0E12" />
            <!-- ⚠️ 与 Avalonia 的 #17FFFFFF **不等价**（理由见上），别"顺手对齐"回去。 -->
            <Setter Property="BorderBrush" Value="#45555555" />
        </Style>

        <!-- 窗口控制按钮：32x32 方形，圆角 9 -->
        <Style x:Key="WinCtrlStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="neg:Negi.CornerRadius" Value="9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#a1a1aa" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1c1c21" />
                    <Setter Property="Foreground" Value="#fafafa" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WinCtrlCloseStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource WinCtrlStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e81123" />
                    <Setter Property="Foreground" Value="#ffffff" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 亮底变体：图标色按右上角那块背景的亮度自动换（见 MainWindow.UpdateWindowButtonTone）。
             ⚠️ 为什么是"换整套 Style"而不是给 Button 写 Foreground：
               WPF 的**本地值优先级高于样式触发器**，直接写 Foreground 会把下面的 IsMouseOver
               触发器压死，悬停就不变白了。换 Style 没有这个坑。
             ⚠️ BasedOn 不继承基类的 Style.Triggers，所以悬停那两条必须在这里重写一遍。
               悬停态自带对比度（深色胶囊 + 白字），所以两种底色下完全一样，不用跟着变。 -->
        <Style x:Key="WinCtrlLightStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource WinCtrlStyle}">
            <Setter Property="Foreground" Value="#18181b" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1c1c21" />
                    <Setter Property="Foreground" Value="#fafafa" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WinCtrlCloseLightStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource WinCtrlCloseStyle}">
            <Setter Property="Foreground" Value="#18181b" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e81123" />
                    <Setter Property="Foreground" Value="#ffffff" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Shadcn 风格按钮（BtnStyle / BtnSmStyle 及其变体）在 App.xaml ——
             背景调节窗和这扇窗共用同一套，抄两份必然有一天只改一边。 -->

        <!-- 停靠栏里的实例选择器 -->
        <Style x:Key="InstSelectStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="52" />
            <Setter Property="Padding" Value="6,0,10,0" />
            <Setter Property="neg:Negi.CornerRadius" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#297F7F7F" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 启动按钮：颜色放样式里（不放内联），否则 :pointerover 覆盖不掉 -->
        <Style x:Key="LaunchBtnStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#fafafa" />
            <Setter Property="Foreground" Value="#18181b" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#ffffff" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 弹层留在树里（靠透明 + 不吃点击隐藏），因为切 Visibility 会把它踢出布局。
             开合的全部动效由 Controls/Pop.cs 接管，含透明度。 -->
        <Style x:Key="PopoverStyle" TargetType="{x:Type FrameworkElement}">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <!-- 音量浮层只做淡入和位移，不用菜单的缩放回弹。
             淡入 130ms + 从按钮底下滑出 6px（180ms ease-out），关掉时 100ms 原路收回。
             命中从一开始就可用，悬停轮询不需要等待动画结束。
             ⚠️ `RenderTransform` 写在元素自己身上而不是这个 Style 里：样式 setter 里的
               `Freezable` 有被冻结的风险，冻住就动不了了。 -->
        <Style x:Key="VolumePopStyle" TargetType="{x:Type Border}">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVolumePopOpen}" Value="True">
                    <Setter Property="IsHitTestVisible" Value="True" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.13" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="0" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.1" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="-6" Duration="0:0:0.1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 页面仅在过渡期间缓存；结束后恢复文字的正常渲染。 -->
        <Style x:Key="PageAnimStyle" TargetType="{x:Type Grid}">
            <Setter Property="controls:PageTransition.Enabled" Value="True" />
        </Style>

        <!-- ============ 竖排音量条（喇叭底下那条）============
             布局照音乐软件那种：一条细轨道，已过部分是实心的、未过部分是暗的，
             小圆钮压在分界处，下面是百分比。
             ⚠️ 配色**用项目自己的 token**（PrimaryBrush / MutedBrush），不要照抄参考图里的红 ——
               参考图只是拿来说明"布局长什么样"，颜色得跟本项目的深色 zinc 主题走。
             ⚠️ 轨道用 RepeatButton 的**模板里再放一条细 Border** 来画，而不是直接给
               RepeatButton 上色 —— 那样看着只有中间 5px 有颜色，直接上色会变成一根
               24px 宽的实心柱子。命中区域不受这根细条限制：模板根那层透明 Grid 把
               整列 24px 都算"按到了"，跳值由 OnVolumeBarMouseDown 现算（见 VolumeSliderStyle）。
             ⚠️ 竖直 Track **不能**写 IsDirectionReversed="True"：实测那样反而是
               "0 在顶上、100 在底下"，而且 DecreaseRepeatButton（实心那半）跑到上面，
               成了"音量越小上面越白"。不写（默认 False）才是 0 在下、往上长。
               实测方法：v=40 时量轨道上圆钮中心，应落在自下往上 40% 处。 -->
        <Style x:Key="VolumeBarStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Width="5" CornerRadius="2.5"
                                Background="{TemplateBinding Background}"
                                HorizontalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VolumeFillStyle" TargetType="{x:Type RepeatButton}" BasedOn="{StaticResource VolumeBarStyle}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        </Style>
        <Style x:Key="VolumeRestStyle" TargetType="{x:Type RepeatButton}" BasedOn="{StaticResource VolumeBarStyle}">
            <!-- 未过那半必须是**看得见**的一条。先后试过 MutedBrush（文字用的灰）和 26% 白，
                 在 #111114 的底上都几乎隐形 —— 35% 的截图里上半段整条消失，看着像只有下半截。
                 用描边同款 #26262b：刚好读得出"还有轨道"，又不跟实心抢戏。 -->
            <Setter Property="Background" Value="#26262b" />
        </Style>
        <Style x:Key="VolumeThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <!-- 钮和实心那半同色（都是 PrimaryBrush = 白），所以得靠一圈底色把它从条里
                             "抠"出来 —— 2px 描边时两者糊成一个葫芦形，看不出钮在哪。3px 才分得开。
                             描边色要跟浮层底（#111114）一致 —— 之前用的是 CardBackgroundBrush，
                             比浮层底浅，钮看着像戴了个灰环。 -->
                        <Ellipse Width="13" Height="13"
                                 Fill="{DynamicResource PrimaryBrush}"
                                 Stroke="#111114"
                                 StrokeThickness="3" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VolumeSliderStyle" TargetType="{x:Type Slider}">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="TickFrequency" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <!-- 整幅背景透明但**可命中**：点条上任何一处（不只中间那 5px）都落到这层，
                             再由 Slider 上的 PreviewMouseLeftButtonDown 换成值。
                             ⚠️ WPF 的 Track **没有** IsMoveToPointEnabled（那是 Avalonia/WinUI 上的属性），
                             而这两根 RepeatButton 也没绑 LargeChange 命令 —— 不自己接事件，点轨道就是没反应。 -->
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track"
                                   Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource VolumeFillStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource VolumeRestStyle}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource VolumeThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 实例卡片 -->
        <Style x:Key="InstCardStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <!-- 四边不等宽，照设计稿那两条 padding 来：上块 13/12/10/14、下条 0/12/12/14
                 （左 14 右 12 上 13 下 12），中间那 10 写在卡里的行间距上。 -->
            <Setter Property="Padding" Value="14,13,12,12" />
            <Setter Property="neg:Negi.CornerRadius" Value="14" />
            <Setter Property="Background" Value="#111114" />
            <Setter Property="BorderBrush" Value="#26262b" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <!-- 纵向也是 Stretch：UniformGrid 把格子拉成等高，卡片内容得跟着填满，
                 底行那句「最近游玩」才贴得到卡底。 -->
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#52525b" />
                </Trigger>
                <!-- 当前实例不再靠一颗「当前」胶囊表示，整张卡的底色就是那个意思（稿子改的）：
                     muted 底 + 半透明白描边，白描边压在 #27272a 上比 #fafafa 那圈柔和，
                     也不会和右下角那颗实心启动键抢焦点。 -->
                <Trigger Property="neg:Negi.Current" Value="True">
                    <Setter Property="Background" Value="#27272a" />
                    <Setter Property="BorderBrush" Value="#24FFFFFF" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="neg:Negi.Current" Value="True" />
                        <Condition Property="IsMouseOver" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="#3DFFFFFF" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <!-- 分段切换按钮：高 28、圆角 7 -->
        <Style x:Key="SegmentBtnStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="neg:Negi.CornerRadius" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#a1a1aa" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#fafafa" />
                </Trigger>
                <Trigger Property="neg:Negi.On" Value="True">
                    <Setter Property="Background" Value="#111114" />
                    <Setter Property="Foreground" Value="#fafafa" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 设置页左侧导航 -->
        <Style x:Key="SetNavBtnStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="neg:Negi.CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#a1a1aa" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1c1c21" />
                    <Setter Property="Foreground" Value="#fafafa" />
                </Trigger>
                <Trigger Property="neg:Negi.On" Value="True">
                    <Setter Property="Background" Value="#353539" />
                    <Setter Property="Foreground" Value="#fafafa" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 实例配置对话框左侧 Tab 导航按钮 -->
        <Style x:Key="InstNavBtnStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="neg:Negi.CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#a1a1aa" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1c1c21" />
                    <Setter Property="Foreground" Value="#fafafa" />
                </Trigger>
                <Trigger Property="neg:Negi.On" Value="True">
                    <Setter Property="Background" Value="#27272a" />
                    <Setter Property="Foreground" Value="#fafafa" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 弹层里的一行（Avalonia 的 Button.MenuItem） -->
        <Style x:Key="MenuRowStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8" />
            <Setter Property="neg:Negi.CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1c1c21" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 小图标按钮 -->
        <Style x:Key="IconBtnStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="neg:Negi.CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#27272a" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IconBtnDangerStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource IconBtnStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3f1218" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 实例卡上的 tag（版本 / 加载器 / 模组数）。稿子改成了"有底的胶囊"：
             半透明白底 + 更亮一档的描边，压在卡片底色上才分得出层；圆角按稿子的 6 而不是半高，
             所以它不是药丸而是圆角方块。当前卡的那一份要再亮一档，用 IsCurrent 的数据触发。 -->
        <Style x:Key="TagPillStyle" TargetType="{x:Type Border}">
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#0DFFFFFF" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Background" Value="#1FFFFFFF" />
                    <Setter Property="BorderBrush" Value="#38FFFFFF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TagTextStyle" TargetType="{x:Type TextBlock}">
            <!-- 稿子 .inst .badge{font-size:11.5px} -->
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#a1a1aa" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Foreground" Value="#fafafa" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 工具条上的 chip（排序）。选中态刻意用"卡底 + 描边"而不是只换字色：
             dark 下 accent 与 tabs 同值，靠底色分选中会和 hover 糊在一起（设置页导航就栽过）。 -->
        <Style x:Key="ChipStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="10,0" />
            <!-- ⚠️ 圆角写"半个高"，不能写 999：CSS 和 Avalonia 会把过大的圆角按**每个轴各自**夹住，
                 于是 999 就是胶囊；WPF 不是 —— 它把 X/Y **一起等比缩小**到放得下，52x22 的框就变成
                 rx=26 / ry=11 的**真椭圆**。所以凡是要药丸形的都得按各自高度写死半径。 -->
            <Setter Property="neg:Negi.CornerRadius" Value="13" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#a1a1aa" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#fafafa" />
                </Trigger>
                <Trigger Property="neg:Negi.On" Value="True">
                    <Setter Property="Background" Value="#111114" />
                    <Setter Property="BorderBrush" Value="#26262b" />
                    <Setter Property="Foreground" Value="#fafafa" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 排序那两项：分段控件里的一段，和右下角「网格 / 列表」同一套语言（容器 muted、
             选中那段是卡底）。以前是两颗没有底的 chip —— 字直接压在壁纸上，亮壁纸上 #a1a1aa
             糊得看不见，试过按背景亮度换档都压不住（视频壁纸每帧都在阈值上下抖）。
             给它们一个自己的底才是解法：对比度来自容器，不吃壁纸，也就不需要亮度自适应了。 -->
        <Style x:Key="SortTabStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <!-- 圆角写半个高，不写 999：WPF 会把 X/Y 一起等比缩，28 高的框写 999 会变成真椭圆。 -->
            <Setter Property="neg:Negi.CornerRadius" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#a1a1aa" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#fafafa" />
                </Trigger>
                <Trigger Property="neg:Negi.On" Value="True">
                    <Setter Property="Background" Value="#111114" />
                    <Setter Property="Foreground" Value="#fafafa" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 摆在卡片底（#111114）上的 chip：ChipStyle 的选中态是"卡底 + 描边"，
             放到同为卡底的对话框里就等于没选中，所以这里改成 muted 底 + 亮一档描边。 -->
        <Style x:Key="PickChipStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ChipStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#fafafa" />
                </Trigger>
                <Trigger Property="neg:Negi.On" Value="True">
                    <Setter Property="Background" Value="#27272a" />
                    <Setter Property="BorderBrush" Value="#3f3f46" />
                    <Setter Property="Foreground" Value="#fafafa" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 危险动作的文字按钮（配置弹窗里的「删除实例」）。描边和字都往红上偏一档，
             但不做实心红 —— 实心红在一堆中性按钮里太吵，反而降低点击的谨慎度。 -->
        <Style x:Key="BtnSmDangerStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource BtnSmOutlineStyle}">
            <Setter Property="Foreground" Value="#f87171" />
            <Setter Property="BorderBrush" Value="#3f1218" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3f1218" />
                    <Setter Property="BorderBrush" Value="#5b1a22" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 实心红的动作键（关闭询问窗里的「直接退出」）。和上面那条分开的理由相反：
             这里它是三选一里唯一"做了就收不回来"的那颗，就该吵。
             底色取 #b3261e 而不是纯红：#111114 这张卡上纯红会发飘，压一档才和 zinc 系配得上。 -->
        <Style x:Key="BtnSmDangerFillStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource BtnSmStyle}">
            <Setter Property="Background" Value="#b3261e" />
            <Setter Property="Foreground" Value="#fafafa" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#c8352c" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 真·勾选框。主题给 CheckBox 画的是开关（设置页那些开关就是它），但"不再询问"
             这种一次性确认勾，语义上是勾选不是切换，所以在这里另画一颗 16 的方框。 -->
        <Style x:Key="CheckTickStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Background="Transparent">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="5"
                                    Background="#1c1c21" BorderBrush="#26262b" BorderThickness="1">
                                <materialIcons:MaterialIcon x:Name="Tick" Kind="Check" Width="12" Height="12"
                                                            Foreground="#18181b" Visibility="Collapsed"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#fafafa" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#fafafa" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <!-- 勾选态已经是实心白，hover 再描一圈灰就脏了，所以只管未勾选的那半。 -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#52525b" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 配置弹窗左侧的 tab。和设置页那条 SetNavBtnStyle 分开写：
             那条的 hover 与选中都是 #1c1c21（dark 下 accent 与 tabs 同值），选中态等于不存在。
             这里选中改用 #27272a + 加粗，hover 留 #1c1c21，两者分得开。 -->
        <Style x:Key="CfgNavBtnStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <!-- 稿子 .cfg nav button{height:36; border-radius:9; font-size:13} -->
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="neg:Negi.CornerRadius" Value="9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#a1a1aa" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1c1c21" />
                    <Setter Property="Foreground" Value="#fafafa" />
                </Trigger>
                <Trigger Property="neg:Negi.On" Value="True">
                    <!-- 选中那格与右侧内容同底（#111114），看起来像从轨道里"通"进了内容区 —— 稿子就是这么画的。
                         这里不用 muted：整张弹窗的底色就是 muted 那一档，再亮一档反而糊不出层次。 -->
                    <Setter Property="Background" Value="#111114" />
                    <Setter Property="Foreground" Value="#fafafa" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 右下角悬浮「新建」：高 36、半圆角 18、紧凑现代药丸设计 -->
        <Style x:Key="FabStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource BtnSmPrimaryStyle}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="neg:Negi.CornerRadius" Value="18" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Effect" Value="{StaticResource ShadowLg}" />
        </Style>

        <!-- 卡片底行那颗「启动」：当前实例是主色实心，其余是灰图标。
             刻意不从 IconBtnStyle 派生 —— 它那条 IsMouseOver 触发器会和"当前=白底"打架，
             这里把四种组合按顺序写全。 -->
        <Style x:Key="CardPlayStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <!-- Padding 必须显式清 0：基样式那条 16,0 会让 28 宽的按钮剩不下内容区，
                 而模板的 Border 是 ClipToBounds=True —— 于是三角被整颗裁掉，不报错。 -->
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="neg:Negi.CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#27272a" />
            <Setter Property="Background" Value="#18181b" />
            <Setter Property="Foreground" Value="#a1a1aa" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Background" Value="#fafafa" />
                    <Setter Property="Foreground" Value="#18181b" />
                    <Setter Property="BorderThickness" Value="0" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsCurrent}" Value="True" />
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#e4e4e7" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsCurrent}" Value="False" />
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#27272a" />
                    <Setter Property="BorderBrush" Value="#3f3f46" />
                    <Setter Property="Foreground" Value="#fafafa" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 工具条「当前目录」按钮：32 高、8 圆角、卡底 + 描边，点开时保持 hover 那副样子，
             浮层开着时一眼能看出是谁把它叫出来的。 -->
        <Style x:Key="FolderPillStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0,8,0" />
            <Setter Property="neg:Negi.CornerRadius" Value="8" />
            <Setter Property="Background" Value="#111114" />
            <Setter Property="BorderBrush" Value="#26262b" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#fafafa" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1c1c21" />
                    <Setter Property="BorderBrush" Value="#52525b" />
                </Trigger>
                <Trigger Property="neg:Negi.On" Value="True">
                    <Setter Property="Background" Value="#1c1c21" />
                    <Setter Property="BorderBrush" Value="#52525b" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 目录浮层里的一行。选中态用 muted（#27272a）而不是 accent：dark 下 accent 与 hover
             同值，靠底色分不出"这就是当前目录"。 -->
        <Style x:Key="FolderRowStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <!-- 稿子 .folder-pop-item{padding:7px 10px}：左右 10、上下 7。 -->
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="neg:Negi.CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1c1c21" />
                </Trigger>
                <Trigger Property="neg:Negi.On" Value="True">
                    <Setter Property="Background" Value="#27272a" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 视图切换那对小方钮（网格 / 列表）。选中态是"卡底 + 字亮"，
             容器自己有 muted 底 + 2 的内边距，所以选中那块看着像从槽里浮起来。 -->
        <Style x:Key="ViewBtnStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="neg:Negi.CornerRadius" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1c1c21" />
                </Trigger>
                <Trigger Property="neg:Negi.On" Value="True">
                    <Setter Property="Background" Value="#111114" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 列表模式的一行：54 高、圆角 12，一整行可点（点=设为当前），右侧三颗图标按钮各有自己的事。
             当前行的底色与描边和卡片模式同一套语言，两种看法之间不用重新学。 -->
        <Style x:Key="InstRowStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="54" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="neg:Negi.CornerRadius" Value="12" />
            <Setter Property="Background" Value="#111114" />
            <Setter Property="BorderBrush" Value="#26262b" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1c1c21" />
                    <Setter Property="BorderBrush" Value="#52525b" />
                </Trigger>
                <Trigger Property="neg:Negi.Current" Value="True">
                    <Setter Property="Background" Value="#27272a" />
                    <Setter Property="BorderBrush" Value="#24FFFFFF" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="neg:Negi.Current" Value="True" />
                        <Condition Property="IsMouseOver" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="#3DFFFFFF" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <!-- 一行下载任务，弹层与设置里的「下载中心」共用。
             行内的按钮要够到窗口级 VM，因为行自己的类型是 DownloadTaskModel。

             **必须放在所有样式之后。** `DataTemplate` 里的 `StaticResource` 是在**模板被
             实例化时**、按模板在文档里的位置解析的 —— 解析时能看到的只有它**之前**已经登记的
             条目（同一份字典里 `BoolToVis` 在前面所以一直没事）。模板原来放在文件顶部，
             而它引用的 `BtnSmOutlineStyle` 定义在后面 ⇒ 第一次真的出现下载行时抛
             `XamlParseException: 无法找到名为"BtnSmOutlineStyle"的资源`，未处理异常直接杀进程。
             因为空列表不实例化模板，像素回归只截空态，一直没暴露 —— 是 `demo` 动词先踩到的。 -->
        <DataTemplate x:Key="DownloadRowTemplate">
            <Border BorderBrush="#26262b" BorderThickness="0,0,0,1" Padding="12,10">
                <neg:NegiStackPanel Spacing="8">
                    <neg:NegiGrid Columns="* Auto">
                        <neg:NegiStackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"
                                       Foreground="#fafafa" TextTrimming="CharacterEllipsis" />
                            <neg:NegiStackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#a1a1aa" />
                                <TextBlock Text="{Binding PercentText}" FontSize="12" Foreground="#71717a" />
                            </neg:NegiStackPanel>
                        </neg:NegiStackPanel>
                        <neg:NegiStackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Style="{StaticResource BtnSmOutlineStyle}" Content="暂停" Height="26" FontSize="12" Padding="10,0"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.PauseDownloadTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding .}" />
                            <Button Style="{StaticResource BtnSmOutlineStyle}" Content="取消" Height="26" FontSize="12" Padding="10,0"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.CancelDownloadTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding .}" />
                            <Button Style="{StaticResource BtnSmOutlineStyle}" Content="继续" Height="26" FontSize="12" Padding="10,0"
                                    Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.ResumeDownloadTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding .}" />
                        </neg:NegiStackPanel>
                    </neg:NegiGrid>
                    <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4"
                                 neg:Negi.CornerRadius="2" Foreground="#fafafa" Background="#26262b" />
                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="#71717a"
                               TextTrimming="CharacterEllipsis" />
                </neg:NegiStackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="SettingsNavTemplate">
            <neg:NegiStackPanel Spacing="4">
                <Button Style="{StaticResource SetNavBtnStyle}" Content="游戏"
                        neg:Negi.On="{Binding CurrentSettingsTab, Converter={StaticResource Equals}, ConverterParameter=游戏}"
                        Command="{Binding SelectSettingsTabCommand}" CommandParameter="游戏" />
                <Button Style="{StaticResource SetNavBtnStyle}" Content="Java"
                        neg:Negi.On="{Binding CurrentSettingsTab, Converter={StaticResource Equals}, ConverterParameter=Java}"
                        Command="{Binding SelectSettingsTabCommand}" CommandParameter="Java" />
                <Button Style="{StaticResource SetNavBtnStyle}" Content="下载"
                        neg:Negi.On="{Binding CurrentSettingsTab, Converter={StaticResource Equals}, ConverterParameter=下载}"
                        Command="{Binding SelectSettingsTabCommand}" CommandParameter="下载" />
                <Button Style="{StaticResource SetNavBtnStyle}" Content="外观"
                        neg:Negi.On="{Binding CurrentSettingsTab, Converter={StaticResource Equals}, ConverterParameter=外观}"
                        Command="{Binding SelectSettingsTabCommand}" CommandParameter="外观" />
                <Button Style="{StaticResource SetNavBtnStyle}" Content="桌宠"
                        neg:Negi.On="{Binding CurrentSettingsTab, Converter={StaticResource Equals}, ConverterParameter=桌宠}"
                        Command="{Binding SelectSettingsTabCommand}" CommandParameter="桌宠" />
                <Button Style="{StaticResource SetNavBtnStyle}" Content="关于"
                        neg:Negi.On="{Binding CurrentSettingsTab, Converter={StaticResource Equals}, ConverterParameter=关于}"
                        Command="{Binding SelectSettingsTabCommand}" CommandParameter="关于" />
            </neg:NegiStackPanel>
        </DataTemplate>
        <DataTemplate x:Key="SettingsCardsTemplate">
            <Grid VerticalAlignment="Top" Margin="0,0,6,0">

                <!-- 游戏 -->
                <Border Background="#111114" BorderBrush="#26262b" BorderThickness="1" CornerRadius="8" Padding="18,0"
                        Visibility="{Binding CurrentSettingsTab, Converter={StaticResource Equals}, ConverterParameter=游戏}">
                    <neg:NegiStackPanel>
                        <Border MinHeight="76" Padding="0,14" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                            <neg:NegiGrid Columns="* Auto">
                                <neg:NegiStackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="最大内存" FontWeight="Medium" Foreground="#fafafa" />
                                    <TextBlock Text="分配给游戏的堆内存，建议不超过物理内存的一半。"
                                               FontSize="12" Foreground="#a0a0a8" TextWrapping="Wrap" Margin="0,0,16,0" />
                                </neg:NegiStackPanel>
                                <neg:NegiStackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Width="244" VerticalAlignment="Center">
                                    <Slider Value="{Binding MaxMemoryGb}" Minimum="1" Maximum="32" Width="174" />
                                    <TextBlock Text="{Binding MaxMemoryGb, StringFormat='{}{0} GB'}"
                                               Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                               Foreground="#fafafa" />
                                </neg:NegiStackPanel>
                            </neg:NegiGrid>
                        </Border>

                        <Border MinHeight="76" Padding="0,14" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                            <neg:NegiGrid Columns="* Auto">
                                <neg:NegiStackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="版本隔离" FontWeight="Medium" Foreground="#fafafa" />
                                    <TextBlock Text="每个实例有独立的存档、Mod 和配置文件。"
                                               FontSize="12" Foreground="#a0a0a8" TextWrapping="Wrap" Margin="0,0,16,0" />
                                </neg:NegiStackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding VersionIsolation}" />
                            </neg:NegiGrid>
                        </Border>

                        <Border MinHeight="76" Padding="0,14" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                            <neg:NegiGrid Columns="* Auto">
                                <neg:NegiStackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="启动后隐藏启动器" FontWeight="Medium" Foreground="#fafafa" />
                                    <TextBlock Text="游戏退出后会自动恢复。" FontSize="12" Foreground="#a0a0a8" />
                                </neg:NegiStackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding HideOnLaunch}" />
                            </neg:NegiGrid>
                        </Border>

                        <Border MinHeight="76" Padding="0,14" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                            <neg:NegiGrid Columns="* Auto">
                                <neg:NegiStackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="关闭窗口时" FontWeight="Medium" Foreground="#fafafa" />
                                    <TextBlock Text="关闭窗口时的默认行为。" FontSize="12" Foreground="#a0a0a8" TextWrapping="Wrap" Margin="0,0,16,0" />
                                </neg:NegiStackPanel>
                                <Border Grid.Column="1" Background="#1c1c21" CornerRadius="10" Padding="3" VerticalAlignment="Center">
                                    <neg:NegiStackPanel Orientation="Horizontal" Spacing="2">
                                        <Button Style="{StaticResource SegmentBtnStyle}" Content="每次询问"
                                                neg:Negi.On="{Binding CloseWindowBehavior, Converter={StaticResource Equals}, ConverterParameter=ask}"
                                                Command="{Binding SetCloseWindowBehaviorCommand}" CommandParameter="ask" />
                                        <Button Style="{StaticResource SegmentBtnStyle}" Content="收进托盘"
                                                neg:Negi.On="{Binding CloseWindowBehavior, Converter={StaticResource Equals}, ConverterParameter=tray}"
                                                Command="{Binding SetCloseWindowBehaviorCommand}" CommandParameter="tray" />
                                        <Button Style="{StaticResource SegmentBtnStyle}" Content="直接退出"
                                                neg:Negi.On="{Binding CloseWindowBehavior, Converter={StaticResource Equals}, ConverterParameter=exit}"
                                                Command="{Binding SetCloseWindowBehaviorCommand}" CommandParameter="exit" />
                                    </neg:NegiStackPanel>
                                </Border>
                            </neg:NegiGrid>
                        </Border>

                        <Border MinHeight="76" Padding="0,14">
                            <neg:NegiGrid Columns="* Auto">
                                <neg:NegiStackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Text="游戏目录" FontWeight="Medium" Foreground="#fafafa" />
                                    <TextBlock Text="{Binding GameRoot}" FontSize="12" Foreground="#a0a0a8"
                                               TextTrimming="CharacterEllipsis" />
                                </neg:NegiStackPanel>
                                <Button Grid.Column="1" Style="{StaticResource BtnSmOutlineStyle}" VerticalAlignment="Center"
                                        Command="{Binding OpenGameRootCommand}">
                                    <neg:NegiStackPanel Orientation="Horizontal" Spacing="6">
                                        <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="14" Height="14" />
                                        <TextBlock Text="打开" VerticalAlignment="Center" />
                                    </neg:NegiStackPanel>
                                </Button>
                            </neg:NegiGrid>
                        </Border>
                    </neg:NegiStackPanel>
                </Border>

                <!-- Java -->
                <Border Background="#111114" BorderBrush="#26262b" BorderThickness="1" CornerRadius="8" Padding="18,0"
                        Visibility="{Binding CurrentSettingsTab, Converter={StaticResource Equals}, ConverterParameter=Java}">
                    <neg:NegiStackPanel>
                        <Border MinHeight="76" Padding="0,14" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                            <neg:NegiGrid Columns="* Auto">
                                <neg:NegiStackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Java 运行时" FontWeight="Medium" Foreground="#fafafa" />
                                    <TextBlock Text="自动模式按游戏版本选择合适的 Java。" FontSize="12" Foreground="#a0a0a8" TextWrapping="Wrap" Margin="0,0,16,0" />
                                </neg:NegiStackPanel>
                                <Button Grid.Column="1" Style="{StaticResource BtnSmOutlineStyle}" Width="240"
                                        HorizontalContentAlignment="Stretch"
                                        Command="{Binding ToggleJavaChooserCommand}">
                                    <neg:NegiGrid Columns="* Auto">
                                        <TextBlock Text="{Binding JavaLabel}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <materialIcons:MaterialIcon Grid.Column="1" Kind="ChevronDown"
                                                                    Width="14" Height="14" Foreground="#a0a0a8" />
                                    </neg:NegiGrid>
                                </Button>
                            </neg:NegiGrid>
                        </Border>

                        <Border Padding="0,8" Visibility="{Binding IsJavaChooserOpen, Converter={StaticResource BoolToVis}}">
                            <neg:NegiStackPanel Spacing="2">
                                <ItemsControl ItemsSource="{Binding JavaOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource MenuRowStyle}"
                                                    Command="{Binding DataContext.SelectJavaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding .}">
                                                <neg:NegiGrid Columns="* Auto">
                                                    <TextBlock Text="{Binding Label}" FontSize="13" Foreground="#fafafa"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <materialIcons:MaterialIcon Grid.Column="1" Kind="Check" Width="16" Height="16"
                                                                                Foreground="#fafafa"
                                                                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                                </neg:NegiGrid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Style="{StaticResource MenuRowStyle}" Click="OnPickJavaClick">
                                    <neg:NegiStackPanel Orientation="Horizontal" Spacing="10">
                                        <materialIcons:MaterialIcon Kind="FolderSearchOutline" Width="18" Height="18"
                                                                    Foreground="#a1a1aa" Margin="7,0" />
                                        <TextBlock Text="浏览 javaw.exe…" FontSize="13" Foreground="#fafafa" VerticalAlignment="Center" />
                                    </neg:NegiStackPanel>
                                </Button>
                            </neg:NegiStackPanel>
                        </Border>

                        <Border MinHeight="76" Padding="0,14">
                            <TextBlock Text="缺少合适的 Java 时，启动会失败并提示需要的版本。"
                                       FontSize="12" Foreground="#a0a0a8" VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </Border>
                    </neg:NegiStackPanel>
                </Border>

                <!-- 下载 -->
                <Border Background="#111114" BorderBrush="#26262b" BorderThickness="1" CornerRadius="8" Padding="18,0"
                        Visibility="{Binding CurrentSettingsTab, Converter={StaticResource Equals}, ConverterParameter=下载}">
                    <neg:NegiStackPanel>
                        <Border MinHeight="76" Padding="0,14" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                            <neg:NegiGrid Columns="* Auto">
                                <TextBlock Text="下载源" FontWeight="Medium" VerticalAlignment="Center" Foreground="#fafafa" />
                                <Border Grid.Column="1" Background="#1c1c21" CornerRadius="10" Padding="3">
                                    <neg:NegiStackPanel Orientation="Horizontal" Spacing="2">
                                        <Button Style="{StaticResource SegmentBtnStyle}" Content="官方"
                                                neg:Negi.On="{Binding DownloadSource, Converter={StaticResource Equals}, ConverterParameter=官方}"
                                                Command="{Binding SetDownloadSourceCommand}" CommandParameter="官方" />
                                        <Button Style="{StaticResource SegmentBtnStyle}" Content="BMCLAPI"
                                                neg:Negi.On="{Binding DownloadSource, Converter={StaticResource Equals}, ConverterParameter=BMCLAPI}"
                                                Command="{Binding SetDownloadSourceCommand}" CommandParameter="BMCLAPI" />
                                        <Button Style="{StaticResource SegmentBtnStyle}" Content="自动"
                                                neg:Negi.On="{Binding DownloadSource, Converter={StaticResource Equals}, ConverterParameter=自动}"
                                                Command="{Binding SetDownloadSourceCommand}" CommandParameter="自动" />
                                    </neg:NegiStackPanel>
                                </Border>
                            </neg:NegiGrid>
                        </Border>

                        <!-- BMCLAPI 的条款要求凡提供镜像处都要署名赞助方，所以这行常驻。 -->
                        <Border Padding="0,14" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                            <neg:NegiStackPanel Spacing="6">
                                <TextBlock Text="{Binding SourceHint}" FontSize="12" Foreground="#a0a0a8"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="BMCLAPI 由 bangbang93 赞助提供。" FontSize="12"
                                           Foreground="#a0a0a8" TextWrapping="Wrap" />
                            </neg:NegiStackPanel>
                        </Border>

                        <Border MinHeight="76" Padding="0,14" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                            <neg:NegiGrid Columns="* Auto">
                                <neg:NegiStackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="下载线程" FontWeight="Medium" Foreground="#fafafa" />
                                    <TextBlock Text="同时下载的连接数，大文件会拆成多段并行。"
                                               FontSize="12" Foreground="#a0a0a8" TextWrapping="Wrap" Margin="0,0,16,0" />
                                </neg:NegiStackPanel>
                                <neg:NegiStackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Width="244" VerticalAlignment="Center">
                                    <Slider Value="{Binding DownloadThreads}" Minimum="1" Maximum="64" Width="174" />
                                    <TextBlock Text="{Binding DownloadThreads, StringFormat='{}{0}'}"
                                               Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                               Foreground="#fafafa" />
                                </neg:NegiStackPanel>
                            </neg:NegiGrid>
                        </Border>

                        <Border Padding="0,16,0,18">
                            <neg:NegiStackPanel Spacing="10">
                                <neg:NegiGrid Columns="* Auto">
                                    <TextBlock Text="下载中心" FontWeight="Medium" Foreground="#fafafa"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Style="{StaticResource BtnSmOutlineStyle}" Content="清除已完成"
                                            Command="{Binding ClearDownloadsCommand}" />
                                </neg:NegiGrid>
                                <Border BorderBrush="#26262b" BorderThickness="1" CornerRadius="10"
                                        ClipToBounds="True" Visibility="{Binding HasDownloads, Converter={StaticResource BoolToVis}}">
                                    <ScrollViewer MaxHeight="320">
                                        <ItemsControl ItemsSource="{Binding Downloads}"
                                                      ItemTemplate="{StaticResource DownloadRowTemplate}" />
                                    </ScrollViewer>
                                </Border>
                                <TextBlock Text="暂无下载任务" Visibility="{Binding HasDownloads, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                           FontSize="13" Foreground="#a0a0a8"
                                           HorizontalAlignment="Center" Margin="0,16,0,16" />
                            </neg:NegiStackPanel>
                        </Border>
                    </neg:NegiStackPanel>
                </Border>

                <!-- 外观 -->
                <Border Background="#111114" BorderBrush="#26262b" BorderThickness="1" CornerRadius="8" Padding="18,0"
                        Visibility="{Binding CurrentSettingsTab, Converter={StaticResource Equals}, ConverterParameter=外观}">
                    <neg:NegiStackPanel>
                        <Border MinHeight="76" Padding="0,14" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                            <neg:NegiGrid Columns="* Auto">
                                <TextBlock Text="主题" FontWeight="Medium" VerticalAlignment="Center" Foreground="#fafafa" />
                                <Button Grid.Column="1" Style="{StaticResource BtnSmOutlineStyle}" Command="{Binding ToggleThemeCommand}">
                                    <neg:NegiStackPanel Orientation="Horizontal" Spacing="6">
                                        <materialIcons:MaterialIcon Kind="WeatherSunny" Width="14" Height="14" />
                                        <TextBlock Text="切换深浅色" VerticalAlignment="Center" />
                                    </neg:NegiStackPanel>
                                </Button>
                            </neg:NegiGrid>
                        </Border>

                        <Border MinHeight="76" Padding="0,14" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                            <neg:NegiGrid Columns="* Auto">
                                <neg:NegiStackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Text="首页 3D 模型" FontWeight="Medium" Foreground="#fafafa" />
                                    <TextBlock Text="左键拖它的位置（会记住），右键转角度。关掉它会把拖过的位置一起清掉，重开回到默认站位。"
                                               FontSize="12" Foreground="#a0a0a8" TextWrapping="Wrap" />
                                </neg:NegiStackPanel>
                                <neg:NegiStackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <!-- 只清位置、不动开关：拖乱了想回原点，不该顺手把模型也关掉 -->
                                    <Button Style="{StaticResource BtnSmOutlineStyle}" Content="复位位置"
                                            Command="{Binding ResetHomeSkinModelPositionCommand}"
                                            Visibility="{Binding HasHomeSkinModelPosition, Converter={StaticResource BoolToVis}}" />
                                    <CheckBox IsChecked="{Binding HomeSkinModelVisible}" />
                                </neg:NegiStackPanel>
                            </neg:NegiGrid>
                        </Border>

                        <Border MinHeight="76" Padding="0,14">
                            <neg:NegiStackPanel Spacing="12">
                                <TextBlock Text="背景" FontWeight="Medium" VerticalAlignment="Center" Foreground="#fafafa" />
                                <WrapPanel>
                                    <!-- 当前背景，一眼能认出选的是哪张 -->
                                    <Border Width="52" Height="34" CornerRadius="8" ClipToBounds="True" Margin="0,0,8,8"
                                            BorderBrush="#26262b" BorderThickness="1"
                                            Visibility="{Binding IsCustomBackground, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <!-- 缩略位不参与取景：50x32 上裁切差看不出东西，
                                                 绑尺寸反而多一条布局依赖。 -->
                                            <Image Source="{Binding BgCustomArt, Converter={StaticResource PixelsToBitmap}}"
                                                   Stretch="UniformToFill" />
                                            <Border Background="#ffffff" Opacity="{Binding BgLightOpacity}" />
                                            <Border Background="#000000" Opacity="{Binding BgDarkOpacity}" />
                                        </Grid>
                                    </Border>
                                    <!-- 视频壁纸的缩略位：不另开一个播放器去抽首帧（那要多一份解码），
                                         只放个胶片图标表示"这里挂的是视频"。 -->
                                    <Border Width="52" Height="34" CornerRadius="8" Margin="0,0,8,8"
                                            Background="#18181b" BorderBrush="#26262b" BorderThickness="1"
                                            Visibility="{Binding IsVideoBackground, Converter={StaticResource BoolToVis}}">
                                        <materialIcons:MaterialIcon Kind="VideoFilm" Width="18" Height="18"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                    Foreground="#a1a1aa" />
                                    </Border>
                                    <Button Style="{StaticResource BtnSmOutlineStyle}" Content="调整" Margin="0,0,8,8"
                                            Command="{Binding OpenBgTuningCommand}"
                                            Visibility="{Binding HasCustomBackground, Converter={StaticResource BoolToVis}}" />
                                    <!-- 这颗是"换回默认壁纸"（连背景一起清掉）。
                                         调节窗里那颗同名的只归零参数、不动壁纸 —— 两件事，
                                         所以文案必须分开写清楚。 -->
                                    <Button Style="{StaticResource BtnSmOutlineStyle}" Content="恢复默认壁纸" Margin="0,0,8,8"
                                            Command="{Binding ResetBackgroundCommand}"
                                            Visibility="{Binding HasCustomBackground, Converter={StaticResource BoolToVis}}" />
                                    <Button Style="{StaticResource BtnSmOutlineStyle}" Click="OnPickBackgroundClick" Margin="0,0,8,8">
                                        <neg:NegiStackPanel Orientation="Horizontal" Spacing="6">
                                            <materialIcons:MaterialIcon Kind="ImageFrame" Width="14" Height="14" />
                                            <TextBlock Text="选择图片" VerticalAlignment="Center" />
                                        </neg:NegiStackPanel>
                                    </Button>
                                    <Button Style="{StaticResource BtnSmOutlineStyle}" Click="OnPickVideoBackgroundClick" Margin="0,0,8,8">
                                        <neg:NegiStackPanel Orientation="Horizontal" Spacing="6">
                                            <materialIcons:MaterialIcon Kind="VideoFilm" Width="14" Height="14" />
                                            <TextBlock Text="选择视频" VerticalAlignment="Center" />
                                        </neg:NegiStackPanel>
                                    </Button>
                                    <!-- 一键搬 Wallpaper Engine 当前壁纸：只搬视频壁纸，
                                         场景 / 网页 / 应用只提示类型、不动背景 -->
                                    <Button Style="{StaticResource BtnSmOutlineStyle}" Click="OnSyncWallpaperEngineClick" Margin="0,0,8,8">
                                        <neg:NegiStackPanel Orientation="Horizontal" Spacing="6">
                                            <materialIcons:MaterialIcon Kind="Wallpaper" Width="14" Height="14" />
                                            <TextBlock Text="同步 Wallpaper Engine" VerticalAlignment="Center" />
                                        </neg:NegiStackPanel>
                                    </Button>
                                </WrapPanel>
                            </neg:NegiStackPanel>
                        </Border>
                    </neg:NegiStackPanel>
                </Border>

                <!-- 桌宠 -->
                <Border Background="#111114" BorderBrush="#26262b" BorderThickness="1" CornerRadius="8" Padding="18,0"
                        Visibility="{Binding CurrentSettingsTab, Converter={StaticResource Equals}, ConverterParameter=桌宠}">
                    <neg:NegiStackPanel>
                        <Border MinHeight="76" Padding="0,14" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                            <neg:NegiGrid Columns="* Auto">
                                <neg:NegiStackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Text="GPU 渲染（硬件加速）" FontWeight="Medium" Foreground="#fafafa" />
                                    <TextBlock Text="桌宠改用显卡渲染。关闭时走软件光栅化，稳定锁 60 帧、静止时停渲染。"
                                               FontSize="12" Foreground="#a0a0a8" TextWrapping="Wrap" />
                                </neg:NegiStackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding PetUseGpu}" />
                            </neg:NegiGrid>
                        </Border>

                        <Border MinHeight="76" Padding="0,14">
                            <neg:NegiStackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="仅对桌宠生效" FontWeight="Medium" Foreground="#fafafa" />
                                <TextBlock Text="启动器主页的皮肤预览始终走软件光栅化 —— 那条路要出确定性截图做像素回归。"
                                           FontSize="12" Foreground="#a0a0a8" TextWrapping="Wrap" />
                            </neg:NegiStackPanel>
                        </Border>
                    </neg:NegiStackPanel>
                </Border>

                <!-- 关于 -->
                <Border Background="#111114" BorderBrush="#26262b" BorderThickness="1" CornerRadius="8" Padding="18,18"
                        Visibility="{Binding CurrentSettingsTab, Converter={StaticResource Equals}, ConverterParameter=关于}">
                    <neg:NegiStackPanel Spacing="14">
                        <neg:NegiStackPanel Orientation="Horizontal" Spacing="12">
                            <Image Source="pack://application:,,,/Assets/app.png" Width="40" Height="40" />
                            <neg:NegiStackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="NegiCraft Launcher" FontSize="16" FontWeight="SemiBold" Foreground="#fafafa" />
                                <TextBlock Text="{Binding LauncherVersion, StringFormat='版本 {0}'}"
                                           FontSize="12" Foreground="#a1a1aa" />
                            </neg:NegiStackPanel>
                        </neg:NegiStackPanel>
                        <TextBlock FontSize="12" Foreground="#a0a0a8" TextWrapping="Wrap" LineHeight="20"
                                   Text="本项目与 Mojang Studios 及 Microsoft 无关联。Minecraft 是 Mojang Studios 的商标。" />
                    </neg:NegiStackPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- 最外层窗口壳：22px 圆角，背景 #09090b，**没有描边** —— 靠自身底色和下面那圈投影
         与桌面分层。别在这个 Border 上写 BorderThickness：那会让所有子元素整体内缩。
         注意：WPF 的 Border 即使 ClipToBounds 也只裁矩形，圆角要另外设 Clip
         （见 MainWindow.xaml.cs 的 OnShellSizeChanged）。 -->
    <Grid>
        <!-- 0. 投影层 —— 两个只为投出阴影而存在的 Border，本体被 Shell 完全盖住看不见。
             参数是 Tailwind v4 的 shadow-lg 原值（两层，都是 10% 黑）：
                 0 10px 15px -3px rgba(0,0,0,.1), 0 4px 6px -4px rgba(0,0,0,.1)
             为什么要拆成两个：① WPF 的 DropShadowEffect 一次只有一层，Avalonia 的 BoxShadow
             能直接写逗号分隔的两层（那边就是一个 caster）；② 它没有 spread，只能用「比 Shell
             每边内缩 |spread|」等价 ⇒ Margin = 60 + 3 / 60 + 4。
             RenderingBias=Quality：Performance 档的模糊核在小半径下会看出阶梯，这层阴影很淡，
             阶梯比阴影本身还显眼。
             ⚠️ 别给弹层/托盘菜单/侧栏这么干：它们的宿主尺寸 == 内容尺寸，溢出会被硬裁
             （见 Theme/Controls.xaml 里 Shadow* 的用法）。 -->
        <Grid x:Name="ShellShadowLayer" IsHitTestVisible="False">
            <Grid.CacheMode>
                <BitmapCache />
            </Grid.CacheMode>
        <Border x:Name="ShellShadowWide"
                Margin="63"
                Background="#09090b"
                CornerRadius="22"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.10" RenderingBias="Quality"
                                  BlurRadius="15" ShadowDepth="10" Direction="270" />
            </Border.Effect>
        </Border>
        <Border x:Name="ShellShadowTight"
                Margin="64"
                Background="#09090b"
                CornerRadius="22"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.10" RenderingBias="Quality"
                                  BlurRadius="6" ShadowDepth="4" Direction="270" />
            </Border.Effect>
        </Border>
        </Grid>

    <Border x:Name="Shell"
            Margin="60"
            Background="#09090b"
            CornerRadius="22"
            ClipToBounds="True"
            SizeChanged="OnShellSizeChanged">

        <Grid>
        <Grid x:Name="LauncherScene">
            <!-- ========================================== -->
            <!-- 1. 像素背景与压暗（每一页都在）              -->
            <!-- ========================================== -->
            <!-- 以前这块只在首页露出，其他页是壳那层死黑 #09090b。现在整窗一张背景，
                 所以侧栏玻璃、窗口按钮取色、视频播放器都不再按页开关（见下面几处同名注释）。
                 x:Name 是给 MainWindow 的亮度采样用的：窗口按钮的图标色要跟着这块区域变，
                 采样必须打在**合成完的**画面上（模糊 / 亮度叠加 / .shade 渐变都算在内），
                 所以取的是这一层的根，而不是单独的 BgLayer。 -->
            <Grid x:Name="BgRoot">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="CacheMode">
                            <Setter.Value>
                                <BitmapCache />
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsVideoBackground}" Value="True">
                                <Setter Property="CacheMode" Value="{x:Null}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <!-- 生成的 240x146 场景拉伸铺满并保持硬边；用户选的图片则按比例裁切、允许插值。
                     RenderOptions 不能绑，所以两条路拆成两个元素。 -->
                <Grid x:Name="BgLayer">
                    <!-- 模糊为 0 时**整个不挂 Effect**：WPF 只要挂了 Effect 就要走一张全窗离屏面，
                         Radius=0 省下的只是模糊运算，省不掉那张面。而视频每来一帧都会脏化这一层
                         ⇒ 面每帧重跑，同批的其它 Effect（手绘阴影块）就有机会呈上未模糊的版本 ——
                         就是"拖完一下黑闪一下"和"右下角固定位置冒出一块黑"的现场。 -->
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <BlurEffect Radius="{Binding BgBlur}" />
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BgBlur}" Value="0">
                                    <Setter Property="Effect" Value="{x:Null}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Image Source="{Binding BgArt, Converter={StaticResource PixelsToBitmap}}"
                           Stretch="Fill"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           Visibility="{Binding HasCustomBackground, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    <!-- 自选壁纸：像素由共享层解码 + 调色（一张图只解一次，几处绘制点共用）。
                         取景与视频走同一条路 —— Rectangle 的 Fill 挂一个绝对 Viewbox 的 ImageBrush
                         （见 MainWindow.ApplyBackgroundFraming），主层与侧栏共用同一个 brush 实例。
                         ⚠️ 别改回 Image + UniformToFill + RenderTransform：Image 会把自己的
                            DesiredSize 报成"cover 之后的内容尺寸"（1180 的壳里报 1200），Grid 的
                            星型列照着它长，元素尺寸就不再等于可视区域，余量算少 20px；改用
                            MaxWidth 夹住又会把高度压成 708。Rectangle 没有内容驱动的 DesiredSize，
                            尺寸由布局说了算，没这个坑。 -->
                    <Rectangle x:Name="BgCustomImage"
                               Stretch="Fill"
                               Visibility="{Binding IsCustomBackground, Converter={StaticResource BoolToVis}}" />
                    <!-- 视频壁纸。与上面两张图互斥（VM 里保证），排在最后所以它在上层。
                         Fill 由 MainWindow 代码挂：同一个 DrawingBrush 还要挂到侧栏背板上，
                         两处共用一份 MediaPlayer，才能只解码一次且画面严格对齐。
                         放在 BgLayer 里是为了跟着 BgBlur 一起模糊。 -->
                    <Rectangle x:Name="BgVideo"
                               Stretch="Fill"
                               Visibility="{Binding IsVideoBackground, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <!-- 亮度：负值压黑、正值提白 -->
                <Border Background="#ffffff" Opacity="{Binding BgLightOpacity}" IsHitTestVisible="False" />
                <Border Background="#000000" Opacity="{Binding BgDarkOpacity}" IsHitTestVisible="False" />

                <!-- .shade 渐变遮罩 -->
                <Grid>
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,1" EndPoint="0,0.68">
                                <GradientStop Color="#73000000" Offset="0.0" />
                                <GradientStop Color="#00000000" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="1,0" EndPoint="0.55,0">
                                <GradientStop Color="#33000000" Offset="0.0" />
                                <GradientStop Color="#00000000" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>
            </Grid>

            <!-- ========================================== -->
            <!-- 2. 顶部拖拽区与窗口按钮                      -->
            <!-- ========================================== -->
            <!-- 拖拽带。稿子那条 `.drag{z-index:25}` 压在 `.content{z-index:10}` 之上，网页里没症状
                 （那是个空的 div，没有按下处理），搬进 WPF 就成了真 bug：胶囊上半截 16px 归它管，
                 点下去只拖窗口。所以这里降到内容层之下（9）—— 内容层自己不带 Background，
                 空的地方照样穿下来命中这条带子，而按钮/文字该收的点击归它们。
                 代价：正好按在标题笔画上那几像素拖不动窗口，那是文字该赢的地方。 -->
            <Border x:Name="DragBand" Height="40" Margin="88,0,100,0"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    MouseLeftButtonDown="OnDragAreaMouseDown"
                    Panel.ZIndex="9" />

            <!-- 右上角：视频壁纸时多一个喇叭，然后是常规的最小化与关闭。
                 这排也参与首页小人的绕障碍夹位（见 MainWindow.xaml.cs 的 ClampHomeSkinPlace）——
                 宽度随喇叭在不在变，所以是量出来的，不是写死的。 -->
            <neg:NegiStackPanel x:Name="TopRightControls"
                                Orientation="Horizontal" Spacing="4"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,12,14,0" Panel.ZIndex="30">
                <!-- 喇叭本体。图标看的就是"音量是不是 0"（VideoBackgroundSound 现在就是那个别名）：
                     0 → VolumeOff，非 0 → VolumeHigh。音量在它下面那条竖排浮层里调，点图标 = 归 0 / 回上一格。
                     ⚠️ 刻意**不给 ToolTip**：悬停时音量浮层会出现在正下方，再弹一个提示气泡
                       就把浮层盖住了（两个都是"悬停出现"）。图标本身已经够自解释。 -->
                <Button x:Name="VideoSoundButton"
                        Style="{StaticResource WinCtrlStyle}"
                        Visibility="{Binding ShowVideoSoundButton, Converter={StaticResource BoolToVis}}"
                        Click="OnVideoSoundClick"
                        MouseEnter="OnVideoSoundMouseEnter">
                    <Grid Width="17" Height="17">
                        <materialIcons:MaterialIcon Kind="VolumeHigh" Width="17" Height="17"
                                                    Visibility="{Binding VideoBackgroundSound, Converter={StaticResource BoolToVis}}" />
                        <materialIcons:MaterialIcon Kind="VolumeOff" Width="17" Height="17"
                                                    Visibility="{Binding VideoBackgroundSound, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    </Grid>
                </Button>

                <Button x:Name="MinimizeButton" Style="{StaticResource WinCtrlStyle}" ToolTip="最小化" Click="OnMinimizeClick">
                    <materialIcons:MaterialIcon Kind="WindowMinimize" Width="17" Height="17" />
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource WinCtrlCloseStyle}" ToolTip="关闭" Click="OnCloseClick">
                    <materialIcons:MaterialIcon Kind="Close" Width="17" Height="17" />
                </Button>
            </neg:NegiStackPanel>

            <!-- 音量浮层：挂在喇叭正下方那条竖排音量条。
                 ⚠️ 之前做的是"悬停时从喇叭左边滑出一条横的"，那个鼠标很难挪上去
                   （条子在往左长、指针却在按钮上）。改成挂在按钮正下方的浮层，
                   指针往下走就进得去；开合靠 MainWindow 里的进出轮询兜底。
                 ⚠️ **宽度写死 48**：浮层靠"喇叭中心 − 浮层宽/2"横向定位（见 RepositionVolumePanel），
                   宽度要是由内容决定，拖动时百分比从 "5%" 变到 "100%" 会让整块变宽，
                   而那个定位只在打开那一刻算一次 ⇒ 箭头自己就飘走了。这就是"音量条没对上喇叭"。
                 ⚠️ 轨道 96 高（原来 76）：这是一根要**拨**的条，76 高时一格不到 0.8px，
                   想调到 80% 全凭手感。加高之后整块约 150，仍在"顺手拨一下"的量级里。
                 ⚠️ 上边距 44 = 喇叭按钮的下边缘（12 + 32），**紧贴着不留缝**，
                   再加 `Background="Transparent"` 把整块矩形都变成可命中 ——
                   否则指针从按钮往下挪时要穿过一段谁都不算"悬停"的死区，
                   收合看门狗正好在那 180ms 里轮询一次就会把浮层关掉。
                 ⚠️ ZIndex 46：画中画（BgShot，45）就在右上角，浮层必须压在它上面。
                 ⚠️ 开合动画**不用 `Pop`**，用资源里 VolumePopStyle 那套自己的。 -->
            <Border x:Name="VolumePanel"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="48"
                    Margin="0,44,0,0"
                    Background="Transparent"
                    Style="{StaticResource VolumePopStyle}"
                    Panel.ZIndex="46"
                    MouseEnter="OnVolumePanelMouseEnter">
                <Border.RenderTransform>
                    <TranslateTransform Y="-6" />
                </Border.RenderTransform>
                <neg:NegiStackPanel Spacing="0" HorizontalAlignment="Center">
                    <!-- 指向喇叭的小尖角。和面板同色，接缝在面板上边的直线段上（圆角在两侧，碰不到）。 -->
                    <Polygon Points="0,7 7,0 14,7" Fill="#111114" HorizontalAlignment="Center" />
                    <Border Background="#111114" BorderBrush="#26262b" BorderThickness="1"
                            CornerRadius="12" Padding="8,10">
                        <neg:NegiStackPanel Spacing="8" HorizontalAlignment="Center">
                            <Slider x:Name="VideoVolumeSlider"
                                    Style="{StaticResource VolumeSliderStyle}"
                                    Height="96" Width="24"
                                    PreviewMouseLeftButtonDown="OnVolumeBarMouseDown"
                                    MouseMove="OnVolumeBarMouseMove"
                                    Value="{Binding VideoBackgroundVolume, Mode=TwoWay}" />
                            <TextBlock Text="{Binding VideoBackgroundVolume, StringFormat={}{0}%}"
                                       Foreground="#fafafa" FontSize="11" FontWeight="Medium"
                                       Width="30" TextAlignment="Center" />
                        </neg:NegiStackPanel>
                    </Border>
                </neg:NegiStackPanel>
            </Border>

            <!-- ========================================== -->
            <!-- 3. 侧栏底下的磨砂背板                        -->
            <!-- ========================================== -->
            <!-- ⚠️ ClipToBounds 在 WPF 上**只裁矩形**（Avalonia 的 Border 会按圆角裁），
                 所以这里得自己给一条圆角裁剪几何，见 OnSidebarBackdropSizeChanged。
                 少了它，被 BlurEffect 放大的背景图会从四个圆角外漏出来，
                 侧栏看着就是个矩形 + 角上一圈糊。 -->
            <Border x:Name="SidebarBackdrop"
                    HorizontalAlignment="Left" VerticalAlignment="Stretch"
                    Margin="12" Width="60"
                    CornerRadius="18"
                    ClipToBounds="True"
                    SizeChanged="OnSidebarBackdropSizeChanged"
                    IsHitTestVisible="False"
                    Panel.ZIndex="19">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CacheMode">
                            <Setter.Value>
                                <BitmapCache />
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsVideoBackground}" Value="True">
                                <Setter Property="CacheMode" Value="{x:Null}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <!-- 把壳的背景图再画一遍，位置退回壳的原点，玻璃才对得上它盖住的东西 -->
                    <Image Source="{Binding BgArt, Converter={StaticResource PixelsToBitmap}}"
                           Stretch="Fill"
                           HorizontalAlignment="Left" VerticalAlignment="Top"
                           Margin="-12,-12,0,0"
                           Width="{Binding ActualWidth, ElementName=Shell}"
                           Height="{Binding ActualHeight, ElementName=Shell}"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           Visibility="{Binding HasCustomBackground, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <Image.Effect>
                            <BlurEffect Radius="18" />
                        </Image.Effect>
                    </Image>
                    <!-- 与主层共用同一个 ImageBrush（代码里挂 Fill）：本地矩形就是壳矩形
                         （Margin -12 抵掉背板的 12），所以 Viewport/Viewbox 喂一组数两处必然对齐。 -->
                    <Rectangle x:Name="SidebarCustomImage"
                               Stretch="Fill"
                               HorizontalAlignment="Left" VerticalAlignment="Top"
                               Margin="-12,-12,0,0"
                               Width="{Binding ActualWidth, ElementName=Shell}"
                               Height="{Binding ActualHeight, ElementName=Shell}"
                               Visibility="{Binding IsCustomBackground, Converter={StaticResource BoolToVis}}">
                        <Rectangle.Effect>
                            <BlurEffect Radius="18" />
                        </Rectangle.Effect>
                    </Rectangle>
                    <!-- 视频壁纸也要在这里再画一遍，否则玻璃后面还是旧静态背景，一眼假。
                         和上面两张图同样的对齐手法（Margin -12,-12 + 壳尺寸）。
                         Fill 与 BgVideo 共用同一个 DrawingBrush（MainWindow 挂上去）。 -->
                    <Rectangle x:Name="SidebarVideo"
                               Stretch="Fill"
                               HorizontalAlignment="Left" VerticalAlignment="Top"
                               Margin="-12,-12,0,0"
                               Width="{Binding ActualWidth, ElementName=Shell}"
                               Height="{Binding ActualHeight, ElementName=Shell}"
                               Visibility="{Binding IsVideoBackground, Converter={StaticResource BoolToVis}}">
                        <Rectangle.Effect>
                            <BlurEffect Radius="18" />
                        </Rectangle.Effect>
                    </Rectangle>
                    <!-- 与背景层同一条底部遮罩，玻璃才不会更亮 -->
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,1" EndPoint="0,0.68">
                                <GradientStop Color="#73000000" Offset="0.0" />
                                <GradientStop Color="#00000000" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>
            </Border>

            <!-- ========================================== -->
            <!-- 4. 浮动侧栏（60px，圆角 18，边距 12）        -->
            <!-- ========================================== -->
            <Border x:Name="Sidebar"
                    Style="{StaticResource SidebarStyle}"
                    HorizontalAlignment="Left" VerticalAlignment="Stretch"
                    Margin="12" Width="60"
                    CornerRadius="18"
                    BorderThickness="1"
                    Padding="0,12"
                    Panel.ZIndex="20">
                <neg:NegiGrid Rows="Auto * Auto Auto">
                    <controls:SqueezeButton x:Name="FoxLogo" Grid.Row="0"
                                            Width="42" Height="36" Margin="0,0,0,8"
                                            HorizontalAlignment="Center"
                                            Cursor="Hand" Background="Transparent"
                                            BorderThickness="0" Padding="0"
                                            AutomationProperties.Name="狐狸">
                        <controls:SqueezeButton.Template>
                            <ControlTemplate TargetType="{x:Type controls:SqueezeButton}">
                                <Grid Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Grid>
                            </ControlTemplate>
                        </controls:SqueezeButton.Template>
                        <Image Source="pack://application:,,,/Assets/app.png"
                               Width="36" Height="36" IsHitTestVisible="False"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </controls:SqueezeButton>

                    <!-- 中间导航：首页 / 实例 / 下载 -->
                    <neg:NegiStackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="8" HorizontalAlignment="Center">
                        <Button Style="{StaticResource NavBtnStyle}"
                                neg:Negi.Active="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=home}"
                                Command="{Binding GoCommand}" CommandParameter="home"
                                ToolTip="首页">
                            <materialIcons:MaterialIcon Kind="Home" Width="20" Height="20" />
                        </Button>

                        <Button Style="{StaticResource NavBtnStyle}"
                                neg:Negi.Active="{Binding IsInstancesActive}"
                                Command="{Binding GoCommand}" CommandParameter="instances"
                                ToolTip="实例">
                            <materialIcons:MaterialIcon Kind="LayersOutline" Width="20" Height="20" />
                        </Button>

                        <Button Style="{StaticResource NavBtnStyle}"
                                neg:Negi.Active="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=download}"
                                Command="{Binding GoCommand}" CommandParameter="download"
                                ToolTip="下载">
                            <materialIcons:MaterialIcon Kind="DownloadOutline" Width="20" Height="20" />
                        </Button>
                    </neg:NegiStackPanel>

                    <!-- 底部导航：设置 -->
                    <Button Grid.Row="2" Style="{StaticResource NavBtnStyle}"
                            neg:Negi.Active="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=settings}"
                            Command="{Binding GoCommand}" CommandParameter="settings"
                            ToolTip="设置"
                            HorizontalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="CogOutline" Width="20" Height="20" />
                    </Button>

                    <!-- 底部导航：账户头像 -->
                    <Button x:Name="AccountAvatar"
                            Grid.Row="3"
                            Width="42" Height="42"
                            neg:Negi.CornerRadius="12"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Margin="0,6,0,0"
                            Cursor="Hand"
                            Command="{Binding ToggleAccPopCommand}"
                            ToolTip="账户"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                        <Image Source="{Binding AvatarBitmap, Converter={StaticResource PixelsToBitmap}}"
                               Width="38" Height="38"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Button>
                </neg:NegiGrid>
            </Border>

            <!-- ========================================== -->
            <!-- 5. 内容区（内边距 22 28 22 100）             -->
            <!-- ========================================== -->
            <Grid x:Name="MainContent" Margin="100,22,28,22" Panel.ZIndex="10">

                <!-- 页 1：首页 -->
                <Grid x:Name="PageHome" Style="{StaticResource PageAnimStyle}" Visibility="{Binding IsOnHome, Converter={StaticResource BoolToVis}}" Margin="-100,-22,-28,-22">
                    <!-- .stage：top 44 / left 92 / 160x250 -->
                    <Canvas Visibility="{Binding ShowHomeSkinModel, Converter={StaticResource BoolToVis}}">
                        <!-- 启动器内的 3D 皮肤模型：有账号才有人可画，外观设置里可以关掉（默认开）。
                             左键拖位置（按首页比例存，见 MainWindow.xaml.cs 的 LayoutHomeSkinPreview），
                             右键绕竖轴转 —— 这两个键的分工只给主页，别的宿主握法照旧。
                             HitFootprintOnly：命中区剪到身体那一块，脚下那 81 DIP 空档不再
                             替小人吃掉「启动游戏」的点击。 -->
                        <skin:SkinPreviewControl x:Name="SkinPreview"
                                                 Canvas.Left="92" Canvas.Top="44"
                                                 CanDragPosition="True"
                                                 RotateButton="Right"
                                                 HitFootprintOnly="True"
                                                 PlayerName="{Binding CurrentAccount.Name}" />
                    </Canvas>

                    <!-- .dock：right 20 / bottom 20 / 宽 380 / 内边距 10 / 圆角 18。
                         投影是背后单独一个 FloatShadowStyle 块（见 Window.Resources），
                         卡片本体不挂 Effect。 -->
                    <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Margin="0,0,20,20" Width="380">
                        <Border x:Name="DockShadow" Style="{StaticResource FloatShadowStyle}" />
                    <Border x:Name="DockCard"
                            Background="#8C0E0E12"
                            BorderBrush="#17FFFFFF"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="10">
                        <neg:NegiStackPanel Spacing="0">
                            <!-- 顶行：实例选择器 + 启动按钮 -->
                            <neg:NegiGrid Columns="* Auto">
                                <!-- .inst-select：高 52 / 内边距 0 10 0 6 / 圆角 12 -->
                                <Button Grid.Column="0" Style="{StaticResource InstSelectStyle}"
                                        x:Name="InstSelectBtn"
                                        Command="{Binding ToggleInstPopCommand}">
                                    <Grid>
                                        <neg:NegiGrid Columns="Auto * Auto"
                                                      Visibility="{Binding CurrentInstance, Converter={StaticResource NotNull}}">
                                            <!-- 40x40 方块图标 -->
                                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="9" ClipToBounds="True" Margin="0,0,10,0">
                                                <Image Source="{Binding CurrentInstance.IconBitmap, Converter={StaticResource PixelsToBitmap}}"
                                                       Width="40" Height="40"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                            </Border>
                                            <!-- 实例信息：名字与版本/加载器 -->
                                            <neg:NegiStackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CurrentInstance.Name}"
                                                           FontSize="14" FontWeight="Bold" Foreground="#fafafa"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding CurrentInstance.MetaText}"
                                                           FontSize="12" Foreground="#a1a1aa" />
                                            </neg:NegiStackPanel>
                                            <materialIcons:MaterialIcon Grid.Column="2" Kind="ChevronUp"
                                                                        Width="18" Height="18" Foreground="#71717a"
                                                                        Margin="6,0,0,0" />
                                        </neg:NegiGrid>

                                        <!-- 首次运行：还什么都没装 -->
                                        <neg:NegiGrid Columns="Auto * Auto"
                                                      Visibility="{Binding CurrentInstance, Converter={StaticResource IsNull}}">
                                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="9" Margin="0,0,10,0"
                                                    Background="#1c1c21" BorderBrush="#26262b" BorderThickness="1">
                                                <materialIcons:MaterialIcon Kind="Plus" Width="18" Height="18"
                                                                            Foreground="#71717a"
                                                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <neg:NegiStackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="还没有实例" FontSize="14" FontWeight="Bold" Foreground="#fafafa" />
                                                <TextBlock Text="点这里选择一个已有实例" FontSize="12" Foreground="#a1a1aa" />
                                            </neg:NegiStackPanel>
                                            <materialIcons:MaterialIcon Grid.Column="2" Kind="ChevronUp"
                                                                        Width="18" Height="18" Foreground="#71717a"
                                                                        Margin="6,0,0,0" />
                                        </neg:NegiGrid>
                                    </Grid>
                                </Button>

                                <!-- .launch：高 52 / 圆角 12 / 600 字重 / 15px。
                                     MinWidth 按最长文案（"游戏运行中"）钉死，切换启动状态时停靠栏不重排。 -->
                                <Button Grid.Column="1" Style="{StaticResource LaunchBtnStyle}"
                                        Height="52" MinWidth="122" Padding="10,0"
                                        neg:Negi.CornerRadius="12"
                                        FontWeight="SemiBold"
                                        FontSize="15"
                                        HorizontalContentAlignment="Center"
                                        Margin="10,0,0,0"
                                        Cursor="Hand"
                                        IsEnabled="{Binding CanLaunch}"
                                        Command="{Binding LaunchGameCommand}"
                                        Content="{Binding LaunchBtnText}" />
                            </neg:NegiGrid>
                        </neg:NegiStackPanel>
                    </Border>
                    </Grid>

                    <!-- #launchProgress：单独一张卡放在左下空处，游戏启动时停靠栏高度不变。
                         Visibility 挂在外层 Grid 上 —— 投影那块得跟着卡片一起消失。 -->
                    <Grid HorizontalAlignment="Left" VerticalAlignment="Bottom"
                          Margin="100,0,0,20" Width="320"
                          Visibility="{Binding IsLaunching, Converter={StaticResource BoolToVis}}">
                        <Border x:Name="LaunchProgressShadow" Style="{StaticResource FloatShadowStyle}" />
                    <Border Background="#8C0E0E12"
                            BorderBrush="#17FFFFFF"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="14,12">
                        <neg:NegiStackPanel Spacing="8">
                            <neg:NegiGrid Columns="* Auto">
                                <TextBlock Grid.Column="0" Text="{Binding LaunchStepText}" FontSize="12" Foreground="#a1a1aa" />
                                <TextBlock Grid.Column="1" Text="{Binding LaunchPctText}" FontSize="12" Foreground="#a1a1aa" />
                            </neg:NegiGrid>
                            <ProgressBar Value="{Binding LaunchProgress}" Maximum="100" Height="4"
                                         neg:Negi.CornerRadius="2"
                                         Foreground="#fafafa"
                                         Background="#407f7f7f" />
                        </neg:NegiStackPanel>
                    </Border>
                    </Grid>
                </Grid>

                <!-- 页 2：实例 -->
                <Grid x:Name="PageInstances" Style="{StaticResource PageAnimStyle}" Focusable="False" FocusVisualStyle="{x:Null}" KeyboardNavigation.TabNavigation="None" Visibility="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=instances}">
                    <neg:NegiGrid Rows="Auto Auto *">
                        <!-- 页头标题：右上角那片（最小化 + 关闭）是窗口操作区，留出安全区。 -->
                        <Grid Grid.Row="0" Height="36" Margin="0,0,96,14">
                            <TextBlock Text="实例" FontSize="24" Height="32" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Foreground="#fafafa" />
                        </Grid>

                        <!-- 第二层工具条：统一 32 高。它已经在窗口操作区下面，所以能一直铺到内容列右边缘。
                             搜索框不再吃满整行 —— 右边那排（导入 / 添加目录 / 目录切换 / 视图切换）要地方。 -->
                        <neg:NegiGrid Grid.Row="1" Columns="Auto Auto Auto Auto * Auto Auto Auto Auto Auto" Height="32" Margin="0,0,0,16">
                            <!-- 搜索框：统一定义在 Theme/Controls.xaml 中的 SearchBoxStyle，
                                 内含 32 高度、8 圆角、左侧放大镜（防击穿）、右侧动态清空按钮。 -->
                            <TextBox Grid.Column="0" x:Name="SearchBox" Style="{StaticResource SearchBoxStyle}"
                                     Width="220" Margin="0,0,8,0"
                                     neg:Negi.Placeholder="搜索实例名或版本..."
                                     Text="{Binding InstanceSearch, UpdateSourceTrigger=PropertyChanged}" />

                            <!-- 加载器筛选：下拉只列实例里真出现过的加载器**种类**。 -->
                            <Button Grid.Column="1" x:Name="LoaderFilterBtn" Style="{StaticResource BtnSmOutlineStyle}"
                                    Height="32" MinWidth="116" Margin="0,0,8,0" FontSize="12.5" neg:Negi.CornerRadius="8"
                                    Command="{Binding ToggleLoaderPopCommand}">
                                <neg:NegiGrid Columns="* Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding InstanceLoaderLabel}" FontSize="12.5" VerticalAlignment="Center" />
                                    <materialIcons:MaterialIcon Grid.Column="1" Kind="ChevronDown" Width="13" Height="13"
                                                                Foreground="#71717a" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </neg:NegiGrid>
                            </Button>

                            <Border Grid.Column="2" Width="1" Height="18" Background="#26262b" Margin="0,0,10,0" VerticalAlignment="Center" />

                            <!-- 排序：分段控件，容器与右下角那排视图切换同一套（muted 底 + 2 内边距 +
                                 选中那段卡底）。两颗都摆在容器里，字色不再和壁纸抢对比度。 -->
                            <Border Grid.Column="3" Height="32" Padding="2" CornerRadius="9" VerticalAlignment="Center"
                                    Background="#27272a" BorderBrush="#26262b" BorderThickness="1">
                                <neg:NegiStackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Style="{StaticResource SortTabStyle}" Content="最近游玩"
                                            neg:Negi.On="{Binding InstanceSort, Converter={StaticResource Equals}, ConverterParameter=最近游玩}"
                                            Command="{Binding SelectInstanceSortCommand}" CommandParameter="最近游玩" />
                                    <Button Style="{StaticResource SortTabStyle}" Content="名称"
                                            neg:Negi.On="{Binding InstanceSort, Converter={StaticResource Equals}, ConverterParameter=名称}"
                                            Command="{Binding SelectInstanceSortCommand}" CommandParameter="名称" />
                                </neg:NegiStackPanel>
                            </Border>

                            <!-- 右边这一排全推到内容列末端。 -->
                            <Button Grid.Column="5" x:Name="ImportPackBtn" Style="{StaticResource BtnSmOutlineStyle}" Height="32"
                                    Margin="0,0,8,0" FontSize="12.5" neg:Negi.CornerRadius="8"
                                    Command="{Binding BeginPackImportCommand}">
                                <neg:NegiStackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="PackageVariantClosed" Width="15" Height="15" Foreground="#a1a1aa" VerticalAlignment="Center" />
                                    <TextBlock Text="导入整合包" FontSize="12.5" VerticalAlignment="Center" />
                                </neg:NegiStackPanel>
                            </Button>

                            <Button Grid.Column="6" x:Name="AddFolderBtn" Style="{StaticResource BtnSmOutlineStyle}" Height="32"
                                    Margin="0,0,8,0" FontSize="12.5" neg:Negi.CornerRadius="8"
                                    Command="{Binding BeginAddFolderCommand}">
                                <neg:NegiStackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="FolderPlusOutline" Width="15" Height="15" Foreground="#a1a1aa" VerticalAlignment="Center" />
                                    <TextBlock Text="添加文件夹" FontSize="12.5" VerticalAlignment="Center" />
                                </neg:NegiStackPanel>
                            </Button>

                            <!-- 实例文件夹切换按钮：移到添加文件夹右侧，与其它按钮保持统一的 8 圆角与 32 高度 -->
                            <Button Grid.Column="7" x:Name="FolderPillBtn" Style="{StaticResource FolderPillStyle}"
                                    Height="32" Margin="0,0,8,0" FontSize="12.5" neg:Negi.CornerRadius="8"
                                    neg:Negi.On="{Binding IsFolderPopOpen}"
                                    Command="{Binding ToggleFolderPopCommand}"
                                    ToolTip="切换游戏目录">
                                <neg:NegiStackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="FolderOutline" Width="15" Height="15" Foreground="#a1a1aa" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ActiveFolderName}" FontSize="12.5" Foreground="#fafafa"
                                               MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <materialIcons:MaterialIcon Kind="ChevronDown" Width="13" Height="13" Foreground="#71717a" VerticalAlignment="Center"
                                                                Visibility="{Binding IsFolderPopOpen, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                    <materialIcons:MaterialIcon Kind="ChevronUp" Width="13" Height="13" Foreground="#71717a" VerticalAlignment="Center"
                                                                Visibility="{Binding IsFolderPopOpen, Converter={StaticResource BoolToVis}}" />
                                </neg:NegiStackPanel>
                            </Button>

                            <Border Grid.Column="8" Width="1" Height="18" Background="#26262b" Margin="0,0,10,0" VerticalAlignment="Center" />

                            <!-- 视图切换：网格 / 列表。选中那颗是卡底，容器是 muted 底，两层分得开。 -->
                            <Border Grid.Column="9" Height="32" Padding="2" CornerRadius="9" VerticalAlignment="Center"
                                    Background="#27272a" BorderBrush="#26262b" BorderThickness="1">
                                <neg:NegiStackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Style="{StaticResource ViewBtnStyle}" ToolTip="卡片网格"
                                            neg:Negi.On="{Binding IsGridView}"
                                            Command="{Binding SelectInstanceViewCommand}" CommandParameter="grid">
                                        <materialIcons:MaterialIcon Kind="ViewGridOutline" Width="14" Height="14"
                                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                                    </Button>
                                    <Button Style="{StaticResource ViewBtnStyle}" ToolTip="紧凑列表"
                                            neg:Negi.On="{Binding IsListView}"
                                            Command="{Binding SelectInstanceViewCommand}" CommandParameter="list">
                                        <materialIcons:MaterialIcon Kind="FormatListBulleted" Width="14" Height="14"
                                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                                    </Button>
                                </neg:NegiStackPanel>
                            </Border>
                        </neg:NegiGrid>

                        <Grid Grid.Row="2">
                            <!-- 卡片模式。UniformGrid 而不是 WrapPanel —— 卡片要"自适应拉伸"就得等宽，
                                 还要等高（底行那句最近游玩是贴底摆的，卡片不齐高就贴不出效果）。
                                 列数由视图按页宽算（见 MainWindow.xaml.cs 的 UpdateInstanceColumns）。 -->
                            <Grid Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}}" Style="{StaticResource PageAnimStyle}">
                            <ScrollViewer Focusable="False" Visibility="{Binding HasInstances, Converter={StaticResource BoolToVis}}">
                                <!-- VerticalAlignment=Top 是必需的，不是装饰：ScrollContentPresenter 给
                                     拉申的孩子排的是「至少一屏高」的矩形，UniformGrid 于是把整屏高度
                                     平摊给那一两行 —— 卡片会被撑成 520 高，两行时中间还会裂开一条大沟。
                                     顶对齐后 UniformGrid 只拿内容高，格子高度=该行最高的那张卡。 -->
                                <ItemsControl Focusable="False" VerticalAlignment="Top" ItemsSource="{Binding VisibleInstances}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="{Binding InstanceColumns}" Margin="0,0,-12,0" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource InstCardStyle}"
                                                    neg:Negi.Current="{Binding IsCurrent}"
                                                    Margin="0,0,12,12"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Command="{Binding DataContext.OpenInstanceConfigCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding .}">
                                                <!-- 右键菜单与「⋯」共用这一份：⋯ 只是把同一个菜单就地开起来
                                                     （见 MainWindow.xaml.cs 的 OnRowMoreClick）。
                                                     ContextMenu 在另一棵可视树里，所以走 PlacementTarget.Tag 取窗口 VM。 -->
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="设为当前"
                                                                  Command="{Binding PlacementTarget.Tag.MakeCurrentInstanceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding .}" />
                                                        <MenuItem Header="立即启动"
                                                                  Command="{Binding PlacementTarget.Tag.LaunchInstanceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding .}" />
                                                        <MenuItem Header="实例配置"
                                                                  Command="{Binding PlacementTarget.Tag.OpenInstanceConfigCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding .}" />
                                                        <MenuItem Header="导出整合包" IsEnabled="False"
                                                                  ToolTip="导出 .mrpack 还没做，先等着。" />
                                                        <Separator />
                                                        <MenuItem Header="重命名"
                                                                  Command="{Binding PlacementTarget.Tag.RenameInstanceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding .}" />
                                                        <MenuItem Header="打开游戏目录"
                                                                  Command="{Binding PlacementTarget.Tag.OpenInstanceFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding .}" />
                                                        <MenuItem Header="打开存档文件夹"
                                                                  Command="{Binding PlacementTarget.Tag.OpenInstanceSavesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding .}" />
                                                        <Separator />
                                                        <MenuItem Header="删除" Foreground="#f87171"
                                                                  Command="{Binding PlacementTarget.Tag.DeleteInstanceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding .}" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>

                                                <neg:NegiGrid Rows="* Auto">
                                                    <!-- 上：图标 + 名字（当前胶囊）+ 两个 tag，右上角「⋯」 -->
                                                    <neg:NegiGrid Grid.Row="0" Columns="Auto * Auto" Margin="0,0,0,10">
                                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="9" ClipToBounds="True" VerticalAlignment="Top">
                                                            <Image Source="{Binding IconBitmap, Converter={StaticResource PixelsToBitmap}}"
                                                                   Width="40" Height="40"
                                                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                                        </Border>
                                                        <neg:NegiStackPanel Grid.Column="1" VerticalAlignment="Top" Spacing="7" Margin="12,0,4,0">
                                                            <!-- 名字自己截断；「当前」不再挂胶囊，整张卡的底色就是那个意思。 -->
                                                            <!-- MaxWidth 只是"长到多长才截"的上限；HorizontalAlignment 必须显式 Left ——
                                                                 Stretch + MaxWidth 会把夹小的元素在槽位里居中，名字就会比下面那排 tag 右移。 -->
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                                       MaxWidth="170" HorizontalAlignment="Left"
                                                                       Foreground="#fafafa" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                            <neg:NegiStackPanel Orientation="Horizontal" Spacing="6">
                                                                <Border Style="{StaticResource TagPillStyle}">
                                                                    <TextBlock Text="{Binding VersionId}" Style="{StaticResource TagTextStyle}" />
                                                                </Border>
                                                                <Border Style="{StaticResource TagPillStyle}">
                                                                    <TextBlock Text="{Binding Loader}" Style="{StaticResource TagTextStyle}" />
                                                                </Border>
                                                            </neg:NegiStackPanel>
                                                        </neg:NegiStackPanel>
                                                        <Button Grid.Column="2" Style="{StaticResource IconBtnStyle}" Width="28" Height="28"
                                                                VerticalAlignment="Top" ToolTip="更多" Click="OnRowMoreClick">
                                                            <materialIcons:MaterialIcon Kind="DotsHorizontal" Width="16" Height="16" Foreground="#a1a1aa" />
                                                        </Button>
                                                    </neg:NegiGrid>

                                                    <!-- 下：最近游玩贴底，右边启动按钮 -->
                                                    <neg:NegiGrid Grid.Row="1" Columns="* Auto">
                                                        <TextBlock Grid.Column="0" Text="{Binding LastPlayedText}" FontSize="12"
                                                                   Foreground="#a1a1aa" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <Button Grid.Column="1" Style="{StaticResource CardPlayStyle}" ToolTip="启动"
                                                                Command="{Binding DataContext.LaunchInstanceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding .}">
                                                            <materialIcons:MaterialIcon Kind="Play" Width="18" Height="18"
                                                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                                                        </Button>
                                                    </neg:NegiGrid>
                                                </neg:NegiGrid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            </Grid>

                            <!-- 列表模式：一行 54，图标 / 名字 / 三个 tag / 最近游玩 / 三颗图标按钮。
                                 名字那格按稿子给固定 300，剩下的高度留给"最近游玩"那一段自己靠右，
                                 窗口再窄也不会把 tag 挤没（它比名字更容易一眼比对）。 -->
                            <Grid Visibility="{Binding IsListView, Converter={StaticResource BoolToVis}}" Style="{StaticResource PageAnimStyle}">
                                <ScrollViewer Focusable="False" Visibility="{Binding HasInstances, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl Focusable="False" VerticalAlignment="Top" ItemsSource="{Binding VisibleInstances}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource InstRowStyle}"
                                                        neg:Negi.Current="{Binding IsCurrent}"
                                                        Margin="0,0,0,8"
                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Command="{Binding DataContext.OpenInstanceConfigCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding .}">
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="设为当前"
                                                                      Command="{Binding PlacementTarget.Tag.MakeCurrentInstanceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="{Binding .}" />
                                                            <MenuItem Header="立即启动"
                                                                      Command="{Binding PlacementTarget.Tag.LaunchInstanceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="{Binding .}" />
                                                            <MenuItem Header="实例配置"
                                                                      Command="{Binding PlacementTarget.Tag.OpenInstanceConfigCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="{Binding .}" />
                                                            <MenuItem Header="导出整合包" IsEnabled="False"
                                                                      ToolTip="导出 .mrpack 还没做，先等着。" />
                                                            <Separator />
                                                            <MenuItem Header="重命名"
                                                                      Command="{Binding PlacementTarget.Tag.RenameInstanceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="{Binding .}" />
                                                            <MenuItem Header="打开游戏目录"
                                                                      Command="{Binding PlacementTarget.Tag.OpenInstanceFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="{Binding .}" />
                                                            <MenuItem Header="打开存档文件夹"
                                                                      Command="{Binding PlacementTarget.Tag.OpenInstanceSavesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="{Binding .}" />
                                                            <Separator />
                                                            <MenuItem Header="删除" Foreground="#f87171"
                                                                      Command="{Binding PlacementTarget.Tag.DeleteInstanceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="{Binding .}" />
                                                        </ContextMenu>
                                                    </Button.ContextMenu>

                                                    <neg:NegiGrid Columns="Auto Auto Auto * Auto" Height="52">
                                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" ClipToBounds="True" VerticalAlignment="Center">
                                                            <Image Source="{Binding IconBitmap, Converter={StaticResource PixelsToBitmap}}"
                                                                   Width="36" Height="36" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                                        </Border>

                                                        <!-- 名字列对齐稿子 .main-info：14 的左边距＝ .inst-row 的 flex gap，300 是列宽本身
                                                             （稿子 .block(36) + gap(14) + .main-info(300) + gap(14) + .tags(290)）。 -->
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Width="300" Margin="14,0,0,0"
                                                                   FontSize="13.5" FontWeight="SemiBold" Foreground="#fafafa"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                                        <!-- tag 自己成列（稿子 .inst-row .tags{width:290px;flex:0 0 290px}、左对齐），
                                                             不然名字短的时候这排会往左跑，行与行之间对不齐。 -->
                                                        <neg:NegiStackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                                                            Width="290" HorizontalAlignment="Left"
                                                                            Margin="14,0,0,0" VerticalAlignment="Center">
                                                            <Border Style="{StaticResource TagPillStyle}">
                                                                <TextBlock Text="{Binding VersionId}" Style="{StaticResource TagTextStyle}" />
                                                            </Border>
                                                            <Border Style="{StaticResource TagPillStyle}">
                                                                <TextBlock Text="{Binding Loader}" Style="{StaticResource TagTextStyle}" />
                                                            </Border>
                                                            <!-- 「N 模组」只在装了模组时出现：空 tag 是噪声，原版实例不需要被提醒自己是原版。 -->
                                                            <Border Style="{StaticResource TagPillStyle}"
                                                                    Visibility="{Binding HasMods, Converter={StaticResource BoolToVis}}">
                                                                <neg:NegiStackPanel Orientation="Horizontal" Spacing="4">
                                                                    <materialIcons:MaterialIcon Kind="CubeOutline" Width="12" Height="12"
                                                                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TextBlock}}}" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding ModCountText}" Style="{StaticResource TagTextStyle}" />
                                                                </neg:NegiStackPanel>
                                                            </Border>
                                                        </neg:NegiStackPanel>

                                                        <TextBlock Grid.Column="3" Text="{Binding LastPlayedText}" FontSize="12"
                                                                   Foreground="#a1a1aa" Margin="12,0,12,0" HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                                        <neg:NegiStackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <Button Style="{StaticResource CardPlayStyle}" ToolTip="启动"
                                                                    Command="{Binding DataContext.LaunchInstanceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding .}">
                                                                <materialIcons:MaterialIcon Kind="Play" Width="18" Height="18"
                                                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                                                            </Button>
                                                            <Button Style="{StaticResource IconBtnStyle}" Width="28" Height="28"
                                                                    ToolTip="更多" Click="OnRowMoreClick">
                                                                <materialIcons:MaterialIcon Kind="DotsHorizontal" Width="16" Height="16" Foreground="#a1a1aa" />
                                                            </Button>
                                                        </neg:NegiStackPanel>
                                                    </neg:NegiGrid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>

                            <!-- 两种空法：这个目录里真没有一个实例，和有实例但被筛没了。
                                 空态下面那两颗按钮是稿子里搬来的：这时候用户最可能做的两件事就是导入一份包，
                                 或者去下载页装一个版本。 -->
                            <neg:NegiStackPanel Visibility="{Binding HasInstances, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                <materialIcons:MaterialIcon Kind="LayersOutline" Width="36" Height="36"
                                                            Foreground="#3f3f46" HorizontalAlignment="Center" />
                                <TextBlock Text="还没有实例" FontSize="14" Foreground="#a1a1aa" HorizontalAlignment="Center" />
                                <TextBlock Text="可以导入一份整合包，或者点右下角「新建」装一个 Minecraft 版本" FontSize="12"
                                           Foreground="#71717a" HorizontalAlignment="Center" />
                                <neg:NegiStackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource BtnSmPrimaryStyle}" Command="{Binding BeginPackImportCommand}">
                                        <neg:NegiStackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="PackageVariantClosed" Width="15" Height="15" VerticalAlignment="Center" />
                                            <TextBlock Text="导入整合包" VerticalAlignment="Center" />
                                        </neg:NegiStackPanel>
                                    </Button>
                                    <Button Style="{StaticResource BtnSmOutlineStyle}" Command="{Binding NewInstanceCommand}">
                                        <neg:NegiStackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="Download" Width="15" Height="15" Foreground="#fafafa" VerticalAlignment="Center" />
                                            <TextBlock Text="下载 Minecraft" VerticalAlignment="Center" />
                                        </neg:NegiStackPanel>
                                    </Button>
                                </neg:NegiStackPanel>
                            </neg:NegiStackPanel>

                            <neg:NegiStackPanel Visibility="{Binding HasNoInstanceMatches, Converter={StaticResource BoolToVis}}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                <TextBlock Text="没有匹配的实例" FontSize="14" Foreground="#a1a1aa" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding InstanceEmptyHint}" FontSize="12" Foreground="#71717a" HorizontalAlignment="Center" />
                            </neg:NegiStackPanel>

                            <!-- 右下角悬浮新建：和首页停靠卡同一个内缩 -->
                            <Button Style="{StaticResource FabStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,24,24" Panel.ZIndex="40" Command="{Binding NewInstanceCommand}">
                                <neg:NegiStackPanel Orientation="Horizontal" Spacing="8">
                                    <materialIcons:MaterialIcon Kind="Plus" Width="16" Height="16" />
                                    <TextBlock Text="新建" VerticalAlignment="Center" />
                                </neg:NegiStackPanel>
                            </Button>
                        </Grid>
                    </neg:NegiGrid>
                </Grid>

                <!-- 页 2.5：实例管理（隐藏页，由实例卡片/列表直接进入） -->
                <Grid x:Name="PageInstanceManage" Style="{StaticResource PageAnimStyle}" Focusable="False" FocusVisualStyle="{x:Null}" KeyboardNavigation.TabNavigation="None" Visibility="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=instance_manage}">
                    <neg:NegiGrid Rows="Auto *">
                        <!-- 页头导航与信息：右上角留出 96px 窗口控制按钮安全区 -->
                        <Grid Grid.Row="0" Margin="0,0,96,16" Height="42">
                            <neg:NegiGrid Columns="Auto Auto * Auto">
                                <!-- 返回按钮 -->
                                <Button Grid.Column="0" Style="{StaticResource BtnSmOutlineStyle}" Height="34" Margin="0,0,14,0"
                                        Command="{Binding BackToInstancesCommand}">
                                    <neg:NegiStackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="ArrowLeft" Width="16" Height="16" />
                                        <TextBlock Text="返回" FontSize="12.5" VerticalAlignment="Center" />
                                    </neg:NegiStackPanel>
                                </Button>

                                <!-- 实例信息 (图标 + 名字 + 标签) -->
                                <neg:NegiStackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Width="36" Height="36" CornerRadius="8" ClipToBounds="True" VerticalAlignment="Center">
                                        <Image Source="{Binding EditingInstance.IconBitmap, Converter={StaticResource PixelsToBitmap}}"
                                               Width="36" Height="36" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    </Border>
                                    <neg:NegiStackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding EditingInstance.Name, FallbackValue='实例管理'}"
                                                   FontSize="15.5" FontWeight="SemiBold" Foreground="#fafafa" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding EditingVersionSummary, FallbackValue=''}"
                                                   FontSize="12" Foreground="#a1a1aa" TextTrimming="CharacterEllipsis" />
                                    </neg:NegiStackPanel>
                                </neg:NegiStackPanel>

                                <!-- 右侧快捷操作：设为当前 + 启动游戏 -->
                                <neg:NegiStackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Button Style="{StaticResource BtnSmOutlineStyle}" Height="34" Content="设为当前"
                                            Visibility="{Binding IsEditingCurrentInstance, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                            Command="{Binding MakeEditingInstanceCurrentCommand}" />
                                    <Button Style="{StaticResource BtnSmPrimaryStyle}" Height="34"
                                            Command="{Binding LaunchEditingInstanceCommand}">
                                        <neg:NegiStackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="Play" Width="16" Height="16" />
                                            <TextBlock Text="启动游戏" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </neg:NegiStackPanel>
                                    </Button>
                                </neg:NegiStackPanel>
                            </neg:NegiGrid>
                        </Grid>

                        <!-- 主体区域：左侧 Tab (180px) + 分割线 (1px) + 右侧内容 (*) -->
                        <neg:NegiGrid Grid.Row="1" Columns="180 32 *">
                            <!-- 左侧 Tab 侧栏 -->
                            <Border Grid.Column="0" Background="#0c0c0e" CornerRadius="12" Padding="8,10" VerticalAlignment="Stretch">
                                <neg:NegiStackPanel Spacing="4">
                                    <!-- 概览 -->
                                    <Button Style="{StaticResource InstNavBtnStyle}"
                                            neg:Negi.On="{Binding ConfigTab, Converter={StaticResource Equals}, ConverterParameter=概览}"
                                            Command="{Binding SelectConfigTabCommand}" CommandParameter="概览">
                                        <neg:NegiStackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="LayersOutline" Width="16" Height="16" VerticalAlignment="Center" />
                                            <TextBlock Text="概览" VerticalAlignment="Center" />
                                        </neg:NegiStackPanel>
                                    </Button>

                                    <!-- 模组 -->
                                    <Button Style="{StaticResource InstNavBtnStyle}"
                                            neg:Negi.On="{Binding ConfigTab, Converter={StaticResource Equals}, ConverterParameter=模组}"
                                            Command="{Binding SelectConfigTabCommand}" CommandParameter="模组">
                                        <neg:NegiGrid Columns="Auto * Auto" VerticalAlignment="Center">
                                            <neg:NegiStackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="CubeOutline" Width="16" Height="16" VerticalAlignment="Center" />
                                                <TextBlock Text="模组" VerticalAlignment="Center" />
                                            </neg:NegiStackPanel>
                                            <Border Grid.Column="2" Style="{StaticResource TagPillStyle}" Padding="6,1"
                                                    Visibility="{Binding EditingMods.Count, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding EditingMods.Count}" Style="{StaticResource TagTextStyle}" />
                                            </Border>
                                        </neg:NegiGrid>
                                    </Button>

                                    <!-- 资源包 -->
                                    <Button Style="{StaticResource InstNavBtnStyle}"
                                            neg:Negi.On="{Binding ConfigTab, Converter={StaticResource Equals}, ConverterParameter=资源包}"
                                            Command="{Binding SelectConfigTabCommand}" CommandParameter="资源包">
                                        <neg:NegiGrid Columns="Auto * Auto" VerticalAlignment="Center">
                                            <neg:NegiStackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="PaletteOutline" Width="16" Height="16" VerticalAlignment="Center" />
                                                <TextBlock Text="资源包" VerticalAlignment="Center" />
                                            </neg:NegiStackPanel>
                                            <Border Grid.Column="2" Style="{StaticResource TagPillStyle}" Padding="6,1"
                                                    Visibility="{Binding EditingResourcePacks.Count, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding EditingResourcePacks.Count}" Style="{StaticResource TagTextStyle}" />
                                            </Border>
                                        </neg:NegiGrid>
                                    </Button>

                                    <!-- 世界 -->
                                    <Button Style="{StaticResource InstNavBtnStyle}"
                                            neg:Negi.On="{Binding ConfigTab, Converter={StaticResource Equals}, ConverterParameter=世界}"
                                            Command="{Binding SelectConfigTabCommand}" CommandParameter="世界">
                                        <neg:NegiGrid Columns="Auto * Auto" VerticalAlignment="Center">
                                            <neg:NegiStackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="Earth" Width="16" Height="16" VerticalAlignment="Center" />
                                                <TextBlock Text="世界" VerticalAlignment="Center" />
                                            </neg:NegiStackPanel>
                                            <Border Grid.Column="2" Style="{StaticResource TagPillStyle}" Padding="6,1"
                                                    Visibility="{Binding EditingWorlds.Count, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding EditingWorlds.Count}" Style="{StaticResource TagTextStyle}" />
                                            </Border>
                                        </neg:NegiGrid>
                                    </Button>

                                    <!-- Java 与内存 -->
                                    <Button Style="{StaticResource InstNavBtnStyle}"
                                            neg:Negi.On="{Binding ConfigTab, Converter={StaticResource Equals}, ConverterParameter=Java}"
                                            Command="{Binding SelectConfigTabCommand}" CommandParameter="Java">
                                        <neg:NegiStackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="RocketLaunchOutline" Width="16" Height="16" VerticalAlignment="Center" />
                                            <TextBlock Text="Java 与内存" VerticalAlignment="Center" />
                                        </neg:NegiStackPanel>
                                    </Button>

                                    <!-- 文件与管理 -->
                                    <Button Style="{StaticResource InstNavBtnStyle}"
                                            neg:Negi.On="{Binding ConfigTab, Converter={StaticResource Equals}, ConverterParameter=目录}"
                                            Command="{Binding SelectConfigTabCommand}" CommandParameter="目录">
                                        <neg:NegiStackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="FolderOutline" Width="16" Height="16" VerticalAlignment="Center" />
                                            <TextBlock Text="文件与管理" VerticalAlignment="Center" />
                                        </neg:NegiStackPanel>
                                    </Button>
                                </neg:NegiStackPanel>
                            </Border>

                            <!-- 分割线 -->
                            <Rectangle Grid.Column="1" Width="1" Fill="#26262b" HorizontalAlignment="Center" VerticalAlignment="Stretch" />

                            <!-- 右侧设置内容 -->
                            <Grid Grid.Column="2">
                                <!-- 1. 概览 -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding ConfigTab, Converter={StaticResource Equals}, ConverterParameter=概览}">
                                    <neg:NegiStackPanel Spacing="16" Margin="0,0,10,0">
                                        <Border Background="#18181b" BorderBrush="#26262b" BorderThickness="1" CornerRadius="12" Padding="16,0">
                                            <neg:NegiStackPanel>
                                                <Border Height="54" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                                    <neg:NegiGrid Columns="* Auto">
                                                        <neg:NegiStackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                            <TextBlock Text="实例名称" FontWeight="Medium" Foreground="#fafafa" FontSize="13" />
                                                            <TextBlock Text="启动器中显示的自定义名称" FontSize="12" Foreground="#71717a" />
                                                        </neg:NegiStackPanel>
                                                        <TextBox Grid.Column="1" Width="220" Height="32" MinHeight="0" Text="{Binding ConfigInstName, Mode=TwoWay}"
                                                                 Background="#111114" BorderBrush="#26262b" BorderThickness="1"
                                                                 neg:Negi.CornerRadius="8" Foreground="#fafafa" Padding="10,0" FontSize="12.5"
                                                                 VerticalAlignment="Center" />
                                                    </neg:NegiGrid>
                                                </Border>
                                                <Border Height="54" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                                    <neg:NegiGrid Columns="* Auto">
                                                        <neg:NegiStackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                            <TextBlock Text="版本隔离" FontWeight="Medium" Foreground="#fafafa" FontSize="13" />
                                                            <TextBlock Text="独立 saves、mods 与配置文件（推荐开启）" FontSize="12" Foreground="#71717a" />
                                                        </neg:NegiStackPanel>
                                                        <CheckBox Grid.Column="1" IsChecked="{Binding ConfigInstIsolated}" />
                                                    </neg:NegiGrid>
                                                </Border>
                                                <Border Height="54" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                                    <neg:NegiGrid Columns="* Auto">
                                                        <neg:NegiStackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                            <TextBlock Text="游戏核心与加载器" FontWeight="Medium" Foreground="#fafafa" FontSize="13" />
                                                            <TextBlock Text="{Binding EditingInstance.MetaText, FallbackValue=''}" FontSize="12" Foreground="#71717a" />
                                                        </neg:NegiStackPanel>
                                                        <Button Grid.Column="1" Style="{StaticResource BtnSmOutlineStyle}" Content="切换核心版本"
                                                                IsEnabled="False" ToolTip="换版本需重新下载依赖库，暂未开放。" />
                                                    </neg:NegiGrid>
                                                </Border>
                                                <Border Height="54">
                                                    <neg:NegiGrid Columns="* Auto">
                                                        <neg:NegiStackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                            <TextBlock Text="所属游戏目录" FontWeight="Medium" Foreground="#fafafa" FontSize="13" />
                                                            <TextBlock Text="{Binding GameRoot}" FontSize="12" Foreground="#71717a"
                                                                       TextTrimming="CharacterEllipsis" FontFamily="Consolas" />
                                                        </neg:NegiStackPanel>
                                                        <Button Grid.Column="1" Style="{StaticResource BtnSmOutlineStyle}" Content="迁移目录…"
                                                                IsEnabled="False" ToolTip="实例迁移功能暂未开放。" />
                                                    </neg:NegiGrid>
                                                </Border>
                                            </neg:NegiStackPanel>
                                        </Border>

                                        <Button Style="{StaticResource BtnSmPrimaryStyle}" Content="保存配置" Height="34" Width="100"
                                                HorizontalAlignment="Right" Command="{Binding SaveEditingInstanceCommand}" />
                                    </neg:NegiStackPanel>
                                </ScrollViewer>

                                <!-- 2. 模组 -->
                                <Grid Visibility="{Binding ConfigTab, Converter={StaticResource Equals}, ConverterParameter=模组}">
                                    <neg:NegiGrid Rows="Auto *">
                                        <!-- 工具条 -->
                                        <neg:NegiGrid Grid.Row="0" Columns="Auto * Auto Auto Auto" Height="32" Margin="0,0,0,12">
                                            <TextBox Grid.Column="0" Style="{StaticResource SearchBoxStyle}" Width="200"
                                                     neg:Negi.Placeholder="搜索模组..."
                                                     Text="{Binding ModSearch, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Grid.Column="1" Text="{Binding EditingModCountText}" FontSize="12.5" Foreground="#a1a1aa"
                                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                                            <Button Grid.Column="2" Style="{StaticResource BtnSmOutlineStyle}" Height="32" Margin="0,0,8,0"
                                                    Command="{Binding AddModFileCommand}">
                                                <neg:NegiStackPanel Orientation="Horizontal" Spacing="6">
                                                    <materialIcons:MaterialIcon Kind="Plus" Width="14" Height="14" />
                                                    <TextBlock Text="添加模组" FontSize="12" VerticalAlignment="Center" />
                                                </neg:NegiStackPanel>
                                            </Button>
                                            <Button Grid.Column="3" Style="{StaticResource BtnSmOutlineStyle}" Height="32" Margin="0,0,8,0"
                                                    Command="{Binding OpenEditingModsCommand}">
                                                <neg:NegiStackPanel Orientation="Horizontal" Spacing="6">
                                                    <materialIcons:MaterialIcon Kind="FolderOutline" Width="14" Height="14" />
                                                    <TextBlock Text="打开文件夹" FontSize="12" VerticalAlignment="Center" />
                                                </neg:NegiStackPanel>
                                            </Button>
                                            <Button Grid.Column="4" Style="{StaticResource BtnSmOutlineStyle}" Height="32"
                                                    Command="{Binding RefreshInstanceManageDataCommand}" ToolTip="刷新模组列表">
                                                <materialIcons:MaterialIcon Kind="Refresh" Width="14" Height="14" />
                                            </Button>
                                        </neg:NegiGrid>

                                        <!-- 模组列表 / 空态 -->
                                        <Grid Grid.Row="1">
                                            <!-- 空态 -->
                                            <Border Visibility="{Binding FilteredEditingMods.Count, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                                    Background="#111114" BorderBrush="#26262b" BorderThickness="1" CornerRadius="14"
                                                    Padding="40,32" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <neg:NegiStackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                                    <materialIcons:MaterialIcon Kind="CubeOutline" Width="38" Height="38" Foreground="#52525b" HorizontalAlignment="Center" />
                                                    <TextBlock Text="暂无模组" FontSize="14" FontWeight="SemiBold" Foreground="#fafafa" HorizontalAlignment="Center" />
                                                    <TextBlock Text="点击右上角「添加模组」或将 .jar 文件放入 mods 文件夹" FontSize="12" Foreground="#a1a1aa" HorizontalAlignment="Center" />
                                                </neg:NegiStackPanel>
                                            </Border>

                                            <!-- 列表 -->
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding FilteredEditingMods}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#18181b" BorderBrush="#26262b" BorderThickness="1" CornerRadius="10"
                                                                    Padding="12,8" Margin="0,0,0,6">
                                                                <neg:NegiGrid Columns="Auto * Auto Auto Auto">
                                                                    <!-- 启用开关 -->
                                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                                              Command="{Binding DataContext.ToggleModCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                              CommandParameter="{Binding .}" Margin="0,0,12,0" ToolTip="切换启用 / 禁用" />
                                                                    <!-- 模组名称 -->
                                                                    <neg:NegiStackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Medium"
                                                                                   Foreground="#fafafa" TextTrimming="CharacterEllipsis">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                                            <Setter Property="Foreground" Value="#71717a" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="#52525b" TextTrimming="CharacterEllipsis" />
                                                                    </neg:NegiStackPanel>
                                                                    <!-- 文件大小 -->
                                                                    <TextBlock Grid.Column="2" Text="{Binding FileSizeText}" FontSize="12" Foreground="#71717a"
                                                                               VerticalAlignment="Center" Margin="14,0" />
                                                                    <!-- 修改日期 -->
                                                                    <TextBlock Grid.Column="3" Text="{Binding ModifiedTimeText}" FontSize="11.5" Foreground="#52525b"
                                                                               VerticalAlignment="Center" Margin="0,0,14,0" />
                                                                    <!-- 删除按钮 -->
                                                                    <Button Grid.Column="4" Style="{StaticResource IconBtnStyle}" Width="28" Height="28"
                                                                            Command="{Binding DataContext.DeleteModCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding .}" ToolTip="删除模组">
                                                                        <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="14" Height="14" Foreground="#f87171" />
                                                                    </Button>
                                                                </neg:NegiGrid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </neg:NegiGrid>
                                </Grid>

                                <!-- 3. 资源包 -->
                                <Grid Visibility="{Binding ConfigTab, Converter={StaticResource Equals}, ConverterParameter=资源包}">
                                    <neg:NegiGrid Rows="Auto *">
                                        <!-- 工具条 -->
                                        <neg:NegiGrid Grid.Row="0" Columns="* Auto Auto Auto" Height="32" Margin="0,0,0,12">
                                            <neg:NegiStackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="已安装资源包" FontSize="14" FontWeight="SemiBold" Foreground="#fafafa" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding EditingResourcePackCountText}" FontSize="12.5" Foreground="#71717a" VerticalAlignment="Center" />
                                            </neg:NegiStackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource BtnSmOutlineStyle}" Height="32" Margin="0,0,8,0"
                                                    Command="{Binding AddResourcePackFileCommand}">
                                                <neg:NegiStackPanel Orientation="Horizontal" Spacing="6">
                                                    <materialIcons:MaterialIcon Kind="Plus" Width="14" Height="14" />
                                                    <TextBlock Text="添加资源包" FontSize="12" VerticalAlignment="Center" />
                                                </neg:NegiStackPanel>
                                            </Button>
                                            <Button Grid.Column="2" Style="{StaticResource BtnSmOutlineStyle}" Height="32" Margin="0,0,8,0"
                                                    Command="{Binding OpenEditingResourcePacksCommand}">
                                                <neg:NegiStackPanel Orientation="Horizontal" Spacing="6">
                                                    <materialIcons:MaterialIcon Kind="FolderOutline" Width="14" Height="14" />
                                                    <TextBlock Text="打开文件夹" FontSize="12" VerticalAlignment="Center" />
                                                </neg:NegiStackPanel>
                                            </Button>
                                            <Button Grid.Column="3" Style="{StaticResource BtnSmOutlineStyle}" Height="32"
                                                    Command="{Binding RefreshInstanceManageDataCommand}" ToolTip="刷新资源包列表">
                                                <materialIcons:MaterialIcon Kind="Refresh" Width="14" Height="14" />
                                            </Button>
                                        </neg:NegiGrid>

                                        <!-- 资源包列表 / 空态 -->
                                        <Grid Grid.Row="1">
                                            <!-- 空态 -->
                                            <Border Visibility="{Binding EditingResourcePacks.Count, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                                    Background="#111114" BorderBrush="#26262b" BorderThickness="1" CornerRadius="14"
                                                    Padding="40,32" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <neg:NegiStackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                                    <materialIcons:MaterialIcon Kind="PaletteOutline" Width="38" Height="38" Foreground="#52525b" HorizontalAlignment="Center" />
                                                    <TextBlock Text="暂无资源包" FontSize="14" FontWeight="SemiBold" Foreground="#fafafa" HorizontalAlignment="Center" />
                                                    <TextBlock Text="点击右上角「添加资源包」或将材质包放入 resourcepacks 文件夹" FontSize="12" Foreground="#a1a1aa" HorizontalAlignment="Center" />
                                                </neg:NegiStackPanel>
                                            </Border>

                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding EditingResourcePacks}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#18181b" BorderBrush="#26262b" BorderThickness="1" CornerRadius="10"
                                                                    Padding="14,10" Margin="0,0,0,6">
                                                                <neg:NegiGrid Columns="Auto * Auto Auto Auto">
                                                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="PaletteOutline" Width="18" Height="18"
                                                                                                Foreground="#a1a1aa" Margin="0,0,12,0" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="Medium"
                                                                               Foreground="#fafafa" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="12" Foreground="#71717a"
                                                                               VerticalAlignment="Center" Margin="14,0" />
                                                                    <TextBlock Grid.Column="3" Text="{Binding ModifiedTimeText}" FontSize="11.5" Foreground="#52525b"
                                                                               VerticalAlignment="Center" Margin="0,0,14,0" />
                                                                    <Button Grid.Column="4" Style="{StaticResource IconBtnStyle}" Width="28" Height="28"
                                                                            Command="{Binding DataContext.DeleteResourcePackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding .}" ToolTip="删除资源包">
                                                                        <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="14" Height="14" Foreground="#f87171" />
                                                                    </Button>
                                                                </neg:NegiGrid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </neg:NegiGrid>
                                </Grid>

                                <!-- 4. 世界 (存档) -->
                                <Grid Visibility="{Binding ConfigTab, Converter={StaticResource Equals}, ConverterParameter=世界}">
                                    <neg:NegiGrid Rows="Auto *">
                                        <!-- 工具条 -->
                                        <neg:NegiGrid Grid.Row="0" Columns="* Auto Auto" Height="32" Margin="0,0,0,12">
                                            <neg:NegiStackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="世界存档" FontSize="14" FontWeight="SemiBold" Foreground="#fafafa" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding EditingWorldCountText}" FontSize="12.5" Foreground="#71717a" VerticalAlignment="Center" />
                                            </neg:NegiStackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource BtnSmOutlineStyle}" Height="32" Margin="0,0,8,0"
                                                    Command="{Binding OpenEditingSavesCommand}">
                                                <neg:NegiStackPanel Orientation="Horizontal" Spacing="6">
                                                    <materialIcons:MaterialIcon Kind="FolderOutline" Width="14" Height="14" />
                                                    <TextBlock Text="打开存档文件夹" FontSize="12" VerticalAlignment="Center" />
                                                </neg:NegiStackPanel>
                                            </Button>
                                            <Button Grid.Column="2" Style="{StaticResource BtnSmOutlineStyle}" Height="32"
                                                    Command="{Binding RefreshInstanceManageDataCommand}" ToolTip="刷新世界列表">
                                                <materialIcons:MaterialIcon Kind="Refresh" Width="14" Height="14" />
                                            </Button>
                                        </neg:NegiGrid>

                                        <!-- 世界列表 / 空态 -->
                                        <Grid Grid.Row="1">
                                            <!-- 空态 -->
                                            <Border Visibility="{Binding EditingWorlds.Count, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                                    Background="#111114" BorderBrush="#26262b" BorderThickness="1" CornerRadius="14"
                                                    Padding="40,32" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <neg:NegiStackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                                    <materialIcons:MaterialIcon Kind="Earth" Width="38" Height="38" Foreground="#52525b" HorizontalAlignment="Center" />
                                                    <TextBlock Text="暂无世界存档" FontSize="14" FontWeight="SemiBold" Foreground="#fafafa" HorizontalAlignment="Center" />
                                                    <TextBlock Text="启动游戏创建世界或将存档解压放入 saves 文件夹" FontSize="12" Foreground="#a1a1aa" HorizontalAlignment="Center" />
                                                </neg:NegiStackPanel>
                                            </Border>

                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding EditingWorlds}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#18181b" BorderBrush="#26262b" BorderThickness="1" CornerRadius="10"
                                                                    Padding="14,10" Margin="0,0,0,6">
                                                                <neg:NegiGrid Columns="Auto * Auto Auto Auto">
                                                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="Earth" Width="18" Height="18"
                                                                                                Foreground="#a1a1aa" Margin="0,0,12,0" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="Medium"
                                                                               Foreground="#fafafa" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="2" Text="{Binding LastPlayedText, StringFormat='保存于 {0}'}" FontSize="12" Foreground="#71717a"
                                                                               VerticalAlignment="Center" Margin="14,0" />
                                                                    <Button Grid.Column="3" Style="{StaticResource BtnSmOutlineStyle}" Height="28" Margin="0,0,8,0"
                                                                            Command="{Binding DataContext.OpenWorldFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding .}">
                                                                        <neg:NegiStackPanel Orientation="Horizontal" Spacing="4">
                                                                            <materialIcons:MaterialIcon Kind="FolderOutline" Width="12" Height="12" />
                                                                            <TextBlock Text="打开" FontSize="11.5" VerticalAlignment="Center" />
                                                                        </neg:NegiStackPanel>
                                                                    </Button>
                                                                    <Button Grid.Column="4" Style="{StaticResource IconBtnStyle}" Width="28" Height="28"
                                                                            Command="{Binding DataContext.DeleteWorldCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding .}" ToolTip="删除世界存档">
                                                                        <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="14" Height="14" Foreground="#f87171" />
                                                                    </Button>
                                                                </neg:NegiGrid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </neg:NegiGrid>
                                </Grid>

                                <!-- 5. Java 与内存 -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding ConfigTab, Converter={StaticResource Equals}, ConverterParameter=Java}">
                                    <neg:NegiStackPanel Spacing="16" Margin="0,0,10,0">
                                        <!-- Java 运行时 -->
                                        <Border Background="#18181b" BorderBrush="#26262b" BorderThickness="1" CornerRadius="12" Padding="16,0">
                                            <neg:NegiStackPanel>
                                                <Border Height="54" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                                    <neg:NegiGrid Columns="* Auto">
                                                        <neg:NegiStackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                            <TextBlock Text="独立 Java 运行时" FontWeight="Medium" Foreground="#fafafa" FontSize="13" />
                                                            <TextBlock Text="关掉则跟随设置 → Java 的全局选择" FontSize="12" Foreground="#71717a" />
                                                        </neg:NegiStackPanel>
                                                        <CheckBox Grid.Column="1" IsChecked="{Binding ConfigInstCustomJava}" />
                                                    </neg:NegiGrid>
                                                </Border>
                                                <Border MinHeight="54" Padding="0,10" BorderBrush="#26262b" BorderThickness="0,0,0,1"
                                                        Visibility="{Binding ConfigInstCustomJava, Converter={StaticResource BoolToVis}}">
                                                    <neg:NegiGrid Columns="* Auto">
                                                        <neg:NegiStackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                            <TextBlock Text="运行时版本" FontWeight="Medium" Foreground="#fafafa" FontSize="13" />
                                                            <TextBlock Text="{Binding ConfigInstJavaLabel}" FontSize="12" Foreground="#71717a" TextTrimming="CharacterEllipsis" />
                                                        </neg:NegiStackPanel>
                                                        <neg:NegiStackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <Button Style="{StaticResource BtnSmOutlineStyle}" Width="160"
                                                                    HorizontalContentAlignment="Stretch"
                                                                    Command="{Binding ToggleInstJavaChooserCommand}">
                                                                <neg:NegiGrid Columns="* Auto">
                                                                    <TextBlock Grid.Column="0" Text="选择…" VerticalAlignment="Center" FontSize="12" />
                                                                    <materialIcons:MaterialIcon Grid.Column="1" Kind="ChevronDown" Width="14" Height="14" Foreground="#71717a" />
                                                                </neg:NegiGrid>
                                                            </Button>
                                                            <Button Style="{StaticResource BtnSmOutlineStyle}" Click="OnPickInstJavaClick" ToolTip="浏览自定义路径">
                                                                <neg:NegiStackPanel Orientation="Horizontal" Spacing="4">
                                                                    <materialIcons:MaterialIcon Kind="FolderSearchOutline" Width="14" Height="14" />
                                                                    <TextBlock Text="浏览…" FontSize="12" VerticalAlignment="Center" />
                                                                </neg:NegiStackPanel>
                                                            </Button>
                                                        </neg:NegiStackPanel>
                                                    </neg:NegiGrid>
                                                </Border>
                                                <Border BorderBrush="#26262b" BorderThickness="1" CornerRadius="10" Background="#111114" Padding="4"
                                                        Margin="0,8,0,8" Visibility="{Binding IsInstJavaChooserOpen, Converter={StaticResource BoolToVis}}">
                                                    <ItemsControl ItemsSource="{Binding InstJavaOptions}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Style="{StaticResource MenuRowStyle}"
                                                                        Command="{Binding DataContext.SelectInstJavaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding .}">
                                                                    <neg:NegiGrid Columns="* Auto">
                                                                        <TextBlock Text="{Binding Label}" FontSize="13" Foreground="#fafafa"
                                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                        <materialIcons:MaterialIcon Grid.Column="1" Kind="Check" Width="14" Height="14"
                                                                                                    Foreground="#fafafa"
                                                                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                                                    </neg:NegiGrid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                                <Border Height="54">
                                                    <neg:NegiGrid Columns="* Auto">
                                                        <neg:NegiStackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                            <TextBlock Text="JVM 附加启动参数" FontWeight="Medium" Foreground="#fafafa" FontSize="13" />
                                                            <TextBlock Text="按空白切开，逐条传给这台实例的 Java 进程" FontSize="12" Foreground="#71717a" />
                                                        </neg:NegiStackPanel>
                                                        <TextBox Grid.Column="1" Width="220" Height="32" VerticalAlignment="Center"
                                                                 neg:Negi.CornerRadius="8" Background="#111114" BorderBrush="#26262b"
                                                                 neg:Negi.Placeholder="-XX:+UseG1GC" FontSize="12"
                                                                 Text="{Binding ConfigInstExtraJvmArgs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    </neg:NegiGrid>
                                                </Border>
                                            </neg:NegiStackPanel>
                                        </Border>

                                        <!-- 内存与性能 -->
                                        <Border Background="#18181b" BorderBrush="#26262b" BorderThickness="1" CornerRadius="12" Padding="16,0">
                                            <neg:NegiStackPanel>
                                                <Border Height="54" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                                    <neg:NegiGrid Columns="* Auto">
                                                        <neg:NegiStackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                            <TextBlock Text="独立最大内存" FontWeight="Medium" Foreground="#fafafa" FontSize="13" />
                                                            <TextBlock Text="{Binding GlobalMemoryGbSummary, StringFormat='关掉则跟随全局设置（当前 {0}）'}"
                                                                       FontSize="12" Foreground="#71717a" />
                                                        </neg:NegiStackPanel>
                                                        <CheckBox Grid.Column="1" IsChecked="{Binding ConfigInstCustomMemory}" />
                                                    </neg:NegiGrid>
                                                </Border>
                                                <Border Height="54" BorderBrush="#26262b" BorderThickness="0,0,0,1"
                                                        Visibility="{Binding ConfigInstCustomMemory, Converter={StaticResource BoolToVis}}">
                                                    <neg:NegiGrid Columns="* Auto">
                                                        <TextBlock Text="分配给这个实例" FontWeight="Medium" Foreground="#fafafa" FontSize="13" VerticalAlignment="Center" />
                                                        <neg:NegiStackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                            <Slider Value="{Binding ConfigInstMemoryGb}" Minimum="1" Maximum="32" Width="180" />
                                                            <TextBlock Text="{Binding ConfigInstMemoryGb, StringFormat='{}{0} GB'}"
                                                                       Width="48" TextAlignment="Right" Foreground="#fafafa" FontWeight="Medium" FontSize="13" />
                                                        </neg:NegiStackPanel>
                                                    </neg:NegiGrid>
                                                </Border>
                                                <Border Height="54">
                                                    <neg:NegiGrid Columns="* Auto">
                                                        <neg:NegiStackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                            <TextBlock Text="内存预分配 (Xms)" FontWeight="Medium" Foreground="#fafafa" FontSize="13" />
                                                            <TextBlock Text="启动就把 -Xms 设为 -Xmx，减少 GC 碎片，代价是启动即占满内存"
                                                                       FontSize="12" Foreground="#71717a" />
                                                        </neg:NegiStackPanel>
                                                        <CheckBox Grid.Column="1" IsChecked="{Binding ConfigInstPreallocate}" />
                                                    </neg:NegiGrid>
                                                </Border>
                                            </neg:NegiStackPanel>
                                        </Border>

                                        <Button Style="{StaticResource BtnSmPrimaryStyle}" Content="保存配置" Height="34" Width="100"
                                                HorizontalAlignment="Right" Command="{Binding SaveEditingInstanceCommand}" />
                                    </neg:NegiStackPanel>
                                </ScrollViewer>

                                <!-- 6. 文件与管理 -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding ConfigTab, Converter={StaticResource Equals}, ConverterParameter=目录}">
                                    <neg:NegiStackPanel Spacing="16" Margin="0,0,10,0">
                                        <Border Background="#18181b" BorderBrush="#26262b" BorderThickness="1" CornerRadius="12" Padding="16,0">
                                            <neg:NegiStackPanel>
                                                <Border Height="54" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                                    <neg:NegiGrid Columns="* Auto">
                                                        <neg:NegiStackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                            <TextBlock Text="实例文件夹" FontWeight="Medium" Foreground="#fafafa" FontSize="13" />
                                                            <TextBlock Text="{Binding EditingGameDirectory}" FontSize="12" Foreground="#71717a"
                                                                       TextTrimming="CharacterEllipsis" FontFamily="Consolas" />
                                                        </neg:NegiStackPanel>
                                                        <Button Grid.Column="1" Style="{StaticResource BtnSmOutlineStyle}"
                                                                Command="{Binding OpenInstanceFolderCommand}" CommandParameter="{Binding EditingInstance}">
                                                            <neg:NegiStackPanel Orientation="Horizontal" Spacing="6">
                                                                <materialIcons:MaterialIcon Kind="FolderOutline" Width="14" Height="14" />
                                                                <TextBlock Text="打开" VerticalAlignment="Center" />
                                                            </neg:NegiStackPanel>
                                                        </Button>
                                                    </neg:NegiGrid>
                                                </Border>
                                                <Border Height="54" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                                    <neg:NegiGrid Columns="* Auto">
                                                        <neg:NegiStackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                            <TextBlock Text="存档 (saves)" FontWeight="Medium" Foreground="#fafafa" FontSize="13" />
                                                            <TextBlock Text="{Binding EditingSavesDirectory}" FontSize="12" Foreground="#71717a"
                                                                       TextTrimming="CharacterEllipsis" FontFamily="Consolas" />
                                                        </neg:NegiStackPanel>
                                                        <Button Grid.Column="1" Style="{StaticResource BtnSmOutlineStyle}"
                                                                Command="{Binding OpenEditingSavesCommand}">
                                                            <neg:NegiStackPanel Orientation="Horizontal" Spacing="6">
                                                                <materialIcons:MaterialIcon Kind="FolderOutline" Width="14" Height="14" />
                                                                <TextBlock Text="打开" VerticalAlignment="Center" />
                                                            </neg:NegiStackPanel>
                                                        </Button>
                                                    </neg:NegiGrid>
                                                </Border>
                                                <Border Height="54" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                                    <neg:NegiGrid Columns="* Auto">
                                                        <neg:NegiStackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                            <TextBlock Text="模组 (mods)" FontWeight="Medium" Foreground="#fafafa" FontSize="13" />
                                                            <TextBlock Text="{Binding EditingModsDirectory}" FontSize="12" Foreground="#71717a"
                                                                       TextTrimming="CharacterEllipsis" FontFamily="Consolas" />
                                                        </neg:NegiStackPanel>
                                                        <Button Grid.Column="1" Style="{StaticResource BtnSmOutlineStyle}"
                                                                Command="{Binding OpenEditingModsCommand}">
                                                            <neg:NegiStackPanel Orientation="Horizontal" Spacing="6">
                                                                <materialIcons:MaterialIcon Kind="FolderOutline" Width="14" Height="14" />
                                                                <TextBlock Text="打开" VerticalAlignment="Center" />
                                                            </neg:NegiStackPanel>
                                                        </Button>
                                                    </neg:NegiGrid>
                                                </Border>
                                                <Border Height="54" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                                    <neg:NegiGrid Columns="* Auto">
                                                        <neg:NegiStackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                            <TextBlock Text="资源包 (resourcepacks)" FontWeight="Medium" Foreground="#fafafa" FontSize="13" />
                                                            <TextBlock Text="{Binding EditingResourcePacksDirectory}" FontSize="12" Foreground="#71717a"
                                                                       TextTrimming="CharacterEllipsis" FontFamily="Consolas" />
                                                        </neg:NegiStackPanel>
                                                        <Button Grid.Column="1" Style="{StaticResource BtnSmOutlineStyle}"
                                                                Command="{Binding OpenEditingResourcePacksCommand}">
                                                            <neg:NegiStackPanel Orientation="Horizontal" Spacing="6">
                                                                <materialIcons:MaterialIcon Kind="FolderOutline" Width="14" Height="14" />
                                                                <TextBlock Text="打开" VerticalAlignment="Center" />
                                                            </neg:NegiStackPanel>
                                                        </Button>
                                                    </neg:NegiGrid>
                                                </Border>
                                                <Border Height="54" BorderBrush="#26262b" BorderThickness="0,0,0,1">
                                                    <neg:NegiGrid Columns="* Auto">
                                                        <neg:NegiStackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                            <TextBlock Text="导出整合包" FontWeight="Medium" Foreground="#fafafa" FontSize="13" />
                                                            <TextBlock Text="打包成 .mrpack 或标准 .zip，暂未开放" FontSize="12" Foreground="#71717a" />
                                                        </neg:NegiStackPanel>
                                                        <Button Grid.Column="1" Style="{StaticResource BtnSmOutlineStyle}" Content="导出文件"
                                                                IsEnabled="False" ToolTip="导出整合包功能开发中。" />
                                                    </neg:NegiGrid>
                                                </Border>
                                                <Border Height="54">
                                                    <neg:NegiGrid Columns="* Auto">
                                                        <neg:NegiStackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                                            <TextBlock Text="删除实例" FontWeight="Medium" Foreground="#fafafa" FontSize="13" />
                                                            <TextBlock Text="版本文件夹会一并删除，包含内部所有存档" FontSize="12" Foreground="#f87171" />
                                                        </neg:NegiStackPanel>
                                                        <Button Grid.Column="1" Style="{StaticResource BtnSmDangerStyle}" Content="删除"
                                                                Command="{Binding DeleteEditingInstanceCommand}" />
                                                    </neg:NegiGrid>
                                                </Border>
                                            </neg:NegiStackPanel>
                                        </Border>
                                    </neg:NegiStackPanel>
                                </ScrollViewer>
                            </Grid>
                        </neg:NegiGrid>
                    </neg:NegiGrid>
                </Grid>

                <!-- 页 3：下载（版本/资源浏览器；任务列表是个弹层） -->
                <Grid x:Name="PageDownload" Style="{StaticResource PageAnimStyle}" Visibility="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=download}">
                    <neg:NegiGrid Rows="Auto *">
                        <!-- .page-head -->
                        <neg:NegiGrid Grid.Row="0" Columns="Auto Auto * Auto Auto" Height="36" Margin="0,0,84,16">
                            <TextBlock Grid.Column="0" Text="下载" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#fafafa" Margin="0,0,8,0" />
                            <!-- .tabs -->
                            <Border Grid.Column="1" Background="#1c1c21" CornerRadius="10" Padding="3">
                                <neg:NegiStackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Style="{StaticResource SegmentBtnStyle}" Content="游戏"
                                            neg:Negi.On="{Binding CurrentResCategory, Converter={StaticResource Equals}, ConverterParameter=game}"
                                            Command="{Binding SelectResCategoryCommand}" CommandParameter="game" />
                                    <Button Style="{StaticResource SegmentBtnStyle}" Content="模组"
                                            neg:Negi.On="{Binding CurrentResCategory, Converter={StaticResource Equals}, ConverterParameter=mod}"
                                            Command="{Binding SelectResCategoryCommand}" CommandParameter="mod" />
                                    <Button Style="{StaticResource SegmentBtnStyle}" Content="整合包"
                                            neg:Negi.On="{Binding CurrentResCategory, Converter={StaticResource Equals}, ConverterParameter=pack}"
                                            Command="{Binding SelectResCategoryCommand}" CommandParameter="pack" />
                                    <Button Style="{StaticResource SegmentBtnStyle}" Content="资源包"
                                            neg:Negi.On="{Binding CurrentResCategory, Converter={StaticResource Equals}, ConverterParameter=rp}"
                                            Command="{Binding SelectResCategoryCommand}" CommandParameter="rp" />
                                    <Button Style="{StaticResource SegmentBtnStyle}" Content="光影"
                                            neg:Negi.On="{Binding CurrentResCategory, Converter={StaticResource Equals}, ConverterParameter=shader}"
                                            Command="{Binding SelectResCategoryCommand}" CommandParameter="shader" />
                                </neg:NegiStackPanel>
                            </Border>

                            <!-- 任务列表弹层触发器 -->
                            <Button Grid.Column="3" x:Name="DlPopBtn" Style="{StaticResource BtnSmOutlineStyle}"
                                    Content="下载任务" Command="{Binding ToggleDlPopCommand}"
                                    Margin="0,0,8,0" VerticalAlignment="Center" />

                            <!-- 搜索 -->
                            <TextBox Grid.Column="4" Style="{StaticResource SearchBoxStyle}" Width="240"
                                     neg:Negi.Placeholder="搜索"
                                     Text="{Binding ResourceSearch, UpdateSourceTrigger=PropertyChanged}" />
                        </neg:NegiGrid>

                        <!-- .list -->
                        <ScrollViewer Grid.Row="1" Visibility="{Binding HasResources, Converter={StaticResource BoolToVis}}">
                            <Border Background="#111114" BorderBrush="#26262b" BorderThickness="1" CornerRadius="14" ClipToBounds="True" VerticalAlignment="Top">
                                <ItemsControl ItemsSource="{Binding FilteredResources}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- .list-item -->
                                            <Border BorderBrush="#26262b" BorderThickness="0,0,0,1" Padding="16,12">
                                                <neg:NegiGrid Columns="Auto * Auto Auto">
                                                    <!-- 36x36 像素图标 -->
                                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" ClipToBounds="True" Margin="0,0,14,0">
                                                        <Image Source="{Binding IconBitmap, Converter={StaticResource PixelsToBitmap}}"
                                                               Width="36" Height="36"
                                                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                                    </Border>

                                                    <!-- .grow：名字 + 说明 -->
                                                    <neg:NegiStackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#fafafa" />
                                                        <TextBlock Text="{Binding Desc}" FontSize="12" Foreground="#a1a1aa" TextTrimming="CharacterEllipsis" />
                                                    </neg:NegiStackPanel>

                                                    <!-- .stat -->
                                                    <TextBlock Grid.Column="2" Text="{Binding Stat}"
                                                               FontSize="12" Foreground="#a1a1aa"
                                                               VerticalAlignment="Center" Margin="16,0,16,0" />

                                                    <!-- .btn .btn-outline .btn-sm -->
                                                    <Button Grid.Column="3" Style="{StaticResource BtnSmOutlineStyle}"
                                                            Content="{Binding ActionText}"
                                                            IsEnabled="{Binding IsActionEnabled}"
                                                            Command="{Binding DataContext.InstallResourceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding .}" />
                                                </neg:NegiGrid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </ScrollViewer>

                        <neg:NegiStackPanel Grid.Row="1" Visibility="{Binding HasResources, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <ProgressBar IsIndeterminate="True" Width="120" Height="4" neg:Negi.CornerRadius="2"
                                         Foreground="#fafafa" Background="#26262b"
                                         HorizontalAlignment="Center"
                                         Visibility="{Binding IsLoadingResources, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding ResourceEmptyText}" FontSize="13" Foreground="#a1a1aa"
                                       HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="420"
                                       TextWrapping="Wrap" />
                        </neg:NegiStackPanel>
                    </neg:NegiGrid>
                </Grid>

                <!-- 普通设置页和浮窗共用设置模板与状态。 -->
                <Grid x:Name="PageSettings" Style="{StaticResource PageAnimStyle}"
                      Visibility="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=settings}">
                    <neg:NegiGrid Rows="Auto *">
                        <neg:NegiGrid Columns="* Auto" Margin="0,0,0,16">
                            <TextBlock Text="设置" FontSize="20" FontWeight="SemiBold" Height="36"
                                       VerticalAlignment="Center" Foreground="#fafafa" />
                            <Button x:Name="SettingsWindowModeButton" Grid.Column="1"
                                    Style="{StaticResource BtnSmOutlineStyle}" Height="32" Margin="0,0,84,0"
                                    Click="OnSettingsModeClick" ToolTip="将设置的默认打开方式改为窗口"
                                    AutomationProperties.Name="切换为窗口模式">
                                <neg:NegiStackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="CogOutline" Width="16" Height="16" />
                                    <TextBlock Text="切换为窗口模式" VerticalAlignment="Center" />
                                </neg:NegiStackPanel>
                            </Button>
                        </neg:NegiGrid>
                        <neg:NegiGrid Grid.Row="1" Columns="160 24 *">
                            <ContentControl x:Name="PageSettingsNavHost" HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Top" />
                            <ScrollViewer x:Name="PageSettingsScroll" Grid.Column="2"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ContentControl x:Name="PageSettingsCardsHost" HorizontalContentAlignment="Stretch" />
                            </ScrollViewer>
                        </neg:NegiGrid>
                    </neg:NegiGrid>
                </Grid>
            </Grid>

        </Grid>

                <!-- 设置浮窗：背景冻结后模糊，弹窗沿用已优化的动画。 -->
                <Grid x:Name="SettingsOverlay" Panel.ZIndex="70" Visibility="Collapsed"
                      PreviewKeyDown="OnSettingsPreviewKeyDown">
                    <Grid x:Name="SettingsScrim" MouseLeftButtonDown="OnSettingsBackdropClick" Background="#09090b">
                        <Image x:Name="SettingsBackdrop" Stretch="Fill" IsHitTestVisible="False" />
                        <Border Background="#68000000" IsHitTestVisible="False" />
                    </Grid>
                    <Grid x:Name="SettingsDialog" MaxWidth="1020" MaxHeight="620" Margin="32"
                          Style="{StaticResource PopoverStyle}"
                          pop:Pop.Anchor="Center" pop:Pop.SlideOnly="True"
                          KeyboardNavigation.TabNavigation="Cycle"
                          KeyboardNavigation.ControlTabNavigation="Cycle"
                          FocusManager.IsFocusScope="True">
                    <Border Background="#18181b" BorderBrush="#3b3b40" BorderThickness="1" CornerRadius="8"
                            SizeChanged="OnSettingsFrameSizeChanged">

                        <neg:NegiGrid Columns="184 *">
                            <Border Background="#141416" BorderBrush="#343438" BorderThickness="0,0,1,0" Padding="14,22,14,16">
                            <neg:NegiGrid Rows="Auto * Auto">
                                <neg:NegiStackPanel Orientation="Horizontal" Spacing="10" Margin="10,0,0,22">
                                    <materialIcons:MaterialIcon Kind="CogOutline" Width="18" Height="18" />
                                    <TextBlock Text="设置" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </neg:NegiStackPanel>
                            <ContentControl x:Name="DialogSettingsNavHost" Grid.Row="1"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" />
                                <TextBlock Grid.Row="2" Text="NegiCraft Launcher" FontSize="11" Foreground="#81818b" Margin="10,16,0,0" />
                            </neg:NegiGrid>
                            </Border>
                            <neg:NegiGrid Grid.Column="1" Rows="Auto *" Margin="24,20,18,20">
                                <neg:NegiGrid Columns="* Auto Auto" Margin="0,0,4,20">
                                    <TextBlock Text="{Binding CurrentSettingsTab}" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button x:Name="SettingsPageModeButton" Grid.Column="1"
                                            Style="{StaticResource BtnSmOutlineStyle}" Height="32" Margin="12,0,8,0"
                                            Click="OnSettingsModeClick" ToolTip="将设置的默认打开方式改为页面"
                                            AutomationProperties.Name="切换为页面模式">
                                        <neg:NegiStackPanel Orientation="Horizontal" Spacing="6">
                                            <materialIcons:MaterialIcon Kind="CogOutline" Width="16" Height="16" />
                                            <TextBlock Text="切换为页面模式" VerticalAlignment="Center" />
                                        </neg:NegiStackPanel>
                                    </Button>
                                    <Button x:Name="SettingsCloseButton" Grid.Column="2" Style="{StaticResource WinCtrlStyle}"
                                            Width="32" Height="32" Click="OnSettingsCloseClick" ToolTip="关闭设置"
                                            AutomationProperties.Name="关闭设置">
                                        <materialIcons:MaterialIcon Kind="Close" Width="18" Height="18" />
                                    </Button>
                                </neg:NegiGrid>
                            <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

                            <!-- .set-card：每个标签一张卡，让每组都以一条无边框的行收尾。
                                 Debug 卡同样由 MainWindow.Debug.cs 代码追加（仅 Debug 构建）。 -->
                            <ContentControl x:Name="DialogSettingsCardsHost" HorizontalContentAlignment="Stretch" />
                            </ScrollViewer>
                            </neg:NegiGrid>
                        </neg:NegiGrid>
                    </Border>
                    </Grid>
                </Grid>

            <!-- ========================================== -->
            <!-- 6. 弹层外的点击遮罩（点外面就关）             -->
            <!-- ========================================== -->
            <Grid Background="Transparent"
                  Panel.ZIndex="45"
                  MouseLeftButtonDown="OnPopoverBackdropMouseDown"
                  Visibility="{Binding HasOpenPopover, Converter={StaticResource BoolToVis}}" />

            <!-- ========================================== -->
            <!-- 7. 弹层                                      -->
            <!-- ========================================== -->
            <!-- #accPop：left 84 / bottom 12 / 宽 280 -->
            <Grid HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Margin="84,0,0,12" Width="280"
                    Style="{StaticResource PopoverStyle}"
                    pop:Pop.Anchor="BottomLeft"
                    pop:Pop.Trigger="{Binding ElementName=AccountAvatar}"
                    pop:Pop.IsOpen="{Binding IsAccPopOpen}"
                    Panel.ZIndex="50">
                <Border Background="#111114" BorderBrush="#26262b" BorderThickness="1"
                        CornerRadius="14" Padding="6" Effect="{StaticResource ShadowLg}">
                <neg:NegiStackPanel Spacing="2">
                    <ScrollViewer MaxHeight="260">
                        <ItemsControl ItemsSource="{Binding Accounts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <neg:NegiGrid Columns="* Auto" Margin="0,1,0,1">
                                        <Button Grid.Column="0" Style="{StaticResource MenuRowStyle}"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Command="{Binding DataContext.SelectAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding .}">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="删除账户"
                                                              Command="{Binding PlacementTarget.Tag.RemoveAccountCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding .}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <neg:NegiGrid Columns="Auto * Auto">
                                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" ClipToBounds="True" Margin="0,0,10,0">
                                                    <Image Source="{Binding AvatarBitmap, Converter={StaticResource PixelsToBitmap}}" Width="30" Height="30" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                                </Border>
                                                <neg:NegiStackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#fafafa" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Type}" FontSize="12" Foreground="#a1a1aa" />
                                                </neg:NegiStackPanel>
                                                <!-- 当前账号打勾 -->
                                                <materialIcons:MaterialIcon Grid.Column="2" Kind="Check" Width="16" Height="16" Foreground="#fafafa"
                                                                            Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}" Margin="0,0,4,0" />
                                            </neg:NegiGrid>
                                        </Button>
                                        <!-- 直接删除按钮 -->
                                        <Button Grid.Column="1" Style="{StaticResource IconBtnDangerStyle}" Width="28" Height="28" Margin="4,0,2,0"
                                                ToolTip="删除账户"
                                                Command="{Binding DataContext.RemoveAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding .}">
                                            <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="15" Height="15" Foreground="#71717a" />
                                        </Button>
                                    </neg:NegiGrid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 分隔线 -->
                    <Rectangle Height="1" Fill="#26262b" Margin="0,6,0,6" Visibility="{Binding HasAccounts, Converter={StaticResource BoolToVis}}" />

                    <Button Style="{StaticResource MenuRowStyle}" Command="{Binding AddOfflineAccountCommand}">
                        <neg:NegiStackPanel Orientation="Horizontal" Spacing="10">
                            <materialIcons:MaterialIcon Kind="AccountPlusOutline" Width="18" Height="18" Foreground="#a1a1aa" Margin="7,0" />
                            <TextBlock Text="添加离线账户" FontSize="13" Foreground="#fafafa" VerticalAlignment="Center" />
                        </neg:NegiStackPanel>
                    </Button>

                    <!-- 等有 Azure 应用 id 之后再开放；命令里会说明原因 -->
                    <Button Style="{StaticResource MenuRowStyle}" Command="{Binding AddMicrosoftAccountCommand}">
                        <neg:NegiStackPanel Orientation="Horizontal" Spacing="10">
                            <materialIcons:MaterialIcon Kind="Microsoft" Width="18" Height="18" Foreground="#a1a1aa" Margin="7,0" />
                            <TextBlock Text="添加微软账户" FontSize="13" Foreground="#71717a" VerticalAlignment="Center" />
                        </neg:NegiStackPanel>
                    </Button>
                </neg:NegiStackPanel>
                </Border>
            </Grid>

            <!-- #instPop：正好在停靠栏上方 8px（bottom 100）/ 宽 380 -->
            <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,20,100" Width="380"
                    Style="{StaticResource PopoverStyle}"
                    pop:Pop.Anchor="BottomLeft"
                    pop:Pop.Trigger="{Binding ElementName=InstSelectBtn}"
                    pop:Pop.IsOpen="{Binding IsInstPopOpen}"
                    Panel.ZIndex="50">
                <Border Background="#111114" BorderBrush="#26262b" BorderThickness="1"
                        CornerRadius="14" Padding="6" Effect="{StaticResource ShadowLg}">
                <neg:NegiStackPanel Spacing="2">
                    <ScrollViewer MaxHeight="300">
                        <ItemsControl ItemsSource="{Binding Instances}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MenuRowStyle}"
                                            Command="{Binding DataContext.SelectInstanceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding .}">
                                        <neg:NegiGrid Columns="Auto * Auto">
                                            <!-- 32x32 方块图标，圆角 7 -->
                                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="7" ClipToBounds="True" Margin="0,0,10,0">
                                                <Image Source="{Binding IconBitmap, Converter={StaticResource PixelsToBitmap}}" Width="32" Height="32" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                            </Border>
                                            <neg:NegiStackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#fafafa" />
                                                <TextBlock Text="{Binding MetaText}" FontSize="12" Foreground="#a1a1aa" />
                                            </neg:NegiStackPanel>
                                            <!-- 当前实例打勾 -->
                                            <materialIcons:MaterialIcon Grid.Column="2" Kind="Check" Width="16" Height="16" Foreground="#fafafa"
                                                                        Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}" />
                                        </neg:NegiGrid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Rectangle Height="1" Fill="#26262b" Margin="0,6,0,6" Visibility="{Binding HasInstances, Converter={StaticResource BoolToVis}}" />

                    <Button Style="{StaticResource MenuRowStyle}" Command="{Binding NewInstanceCommand}">
                        <neg:NegiStackPanel Orientation="Horizontal" Spacing="10">
                            <materialIcons:MaterialIcon Kind="Plus" Width="18" Height="18" Foreground="#a1a1aa" Margin="7,0" />
                            <TextBlock Text="安装新版本" FontSize="13" Foreground="#fafafa" VerticalAlignment="Center" />
                        </neg:NegiStackPanel>
                    </Button>
                </neg:NegiStackPanel>
                </Border>
            </Grid>

            <!-- ========================================== -->
            <!-- 7a2. 加载器筛选下拉（挂在实例页工具条那颗按钮上） -->
            <!-- ========================================== -->
            <!-- 选项由 VM 的 LoaderChoices 生成：只列实例里真出现过的加载器。
                 种类再多也不会把工具条撑爆，没装过的类型也不摆出来碍事。 -->
            <!-- 停的位置由 Pop.Pin 按那颗按钮的矩形现算（UnderLeft = 左边与按钮齐、上沿在按钮下方 6），
                 和稿子里 `p.style.left=r.left; p.style.top=r.bottom+6` 是同一条规则。
                 以前的 Margin 是手量的窗口坐标 —— 按钮在工具条第几格、搜索框多宽都会挪它，量一次坏一次。
                 这里留的 Margin 只在 Pin 量不到（首次布局还没跑完）时兜底。 -->
            <Grid x:Name="LoaderPop" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="0,102,0,0" Width="208"
                    Style="{StaticResource PopoverStyle}"
                    pop:Pop.Anchor="TopLeft"
                    pop:Pop.Pin="UnderLeft"
                    pop:Pop.PinGap="6"
                    pop:Pop.Trigger="{Binding ElementName=LoaderFilterBtn}"
                    pop:Pop.IsOpen="{Binding IsLoaderPopOpen}"
                    Panel.ZIndex="50">
                <Border Background="#111114" BorderBrush="#26262b" BorderThickness="1"
                        CornerRadius="14" Padding="6" Effect="{StaticResource ShadowLg}">
                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                    <ItemsControl HorizontalContentAlignment="Stretch" ItemsSource="{Binding LoaderChoices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource MenuRowStyle}"
                                        Command="{Binding DataContext.SelectInstanceLoaderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Name}">
                                    <neg:NegiGrid Columns="* Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="13" Foreground="#fafafa" VerticalAlignment="Center" />
                                        <materialIcons:MaterialIcon Grid.Column="1" Kind="Check" Width="16" Height="16" Foreground="#fafafa"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                    </neg:NegiGrid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                </Border>
            </Grid>

            <!-- ========================================== -->
            <!-- 7a3. 目录切换浮层（挂在页头那颗胶囊上）      -->
            <!-- ========================================== -->
            <!-- 每个目录是一棵自己的 .minecraft：versions/ 各扫各的，实例元数据按目录分开存。
                 每行右边那颗「⋯」和行右键是同一个菜单（重命名 / 设为默认 / 复制路径 / 移除）。
                 选中态不再打勾，直接给 muted 底 —— 稿子定的口径。 -->
            <!-- 停的位置交给 Pop.Pin：UnderRight + 间隙 6，右边缘与按钮对齐展开。
                 下面的 Margin 只是 Pin 量不到时的兜底位置。 -->
            <Grid x:Name="FolderPop" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="0,102,0,0" Width="300"
                    Style="{StaticResource PopoverStyle}"
                    pop:Pop.Anchor="TopRight"
                    pop:Pop.Pin="UnderRight"
                    pop:Pop.PinGap="6"
                    pop:Pop.Trigger="{Binding ElementName=FolderPillBtn}"
                    pop:Pop.IsOpen="{Binding IsFolderPopOpen}"
                    Panel.ZIndex="50">
                <Border Background="#111114" BorderBrush="#26262b" BorderThickness="1"
                        CornerRadius="12" Padding="4" Effect="{StaticResource ShadowLg}">
                <!-- 稿子 .folder-pop-list{gap:2px}；垂直滚动条要 Auto —— WPF 的 ScrollViewer 默认是
                     Visible，会一直占掉右边 10px，只有一个目录时那 10px 就变成浮层右边的一条空档。 -->
                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                    <ItemsControl HorizontalContentAlignment="Stretch" ItemsSource="{Binding Folders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- 稿子 .folder-pop-list{gap:2px}：行与行之间留缝，选中/hover 的底色
                                     才不会连成一整块看不出边界。 -->
                                <neg:NegiStackPanel Orientation="Vertical" Spacing="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource FolderRowStyle}"
                                        neg:Negi.On="{Binding IsCurrent}"
                                        Command="{Binding DataContext.SelectFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Path}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="重命名目录"
                                                      Command="{Binding PlacementTarget.Tag.RenameFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding Path}" />
                                            <MenuItem Header="设为默认目录"
                                                      Command="{Binding PlacementTarget.Tag.SetDefaultFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding Path}" />
                                            <MenuItem Header="复制路径" Click="OnCopyFolderPath" />
                                            <Separator />
                                            <MenuItem Header="移除此目录" Foreground="#f87171"
                                                      Command="{Binding PlacementTarget.Tag.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding Path}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>

                                    <neg:NegiGrid Columns="Auto * Auto">
                                        <materialIcons:MaterialIcon Grid.Column="0" Kind="FolderOutline" Width="16" Height="16"
                                                                    Foreground="#a1a1aa" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <!-- 名字与路径之间的间距靠行高给（稿子 .folder-pop-item .grow 的 line-height:1.25），不另加 Spacing。 -->
                                        <neg:NegiStackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <neg:NegiStackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Name}" FontSize="13"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="170" VerticalAlignment="Center">
                                                    <!-- 稿子 .folder-pop-item b{font-weight:500}，选中那条 .on b{600}。
                                                         字重写在 Style 里而不是属性上：属性上的局部值会压住触发器。 -->
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="FontWeight" Value="Medium" />
                                                            <Setter Property="Foreground" Value="#fafafa" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <!-- 「默认」是 .badge 那一套：透明底 + 1px 描边，行内覆写 height 16 / 字号 10 / padding 0 5。
                                                     实心块会比旁边的目录名更抢眼，而它只是个状态。 -->
                                                <Border Height="16" Padding="5,0" CornerRadius="8"
                                                        BorderBrush="#26262b" BorderThickness="1"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="默认" FontSize="10" Foreground="#a1a1aa" VerticalAlignment="Center" />
                                                </Border>
                                            </neg:NegiStackPanel>
                                            <!-- 目录不在了要说清楚：路径念一遍不如这一句有用（拔了移动硬盘不是 bug）。 -->
                                            <TextBlock Text="{Binding Path}" FontSize="11" Foreground="#71717a"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       Visibility="{Binding Exists, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="这个目录已经不在了" FontSize="11" Foreground="#f87171"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding Exists, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                        </neg:NegiStackPanel>
                                        <Button Grid.Column="2" Width="24" Height="24"
                                                VerticalAlignment="Center" ToolTip="目录设置" Click="OnRowMoreClick">
                                            <Button.Style>
                                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource IconBtnStyle}">
                                                    <!-- 稿子把这颗「⋯」做成 hover 才露出来：右键开的是同一个菜单，
                                                         每行常驻一颗只会一路喊"这里还有东西"。 -->
                                                    <Setter Property="Opacity" Value="0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                            <Setter Property="Opacity" Value="0.75" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <materialIcons:MaterialIcon Kind="DotsHorizontal" Width="13" Height="13" Foreground="#a1a1aa" />
                                        </Button>
                                    </neg:NegiGrid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                </Border>
            </Grid>

            <!-- ========================================== -->
            <!-- 7b. 下载任务弹层（挂在下载页的「下载任务」按钮上） -->
            <!-- ========================================== -->
            <Grid HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,64,112,0" Width="440"
                    Style="{StaticResource PopoverStyle}"
                    pop:Pop.Anchor="TopRight"
                    pop:Pop.Trigger="{Binding ElementName=DlPopBtn}"
                    pop:Pop.IsOpen="{Binding IsDlPopOpen}"
                    Panel.ZIndex="50">
                <Border Background="#111114" BorderBrush="#26262b" BorderThickness="1"
                        CornerRadius="14" Padding="4" ClipToBounds="True" Effect="{StaticResource ShadowLg}">
                <neg:NegiGrid Rows="Auto *">
                    <neg:NegiGrid Grid.Row="0" Columns="* Auto" Margin="10,8,10,10">
                        <TextBlock Grid.Column="0" Text="下载任务" FontWeight="SemiBold" FontSize="13"
                                   Foreground="#fafafa" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource BtnSmOutlineStyle}" Content="清除已完成"
                                Command="{Binding ClearDownloadsCommand}" />
                    </neg:NegiGrid>

                    <ScrollViewer Grid.Row="1" MaxHeight="380" Visibility="{Binding HasDownloads, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Downloads}"
                                      ItemTemplate="{StaticResource DownloadRowTemplate}" />
                    </ScrollViewer>

                    <TextBlock Grid.Row="1" Text="暂无下载任务" Visibility="{Binding HasDownloads, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                               FontSize="13" Foreground="#a1a1aa"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,28,0,28" />
                </neg:NegiGrid>
                </Border>
            </Grid>

            <!-- ========================================== -->
            <!-- 8. 背景取景三件套（自选壁纸时才出现）        -->
            <!-- ========================================== -->
            <!-- 调节卡片已经搬去独立窗口（Views/BackgroundTuningWindow），主窗口里只留
                 "看"的东西：中上一句提示、右上角一格画中画、底下一条操作说明。
                 提示说的是画中画那一格 —— 它只是预览，别误当成又贴了一张壁纸。 -->
            <!-- 调节模式的独占层：按住拖 = 平移，滚轮 = 缩放。
                 它压在侧栏 / 皮肤 / 停靠栏**之上**（ZIndex 44，比它们都高），所以调节期间
                 那些控件是点不动的 —— 否则一边调一边能翻到别的页、甚至把游戏启动了，
                 而背景只在首页存在，调节窗就成了在调一个看不见的东西。
                 顶部让出 52px：窗口按钮和拖窗口那条得一直能用。
                 ⚠️ 这里绝不调 DragMove()：那是拖窗口，本层拖的是背景。 -->
            <Grid x:Name="BgPanSurface" Panel.ZIndex="44" Background="Transparent" Cursor="SizeAll"
                  Margin="0,52,0,0"
                  Visibility="{Binding IsFramingVisible, Converter={StaticResource BoolToVis}}"
                  MouseLeftButtonDown="OnBackgroundPanDown"
                  MouseMove="OnBackgroundPanMove"
                  MouseLeftButtonUp="OnBackgroundPanUp"
                  LostMouseCapture="OnBackgroundPanLostCapture"
                  MouseWheel="OnBackgroundWheel" />

            <Border x:Name="BgHintPill" Panel.ZIndex="45" Cursor="SizeAll"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,0"
                    Background="#E6111114" BorderBrush="#26262b" BorderThickness="1"
                    CornerRadius="15" Padding="11,0" Height="30"
                    Effect="{StaticResource ShadowToast}"
                    MouseLeftButtonDown="OnHintPillMouseDown"
                    MouseMove="OnFloatDragMove"
                    MouseLeftButtonUp="OnFloatDragEnd"
                    LostMouseCapture="OnFloatDragLostCapture"
                    Visibility="{Binding IsFramingVisible, Converter={StaticResource BoolToVis}}">
                <neg:NegiStackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="ImageFrame" Width="13" Height="13"
                                                Foreground="#a1a1aa" VerticalAlignment="Center" />
                    <TextBlock Text="背景预览" FontSize="12" Foreground="#d4d4d8" VerticalAlignment="Center" />
                </neg:NegiStackPanel>
            </Border>

            <!-- 画中画：整张图 contain 进这格，白框 = 窗口真正看得见的那一块。
                 两个矩形都来自共享的 BackgroundFrame.ComputeCoverage，和背景用的是同一组数，
                 所以它不可能和真实取景对不上。位图复用主层那张已冻结的（零额外解码/转换）。
                 ⚠️ 视频没有解码缓冲，画不出缩略图，所以这格只给自选图片看。 -->
            <!-- 画中画：整张图 contain 进来，白框 = 窗口真正看得见的那一块。两个矩形都来自共享的
                 ComputeCoverage，和背景用的是同一组数，所以它不可能和真实取景对不上。
                 位图复用主层那张已冻结的（零额外解码/转换）；视频没有解码缓冲，就只画几何。
                 外围那层底色/描边去掉了 —— 只留图本身和主窗口同款那圈阴影。 -->
            <Border x:Name="BgShot" Panel.ZIndex="45" Cursor="SizeAll"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,52,14,0"
                    Width="156" Height="95" CornerRadius="6" ClipToBounds="True"
                    Effect="{StaticResource WindowShadowEffect}"
                    MouseLeftButtonDown="OnBackgroundShotMouseDown"
                    MouseMove="OnFloatDragMove"
                    MouseLeftButtonUp="OnFloatDragEnd"
                    LostMouseCapture="OnFloatDragLostCapture"
                    Visibility="{Binding IsFramingVisible, Converter={StaticResource BoolToVis}}">
                <!-- ⚠️ 必须是 Canvas：两个矩形是按 Canvas.Left/Top 定位的，放在 Grid 里
                     那两个附加属性等于不存在，矩形会被布局摆成居中 —— 视频时里面没图，
                     结果就是"画中画什么都没有"。 -->
                <Canvas>
                    <!-- 描边画的是"整张画面"的边界：自选图片有缩略图时它贴着图边几乎看不见，
                         而视频没有缓冲可画（Fill 是空的），全靠这条线才看得出"我们只看到中间这块"。 -->
                    <Rectangle x:Name="BgShotImage" Stretch="Fill"
                               Stroke="#3f3f46" StrokeThickness="1" />
                    <Rectangle x:Name="BgShotView" Stroke="#fafafa" StrokeThickness="1.5" RadiusX="3" RadiusY="3" />
                </Canvas>
            </Border>

            <!-- 操作说明：窗口最下面。左右分别是停靠栏和进度卡，居中这条正好落在它们中间。 -->
            <Border Panel.ZIndex="45"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"
                    Background="#E6111114" BorderBrush="#26262b" BorderThickness="1"
                    CornerRadius="15" Padding="12,0" Height="30"
                    Effect="{StaticResource ShadowToast}"
                    Visibility="{Binding IsFramingVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="在背景上按住拖动即可平移，滚轮缩放"
                           FontSize="12" Foreground="#d4d4d8" VerticalAlignment="Center" />
            </Border>

            <!-- ========================================== -->
            <!-- 9. 横幅（瞬时状态提示）                       -->
            <!-- ========================================== -->
            <!-- 启动停靠栏占着右下角，所以提示从顶部边缘垂下来，不跟它撞。 -->
            <Grid HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,20,0,0" MaxWidth="520"
                    Style="{StaticResource PopoverStyle}"
                    pop:Pop.Anchor="TopCenter"
                    pop:Pop.IsOpen="{Binding IsBannerOpen}"
                    Panel.ZIndex="65">
                <Border Background="#F2111114" BorderBrush="#26262b" BorderThickness="1"
                        CornerRadius="12" Padding="14,10" Effect="{StaticResource ShadowToast}">
                <neg:NegiGrid Columns="Auto * Auto">
                    <materialIcons:MaterialIcon Grid.Column="0" Kind="InformationOutline" Width="16" Height="16"
                                                Foreground="#a1a1aa" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding BannerText}" FontSize="13" Foreground="#fafafa"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="2" Style="{StaticResource WinCtrlStyle}" Width="22" Height="22" neg:Negi.CornerRadius="6"
                            Margin="10,0,0,0" VerticalAlignment="Center"
                            Command="{Binding DismissBannerCommand}" ToolTip="关闭">
                        <materialIcons:MaterialIcon Kind="Close" Width="13" Height="13" />
                    </Button>
                </neg:NegiGrid>
                </Border>
            </Grid>

            <!-- ========================================== -->
            <!-- 10. 对话框（窗口内的输入 / 确认）              -->
            <!-- ========================================== -->
            <Grid Panel.ZIndex="70">
                <Border Background="#A6000000" Visibility="{Binding IsDialogOpen, Converter={StaticResource BoolToVis}}"
                        MouseLeftButtonDown="OnDialogBackdropMouseDown" />

                <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                        Width="400"
                        Style="{StaticResource PopoverStyle}"
                        pop:Pop.Anchor="Center"
                        pop:Pop.IsOpen="{Binding IsDialogOpen}">
                    <Border Background="#111114" BorderBrush="#26262b" BorderThickness="1"
                            CornerRadius="16" Padding="22,20" Effect="{StaticResource ShadowLg}">
                    <neg:NegiStackPanel Spacing="14">
                        <TextBlock Text="{Binding DialogTitle}" FontSize="16" FontWeight="SemiBold" Foreground="#fafafa" />

                        <TextBlock Text="{Binding DialogMessage}" FontSize="13" Foreground="#a1a1aa"
                                   TextWrapping="Wrap" LineHeight="20"
                                   Visibility="{Binding HasDialogMessage, Converter={StaticResource BoolToVis}}" />

                        <TextBox x:Name="DialogInputBox"
                                 Text="{Binding DialogInput, Mode=TwoWay}"
                                 neg:Negi.Placeholder="{Binding DialogPlaceholder}"
                                 Visibility="{Binding DialogHasInput, Converter={StaticResource BoolToVis}}"
                                 Background="#1c1c21" BorderBrush="#26262b" BorderThickness="1"
                                 neg:Negi.CornerRadius="10" Foreground="#fafafa"
                                 KeyDown="OnDialogInputKeyDown" />

                        <neg:NegiStackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Style="{StaticResource BtnSmOutlineStyle}" Content="取消" Command="{Binding CancelDialogCommand}" />
                            <Button Style="{StaticResource BtnSmPrimaryStyle}" Content="{Binding DialogConfirmText}"
                                    Command="{Binding ConfirmDialogCommand}" />
                        </neg:NegiStackPanel>
                    </neg:NegiStackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ========================================== -->
            <!-- 10.4 导入整合包 / 添加已有目录 / 拖放遮罩     -->
            <!-- ========================================== -->
            <!-- 导入的进度同时进右下角的任务列表：这份活和装一个版本是同一量级，不该只在这张对话框里可见。 -->
            <Grid Panel.ZIndex="72" Visibility="{Binding IsPackImportOpen, Converter={StaticResource BoolToVis}}">
                <Border Background="#A6000000" MouseLeftButtonDown="OnPackBackdropMouseDown" />

                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="480"
                        Style="{StaticResource PopoverStyle}"
                        pop:Pop.Anchor="Center"
                        pop:Pop.IsOpen="{Binding IsPackImportOpen}">
                    <Border Background="#111114" BorderBrush="#26262b" BorderThickness="1"
                            CornerRadius="16" Padding="24,18" Effect="{StaticResource ShadowLg}">
                    <neg:NegiStackPanel Spacing="14">
                        <neg:NegiGrid Columns="Auto * Auto">
                            <materialIcons:MaterialIcon Grid.Column="0" Kind="PackageVariantClosed" Width="22" Height="22"
                                                        Foreground="#fafafa" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <neg:NegiStackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="导入整合包" FontSize="16" FontWeight="SemiBold" Foreground="#fafafa" />
                                <TextBlock Text="支持 Modrinth (.mrpack)、CurseForge (.zip)、MultiMC / Prism 与一整份 .minecraft 的压缩包"
                                           FontSize="12" Foreground="#a1a1aa" TextWrapping="Wrap" />
                            </neg:NegiStackPanel>
                            <Button Grid.Column="2" Style="{StaticResource WinCtrlStyle}" Width="26" Height="26"
                                    neg:Negi.CornerRadius="7" VerticalAlignment="Top"
                                    Command="{Binding ClosePackImportCommand}" ToolTip="关闭">
                                <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" />
                            </Button>
                        </neg:NegiGrid>

                        <!-- 拖拽区：点它和把文件拖进窗口是同一件事（都走 OfferPackFile）。
                             选了文件之后这一格就改成念文件名，省得用户不确定到底选中了什么。 -->
                        <Grid Height="104" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="OnPickPackFileClick">
                            <!-- 虚线只有 Shape 有 StrokeDashArray，WPF 的 Border 画不出来。
                                 描边色写在 Style 里，本地值会压过触发器，hover 那条才改得动。 -->
                            <Rectangle RadiusX="12" RadiusY="12" StrokeThickness="2" StrokeDashArray="5 4">
                                <Rectangle.Style>
                                    <Style TargetType="{x:Type Rectangle}">
                                        <Setter Property="Stroke" Value="#26262b" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                                <Setter Property="Stroke" Value="#52525b" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                            <neg:NegiStackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="PackageVariantClosed" Width="26" Height="26"
                                                            Foreground="#a1a1aa" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding PackDropTitle}"
                                           FontSize="13.5" FontWeight="SemiBold" Foreground="#fafafa"
                                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="380" />
                                <TextBlock Text="支持 .mrpack 与 .zip；rar 解不了" FontSize="12"
                                           Foreground="#71717a" HorizontalAlignment="Center" />
                            </neg:NegiStackPanel>
                        </Grid>

                        <neg:NegiStackPanel Spacing="6">
                            <TextBlock Text="安装到" FontSize="13" FontWeight="Medium" Foreground="#fafafa" />
                            <!-- 目录不多，一排 chip 比下拉少一层弹窗；只有一个目录时也照样摆，看得见落到哪。 -->
                            <ItemsControl ItemsSource="{Binding Folders}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <neg:NegiStackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource PickChipStyle}" Content="{Binding Name}"
                                                MaxWidth="180"
                                                neg:Negi.On="{Binding IsPackTarget}"
                                                ToolTip="{Binding Path}"
                                                Command="{Binding DataContext.SelectPackTargetFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Path}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </neg:NegiStackPanel>

                        <neg:NegiStackPanel Spacing="6">
                            <TextBlock Text="实例名称" FontSize="13" FontWeight="Medium" Foreground="#fafafa" />
                            <TextBox neg:Negi.CornerRadius="8" Background="#1c1c21" BorderBrush="#26262b"
                                     neg:Negi.Placeholder="默认用压缩包的名字" Text="{Binding PackInstanceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </neg:NegiStackPanel>

                        <neg:NegiStackPanel Spacing="6" Visibility="{Binding IsPackImportBusy, Converter={StaticResource BoolToVis}}">
                            <neg:NegiGrid Columns="* Auto">
                                <TextBlock Grid.Column="0" Text="{Binding PackStageText}" FontSize="12" Foreground="#a1a1aa" />
                                <TextBlock Grid.Column="1" Text="{Binding PackProgressText}" FontSize="12" Foreground="#a1a1aa" />
                            </neg:NegiGrid>
                            <ProgressBar Value="{Binding PackProgressValue}" Maximum="100" Height="4"
                                         neg:Negi.CornerRadius="2" Foreground="#fafafa" Background="#407f7f7f" />
                        </neg:NegiStackPanel>

                        <neg:NegiStackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <Button Style="{StaticResource BtnSmOutlineStyle}" Content="取消"
                                    Command="{Binding ClosePackImportCommand}" />
                            <Button Style="{StaticResource BtnSmPrimaryStyle}" Content="开始导入"
                                    IsEnabled="{Binding CanStartPackImport}"
                                    Command="{Binding StartPackImportCommand}" />
                        </neg:NegiStackPanel>
                    </neg:NegiStackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- 添加已有目录：关联本地现成的 .minecraft，让它进目录列表。这里只登记，不动盘上的东西。 -->
            <Grid Panel.ZIndex="72" Visibility="{Binding IsAddFolderOpen, Converter={StaticResource BoolToVis}}">
                <Border Background="#A6000000" MouseLeftButtonDown="OnAddFolderBackdropMouseDown" />

                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="480"
                        Style="{StaticResource PopoverStyle}"
                        pop:Pop.Anchor="Center"
                        pop:Pop.IsOpen="{Binding IsAddFolderOpen}">
                    <Border Background="#111114" BorderBrush="#26262b" BorderThickness="1"
                            CornerRadius="16" Padding="24,18" Effect="{StaticResource ShadowLg}">
                    <neg:NegiStackPanel Spacing="14">
                        <neg:NegiGrid Columns="Auto * Auto">
                            <materialIcons:MaterialIcon Grid.Column="0" Kind="FolderPlusOutline" Width="22" Height="22"
                                                        Foreground="#fafafa" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <neg:NegiStackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="添加已有目录" FontSize="16" FontWeight="SemiBold" Foreground="#fafafa" />
                                <TextBlock Text="关联本地现成的游戏目录，和启动器自己的目录一起切换"
                                           FontSize="12" Foreground="#a1a1aa" />
                            </neg:NegiStackPanel>
                            <Button Grid.Column="2" Style="{StaticResource WinCtrlStyle}" Width="26" Height="26"
                                    neg:Negi.CornerRadius="7" VerticalAlignment="Top"
                                    Command="{Binding CloseAddFolderCommand}" ToolTip="关闭">
                                <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" />
                            </Button>
                        </neg:NegiGrid>

                        <neg:NegiStackPanel Spacing="6">
                            <TextBlock Text="文件夹路径" FontSize="13" FontWeight="Medium" Foreground="#fafafa" />
                            <neg:NegiGrid Columns="* Auto">
                                <TextBox Grid.Column="0" neg:Negi.CornerRadius="8" Background="#1c1c21" BorderBrush="#26262b"
                                         neg:Negi.Placeholder="例如 D:\Minecraft\mod client\.minecraft"
                                         Text="{Binding NewFolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Stretch" />
                                <Button Grid.Column="1" Style="{StaticResource BtnSmOutlineStyle}" Content="浏览…"
                                        Width="76" Margin="8,0,0,0" Click="OnPickGameFolderClick" />
                            </neg:NegiGrid>
                        </neg:NegiStackPanel>

                        <neg:NegiStackPanel Spacing="6">
                            <TextBlock Text="显示别名" FontSize="13" FontWeight="Medium" Foreground="#fafafa" />
                            <TextBox neg:Negi.CornerRadius="8" Background="#1c1c21" BorderBrush="#26262b"
                                     neg:Negi.Placeholder="留空就用路径末段" Text="{Binding NewFolderName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </neg:NegiStackPanel>

                        <!-- 这句是真校验：路径存不存在、有没有重复、versions 里几个实例。 -->
                        <Border CornerRadius="8" Background="#1c1c21" BorderBrush="#26262b" BorderThickness="1" Padding="10,8">
                            <neg:NegiGrid Columns="Auto *">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="CheckCircleOutline" Width="15" Height="15"
                                                            Foreground="#4ade80" VerticalAlignment="Center" Margin="0,0,8,0"
                                                            Visibility="{Binding NewFolderLooksValid, Converter={StaticResource BoolToVis}}" />
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="AlertCircleOutline" Width="15" Height="15"
                                                            Foreground="#fbbf24" VerticalAlignment="Center" Margin="0,0,8,0"
                                                            Visibility="{Binding NewFolderLooksValid, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                <TextBlock Grid.Column="1" Text="{Binding NewFolderScanHint}" FontSize="12"
                                           Foreground="#d4d4d8" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </neg:NegiGrid>
                        </Border>

                        <neg:NegiStackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <Button Style="{StaticResource BtnSmOutlineStyle}" Content="取消"
                                    Command="{Binding CloseAddFolderCommand}" />
                            <Button Style="{StaticResource BtnSmPrimaryStyle}" Content="确认添加"
                                    Command="{Binding ConfirmAddFolderCommand}" />
                        </neg:NegiStackPanel>
                    </neg:NegiStackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- 拖进来时的整窗提示：只要"松手就导入"这一句，别在用户还没松手时就开始解析。
                 这层不参与命中测试，鼠标的事全部交给窗口那套 DragOver / Drop 处理。 -->
            <Grid Panel.ZIndex="90" Background="#B8000000" IsHitTestVisible="False"
                  Visibility="{Binding IsDropOverlayVisible, Converter={StaticResource BoolToVis}}">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        CornerRadius="20" BorderThickness="2" BorderBrush="#fafafa"
                        Background="#111114" Padding="40,28">
                    <neg:NegiStackPanel Spacing="10" HorizontalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="PackageVariantClosed" Width="34" Height="34"
                                                    Foreground="#fafafa" HorizontalAlignment="Center" />
                        <TextBlock Text="释放以导入整合包" FontSize="16" FontWeight="SemiBold"
                                   Foreground="#fafafa" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding ActiveFolderName, StringFormat=导入到当前文件夹：{0}}"
                                   FontSize="12" Foreground="#a1a1aa" HorizontalAlignment="Center" />
                    </neg:NegiStackPanel>
                </Border>
            </Grid>



            <!-- ========================================== -->
            <!-- 10.6 关闭询问弹窗                            -->
            <!-- ========================================== -->
            <!-- 只有设置里「关闭窗口时 = 每次询问」才会走到这里。三个出口：托盘 / 退出 / 取消；
                 勾了「不再询问」就把这次选的那条写回设置，以后不再弹（设置里随时能改回来）。 -->
            <Grid Panel.ZIndex="74" Visibility="{Binding IsClosePromptOpen, Converter={StaticResource BoolToVis}}">
                <Border Background="#A6000000" MouseLeftButtonDown="OnClosePromptBackdropMouseDown" />

                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="420"
                        Style="{StaticResource PopoverStyle}"
                        pop:Pop.Anchor="Center"
                        pop:Pop.IsOpen="{Binding IsClosePromptOpen}">
                    <Border Background="#111114" BorderBrush="#26262b" BorderThickness="1"
                            CornerRadius="16" Padding="22,20" Effect="{StaticResource ShadowLg}">
                    <neg:NegiStackPanel Spacing="14">
                        <neg:NegiStackPanel Spacing="4">
                            <TextBlock Text="关闭启动器" FontSize="16" FontWeight="SemiBold" Foreground="#fafafa" />
                            <TextBlock Text="收进托盘后，点托盘图标就能再把启动器唤出来；直接退出会连同桌宠一起结束。"
                                       FontSize="13" Foreground="#a1a1aa" TextWrapping="Wrap" LineHeight="20" />
                        </neg:NegiStackPanel>

                        <neg:NegiStackPanel Orientation="Horizontal" Spacing="8">
                            <CheckBox Style="{StaticResource CheckTickStyle}" IsChecked="{Binding ClosePromptRemember}" />
                            <TextBlock Text="不再询问" FontSize="13" Foreground="#a1a1aa" VerticalAlignment="Center" />
                        </neg:NegiStackPanel>

                        <neg:NegiStackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                            <Button Style="{StaticResource BtnSmOutlineStyle}" Content="取消"
                                    Command="{Binding CancelCloseCommand}" />
                            <Button Style="{StaticResource BtnSmDangerFillStyle}" Content="直接退出"
                                    Command="{Binding AnswerCloseCommand}" CommandParameter="exit" />
                            <Button Style="{StaticResource BtnSmPrimaryStyle}" Content="最小化到托盘"
                                    Command="{Binding AnswerCloseCommand}" CommandParameter="tray" />
                        </neg:NegiStackPanel>
                    </neg:NegiStackPanel>
                    </Border>
                </Grid>
            </Grid>

        </Grid>
    </Border>
    </Grid>
</Window>
