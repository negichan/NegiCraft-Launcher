            </ControlTemplate>
        </Setter>
    </ControlTheme>
    <ControlTheme
        TargetType="TextBox"
        x:Key="{x:Type TextBox}">
        <Setter
            Property="Background"
            Value="{DynamicResource CardBackgroundBrush}" />
        <Setter
            Property="Foreground"
            Value="{DynamicResource ForegroundBrush}" />
        <Setter
            Property="BorderBrush"
            Value="{DynamicResource BorderLineBrush}" />
