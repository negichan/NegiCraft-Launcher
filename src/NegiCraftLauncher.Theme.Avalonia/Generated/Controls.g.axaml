            <Setter
                Property="IsVisible"
                Value="True" />
        </Style>
        <Style
            Selector="^.SearchBox:not(:empty) /template/ Button#PART_ClearButton">
            <Setter
                Property="IsVisible"
                Value="True" />
        </Style>
        <Style
            Selector="^.clearButton:not(:empty) /template/ Button#PART_ClearButton">
            <Setter
                Property="IsVisible"
