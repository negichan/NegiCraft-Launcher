            <Setter
                Property="Background"
                Value="#111114" />
            <Setter
                Property="BorderBrush"
                Value="#26262b" />
            <Setter
                Property="FontSize"
                Value="12.5" />
            <Setter
                Property="Padding"
                Value="6,0,6,0" />
            <Setter
                Property="VerticalContentAlignment"
                Value="Center" />
        </Style>
        <Style
