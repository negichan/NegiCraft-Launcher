        <Setter
            Property="CaretBrush"
            Value="{DynamicResource ForegroundBrush}" />
        <Setter
            Property="SelectionBrush"
            Value="{DynamicResource RingBrush}" />
        <Setter
            Property="SelectionForegroundBrush"
            Value="{DynamicResource ForegroundBrush}" />
        <Setter
            Property="FocusAdorner"
