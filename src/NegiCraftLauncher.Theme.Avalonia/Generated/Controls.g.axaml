                                    Width="12"
                                    Height="12"
                                    Fill="#71717a"
                                    Stretch="Uniform"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Button>
                        </Panel>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style
            Selector="^:pointerover /template/ Border#Border">
            <Setter
                Property="BorderBrush"
                Value="{DynamicResource RingBrush}" />
