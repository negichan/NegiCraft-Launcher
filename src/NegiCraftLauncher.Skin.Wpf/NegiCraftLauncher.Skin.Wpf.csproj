<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WPF 侧的皮肤预览控件（软件光栅化 → WriteableBitmap）。
         与 Avalonia 的 NegiCraftLauncher.Skin/Controls/MinecraftSkinPreview 是**两份独立资产**：
         那边内嵌 SkinRenderControl（OpenGlControlBase），WPF 的分层透明窗承载不了子 HWND。
         启动器主页与桌宠共用本工程，所以它不能引用 App.Wpf。 -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>NegiCraftLauncher.Skin.Wpf</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- ⚠️ WPF SDK **没有默认的 Resource 通配**（只默认收 .xaml），字体、图片、图标
         都得显式包含。少了这条，pack://application:,,,/NegiCraftLauncher.Skin.Wpf;component/Assets/Fonts
         会静默回退到系统字体 —— 不报错，只是名牌上的 Jersey 10 变成了 Segoe UI。 -->
    <Resource Include="Assets\Fonts\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- 软件光栅化器与像素层。Raster 只引用 MinecraftSkinRender.Core，不带 SkiaSharp。 -->
    <ProjectReference Include="..\NegiCraftLauncher.Raster\NegiCraftLauncher.Raster.csproj" />
  </ItemGroup>

</Project>
