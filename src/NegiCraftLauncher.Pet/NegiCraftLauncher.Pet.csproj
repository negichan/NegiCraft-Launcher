<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WPF 侧桌宠本体（库）。启动器进程内托管与独立 NegiPet.exe 都用它。
         与 Avalonia 的 NegiCraftLauncher.Pet.Avalonia 是**两份独立资产**：那边是 Window + Panel，
         这边是 WPF Window + Grid，XAML 没有共同编译器。
         共用的是 NegiCraftLauncher.Pet.Core（IPetHost / PetSettings / 全局钩子）。 -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>NegiCraftLauncher.Pet</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NegiCraftLauncher.Pet.Core\NegiCraftLauncher.Pet.Core.csproj" />
    <!-- 图标控件（自写，见 NegiCraftLauncher.Icons.csproj 的说明）。 -->
    <ProjectReference Include="..\NegiCraftLauncher.Icons\NegiCraftLauncher.Icons.csproj" />
    <!-- 软件光栅化的皮肤预览控件，桌宠与启动器主页共用。 -->
    <ProjectReference Include="..\NegiCraftLauncher.Skin\NegiCraftLauncher.Skin.csproj" />
    <!-- 设计 token + 控件主题，桌宠的右键菜单与对话框跟启动器长得一模一样。 -->
    <ProjectReference Include="..\NegiCraftLauncher.Theme\NegiCraftLauncher.Theme.csproj" />
  </ItemGroup>

</Project>
