<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Avalonia metapackage is enough: it ships Avalonia.OpenGL, which OpenGlControlBase needs.
         The platform backends stay in the executables. -->
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\libs\MinecraftSkinRender\MinecraftSkinRender.csproj" />
  </ItemGroup>
</Project>
