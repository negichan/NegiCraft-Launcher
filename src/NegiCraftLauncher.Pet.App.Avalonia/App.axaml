<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NegiCraftLauncher.Pet.App.Avalonia.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <!-- The shared launcher theme, so the pet's menu/dialogs match the launcher exactly. -->
        <StyleInclude Source="avares://NegiCraftLauncher.Theme.Avalonia/Theme.axaml"/>
        <!-- 图标控件不用注册样式：它在 Render 里自绘（默认前景色由控件自己给）。 -->
    </Application.Styles>
</Application>
