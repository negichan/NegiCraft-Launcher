<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- Vendored from Coloryr/MinecraftSkinRender (MIT) @ 8da2c913, released as 1.2.0. See VENDOR.md. -->
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <!-- Upstream code was written without nullable annotations; keep its warnings out of our build. -->
        <NoWarn>$(NoWarn);CS8618</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SkiaSharp" Version="3.119.2" />
    </ItemGroup>

    <ItemGroup>
        <!-- 几何表 / UV 表 / 位姿数学 / 动画都在 Core 里（零依赖），这里只补 OpenGL 与 SkiaSharp 贴图。
             WPF 侧只引用 Core，不引用本工程 —— 那样才不会把 libSkiaSharp 带进 Windows 包。 -->
        <ProjectReference Include="..\MinecraftSkinRender.Core\MinecraftSkinRender.Core.csproj" />
    </ItemGroup>
</Project>
