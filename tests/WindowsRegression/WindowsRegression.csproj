<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SourceRoot Condition="'$(SourceRoot)' == ''">../..</SourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SourceRoot)/src/NegiCraftLauncher.App/Controls/Pop.cs" Link="Pop.cs" />
    <Compile Include="$(SourceRoot)/src/NegiCraftLauncher.App/Controls/PageTransition.cs" Link="PageTransition.cs" />
    <Compile Include="$(SourceRoot)/src/NegiCraftLauncher.App/Controls/SqueezeButton.cs" Link="SqueezeButton.cs" />
    <ProjectReference Include="$(SourceRoot)/src/NegiCraftLauncher.Pet/NegiCraftLauncher.Pet.csproj" />
    <!-- PageTransition 现在要从 ViewModels 里读页面切换的方向（共享层，两端同一份判据）。 -->
    <ProjectReference Include="$(SourceRoot)/src/NegiCraftLauncher.ViewModels/NegiCraftLauncher.ViewModels.csproj" />
  </ItemGroup>
</Project>
