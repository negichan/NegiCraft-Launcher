<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SourceRoot Condition="'$(SourceRoot)' == ''">../..</SourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SourceRoot)/src/NegiCraftLauncher.App/Controls/Pop.cs" Link="Pop.cs" />
    <ProjectReference Include="$(SourceRoot)/src/NegiCraftLauncher.Pet/NegiCraftLauncher.Pet.csproj" />
  </ItemGroup>
</Project>
